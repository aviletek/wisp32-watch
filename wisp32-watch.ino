static long aiConnectSramDeltaBytes = -1;
static unsigned long aiConnectCount = 0;
static unsigned long aiDisconnectCount = 0;
static uint32_t sramFreeAfterBoot = 0;

void connectAiWebSocket() {
  aiState = AI_CONNECTING;
  drawAiOrTranslatorPage();
  uint32_t heapBeforeAiConnect = ESP.getFreeHeap();
  aiClient.onMessage(onAiMessage);
  aiClient.onEvent(onAiEvent);
  aiClient.setInsecure();
  String modelForConnect = translatorPageOpen ? activeTranslatorRealtimeModel : aiRealtimeModel;
  aiActiveProviderIsGemini = aiModelIsGemini(modelForConnect);

  aiClient.clearHeaders();

  bool ok;
  if (aiActiveProviderIsGemini) {
    aiClient.addHeader("Origin", "");
    String url = "wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent?key=" + activeGeminiKey;
    Serial.printf("[AI] connect: model=%s provider=gemini\n", modelForConnect.c_str());
    ok = aiClient.connect(url);
    if (ok) {
      if (translatorPageOpen) sendGeminiTranslatorConversationalSetup();
      else sendGeminiSetup();
    }
  } else {
    aiClient.addHeader("Authorization", "Bearer " + activeOpenAiKey);
    String url = "wss://api.openai.com/v1/realtime?model=" + modelForConnect;
    Serial.printf("[AI] connect: model=%s\n", modelForConnect.c_str());
    ok = aiClient.connect(url);
  }

  if (ok) {
    aiConnectSramDeltaBytes = (long)heapBeforeAiConnect - (long)ESP.getFreeHeap();
    aiConnectCount++;
  }

  if (!ok) {
    Serial.printf("[AI] WebSocket connect failed, free heap=%u, max alloc=%u\n",
                  (unsigned)ESP.getFreeHeap(), (unsigned)ESP.getMaxAllocHeap());
    aiErrorMsg = "Connect failed";
    aiErrorDetail = "";
    aiState = AI_ERROR;
    drawAiOrTranslatorPage();
  }
}

static unsigned long aiPsramAllocCount = 0;
static unsigned long aiPsramFreeCount = 0;

void ensureAiPlayRing() {
  if (aiPlayRing) return;
  Serial.print("[AI] free PSRAM before playback ring alloc: ");
  Serial.println(ESP.getFreePsram());
  size_t tryCap[] = { AI_PLAY_RING_BYTES, 64000UL * 10UL, 64000UL * 5UL, 64000UL * 2UL };
  for (size_t i = 0; i < sizeof(tryCap) / sizeof(tryCap[0]); i++) {
    aiPlayRing = (uint8_t*)ps_malloc(tryCap[i]);
    if (aiPlayRing) { aiPlayRingCap = tryCap[i]; break; }
  }
  if (!aiPlayRing) {
    aiPlayRingCap = 0;
    Serial.println("[AI] playback ring alloc FAILED at every fallback size — no audio will play");
  } else {
    Serial.print("[AI] playback ring alloc ok, bytes=");
    Serial.println(aiPlayRingCap);
    aiPsramAllocCount++;
  }
}

void prepareAiPage() {
  aiPageOpen = true;
  aiState = AI_IDLE;
  requestAudioServerStop();
  aiMemResetPending = true;
  { time_t _n = time(NULL);
    aiChatSessionId = (_n > 1000000000) ? String((unsigned long)_n)
                                        : ("b" + String(aiConnectCount + 1)); }
  aiChatTurnN = 0;
  aiLogSessionStart();
  aiToolHistoryOpen = false;
  aiToolHistoryCount = 0;
  aiTextLineCount = 0;
  aiTextUserLineCount = 0;
  aiTextScrollLine = 0;
  aiRevealedChars = 0;
  micResumeForPage();
  ensureAiTasks();
  ensureAiPlayRing();
  ensureAiRecBuf();
  aiPlayRingReset();
  aiPlayActive = true;
  aiEnsureDeltaQueue();
  aiDeltaTaskActive = true;
  translatorReplaying = false;
  drawAiPage();
}

void connectAiIfNeeded() {
  connectAiWebSocket();
}

void openAiPage() {
  if (featureDisabled("ai")) return;
  wxYieldForUi();
  if (!aiProviderHasKeyFor(aiRealtimeModel, false)) return;
  prepareAiPage();
  if (aiTurnLimitReached()) {
    aiErrorMsg = "Daily AI limit reached";
    aiErrorDetail = "Resets at midnight";
    aiState = AI_ERROR;
    drawAiOrTranslatorPage();
    return;
  }
  connectAiIfNeeded();
}

static void replaySavedCancel();

void closeAiPage() {
  aiPageOpen = false;
  sessionTurnsSet(aiChatSessionId, aiChatTurnN);
  replaySavedCancel();
  aiFlushPendingAudioLogFinalize();
  aiToolHistoryOpen = false;
  aiDeltaTaskActive = false;
  aiPlayActive = false;
  if (aiListening) aiListening = false;
  if (aiOpenAiSendActive) {
    unsigned long openAiSendWaitStart = millis();
    while (aiOpenAiSendActive && millis() - openAiSendWaitStart < 3000) delay(5);
  }
  delay(40);
  if (aiRecBuf) { free(aiRecBuf); aiRecBuf = nullptr; }
  aiDrainDeltaQueue();
  if (aiPlayRing) { free(aiPlayRing); aiPlayRing = nullptr; aiPlayRingCap = 0; aiPsramFreeCount++; }
  aiPlayRingReset();
  if (aiSessionReady) aiDisconnectCount++;
  aiClient.close();
  aiSessionReady = false;
  aiLogSessionEnd();
  aiState = AI_IDLE;
  aiActiveFile = "";
  micParkForPage();
  translatorReplaying = false;
  if (!sdMounted) { drawSdCardMissingScreen(); return; }
  drawClockScreen();
}

void stopAiResponse() {
  Serial.println("[AI] barge-in: stopping response playback");
  aiState = AI_STOPPING;
  drawAiOrTranslatorPage();
  aiResponseCancelled = true;
  replaySavedCancel();

  aiDeltaTaskActive = false;
  delay(15);
  aiDrainDeltaQueue();

  aiPlayActive = false;
  delay(15);
  aiPlayRingReset();
  aiPlayActive = true;
  resetAiPlaybackResampler();
  aiDeltaTaskActive = true;
  if ((aiPageOpen || translatorPageOpen) && aiDisplayModeIndex != AI_DISPLAY_VOICE
      && aiRevealedChars < (int)aiReplyTranscript.length()) {
    aiRewrapTextLines();
    aiRevealedChars = aiReplyTranscript.length();
    if (aiDisplayModeIndex == AI_DISPLAY_SILENT) aiSilentModeAutoFollow();
  }
  aiState = AI_IDLE;
  drawAiOrTranslatorPage();

  if (aiLogActive) aiLogWriteReceivedAudio();
  if (aiLogTurnOpen) aiLogTurnEnd(aiBuildAudioBase(aiUserTranscript));

  if (aiSessionReady && !aiActiveProviderIsGemini) {
    DynamicJsonDocument cancel(64);
    cancel["type"] = "response.cancel";
    String out; serializeJson(cancel, out);
    aiClient.send(out);
  }
}

void replayLastTranslation() {
  if (!aiRecBuf || aiRecFilled == 0) return;
  if (aiState != AI_IDLE && aiState != AI_ERROR) return;
  aiState = AI_SPEAKING;
  translatorReplaying = true;
  drawAiOrTranslatorPage();
  resetAiPlaybackResampler();
  aiPlayRingWrite(aiRecBuf, aiRecFilled);
}

void ensureAiRecBuf() {
  if (aiRecBuf) return;
  aiRecCap = (size_t)AUDIO_SAMPLE_RATE * 2 * 2 * AI_MAX_RECORD_MS / 1000;
  aiRecBuf = (uint8_t*)ps_malloc(aiRecCap);
  if (!aiRecBuf) {
    aiRecCap = 0;
    Serial.println("[AI] recording buffer alloc FAILED — recording unavailable this session");
  } else {
    Serial.print("[AI] recording buffer alloc ok, bytes=");
    Serial.println(aiRecCap);
  }
}

void aiStartListening() {
  if (!audioOk || !micArrayOk || !aiSessionReady) {
    Serial.print("[AI] aiStartListening() bailed: audioOk="); Serial.print(audioOk);
    Serial.print(" micArrayOk="); Serial.print(micArrayOk);
    Serial.print(" aiSessionReady="); Serial.println(aiSessionReady);
    return;
  }
  if (fileTranscribeActive) {
    Serial.println("[AI] aiStartListening() bailed: a file is being transcribed");
    return;
  }
  if (aiState == AI_LISTENING && !aiListening) {
    Serial.println("[AI] aiStartListening() bailed: previous turn's audio still being sent");
