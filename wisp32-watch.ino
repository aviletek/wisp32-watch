    "function apiClear(){"
    "document.getElementById('apiMethodH').value='';document.getElementById('apiUrlH').value='';"
    "document.getElementById('apiHeadersH').value='';document.getElementById('apiAuthTypeH').value='';"
    "document.getElementById('apiAuthKeyNameH').value='';document.getElementById('apiAuthValueH').value='';"
    "document.getElementById('apiBodyH').value='';"
