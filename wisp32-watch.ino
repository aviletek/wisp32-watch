  String fn   = server.hasArg("file") ? server.arg("file") : "";
  String dest = server.hasArg("dest") ? sanitizeDirPath(server.arg("dest")) : "";
  if (fn.length() == 0) { server.sendHeader("Location", "/"); server.send(303); return; }
  int ls = fn.lastIndexOf('/');
  String basename = (ls >= 0) ? fn.substring(ls + 1) : fn;
  String srcDir = (ls > 0) ? fn.substring(0, ls) : "";
  String srcPath = String(KNOWLEDGE_DIR) + "/" + fn;
  String dstPath = String(KNOWLEDGE_DIR) + (dest.length() > 0 ? "/" + dest : "") + "/" + basename;
  if (srcPath != dstPath && SD_MMC.exists(srcPath)) {
    uint8_t buf[512];
    File src = SD_MMC.open(srcPath, FILE_READ);
    File dst = SD_MMC.open(dstPath, FILE_WRITE);
    if (src && dst) {
      while (src.available()) { size_t n = src.read(buf, sizeof(buf)); dst.write(buf, n); }
      src.close(); dst.close();
      SD_MMC.remove(srcPath);
      String srcPw = srcPath + ".pwd";
      if (SD_MMC.exists(srcPw)) SD_MMC.rename(srcPw, dstPath + ".pwd");
      reloadKnowledge();
    } else { if (src) src.close(); if (dst) dst.close(); }
  }
  server.sendHeader("Location", "/" + (srcDir.length() > 0 ? "?path=" + srcDir : String(""))); server.send(303);
}

void handleFileToKB() {
  if (!requireAuth()) return;
  String fn   = server.hasArg("file") ? server.arg("file") : "";
  String dest = server.hasArg("dest") ? sanitizeDirPath(server.arg("dest")) : "";
  if (fn.length() == 0) { server.send(400, "application/json", "{\"ok\":false,\"err\":\"No file given\"}"); return; }
  int ls = fn.lastIndexOf('/');
  String basename = (ls >= 0) ? fn.substring(ls + 1) : fn;
  String srcBase = String(FILES_DIR) + "/" + fn;
  if (SD_MMC.exists(srcBase)) {
    File probe = SD_MMC.open(srcBase, FILE_READ);
    size_t srcSize = probe ? probe.size() : 0;
    if (probe) probe.close();
    if (srcSize > AI_FILE_OPEN_MAX_CHARS) {
      server.send(413, "application/json", "{\"ok\":false,\"err\":\"File too large \\u2014 Knowledge base files must be under 200KB\"}");
      return;
    }
  }
  basename = kbUniqueFilename(dest, basename);
  String dstPath = String(KNOWLEDGE_DIR) + (dest.length() > 0 ? "/" + dest : "") + "/" + basename;
  bool ok = false;
  if (SD_MMC.exists(srcBase)) {
    String content = readKnowledgeFile(srcBase);
    if (writeKnowledgeFile(dstPath, content)) {
      SD_MMC.remove(srcBase);
      kbAiAutoUnlistIfCapReached((dest.length() > 0 ? dest + "/" : "") + basename);
      reloadKnowledge();
      ok = true;
    }
  }
  if (ok) {
    server.send(200, "application/json", "{\"ok\":true}");
  } else {
    server.send(500, "application/json", "{\"ok\":false,\"err\":\"Transfer failed\"}");
  }
}

void handleFileMove() {
  if (!requireAuth()) return;
  String fn = server.hasArg("file") ? server.arg("file") : "";
  String dest = server.hasArg("dest") ? sanitizeDirPath(server.arg("dest")) : "";
  if (fn.length() == 0) { server.send(400, "application/json", "{\"ok\":false,\"err\":\"No file given\"}"); return; }
  int ls = fn.lastIndexOf('/');
  String basename = (ls >= 0) ? fn.substring(ls + 1) : fn;
  String srcBase = String(FILES_DIR) + "/" + fn;
  String dstBase = String(FILES_DIR) + (dest.length() > 0 ? "/" + dest : "") + "/" + basename;
  bool ok = true;
  if (srcBase != dstBase) {
    uint8_t buf[512];
    File src = SD_MMC.open(srcBase, FILE_READ);
    File dst = SD_MMC.open(dstBase, FILE_WRITE);
    if (src && dst) {
      while (src.available()) { size_t n = src.read(buf, sizeof(buf)); dst.write(buf, n); }
      src.close(); dst.close(); SD_MMC.remove(srcBase);
      for (const char* suf : {".meta"}) {
        String os = srcBase + suf, ns = dstBase + suf;
        if (SD_MMC.exists(os)) {
          File ps = SD_MMC.open(os, FILE_READ); File pd = SD_MMC.open(ns, FILE_WRITE);
          if (ps && pd) {
            while (ps.available()) { size_t n = ps.read(buf, sizeof(buf)); pd.write(buf, n); }
            ps.close(); pd.close(); SD_MMC.remove(os);
          } else { if (ps) ps.close(); if (pd) pd.close(); }
        }
      }
    } else { if (src) src.close(); if (dst) dst.close(); ok = false; }
  }
  if (ok) {
    server.send(200, "application/json", "{\"ok\":true}");
  } else {
    server.send(500, "application/json", "{\"ok\":false,\"err\":\"Move failed\"}");
  }
}

void rmDirRecursive(const String& path) {
  File dir = SD_MMC.open(path);
  if (!dir || !dir.isDirectory()) { if (dir) dir.close(); return; }
  File f = dir.openNextFile();
  while (f) {
    String fullName = f.name();
    int ls = fullName.lastIndexOf('/');
    String childName = (ls >= 0) ? fullName.substring(ls + 1) : fullName;
    String childPath = path + "/" + childName;
    bool isDir = f.isDirectory();
    f.close();
    if (isDir) rmDirRecursive(childPath);
    else SD_MMC.remove(childPath);
    f = dir.openNextFile();
  }
  dir.close();
  SD_MMC.rmdir(path);
}

