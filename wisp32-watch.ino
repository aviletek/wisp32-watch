                  fqgInTok, fqgOutTok, fqgCachedTok, fqgThoughtTok, -1, -1, -1, -1, -1, fqgTotalTok, -1, -1);
    return answer.length() > 0 ? answer : "No answer returned.";
  }
  return "Error: file Q&A request failed after retry";
}

#define KB_AIGEN_SAMPLE_MAX   3000
#define KB_AIGEN_SAMPLE_HEAD  1900
#define KB_AIGEN_GUIDE_MAX    300

static String kbAiGenSample(const String& content) {
  int total = (int)content.length();
  if (total <= KB_AIGEN_SAMPLE_MAX) return content;
  int headEnd = content.lastIndexOf('\n', KB_AIGEN_SAMPLE_HEAD);
  if (headEnd < 200) headEnd = KB_AIGEN_SAMPLE_HEAD;
  int tailLen = KB_AIGEN_SAMPLE_MAX - headEnd;
  if (tailLen < 200) return content.substring(0, KB_AIGEN_SAMPLE_MAX);
  int midStart = content.indexOf('\n', total / 2);
  if (midStart < 0 || midStart + 1 + tailLen > total) return content.substring(0, KB_AIGEN_SAMPLE_MAX);
  String s = content.substring(0, headEnd);
  s += "\n\n[... middle of the file omitted ...]\n\n";
  s += content.substring(midStart + 1, midStart + 1 + tailLen);
  return s;
}

static bool kbAiGenAsk(const String& prompt, String* out, String* err) {
  bool gemini = aiModelIsGemini(activeFileQaModel);
  String payload;
  payload.reserve(prompt.length() + 400);
  payload = "{\"model\":\"";
  payload += activeFileQaModel;
  payload += "\",\"input\":\"";
  jsonEscapeAppendTo(payload, prompt);
  payload += "\"";
  if (gemini) {
    String genCfg = "\"max_output_tokens\":2000";
    if (aiFileQaEffort == "minimal" || aiFileQaEffort == "low" ||
        aiFileQaEffort == "medium"  || aiFileQaEffort == "high") {
      genCfg += ",\"thinking_level\":\"" + aiFileQaEffort + "\"";
    }
    payload += ",\"generation_config\":{" + genCfg + "}";
  } else {
    if (aiFileQaEffort != "none") payload += ",\"reasoning\":{\"effort\":\"" + aiFileQaEffort + "\"}";
    payload += ",\"max_output_tokens\":2000";
  }
  payload += "}";

  Serial.printf("[KB] auto-generate: model=%s effort=%s payload=%u bytes, free heap=%u, max alloc=%u\n",
                activeFileQaModel.c_str(), aiFileQaEffort.c_str(), (unsigned)payload.length(),
                (unsigned)ESP.getFreeHeap(), (unsigned)ESP.getMaxAllocHeap());

  HTTPClient http;
  int code = -1;
  for (int netTry = 0; netTry < 2; netTry++) {
    if (gemini) http.begin("https://generativelanguage.googleapis.com/v1beta/interactions?key=" + activeGeminiKey);
    else        http.begin("https://api.openai.com/v1/responses");
    http.setTimeout(45000);
    http.addHeader("Content-Type", "application/json");
    if (!gemini) http.addHeader("Authorization", String("Bearer ") + activeOpenAiKey);
    http.addHeader("Content-Length", String(payload.length()));
    code = http.POST(payload);
    if (code >= 0) break;
    Serial.printf("[KB] auto-generate connection failed, HTTP %d, retrying\n", code);
    http.end();
    delay(400);
  }
  if (code != 200) {
    String body = http.getString();
    http.end();
    Serial.printf("[KB] auto-generate failed, HTTP %d, body: %s\n", code, body.substring(0, 300).c_str());
    *err = (code < 0) ? "Couldn't reach the model. Check the connection and try again."
                      : ("The model returned HTTP " + String(code) + (body.length() > 0 ? (" - " + body.substring(0, 160)) : ""));
    return false;
  }
  String rb = http.getString();
  http.end();
  BasicJsonDocument<PsramJsonAllocator> res(16384);
  if (deserializeJson(res, rb) != DeserializationError::Ok) {
    Serial.print("[KB] auto-generate parse failed, body: "); Serial.println(rb.substring(0, 300));
    *err = "Could not read the model's reply";
    return false;
  }
  *out = "";
  if (gemini) {
    for (JsonObject step : res["steps"].as<JsonArray>()) {
      if (strcmp(step["type"] | "", "model_output") != 0) continue;
      for (JsonObject c : step["content"].as<JsonArray>()) {
        if (strcmp(c["type"] | "", "text") == 0) { *out = String((const char*)(c["text"] | "")); break; }
      }
      if (out->length() > 0) break;
    }
  } else {
    for (JsonObject item : res["output"].as<JsonArray>()) {
      if (strcmp(item["type"] | "", "message") != 0) continue;
      for (JsonObject c : item["content"].as<JsonArray>()) {
        if (strcmp(c["type"] | "", "output_text") == 0) { *out = String((const char*)(c["text"] | "")); break; }
      }
      if (out->length() > 0) break;
    }
  }
  if (out->length() == 0) { *err = "The model returned nothing"; return false; }
  return true;
}

static void kbAiGenParse(const String& raw, String* desc, String* instr) {
  int d = raw.indexOf("DESCRIPTION:");
  int i = raw.indexOf("INSTRUCTIONS:");
  if (d >= 0) {
    int from = d + 12;
    int end = (i > d) ? i : (int)raw.length();
    int nl = raw.indexOf('\n', from);
    if (nl >= 0 && nl < end) end = nl;
    *desc = raw.substring(from, end);
  }
  if (i >= 0) *instr = raw.substring(i + 13);
  desc->trim();
  instr->trim();
  if ((int)desc->length() > KB_AIMETA_DESC_MAX) {
    *desc = desc->substring(0, KB_AIMETA_DESC_MAX);
    int sp = desc->lastIndexOf(' ');
    if (sp > KB_AIMETA_DESC_MAX - 30) *desc = desc->substring(0, sp);
  }
  if ((int)instr->length() > KB_AIMETA_INSTR_MAX) *instr = instr->substring(0, KB_AIMETA_INSTR_MAX);
}

static bool kbAiGenerateMeta(const String& fileRef, String guidance,
                             String curDesc, String curInstr,
                             String* outDesc, String* outInstr, String* outErr) {
  *outDesc = ""; *outInstr = ""; *outErr = "";
  if (!sdMounted)                    { *outErr = "No SD card"; return false; }
  if (WiFi.status() != WL_CONNECTED) { *outErr = "Not connected to WiFi"; return false; }
  if (fileRef.length() == 0 || fileRef.indexOf("..") >= 0) { *outErr = "Bad file reference"; return false; }
  if (kbFindRestrictingPin(fileRef).length() > 0) { *outErr = "This file is PIN restricted"; return false; }
  if (aiFileQaModelIndex == 0 || !aiProviderHasKeyFor(activeFileQaModel, false)) {
    *outErr = "No file Q&A model with a key is set up (Settings > AI Models)";
    return false;
  }
  if (aiSessionReady) { *outErr = "Close the AI Assistant session first, then try again"; return false; }

  String path = String(KNOWLEDGE_DIR) + "/" + fileRef;
  if (!SD_MMC.exists(path)) { *outErr = "File not found on the card"; return false; }

  String sample;
  {
    String content;
    String syncUrl; bool wipeAfterUse = false;
    bool hasSync = kbSyncGet(fileRef, &syncUrl, nullptr, nullptr, nullptr, nullptr, &wipeAfterUse) && syncUrl.length() > 0;
    if (hasSync && wipeAfterUse) {
      String body, ferr;
      if (!kbHttpGet(syncUrl, body, ferr)) { *outErr = "Couldn't reach the file's source (" + ferr + ")"; return false; }
      kbSyncDecryptBodyIfNeeded(body);
      content = sanitizeUtf8(body);
    } else {
      if (hasSync) kbSyncFileIfStale(fileRef);
      content = sanitizeUtf8(readKnowledgeFile(path));
    }
    if (content.length() == 0) { *outErr = "Could not read the file"; return false; }
    sample = sanitizeUtf8(kbAiGenSample(content));
  }

  guidance.trim();
  if ((int)guidance.length() > KB_AIGEN_GUIDE_MAX) guidance = guidance.substring(0, KB_AIGEN_GUIDE_MAX);

  String prompt;
  prompt.reserve(sample.length() + guidance.length() + 1400);
  prompt  = "You are writing the two configuration fields that tell an on-device AI assistant how to use a "
            "file stored on the user's smartwatch.\n\n"
            "Return EXACTLY this shape and nothing else:\n"
            "DESCRIPTION: <one line, at most 160 characters>\n"
            "INSTRUCTIONS: <at most 1000 characters, may span several lines>\n\n"
            "DESCRIPTION is the only thing the assistant sees before it decides whether to open this file, so "
            "it must say what the file is AND when to reach for it, in one line. Write it as a trigger, for "
            "example: \"Current shoe stock. Use for any question about stock, sizes or pricing.\"\n\n"
            "INSTRUCTIONS are sent only after the file has been opened. Explain how to read it: what the "
            "columns or sections mean, what units are used, any field whose name is not self-explanatory, and "
            "how to answer well from it.\n\n"
            "No markdown, no quotes around the values, no preamble.\n\n";
  if (guidance.length() > 0) {
    prompt += "The user has asked for this specifically, and it takes priority over the general advice above:\n";
    prompt += guidance;
    prompt += "\n\n";
  }
  curDesc.trim();
  curInstr.trim();
  if ((int)curDesc.length()  > KB_AIMETA_DESC_MAX)  curDesc  = curDesc.substring(0, KB_AIMETA_DESC_MAX);
  if ((int)curInstr.length() > KB_AIMETA_INSTR_MAX) curInstr = curInstr.substring(0, KB_AIMETA_INSTR_MAX);
  if (curDesc.length() > 0 || curInstr.length() > 0) {
    prompt += "A version of these fields already exists, below. Treat it as a draft to revise rather than "
              "something to ignore: keep what is right about it, and return BOTH fields in full even if one "
              "of them needs no change.\n";
    if (curDesc.length() > 0)  { prompt += "Current DESCRIPTION: ";  prompt += curDesc;  prompt += "\n"; }
    if (curInstr.length() > 0) { prompt += "Current INSTRUCTIONS: "; prompt += curInstr; prompt += "\n"; }
    prompt += "\n";
  }
  prompt += "File name: ";
  prompt += fileRef;
  prompt += "\nA sample of the file follows. It may be an excerpt of a much larger file, so describe the whole "
            "file rather than just the part you can see.\n\n";
  prompt += sample;
  sample = "";

  String raw;
  if (!kbAiGenAsk(prompt, &raw, outErr)) return false;
  prompt = "";
  kbAiGenParse(raw, outDesc, outInstr);
  if (outDesc->length() == 0 && outInstr->length() == 0) {
    Serial.print("[KB] auto-generate: unparseable reply: "); Serial.println(raw.substring(0, 300));
    *outErr = "The model's reply wasn't in the expected format. Try again.";
    return false;
  }
  Serial.printf("[KB] auto-generate: '%s' -> desc %u chars, instr %u chars\n",
                fileRef.c_str(), (unsigned)outDesc->length(), (unsigned)outInstr->length());
  return true;
}

String aiToolDeepThink(String question) {
  question.trim();
  if (question.length() == 0) return "Error: no question provided";

  if (aiModelIsGemini(activeDeepThinkModel)) return aiToolDeepThinkGemini(question);

  HTTPClient http;
  http.begin("https://api.openai.com/v1/chat/completions");
  http.setTimeout(45000);
  http.addHeader("Authorization", String("Bearer ") + activeOpenAiKey);
  http.addHeader("Content-Type", "application/json");

  bool effortSent = (aiDeepThinkEffort != "none");
  String payload = "{\"model\":\"" + activeDeepThinkModel + "\"";
  if (effortSent) {
    payload += ",\"reasoning_effort\":\"" + aiDeepThinkEffort + "\"";
  }
  if (AI_MAX_OUT_TOKENS_VALUES[aiThinkMaxTokIndex] > 0) {
    payload += ",\"max_completion_tokens\":" + String(AI_MAX_OUT_TOKENS_VALUES[aiThinkMaxTokIndex]);
  }
  payload += ",\"messages\":["
    "{\"role\":\"system\",\"content\":\"Answer thoroughly and precisely. This question needs careful, step-by-step reasoning, not a quick guess.\"},"
    "{\"role\":\"user\",\"content\":\"" + jsonEscape(question) + "\"}]}";

  Serial.printf("[AI] deep_think: model=%s effort=%s maxTok=%s payload=%u bytes\n",
                activeDeepThinkModel.c_str(), effortSent ? aiDeepThinkEffort.c_str() : "not sent",
                AI_MAX_OUT_TOKENS_VALUES[aiThinkMaxTokIndex] > 0 ? AI_MAX_OUT_TOKENS_NAMES[aiThinkMaxTokIndex] : "not sent",
                (unsigned)payload.length());

  int code = http.POST(payload);
  taskRebootOnHttpDashOne(code);
  if (code != 200) {
    String errBody = http.getString();
    http.end();
    Serial.print("[AI] deep_think failed, HTTP "); Serial.print(code);
    Serial.print(", body: "); Serial.println(errBody.substring(0, 500));
    return "Error: deep think request failed (HTTP " + String(code) + ")";
  }
  String rb = http.getString();
  http.end();

  BasicJsonDocument<PsramJsonAllocator> res(16384);
  DeserializationError err = deserializeJson(res, rb);
  if (err != DeserializationError::Ok) {
    Serial.print("[AI] deep_think response parse failed: "); Serial.println(err.c_str());
    Serial.print("[AI] response body (first 500 chars): "); Serial.println(rb.substring(0, 500));
    return "Error: could not parse response";
  }
  String answer = res["choices"][0]["message"]["content"] | "";
  int dtPromptTok = res["usage"]["prompt_tokens"] | 0;
  int dtCachedTok = res["usage"]["prompt_tokens_details"]["cached_tokens"] | 0;
  int dtComplTok = res["usage"]["completion_tokens"] | 0;
  int dtReasonTok = res["usage"]["completion_tokens_details"]["reasoning_tokens"] | 0;
  int dtTotalTok = res["usage"]["total_tokens"] | 0;
  Serial.printf("[AI] deep_think: tokens prompt=%d (cached=%d) completion=%d (reasoning=%d) total=%d\n",
                dtPromptTok, dtCachedTok, dtComplTok, dtReasonTok, dtTotalTok);
  logTokenUsage("deepthink", "", "openai", activeDeepThinkModel,
                AI_MAX_OUT_TOKENS_VALUES[aiThinkMaxTokIndex] > 0 ? AI_MAX_OUT_TOKENS_VALUES[aiThinkMaxTokIndex] : -1,
                dtPromptTok, dtComplTok, dtCachedTok, dtReasonTok, -1, -1, -1, -1, -1, dtTotalTok, -1, -1);
  return answer.length() > 0 ? answer : "No answer returned.";
}

String aiToolDeepThinkGemini(String question) {
  bool effortSent = (aiDeepThinkEffort == "minimal" || aiDeepThinkEffort == "low" ||
                      aiDeepThinkEffort == "medium" || aiDeepThinkEffort == "high");
  String genCfg;
  if (effortSent) genCfg += "\"thinking_level\":\"" + aiDeepThinkEffort + "\"";
  if (AI_MAX_OUT_TOKENS_VALUES[aiThinkMaxTokIndex] > 0) {
    if (genCfg.length() > 0) genCfg += ",";
    genCfg += "\"max_output_tokens\":" + String(AI_MAX_OUT_TOKENS_VALUES[aiThinkMaxTokIndex]);
  }
  String payload = "{\"model\":\"" + activeDeepThinkModel + "\",\"system_instruction\":\""
    "Answer thoroughly and precisely. This question needs careful, step-by-step reasoning, not a quick guess.\","
    "\"input\":\"" + jsonEscape(question) + "\"";
  if (genCfg.length() > 0) payload += ",\"generation_config\":{" + genCfg + "}";
  payload += "}";

  Serial.printf("[AI] deep_think (gemini): model=%s thinking=%s maxTok=%s payload=%u bytes\n",
                activeDeepThinkModel.c_str(), effortSent ? aiDeepThinkEffort.c_str() : "not sent",
                AI_MAX_OUT_TOKENS_VALUES[aiThinkMaxTokIndex] > 0 ? AI_MAX_OUT_TOKENS_NAMES[aiThinkMaxTokIndex] : "not sent",
                (unsigned)payload.length());

  HTTPClient http;
  http.begin("https://generativelanguage.googleapis.com/v1beta/interactions?key=" + activeGeminiKey);
  http.setTimeout(45000);
  http.addHeader("Content-Type", "application/json");

  int code = http.POST(payload);
  taskRebootOnHttpDashOne(code);
  if (code != 200) {
    String errBody = http.getString();
    http.end();
    Serial.print("[AI] deep_think (gemini) failed, HTTP "); Serial.print(code);
    Serial.print(", body: "); Serial.println(errBody.substring(0, 500));
    return "Error: deep think request failed (HTTP " + String(code) + ")";
  }
  String rb = http.getString();
  http.end();

  BasicJsonDocument<PsramJsonAllocator> res(16384);
  DeserializationError err = deserializeJson(res, rb);
  if (err != DeserializationError::Ok) {
    Serial.print("[AI] deep_think (gemini) response parse failed: "); Serial.println(err.c_str());
    Serial.print("[AI] response body (first 500 chars): "); Serial.println(rb.substring(0, 500));
    return "Error: could not parse response";
  }
  String answer = "";
  for (JsonObject step : res["steps"].as<JsonArray>()) {
    if (strcmp(step["type"] | "", "model_output") == 0) {
      for (JsonObject c : step["content"].as<JsonArray>()) {
        if (strcmp(c["type"] | "", "text") == 0) {
          answer = String((const char*)(c["text"] | ""));
          break;
        }
      }
      if (answer.length() > 0) break;
