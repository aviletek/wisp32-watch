    wxSlot1 = wxSlotFromArg("wxSlot1", wxSlot1);
    wxSlot2 = wxSlotFromArg("wxSlot2", wxSlot2);
    wxSlot3 = wxSlotFromArg("wxSlot3", wxSlot3);
