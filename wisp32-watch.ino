void saveCredentials() {
  if (!sdMounted) return;
  DynamicJsonDocument doc(8192);
  doc["openai_key"] = activeOpenAiKey;
  doc["gemini_key"] = activeGeminiKey;
  doc["web_password"] = activeWebPassword;
  doc["device_lock_pin"] = activeDeviceLockPin;
  doc["notify_email"] = activeNotifyEmail;
  doc["notify_app_password"] = activeNotifyAppPassword;
  doc["notify_smtp_host"] = activeNotifySmtpHost;
  doc["notify_smtp_port"] = activeNotifySmtpPort;
  doc["email_default_subject"] = activeEmailDefaultSubject;
  doc["email_signature"] = activeEmailSignature;
  JsonArray nets = doc.createNestedArray("wifi_networks");
  for (int i = 0; i < activeWifiNetworkCount; i++) {
    JsonObject n = nets.createNestedObject();
    n["ssid"] = activeWifiNetworks[i].ssid;
    n["pass"] = activeWifiNetworks[i].pass;
  }
  JsonArray keys = doc.createNestedArray("custom_keys");
  for (int i = 0; i < activeCustomKeyCount; i++) {
    JsonObject k = keys.createNestedObject();
    k["name"]  = activeCustomKeys[i].name;
    k["value"] = activeCustomKeys[i].value;
  }
  String out; serializeJson(doc, out);
  writeCredentialsFile(out);
}

void loadCredentials() {
  if (!sdMounted) return;
  if (SD_MMC.exists(CREDENTIALS_FILE)) {
    bool wasPlaintext = false;
    String raw = readCredentialsFile(&wasPlaintext);
    DynamicJsonDocument doc(8192);
    if (deserializeJson(doc, raw) == DeserializationError::Ok) {
      activeOpenAiKey      = String((const char*)(doc["openai_key"]      | ""));
      activeGeminiKey      = String((const char*)(doc["gemini_key"]      | ""));
      activeWebPassword    = String((const char*)(doc["web_password"]    | ""));
      activeDeviceLockPin  = String((const char*)(doc["device_lock_pin"] | ""));
      activeNotifyEmail       = String((const char*)(doc["notify_email"]        | ""));
      activeNotifyAppPassword = String((const char*)(doc["notify_app_password"] | ""));
      activeNotifySmtpHost    = String((const char*)(doc["notify_smtp_host"]    | "smtp.gmail.com"));
      activeNotifySmtpPort    = doc["notify_smtp_port"] | 465;
      activeEmailDefaultSubject = String((const char*)(doc["email_default_subject"] | "Message from your badge"));
      activeEmailSignature      = String((const char*)(doc["email_signature"]        | ""));
      activeWifiNetworkCount = 0;
      JsonArray nets = doc["wifi_networks"].as<JsonArray>();
      for (JsonObject n : nets) {
        if (!activeWifiNetworks || activeWifiNetworkCount >= MAX_WIFI_NETWORKS) break;
        activeWifiNetworks[activeWifiNetworkCount].ssid = String((const char*)(n["ssid"] | ""));
        activeWifiNetworks[activeWifiNetworkCount].pass = String((const char*)(n["pass"] | ""));
        activeWifiNetworkCount++;
      }
      activeCustomKeyCount = 0;
      JsonArray keys = doc["custom_keys"].as<JsonArray>();
      for (JsonObject k : keys) {
        if (!activeCustomKeys || activeCustomKeyCount >= MAX_CUSTOM_KEYS) break;
        String kn = String((const char*)(k["name"] | ""));
        if (kn.length() == 0) continue;
        activeCustomKeys[activeCustomKeyCount].name  = kn;
        activeCustomKeys[activeCustomKeyCount].value = String((const char*)(k["value"] | ""));
        activeCustomKeyCount++;
      }
      Serial.println("[Credentials] loaded from SD");
      if (wasPlaintext) {
        Serial.println("[Credentials] credentials.json under the wrong/legacy key — re-saving under the current key");
        saveCredentials();
      }
      return;
    }
    Serial.println("[Credentials] credentials.json unreadable — using empty defaults in memory only");
  }
  activeOpenAiKey     = "";
  activeGeminiKey     = "";
  activeWebPassword   = "";
  activeWifiNetworkCount = 0;
  bool credentialsFileExists = SD_MMC.exists(CREDENTIALS_FILE);
  if (sdCardRecognized && !credentialsFileExists) {
    saveCredentials();
    Serial.println("[Credentials] no credentials.json — seeded empty and saved to SD");
  } else if (sdCardRecognized && credentialsFileExists) {
    Serial.println("[Credentials] EXISTING credentials.json could not be read — using empty defaults in memory only.");
    Serial.println("[Credentials] The file on the card was left untouched. Do NOT save credentials until the read failure is understood, or the blanks will replace it.");
  } else {
    Serial.println("[Credentials] unrecognized SD card — using empty defaults in memory only, NOT saved to card");
  }
}

