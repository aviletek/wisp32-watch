  if (aiNoteTitleModelIndex != 0) {
    for (int i = 0; i < aiNoteTitleModelCount; i++) {
      if (aiModelIsGemini(aiNoteTitleModels[i]) == wantGemini) {
        aiNoteTitleModelIndex = i + 1;
        activeNoteTitleModel = aiNoteTitleModels[i];
        break;
      }
    }
  }
  if (aiFileQaModelIndex != 0) {
    for (int i = 0; i < aiFileQaModelCount; i++) {
      if (aiModelIsGemini(aiFileQaModels[i]) == wantGemini) {
        aiFileQaModelIndex = i + 1;
        activeFileQaModel = aiFileQaModels[i];
        break;
      }
