static void _drawWifiSetupInstructions(bool cancelable) {
  gfx->fillScreen(COLOR_BLACK);
  _clockCenterPrint("WiFi Setup", 50, 3, COLOR_WHITE);
  IPAddress apIp = WiFi.softAPIP();
  _clockCenterPrint("1. Connect to WiFi Network:", 130, 2, COLOR_GRAY);
  _clockCenterPrint("Watch-Setup", 165, 3, COLOR_BLUE);
  _clockCenterPrint("2. Open a browser to:", 220, 2, COLOR_GRAY);
  _clockCenterPrint(apIp.toString().c_str(), 255, 3, COLOR_BLUE);
  if (cancelable) _clockCenterPrint("Tap anywhere to cancel", SCREEN_HEIGHT - 50, 2, COLOR_GRAY);
  else            _clockCenterPrint("Swipe down for Settings", SCREEN_HEIGHT - 50, 2, COLOR_GRAY);
