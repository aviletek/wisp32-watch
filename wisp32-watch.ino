#define PCF85063_I2C_ADDR 0x51

static uint8_t _pcfBcd2dec(uint8_t bcd) { return ((bcd >> 4) * 10) + (bcd & 0x0F); }
static uint8_t _pcfDec2bcd(uint8_t dec) { return ((dec / 10) << 4) | (dec % 10); }

static bool pcf85063ReadTime(struct tm* out) {
  Wire.beginTransmission(PCF85063_I2C_ADDR);
  Wire.write(0x04);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom((int)PCF85063_I2C_ADDR, 7) != 7) return false;
  uint8_t sec = Wire.read(), mn = Wire.read(), hr = Wire.read();
  uint8_t day = Wire.read(); Wire.read();
  uint8_t mon = Wire.read(), yr = Wire.read();
  if (sec & 0x80) return false;

  memset(out, 0, sizeof(struct tm));
  out->tm_sec  = _pcfBcd2dec(sec & 0x7F);
  out->tm_min  = _pcfBcd2dec(mn & 0x7F);
  out->tm_hour = _pcfBcd2dec(hr & 0x3F);
  out->tm_mday = _pcfBcd2dec(day & 0x3F);
  out->tm_mon  = _pcfBcd2dec(mon & 0x1F) - 1;
  out->tm_year = _pcfBcd2dec(yr) + 100;
  out->tm_isdst = -1;
  return true;
}

static bool pcf85063WriteTime(const struct tm* t) {
  Wire.beginTransmission(PCF85063_I2C_ADDR);
  Wire.write(0x04);
  Wire.write(_pcfDec2bcd((uint8_t)t->tm_sec));
  Wire.write(_pcfDec2bcd((uint8_t)t->tm_min));
  Wire.write(_pcfDec2bcd((uint8_t)t->tm_hour));
  Wire.write(_pcfDec2bcd((uint8_t)t->tm_mday));
  Wire.write((uint8_t)0);
  Wire.write(_pcfDec2bcd((uint8_t)(t->tm_mon + 1)));
  Wire.write(_pcfDec2bcd((uint8_t)(t->tm_year % 100)));
  return Wire.endTransmission() == 0;
}

static time_t utcTmToEpoch(const struct tm* t) {
  int year = t->tm_year + 1900;
  int mon  = t->tm_mon + 1;
  int y = year - (mon <= 2 ? 1 : 0);
  long era = (y >= 0 ? y : y - 399) / 400;
  unsigned yoe = (unsigned)(y - era * 400);
  unsigned doy = (unsigned)((153 * (mon + (mon > 2 ? -3 : 9)) + 2) / 5 + t->tm_mday - 1);
  unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
  long days = era * 146097L + (long)doe - 719468L;
  return (time_t)(days * 86400L + t->tm_hour * 3600L + t->tm_min * 60L + t->tm_sec);
}

static void pcf85063SyncToSystemClock() {
  struct tm t;
  if (!pcf85063ReadTime(&t)) return;
  if (t.tm_year < (2024 - 1900) || t.tm_year > (2099 - 1900)) return;
  time_t epoch = utcTmToEpoch(&t);
  struct timeval tv = { epoch, 0 };
  settimeofday(&tv, NULL);
}

static void pcf85063SyncFromSystemClock() {
  time_t now = time(NULL);
  struct tm t;
  gmtime_r(&now, &t);
  pcf85063WriteTime(&t);
}

