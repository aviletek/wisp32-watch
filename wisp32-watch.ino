void handleSaveConfig() {
  if (!requireAuth()) return;
  if (server.hasArg("lat")) clockLat = server.arg("lat").toDouble();
  if (server.hasArg("lon")) clockLon = server.arg("lon").toDouble();
  auto wxSlotFromArg = [](const char* argName, int fallback) -> int {
    if (!server.hasArg(argName)) return fallback;
    String v = server.arg(argName);
    for (int i = 0; i < WX_COUNT; i++) { if (v == WX_DATAPOINT_NAMES[i]) return i; }
    return fallback;
  };
  wxSlot1 = wxSlotFromArg("wxSlot1", wxSlot1);
  wxSlot2 = wxSlotFromArg("wxSlot2", wxSlot2);
  wxSlot3 = wxSlotFromArg("wxSlot3", wxSlot3);
  wxSlot4 = wxSlotFromArg("wxSlot4", wxSlot4);
  if (server.hasArg("clockIdMode")) {
    int v = server.arg("clockIdMode").toInt();
    if (v >= CLOCK_ID_NAME && v <= CLOCK_ID_CUSTOM) clockIdMode = v;
  }
  if (server.hasArg("ipText")) { clockIpCustomText = server.arg("ipText"); clockIpCustomText.trim(); }
  if (server.hasArg("colorWhite")) COLOR_WHITE = hexToRgb565(server.arg("colorWhite"));
  if (server.hasArg("colorBlue"))  COLOR_BLUE  = hexToRgb565(server.arg("colorBlue"));
  if (server.hasArg("colorBlack")) COLOR_BLACK = hexToRgb565(server.arg("colorBlack"));
  if (server.hasArg("navOrder")) activeNavOrder = server.arg("navOrder");
  if (server.hasArg("navHidden")) activeNavHidden = server.arg("navHidden");
  if (server.hasArg("featuresOff")) activeFeaturesDisabled = server.arg("featuresOff");

  aiShowOriginTags   = server.hasArg("showTags") && server.arg("showTags") == "1";
  aiRecordAiResponse = server.hasArg("recAi")    && server.arg("recAi")    == "1";
  aiRecordUserInput  = server.hasArg("recUser")  && server.arg("recUser")  == "1";
  if (!aiRecordAiResponse) aiRecordUserInput = false;
  if (server.hasArg("replayMode")) aiReplayMode = (uint8_t)constrain(server.arg("replayMode").toInt(), 0, 2);
  if (server.hasArg("replayModel")) { aiReplayMatchModel = server.arg("replayModel"); aiReplayMatchModel.trim(); }
  if (server.hasArg("replayPrompt")) {
    String rp = server.arg("replayPrompt"); rp.trim();
    if (rp.length() == 0 || rp == String(DEFAULT_REPLAY_MATCH_PROMPT)) {
      customReplayMatchPrompt = "";
      if (sdMounted && SD_MMC.exists(PROMPT_REPLAYMATCH_FILE)) SD_MMC.remove(PROMPT_REPLAYMATCH_FILE);
    } else {
      customReplayMatchPrompt = rp;
      if (sdMounted) writeKnowledgeFile(PROMPT_REPLAYMATCH_FILE, rp);
    }
  }

  recomputeDerivedColors();
  saveSettings();
  redrawCurrentPage();
  if (server.hasArg("ajax")) server.send(200, "text/plain", "ok");
  else redirectWithSaveMessage("/configuration", "Saved");
}

