void drawClockScreen() {
  weatherPaused = false;
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) {
    gfx->fillScreen(COLOR_BLACK);
    _drawStatusRow();
    gfx->setTextColor(COLOR_BLUE, COLOR_BLACK);
    gfx->setTextSize(2);
    gfx->setCursor(20, SCREEN_HEIGHT / 2);
    gfx->print("No time sync");
    return;
  }
  gfx->fillScreen(COLOR_BLACK);
  _drawStatusRow();

  char timeStr[10]; strftime(timeStr, sizeof(timeStr), "%H:%M", &timeinfo);
  char dateStr[24]; uiFormatClockDate(dateStr, sizeof(dateStr), timeinfo);

  const int dateY = 85, dateSize = 4;
  gfx->setTextSize(dateSize);
  int16_t dx, dy; uint16_t dw, dh;
  gfx->getTextBounds(dateStr, 0, 0, &dx, &dy, &dw, &dh);
  gfx->setTextColor(CLK_DATE_COLOR, COLOR_BLACK);
  gfx->setCursor((SCREEN_WIDTH - (int)dw) / 2, dateY);
  gfx->print(dateStr);

  const int timeY = dateY + (int)dh + 10 + 10 + 10;
  gfx->setTextSize(8);
  int16_t tx, ty; uint16_t tw, th;
  gfx->getTextBounds(timeStr, 0, 0, &tx, &ty, &tw, &th);
  gfx->setTextColor(CLK_TIME_COLOR, COLOR_BLACK);
  gfx->setCursor((SCREEN_WIDTH - tw) / 2, timeY);
  gfx->print(timeStr);

  const int wxSize = 3;
  const int tempY = timeY + (int)th + 10 + 15;
  int weatherBottomY = tempY + 24;
  int wxCurY = tempY;
  bool clockLocked = deviceLockedForAuth();

  if (clockLocked) {
    _clockCenterPrint("SD Card Locked", wxCurY, 2, COLOR_RED, 12);
    weatherBottomY = wxCurY + 16;
    wxCurY = weatherBottomY + 14;
    _clockCenterPrint("Log in via web to unlock", wxCurY, 2, CLK_DATE_COLOR, 12);
    weatherBottomY = wxCurY + 16;
  } else {
    bool wxOff = featureDisabled("weather");
    int wxLineSlots[2] = { wxOff ? WX_NONE : wxSlot1, wxOff ? WX_NONE : wxSlot2 };
    for (int i = 0; i < 2; i++) {
      int dp = wxLineSlots[i];
      if (dp == WX_NONE) continue;
      if (dp == WX_TEMP && clockTempC == -999) continue;
      String text = wxSlotFullText(dp, timeinfo);
      if (text.length() == 0) continue;
      gfx->setTextSize(wxSize);
      int16_t ex, ey; uint16_t ew, eh;
      gfx->getTextBounds(text.c_str(), 0, 0, &ex, &ey, &ew, &eh);
      _clockCenterPrint(text.c_str(), wxCurY, wxSize, CLK_DATE_COLOR);
      weatherBottomY = wxCurY + (int)eh;
      wxCurY = weatherBottomY + 11;
    }
  }

  const int rainSunRowY = 400;
  _drawWifiIcon((weatherBottomY + rainSunRowY) / 2 - 15, WiFi.status() == WL_CONNECTED);

  struct WxRowItem { bool have = false; String text = ""; };
  auto buildRowItem = [&](int dp) -> WxRowItem {
    WxRowItem it;
    if (dp == WX_NONE) return it;
    String t = wxSlotFullText(dp, timeinfo);
    if (t.length() == 0) return it;
    it.have = true; it.text = t;
    return it;
  };

  bool wxRowOff = clockLocked || featureDisabled("weather");
  WxRowItem leftItem  = wxRowOff ? WxRowItem() : buildRowItem(wxSlot3);
  WxRowItem rightItem = wxRowOff ? WxRowItem() : buildRowItem(wxSlot4);

  if (leftItem.have || rightItem.have) {
    const int rowY = rainSunRowY, sz = wxSize;
    const int groupGap = 34;
    gfx->setTextSize(sz);
    int16_t bx, by; uint16_t leftTextW = 0, rightTextW = 0, bh;
    if (leftItem.have)  gfx->getTextBounds(leftItem.text.c_str(), 0, 0, &bx, &by, &leftTextW, &bh);
    if (rightItem.have) gfx->getTextBounds(rightItem.text.c_str(), 0, 0, &bx, &by, &rightTextW, &bh);

    int leftGroupW  = leftItem.have  ? (int)leftTextW  : 0;
    int rightGroupW = rightItem.have ? (int)rightTextW : 0;
    int totalW = leftGroupW + (leftItem.have && rightItem.have ? groupGap : 0) + rightGroupW;
    int x = (SCREEN_WIDTH - totalW) / 2;

    gfx->setTextColor(CLK_DATE_COLOR, COLOR_BLACK);
    if (leftItem.have) {
      gfx->setCursor(x, rowY);
      gfx->print(leftItem.text);
      x += leftGroupW + groupGap;
    }
    if (rightItem.have) {
      gfx->setCursor(x, rowY);
      gfx->print(rightItem.text);
    }
  }

  drawDevicePlaybackStatusFrame();
}

static void drawDevicePlaybackStatusFrame() {
  const int y = SCREEN_HEIGHT - 40;
  gfx->fillRect(0, y - 20, SCREEN_WIDTH, 28, COLOR_BLACK);
  if (!devicePlaybackActive || devicePlaybackScrollText.length() == 0) return;
  gfx->setTextSize(2);
  gfx->setTextWrap(false);
  gfx->setTextColor(CLK_DATE_COLOR, COLOR_BLACK);
  int x = devicePlaybackScrolls ? devicePlaybackScrollX : (SCREEN_WIDTH - devicePlaybackScrollTextWidth) / 2;
  gfx->setCursor(x, y);
  gfx->print(devicePlaybackScrollText);
}

