  }
}

void aiNetToolTaskFn(void* pv) {
  for (;;) {
    if (!aiNetToolActive) { vTaskDelay(pdMS_TO_TICKS(20)); continue; }

    if (_netMutex) xSemaphoreTake(_netMutex, portMAX_DELAY);
    {
      DynamicJsonDocument argsDoc(aiNetToolArgsJson.length() + 512);
      DeserializationError argsErr = deserializeJson(argsDoc, aiNetToolArgsJson);
      if (argsErr) {
        aiNetToolResult = "Error: could not read tool arguments";
      } else {
        if (!aiRunToolCall(aiNetToolName.c_str(), argsDoc.as<JsonVariantConst>(), aiNetToolResult, true, true)) {
          aiNetToolResult = "Error: unknown tool";
        }
      }
    }
    if (_netMutex) xSemaphoreGive(_netMutex);
    aiNetToolArgsJson = "";
    aiNetToolActive = false;
    aiNetToolDone = true;
  }
}

static bool aiToolIsAsyncNetwork(const char* name) {
  return strcmp(name, "deep_think") == 0
      || strcmp(name, "ask_file_question") == 0;
}

void aiStartNetToolAsync(const char* name, const String& argsJson, const String& argsPreview,
                         const String& callId, bool replyIsGemini) {
  aiNetToolName = name;
  aiNetToolArgsJson = argsJson;
  aiNetToolArgsPreview = argsPreview;
  aiNetToolCallId = callId;
  aiNetToolReplyIsGemini = replyIsGemini;
  aiNetToolStartMs = millis();

  aiInsertOriginTag(name);

  if      (strcmp(name, "deep_think")        == 0) aiNetToolLabel = "Deep Thinking...";
  else if (strcmp(name, "ask_file_question") == 0) aiNetToolLabel = "Reading File...";
  else                                             aiNetToolLabel = "Tool Call...";
  aiToolLabel = aiNetToolLabel;
  aiState = AI_TOOL_CALL;
  drawAiPage();
  if (displayOn) gfx->flush();

  Serial.print("[AI] tool call (async): "); Serial.print(name);
  Serial.print(" args="); Serial.println(argsPreview);

  netToolHeapBefore = ESP.getFreeHeap();
  netToolActive = true;
  netToolStartCount++;
  strncpy(netToolLastLabel, aiNetToolLabel.c_str(), sizeof(netToolLastLabel) - 1);
  netToolLastLabel[sizeof(netToolLastLabel) - 1] = '\0';

  aiNetToolResult = "";
  aiNetToolDone = false;
  if (!aiNetToolTaskHandle) {
    if (!aiNetToolStack) aiNetToolStack = (StackType_t*)ps_malloc(AI_NETTOOL_STACK_BYTES);
    bool ok = false;
    if (aiNetToolStack) {
      aiNetToolTaskHandle = xTaskCreateStaticPinnedToCore(aiNetToolTaskFn, "aiNetTool",
                              AI_NETTOOL_STACK_BYTES, NULL, 1, aiNetToolStack, &aiNetToolTCB, 1);
      ok = (aiNetToolTaskHandle != nullptr);
      if (ok) Serial.println("[AI] net tool task created (8KB stack in PSRAM)");
    }
    if (!ok) {
      Serial.println("[AI] net tool PSRAM stack unavailable — falling back to internal");
      ok = (xTaskCreatePinnedToCore(aiNetToolTaskFn, "aiNetTool", AI_NETTOOL_STACK_BYTES,
                                    NULL, 1, &aiNetToolTaskHandle, 1) == pdPASS);
    }
    if (!ok) {
      aiNetToolResult = "Error: could not start tool (out of memory)";
      aiNetToolTaskHandle = nullptr;
      aiNetToolDone = true;
      return;
    }
  }
  aiNetToolActive = true;
}

#define TASK_MAX_STEPS 8
#define TASK_SYSTEM_PREAMBLE \
  "You are executing an unattended task with no user present to ask questions or approve " \
  "actions. If any detail is unspecified (language, tone, format, filenames, etc.), make " \
  "the most reasonable choice yourself and proceed — never end a turn with a question, " \
  "since there is no one to answer it. Only stop early if the task is genuinely impossible " \
  "to complete, and explain why in your final answer instead of asking what to do. " \
  "Your final answer is the only record of this run a person will actually read — write it " \
  "as if they never saw any of the intermediate tool calls. Include the real content you " \
  "gathered (the actual search results, figures, names, numbers, quotes — whatever the task " \
  "produced), not just a step-by-step \"step 1 done, step 2 done\" recap confirming actions " \
  "happened. A person reading only this answer should learn what you found, not merely that " \
  "you looked. The same standard applies to anything you hand to a tool that a person will " \
  "read, such as an email body: write it as a clean, human-readable message using the real " \
  "information you gathered, never by pasting raw data (JSON, CSV rows, API responses) " \
  "verbatim into what they'll see."

static String taskSystemPreambleWithDate() {
  String p = TASK_SYSTEM_PREAMBLE;
  struct tm ti;
  if (getLocalTime(&ti)) {
    char buf[40]; strftime(buf, sizeof(buf), "%A %B %d %Y, %H:%M", &ti);
    p += "\n\nCurrent date and time: " + String(buf);
  }
  return p;
}

String taskRunOpenAI(const String& model, const String& instructions, String* status) {
  *status = "ok";
  BasicJsonDocument<PsramJsonAllocator> inputDoc(16384);
  JsonArray input = inputDoc.to<JsonArray>();
  {
    JsonObject item = input.createNestedObject();
    item["role"] = "user";
    item["content"] = instructions;
  }

  String lastText = "";
  bool hadToolError = false;
  for (int step = 0; step < TASK_MAX_STEPS; step++) {
    BasicJsonDocument<PsramJsonAllocator> payloadDoc(24576);
    payloadDoc["model"] = model;
    payloadDoc["instructions"] = taskSystemPreambleWithDate();
    payloadDoc["input"] = input;
    JsonArray tools = payloadDoc.createNestedArray("tools");
    aiBuildToolsArray(tools, false);
    size_t payloadLen = measureJson(payloadDoc);
    char* payload = (char*)ps_malloc(payloadLen + 1);
    if (!payload) { *status = "error: out of memory"; return lastText; }
    serializeJson(payloadDoc, payload, payloadLen + 1);

    Serial.printf("[Task] OpenAI step %d: model=%s payload=%u bytes, free heap=%u, max alloc=%u, free psram=%u\n",
                  step, model.c_str(), (unsigned)payloadLen, (unsigned)ESP.getFreeHeap(), (unsigned)ESP.getMaxAllocHeap(), (unsigned)ESP.getFreePsram());

    int code = 0;
    String respBody;
    for (int attempt = 0; attempt <= aiTaskRetries; attempt++) {
      HTTPClient http;
      http.begin("https://api.openai.com/v1/responses");
      http.setReuse(false);
      http.setTimeout(30000);
      http.addHeader("Authorization", String("Bearer ") + activeOpenAiKey);
      http.addHeader("Content-Type", "application/json");
      code = http.POST((uint8_t*)payload, payloadLen);
      taskRebootOnHttpDashOne(code);
      if (code == 200) { respBody = http.getString(); http.end(); break; }
      String errBody = http.getString();
      http.end();
      Serial.printf("[Task] OpenAI step %d attempt %d failed, HTTP %d, free heap=%u, max alloc=%u: %s\n",
                    step, attempt, code, (unsigned)ESP.getFreeHeap(), (unsigned)ESP.getMaxAllocHeap(), errBody.substring(0, 300).c_str());
    }
    free(payload);
    if (code != 200) {
      *status = "error: HTTP " + String(code);
      return lastText;
    }

    BasicJsonDocument<PsramJsonAllocator> respDoc(24576);
    if (deserializeJson(respDoc, respBody) != DeserializationError::Ok) {
      *status = "error: bad response JSON";
      return lastText;
    }

    bool hadToolCall = false;
    JsonArray output = respDoc["output"].as<JsonArray>();
    for (JsonObject item : output) {
      const char* type = item["type"] | "";
      if (strcmp(type, "function_call") == 0) {
        hadToolCall = true;
        const char* name = item["name"] | "";
        const char* callId = item["call_id"] | "";
        const char* argsStr = item["arguments"] | "{}";
        BasicJsonDocument<PsramJsonAllocator> argsDoc(1024);
        deserializeJson(argsDoc, argsStr);
        String result;
        if (!aiRunToolCall(name, argsDoc.as<JsonObject>(), result, true)) result = "Error: unknown tool";
        if (result.startsWith("Error:")) hadToolError = true;
        JsonObject echo = input.createNestedObject();
        echo["type"] = "function_call";
        echo["call_id"] = callId;
        echo["name"] = name;
        echo["arguments"] = argsStr;
        JsonObject out = input.createNestedObject();
        out["type"] = "function_call_output";
        out["call_id"] = callId;
        out["output"] = result;
      } else if (strcmp(type, "message") == 0) {
        JsonArray content = item["content"].as<JsonArray>();
        for (JsonObject c : content) {
          if (strcmp(c["type"] | "", "output_text") == 0) lastText += String((const char*)(c["text"] | ""));
        }
      }
    }
    if (!hadToolCall) {
      if (hadToolError) *status = "error: a step failed — see result text";
      return lastText;
    }
  }
  *status = hadToolError ? "error: a step failed — see result text" : ("hit step limit (" + String(TASK_MAX_STEPS) + ")");
  return lastText;
}

String taskRunGemini(const String& model, const String& instructions, String* status) {
  *status = "ok";
  BasicJsonDocument<PsramJsonAllocator> contentsDoc(16384);
  JsonArray contents = contentsDoc.to<JsonArray>();
  {
    JsonObject turn = contents.createNestedObject();
    turn["role"] = "user";
    turn.createNestedArray("parts").createNestedObject()["text"] = instructions;
  }

  BasicJsonDocument<PsramJsonAllocator> flatToolsDoc(8192);
  JsonArray flatTools = flatToolsDoc.to<JsonArray>();
  aiBuildToolsArray(flatTools, false);

  String lastText = "";
  bool hadToolError = false;
  for (int step = 0; step < TASK_MAX_STEPS; step++) {
    BasicJsonDocument<PsramJsonAllocator> payloadDoc(24576);
    payloadDoc["contents"] = contents;
    payloadDoc.createNestedObject("systemInstruction").createNestedArray("parts")
        .createNestedObject()["text"] = taskSystemPreambleWithDate();
    JsonArray funcDecls = payloadDoc.createNestedArray("tools").createNestedObject().createNestedArray("functionDeclarations");
    for (JsonObject t : flatTools) {
      JsonObject fd = funcDecls.createNestedObject();
      fd["name"] = t["name"];
      fd["description"] = t["description"];
      if (t.containsKey("parameters")) fd["parametersJsonSchema"] = t["parameters"];
    }
    size_t payloadLen = measureJson(payloadDoc);
    char* payload = (char*)ps_malloc(payloadLen + 1);
    if (!payload) { *status = "error: out of memory"; return lastText; }
    serializeJson(payloadDoc, payload, payloadLen + 1);

    Serial.printf("[Task] Gemini step %d: model=%s payload=%u bytes, free heap=%u, max alloc=%u, free psram=%u\n",
                  step, model.c_str(), (unsigned)payloadLen, (unsigned)ESP.getFreeHeap(), (unsigned)ESP.getMaxAllocHeap(), (unsigned)ESP.getFreePsram());

    int code = 0;
    String respBody;
    String url = "https://generativelanguage.googleapis.com/v1beta/models/" + model + ":generateContent?key=" + activeGeminiKey;
    for (int attempt = 0; attempt <= aiTaskRetries; attempt++) {
      HTTPClient http;
      http.begin(url);
      http.setReuse(false);
      http.setTimeout(30000);
      http.addHeader("Content-Type", "application/json");
      code = http.POST((uint8_t*)payload, payloadLen);
      taskRebootOnHttpDashOne(code);
      if (code == 200) { respBody = http.getString(); http.end(); break; }
      String errBody = http.getString();
      http.end();
      Serial.printf("[Task] Gemini step %d attempt %d failed, HTTP %d, free heap=%u, max alloc=%u: %s\n",
                    step, attempt, code, (unsigned)ESP.getFreeHeap(), (unsigned)ESP.getMaxAllocHeap(), errBody.substring(0, 300).c_str());
    }
    free(payload);
    if (code != 200) {
      *status = "error: HTTP " + String(code);
      return lastText;
    }

    BasicJsonDocument<PsramJsonAllocator> respDoc(24576);
    if (deserializeJson(respDoc, respBody) != DeserializationError::Ok) {
      *status = "error: bad response JSON";
      return lastText;
    }

    bool hadToolCall = false;
    JsonArray parts = respDoc["candidates"][0]["content"]["parts"].as<JsonArray>();
    JsonObject modelTurn = contents.createNestedObject();
    modelTurn["role"] = "model";
    JsonArray modelParts = modelTurn.createNestedArray("parts");
    JsonArray functionResponseParts;
    for (JsonObject part : parts) {
      if (part.containsKey("functionCall")) {
        hadToolCall = true;
        const char* name = part["functionCall"]["name"] | "";
        JsonVariantConst args = part["functionCall"]["args"];
        modelParts.add(part);
        String result;
        if (!aiRunToolCall(name, args, result, true)) result = "Error: unknown tool";
        if (result.startsWith("Error:")) hadToolError = true;
        if (functionResponseParts.isNull()) {
          JsonObject fnTurn = contents.createNestedObject();
          fnTurn["role"] = "user";
          functionResponseParts = fnTurn.createNestedArray("parts");
        }
        JsonObject fr = functionResponseParts.createNestedObject().createNestedObject("functionResponse");
        fr["name"] = name;
        fr.createNestedObject("response")["result"] = result;
      } else if (part.containsKey("text")) {
        lastText += String((const char*)(part["text"] | ""));
        modelParts.add(part);
      }
    }
    if (!hadToolCall) {
      if (hadToolError) *status = "error: a step failed — see result text";
      return lastText;
    }
  }
  *status = hadToolError ? "error: a step failed — see result text" : ("hit step limit (" + String(TASK_MAX_STEPS) + ")");
  return lastText;
}

String taskFireConfiguredApiCall(const PageTask& t, bool& ok) {
  ok = false;
  if (t.apiUrl.length() == 0) return "Error: no API URL configured";

  String url = t.apiUrl;
  String authHeaderName = "", authHeaderValue = "";
  if (t.apiAuthType == "bearer") {
    authHeaderName = "Authorization";
    authHeaderValue = "Bearer " + t.apiAuthValue;
  } else if (t.apiAuthType == "basic") {
    size_t b64Cap = ((t.apiAuthValue.length() + 2) / 3) * 4 + 4;
    uint8_t* b64buf = (uint8_t*)malloc(b64Cap);
    if (b64buf) {
      size_t outLen = 0;
      mbedtls_base64_encode(b64buf, b64Cap, &outLen, (const uint8_t*)t.apiAuthValue.c_str(), t.apiAuthValue.length());
      authHeaderName = "Authorization";
      authHeaderValue = "Basic " + String((const char*)b64buf, outLen);
      free(b64buf);
    }
  } else if (t.apiAuthType == "apikey_header") {
    authHeaderName = t.apiAuthKeyName;
    authHeaderValue = t.apiAuthValue;
  } else if (t.apiAuthType == "apikey_query") {
    url += (url.indexOf('?') >= 0 ? "&" : "?") + urlEncodeParam(t.apiAuthKeyName) + "=" + urlEncodeParam(t.apiAuthValue);
  }

  String method = t.apiMethod; method.toUpperCase();
  if (method.length() == 0) method = "GET";

  int code = 0;
  String body;
  for (int attempt = 0; attempt <= aiTaskRetries; attempt++) {
    HTTPClient http;
    http.begin(url);
    http.setReuse(false);
    http.setTimeout(20000);

    bool hasContentType = false;
    int pos = 0;
    while (pos < (int)t.apiHeaders.length()) {
      int nl = t.apiHeaders.indexOf('\n', pos);
      String line = (nl < 0) ? t.apiHeaders.substring(pos) : t.apiHeaders.substring(pos, nl);
      pos = (nl < 0) ? t.apiHeaders.length() : nl + 1;
      line.trim();
      int colon = line.indexOf(':');
      if (colon <= 0) continue;
      String hk = line.substring(0, colon); hk.trim();
      String hv = line.substring(colon + 1); hv.trim();
      if (hk.length() == 0) continue;
      if (hk.equalsIgnoreCase("content-type")) hasContentType = true;
      http.addHeader(hk, hv);
    }
    if (authHeaderName.length() > 0) http.addHeader(authHeaderName, authHeaderValue);
    if (t.apiBody.length() > 0 && !hasContentType) http.addHeader("Content-Type", "application/json");

    Serial.printf("[Task] API call: %s %s, attempt %d, free heap=%u, max alloc=%u, free psram=%u\n",
                  method.c_str(), url.c_str(), attempt, (unsigned)ESP.getFreeHeap(), (unsigned)ESP.getMaxAllocHeap(), (unsigned)ESP.getFreePsram());
    code = http.sendRequest(method.c_str(), t.apiBody);
    taskRebootOnHttpDashOne(code);
    body = http.getString();
    http.end();
    Serial.printf("[Task] API call result: HTTP %d, attempt %d, free heap=%u, max alloc=%u, free psram=%u\n",
                  code, attempt, (unsigned)ESP.getFreeHeap(), (unsigned)ESP.getMaxAllocHeap(), (unsigned)ESP.getFreePsram());
    if (code >= 200 && code < 300) break;
  }

  if (code < 200 || code >= 300) {
    return "Error: HTTP " + String(code) + (body.length() > 0 ? (" - " + body.substring(0, 500)) : "");
  }
  ok = true;
  const size_t TASK_API_RESPONSE_MAX_CHARS = 6000;
  if (body.length() > TASK_API_RESPONSE_MAX_CHARS) {
    body = body.substring(0, TASK_API_RESPONSE_MAX_CHARS) + "\n...[response truncated, " + String((unsigned)body.length()) + " bytes total]";
  }
  return body;
}

#define READ_WEBPAGE_MAX_BYTES 2000000UL
#define READ_WEBPAGE_MAX_MATCHES 100
#define READ_WEBPAGE_MAX_RESULT_LEN 25000
#define READ_WEBPAGE_MAX_PREVIEW_LEN 25000

String taskFetchWebpageRaw(String url, int offset, int range, uint8_t** outBuf, size_t* outLen, long* outDeclaredSize) {
  url.trim();
  if (url.length() == 0) return "Error: no URL given";
  if (offset < 0) offset = 0;
  if (range <= 0 || range > (int)READ_WEBPAGE_MAX_BYTES) range = READ_WEBPAGE_MAX_BYTES;
  String lowerUrl = url; lowerUrl.toLowerCase();
  if (!lowerUrl.startsWith("http://") && !lowerUrl.startsWith("https://")) {
    url = "https://" + url;
  }

  uint8_t* buf = nullptr;
  size_t got = 0;
  int code = 0;
  long declaredSize = -2;
  for (int attempt = 0; attempt <= aiTaskRetries; attempt++) {
    HTTPClient http;
    http.begin(url);
    http.setReuse(false);
    http.setTimeout(60000);
    http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
    http.addHeader("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36");
    http.addHeader("Accept-Encoding", "identity");
    if (offset > 0) {
      http.addHeader("Range", "bytes=" + String(offset) + "-" + String(offset + range - 1));
    }
    static const char* RW_HEADER_KEYS[] = { "Transfer-Encoding" };
    http.collectHeaders(RW_HEADER_KEYS, 1);
    code = http.GET();

    if (offset > 0 && code == 200) {
      http.end();
      return "Error: this website doesn't support jumping to an offset (ignored the range request) — try offset 0";
    }
    if (code == 416) {
      http.end();
      return "Error: offset " + String(offset) + " is beyond the end of this page";
    }
    bool gotExpectedCode = (offset > 0) ? (code == 206) : (code >= 200 && code < 300);
    if (!gotExpectedCode) {
      http.end();
      Serial.printf("[Task] Read webpage attempt %d failed, HTTP %d, url=%s\n", attempt, code, url.c_str());
      continue;
    }

    declaredSize = http.getSize();
    String rwTransferEncoding = http.header("Transfer-Encoding");
    Serial.printf("[Task] Read webpage attempt %d: HTTP %d, Content-Length=%ld, Transfer-Encoding=\"%s\", url=%s\n",
                  attempt, code, declaredSize, rwTransferEncoding.c_str(), url.c_str());
    if (!buf) buf = (uint8_t*)ps_malloc((size_t)range + 1);
    if (!buf) { http.end(); return "Error: out of memory"; }
    got = 0;
    WiFiClient* stream = http.getStreamPtr();
    unsigned long deadlineMs = millis() + 60000;
    if (rwTransferEncoding.equalsIgnoreCase("chunked")) {
      while (got < (size_t)range && millis() < deadlineMs) {
        if (!http.connected() && stream->available() == 0) break;
        String chunkHeader = stream->readStringUntil('\n');
        chunkHeader.trim();
        if (chunkHeader.length() == 0) break;
        long chunkLen = strtol(chunkHeader.c_str(), NULL, 16);
        if (chunkLen <= 0) break;
        size_t remaining = (size_t)range - got;
        size_t toRead = ((size_t)chunkLen < remaining) ? (size_t)chunkLen : remaining;
        size_t r = stream->readBytes((char*)buf + got, toRead);
        got += r;
        if (r < toRead) break;
        if (toRead < (size_t)chunkLen) break;
        char trail[2];
        if (stream->readBytes(trail, 2) != 2 || trail[0] != '\r' || trail[1] != '\n') break;
      }
    } else {
      while (got < (size_t)range && millis() < deadlineMs) {
        if (!http.connected() && stream->available() == 0) break;
        size_t avail = stream->available();
        if (avail == 0) { delay(5); continue; }
        size_t remaining = (size_t)range - got;
        size_t toRead = (avail < remaining) ? avail : remaining;
        size_t r = stream->readBytes((char*)buf + got, toRead);
        if (r == 0) break;
        got += r;
      }
    }
    bool stillConnected = http.connected();
    Serial.printf("[Task] Read webpage attempt %d: got %u byte(s) (declared %ld), still connected=%d\n",
                  attempt, (unsigned)got, declaredSize, (int)stillConnected);
    http.end();
    break;
  }
  bool finalOk = (offset > 0) ? (code == 206) : (code >= 200 && code < 300);
  if (!finalOk) {
    if (buf) free(buf);
    if (code == 403) {
      return "Error: HTTP 403 — this site refused the request, most likely because it detected an automated client and blocked it";
    }
    if (code == -11) {
      return "Error: HTTP -11 — the connection timed out waiting for a response (took longer than 60 seconds). Usually a slow or heavy page, occasionally a site deliberately throttling automated requests — unlike a 403, this one's ambiguous, so retrying may or may not help.";
    }
    if (code == 429) {
      return "Error: HTTP 429 — this site is rate-limiting requests (too many, too fast). Retrying right away probably won't help — try again later, or less often.";
    }
    if (code == 401) {
      return "Error: HTTP 401 — this page requires signing in first. There's no way for this to log into a site, so a page behind a login wall isn't reachable this way.";
    }
    if (code == 500 || code == 502 || code == 503 || code == 504) {
      return "Error: HTTP " + String(code) + " — the site itself is having a server-side problem right now, not something wrong with this request. Often temporary.";
    }
    if (code == -1) {
      return "Error: HTTP -1 — the connection was refused or never went through. Could be a bad or unreachable URL, or a temporary network issue — try again, or double-check the URL.";
    }
    return "Error: HTTP " + String(code);
  }
  if (!buf) return "Error: out of memory";
  buf[got] = 0;
  *outBuf = buf;
  *outLen = got;
  *outDeclaredSize = declaredSize;
  return "";
}

String taskReadWebpageContent(String url, String keyword, int offset, int range, String contextSpec, String* outRaw, int* outRawLen, long* outDeclaredSize) {
  url.trim();
  keyword.trim();
  int radius = 0;
  String direction = "both";
  {
    int colon = contextSpec.indexOf(':');
    String numPart = (colon >= 0) ? contextSpec.substring(0, colon) : contextSpec;
    String dirPart = (colon >= 0) ? contextSpec.substring(colon + 1) : "";
    dirPart.trim(); dirPart.toLowerCase();
    radius = numPart.toInt();
    if (dirPart == "above" || dirPart == "below") direction = dirPart;
  }
  if (radius < 0) radius = 0;

  uint8_t* buf = nullptr;
  size_t got = 0;
  long declaredSize = -2;
  String fetchErr = taskFetchWebpageRaw(url, offset, range, &buf, &got, &declaredSize);
  if (fetchErr.length() > 0) return fetchErr;
  String content((char*)buf, (unsigned int)got);
  free(buf);
  int contentLen = content.length();

  if (outRaw) {
    int rawLen = contentLen;
    if (rawLen > READ_WEBPAGE_MAX_PREVIEW_LEN) rawLen = READ_WEBPAGE_MAX_PREVIEW_LEN;
    *outRaw = content.substring(0, rawLen);
    if (outRawLen) *outRawLen = contentLen;
  }
  if (outDeclaredSize) *outDeclaredSize = declaredSize;

  if (keyword.length() == 0) {
    int previewLen = (radius > 0) ? radius : contentLen;
    if (previewLen > contentLen) previewLen = contentLen;
    if (previewLen > READ_WEBPAGE_MAX_PREVIEW_LEN) previewLen = READ_WEBPAGE_MAX_PREVIEW_LEN;
    return "Preview, first " + String(previewLen) + " character(s), " + String(contentLen) + " total fetched (offset " + String(offset) + "): " + content.substring(0, previewLen);
  }

  String keywordLower = keyword; keywordLower.toLowerCase();
  String contentLower = content; contentLower.toLowerCase();
  int klen = keyword.length();
  String result = "";
  int matchCount = 0;
  bool resultCapped = false;
  int searchFrom = 0;
  while (matchCount < READ_WEBPAGE_MAX_MATCHES) {
    int idx = contentLower.indexOf(keywordLower, searchFrom);
    if (idx < 0) break;
    int startCtx = (direction == "below") ? idx : idx - radius;
    if (startCtx < 0) startCtx = 0;
    int endCtx = (direction == "above") ? (idx + klen) : (idx + klen + radius);
    if (endCtx > contentLen) endCtx = contentLen;
    if (endCtx - startCtx > READ_WEBPAGE_MAX_RESULT_LEN) endCtx = startCtx + READ_WEBPAGE_MAX_RESULT_LEN;
    matchCount++;
    result += String(matchCount) + ". " + content.substring(startCtx, endCtx) + "\n";
    if ((int)result.length() >= READ_WEBPAGE_MAX_RESULT_LEN) { resultCapped = true; break; }
    searchFrom = idx + klen;
  }
  if (matchCount == 0) return "No matches found for \"" + keyword + "\" in the " + String(contentLen) + " character(s) fetched starting at offset " + String(offset);
  if (resultCapped) result += "(stopped after " + String(matchCount) + " match(es) — combined result reached " + String(READ_WEBPAGE_MAX_RESULT_LEN) + " characters)";
  else if (matchCount >= READ_WEBPAGE_MAX_MATCHES) result += "(capped at " + String(READ_WEBPAGE_MAX_MATCHES) + " matches)";
  return result;
}

String resolvePlaceholders(String text, NamedValue* values, int count) {
  for (int i = 0; i < count; i++) {
    text.replace("{{" + values[i].name + "}}", values[i].value);
  }
  return text;
}

int taskExtractApiValues(const PageTask& t, const String& apiResponseJson, NamedValue* values, int startIdx, int maxValues) {
  int count = startIdx;
  if (t.apiExtractCount == 0 || count >= maxValues) return count;
  BasicJsonDocument<PsramJsonAllocator> doc(4096);
  if (deserializeJson(doc, apiResponseJson) != DeserializationError::Ok) return count;
  for (int i = 0; i < t.apiExtractCount && count < maxValues; i++) {
    JsonVariant v = doc.as<JsonVariant>();
    String path = t.apiExtracts[i].path;
    int pos = 0;
    bool found = (path.length() > 0);
    while (found && pos < (int)path.length()) {
      int dot = path.indexOf('.', pos);
      String segment = (dot < 0) ? path.substring(pos) : path.substring(pos, dot);
      if (!v.is<JsonObject>() || !v.containsKey(segment)) { found = false; break; }
      v = v[segment];
      pos = (dot < 0) ? path.length() : dot + 1;
    }
    if (found) {
      values[count].name = t.apiExtracts[i].name;
      values[count].value = v.as<String>();
      count++;
    }
  }
  return count;
}

String taskRunActionStep(const TaskStep& step, NamedValue* values, int count) {
  auto p = [&](int i) -> String { return resolvePlaceholders(step.param[i], values, count); };
  String action = step.action;
  unsigned long startMs = millis();
  String result, argsPreview;

  if (action == "set_alarm") {
    String t = p(1);
    argsPreview = "name=" + p(0) + ", time=" + (t.length() > 0 ? t : String("(immediate)"));
    result = aiToolSetAlarm(p(0), t.length() > 0 ? 0 : 1, t);
  } else if (action == "cancel_alarms") {
    argsPreview = "name=" + (p(0).length() > 0 ? p(0) : String("(all)"));
    result = aiToolCancelAlarms("", p(0));
  } else if (action == "start_timer") {
    argsPreview = "name=" + p(0);
    result = aiToolStartTimer(p(0));
  } else if (action == "stop_timer") {
    argsPreview = "name=" + (p(0).length() > 0 ? p(0) : String("(running)"));
    result = aiToolStopTimer(p(0));
  } else if (action == "reset_timer") {
    argsPreview = "name=" + p(0);
    result = aiToolResetTimer(p(0));
  } else if (action == "delete_timer") {
    argsPreview = "name=" + p(0);
    result = aiToolDeleteTimer(p(0));
  } else if (action == "send_email") {
    argsPreview = "to=" + p(0) + ", subject=" + p(1) + ", body=" + p(2) + (p(3).length() > 0 ? ", attachments=" + p(3) : String(""));
    result = aiToolSendEmail(p(0), p(1), p(2), p(3), true);
  } else if (action == "set_volume") {
    argsPreview = "level=" + p(0);
    result = aiToolSetVolume(p(0).toInt());
  } else if (action == "set_brightness") {
    argsPreview = "level=" + p(0);
    result = aiToolSetBrightness(p(0).toInt());
  } else if (action == "calculate") {
    argsPreview = "expression=" + p(0);
    result = aiToolCalculate(p(0));
  } else if (action == "convert") {
    argsPreview = "value=" + p(0) + ", from=" + p(1) + ", to=" + p(2);
    result = aiToolConvert(p(0).toDouble(), p(1), p(2));
  } else if (action == "file_create") {
    argsPreview = "name=" + p(0);
    result = aiToolFileCreate(p(0));
  } else if (action == "remember") {
    argsPreview = "content=" + p(0);
    result = taskRememberContent(p(0));
  } else if (action == "file_append") {
    argsPreview = "content=" + p(0);
    result = taskFileAppendContent(p(0));
  } else if (action == "file_open") {
    argsPreview = "name=" + p(0);
    result = taskFileOpenContent(p(0), p(1));
  } else if (action == "read_webpage") {
    argsPreview = "url=" + p(0) + ", look for=" + p(1) + ", offset=" + p(2) + ", range=" + p(3) + ", radius=" + p(4);
    result = taskReadWebpageContent(p(0), p(1), p(2).toInt(), p(3).toInt(), p(4), nullptr, nullptr, nullptr);
  } else {
    return "Error: unknown action \"" + action + "\"";
  }

  logToolCallEvent("action", action.c_str(), millis() - startMs, argsPreview, result);
  return result;
}

static String smtpReadLine(WiFiClientSecure& client) {
  String line = client.readStringUntil('\n');
  line.trim();
  return line;
}

static int smtpReadReply(WiFiClientSecure& client) {
  String line;
  int code = 0;
  do {
    line = smtpReadLine(client);
    if (line.length() < 3) return code;
    code = line.substring(0, 3).toInt();
  } while (line.length() > 3 && line[3] == '-');
  return code;
}

static void smtpStreamAttachmentBase64(WiFiClientSecure& client, const String& content) {
  const size_t n = content.length();
  const uint8_t* raw = (const uint8_t*)content.c_str();
  char b64line[81];
  String out;
  out.reserve(20 * 78);
  size_t pos = 0;
  while (pos < n) {
    out = "";
    for (int line = 0; line < 20 && pos < n; line++) {
      size_t sub = (n - pos < 57) ? (n - pos) : 57;
      size_t olen;
      mbedtls_base64_encode((uint8_t*)b64line, sizeof(b64line), &olen, raw + pos, sub);
      out += String(b64line);
      out += "\r\n";
      pos += sub;
    }
    client.print(out);
  }
}

static String smtpSendMailAttempt(const String& toAddr, const String& subject, const String& body, const SmtpAttachment* attachments, int attachmentCount) {
  if (activeNotifyEmail.length() == 0 || activeNotifyAppPassword.length() == 0) {
    return "no notify email/app password configured";
  }
  WiFiClientSecure client;
  client.setInsecure();
  client.setHandshakeTimeout(10);
  client.setTimeout(15000);
  Serial.printf("[SMTP] connecting, free heap=%u\n", (unsigned)ESP.getFreeHeap());
  if (!client.connect(activeNotifySmtpHost.c_str(), activeNotifySmtpPort)) return "SMTP connect failed";
  if (smtpReadReply(client) != 220) { client.stop(); return "SMTP: no greeting"; }

  client.print("EHLO waveshare-badge\r\n");
  if (smtpReadReply(client) != 250) { client.stop(); return "SMTP: EHLO rejected"; }

  client.print("AUTH LOGIN\r\n");
  if (smtpReadReply(client) != 334) { client.stop(); return "SMTP: AUTH LOGIN rejected"; }

  char b64buf[256]; size_t b64Len;
  mbedtls_base64_encode((uint8_t*)b64buf, sizeof(b64buf), &b64Len,
                         (const uint8_t*)activeNotifyEmail.c_str(), activeNotifyEmail.length());
  client.write((const uint8_t*)b64buf, b64Len);
  client.print("\r\n");
  if (smtpReadReply(client) != 334) { client.stop(); return "SMTP: username rejected"; }

  mbedtls_base64_encode((uint8_t*)b64buf, sizeof(b64buf), &b64Len,
                         (const uint8_t*)activeNotifyAppPassword.c_str(), activeNotifyAppPassword.length());
  client.write((const uint8_t*)b64buf, b64Len);
  client.print("\r\n");
  if (smtpReadReply(client) != 235) { client.stop(); return "SMTP: auth failed — check app password"; }

  client.print("MAIL FROM:<" + activeNotifyEmail + ">\r\n");
  if (smtpReadReply(client) != 250) { client.stop(); return "SMTP: MAIL FROM rejected"; }

  client.print("RCPT TO:<" + toAddr + ">\r\n");
  int rcptCode = smtpReadReply(client);
  if (rcptCode != 250 && rcptCode != 251) { client.stop(); return "SMTP: recipient rejected"; }

  client.print("DATA\r\n");
  if (smtpReadReply(client) != 354) { client.stop(); return "SMTP: DATA rejected"; }

  if (attachmentCount == 0) {
    String msg;
    msg.reserve(subject.length() + body.length() + 200);
    msg += "From: " + activeNotifyEmail + "\r\n";
    msg += "To: " + toAddr + "\r\n";
    msg += "Subject: " + subject + "\r\n";
    msg += "Content-Type: text/plain; charset=utf-8\r\n\r\n";
    msg += body;
    msg.replace("\n.", "\n..");
    msg += "\r\n.\r\n";
    client.print(msg);
  } else {
    String boundary = "----BadgeBoundary7f3a9c1e";
    String head;
    head.reserve(subject.length() + body.length() + 300);
    head += "From: " + activeNotifyEmail + "\r\n";
    head += "To: " + toAddr + "\r\n";
    head += "Subject: " + subject + "\r\n";
    head += "MIME-Version: 1.0\r\n";
    head += "Content-Type: multipart/mixed; boundary=\"" + boundary + "\"\r\n\r\n";
    head += "--" + boundary + "\r\n";
    head += "Content-Type: text/plain; charset=utf-8\r\n\r\n";
    head += body;
    head.replace("\n.", "\n..");
    head += "\r\n";
    client.print(head);

    for (int i = 0; i < attachmentCount; i++) {
      String partHead;
      partHead += "--" + boundary + "\r\n";
      partHead += "Content-Type: application/octet-stream; name=\"" + attachments[i].filename + "\"\r\n";
      partHead += "Content-Transfer-Encoding: base64\r\n";
      partHead += "Content-Disposition: attachment; filename=\"" + attachments[i].filename + "\"\r\n\r\n";
      client.print(partHead);
      smtpStreamAttachmentBase64(client, attachments[i].content);
      client.print("\r\n");
    }
    client.print("--" + boundary + "--\r\n");
    client.print("\r\n.\r\n");
  }
  if (smtpReadReply(client) != 250) { client.stop(); return "SMTP: message rejected"; }

  client.print("QUIT\r\n");
  client.stop();
  return "";
}

static String smtpSendMail(const String& toAddr, const String& subject, const String& body, const SmtpAttachment* attachments, int attachmentCount) {
  String err;
  for (int attempt = 0; attempt <= aiTaskRetries; attempt++) {
    err = smtpSendMailAttempt(toAddr, subject, body, attachments, attachmentCount);
    if (err.length() == 0) return "";
    Serial.printf("[SMTP] attempt %d failed: %s\n", attempt, err.c_str());
  }
  return err;
}

class AiTaskDirGuard {
  String savedActiveFile;
public:
  AiTaskDirGuard(const String& dir, int retries = 0) {
    aiTaskActiveDir = dir; aiTaskRetries = retries;
    savedActiveFile = aiActiveFile;
    aiActiveFile = "";
  }
  ~AiTaskDirGuard() { aiTaskActiveDir = ""; aiTaskRetries = 0; aiActiveFile = savedActiveFile; }
};

String taskExecute(const String& fileName) {
  int taskDirSlash = fileName.lastIndexOf('/');
  AiTaskDirGuard dirGuard(taskDirSlash >= 0 ? fileName.substring(0, taskDirSlash) : "");

  String fullPath = String(KNOWLEDGE_DIR) + "/" + fileName;
  if (!SD_MMC.exists(fullPath)) return "Task file not found";
  String content = readKnowledgeFile(fullPath);

  String model, notifyEmail, body;
  if (!parseTaskFile(content, &model, &notifyEmail, &body)) return "Not a task file (missing #TASK header)";
  if (model.length() == 0) model = aiRealtimeModel;
  if (body.length() == 0) {
    return "Task has no instructions";
  }
  if (!aiProviderHasKeyFor(model, false)) {
    String msg = "error: no API key configured for " + model;
    return msg;
  }

  String status;
  String result = aiModelIsGemini(model) ? taskRunGemini(model, body, &status)
                                          : taskRunOpenAI(model, body, &status);

  if (result.length() > 0) {
    int slash = fileName.lastIndexOf('/');
    String resultName = (slash >= 0) ? fileName.substring(slash + 1) : fileName;
    int dot = resultName.lastIndexOf('.');
    if (dot > 0) resultName = resultName.substring(0, dot);
    writeKnowledgeFile(String(KNOWLEDGE_DIR) + "/" + resultName + " result.txt", result);
  }

  if (notifyEmail.length() > 0) {
    String subject = (status == "ok" ? "Task complete: " : "Task failed: ") + fileName;
    String emailBody = "File: " + fileName + "\nModel: " + model + "\nStatus: " + status + "\n\n"
                      + (result.length() > 0 ? result.substring(0, 500) : "(no output)");
    smtpSendMail(notifyEmail, subject, emailBody);
  }

  return status == "ok" ? "Task complete" : ("Task " + status);
}

static void aiFlushPendingAudioLogFinalize() {
  if (!aiPendingAudioLogFinalize) return;
  aiPendingAudioLogFinalize = false;
  aiLogWriteReceivedAudio();
  if (aiPendingAudioLogIsTranslator) {
    aiLogTurnEnd(aiPendingAudioLogBase);
  } else {
    aiLogTranscriptAccum += "Q: " + aiPendingAudioLogUserTranscript + "\nA: " + aiPendingAudioLogReplyTranscript + "\n";
    if (aiRecordAiResponse) aiWriteResponseClip(aiPendingAudioLogBase);
  }
}

static void aiFinalizeTurn(const String& logModel) {
  if (!translatorPageOpen && aiReplyTranscript.length() > 0
      && aiReplyTranscript.indexOf(ORIGIN_TAG_LEAD) < 0) {
    aiReplyTranscript = originTagMark('A') + aiReplyTranscript;
  }
  emitGeminiGroundingToolLog();
  if (aiDisplayModeIndex != AI_DISPLAY_VOICE && aiPageOpen && !aiToolHistoryOpen) {
    bool hadText = aiTextLineCount > 0;
    aiRewrapTextLines();
    aiRevealedChars = aiReplyTranscript.length();
    if (aiDisplayModeIndex == AI_DISPLAY_SILENT) aiSilentModeAutoFollow();
    if (aiTextLineCount > 0) {
      if (!hadText) drawAiPage();
      else drawAiTextArea();
    }
  }
  Serial.printf("[ChatLog] aiFinalizeTurn(model=%s) saveHistoryMode=%s replyLen=%u\n",
                logModel.c_str(), SAVE_HISTORY_MODE_NAMES[saveHistoryMode], (unsigned)aiReplyTranscript.length());
  String audioBase = aiBuildAudioBase(aiUserTranscript);
  if (saveHistoryMode >= SAVE_TEXT && aiReplyTranscript.length() > 0) {
    struct tm ti; String ts = "";
    if (getLocalTime(&ti)) { char buf[20]; strftime(buf, sizeof(buf), "%Y-%m-%d %H:%M:%S", &ti); ts = String(buf); }
    String sTag = aiChatSessionId.length() ? (" | s=" + aiChatSessionId) : String("");
    String nTag = aiChatSessionId.length() ? (" | n=" + String(aiChatTurnN)) : String("");
    bool audioSavedThisTurn = translatorPageOpen ? (saveHistoryMode == SAVE_TEXT_AUDIO)
                                                 : aiRecordAiResponse;
    String aTag = (aiChatSessionId.length() && audioSavedThisTurn)
      ? (" | a=" + String(translatorPageOpen ? "T:" : "A:") + audioBase)
      : String("");
    String entry = "[" + ts + " | " + logModel + sTag + nTag + aTag + "]\nQ: " + aiUserTranscript + "\nA: " + stripOriginTags(aiReplyTranscript)
          + aiToolCallLog + "\n";
    if (saveHistoryMode != SAVE_AUDIO_ONLY) appendChatLog(entry);
    if ((aiLogActive) ||
         (aiRecordAiResponse && !translatorPageOpen &&
          (saveHistoryMode == SAVE_TEXT_AUDIO || saveHistoryMode == SAVE_AUDIO_ONLY))) {
      if (aiDeltaQueue && uxQueueMessagesWaiting(aiDeltaQueue) > 0) {
        aiPendingAudioLogFinalize = true;
        aiPendingAudioLogSetMs = millis();
        aiPendingAudioLogIsTranslator = aiLogIsTranslator;
        aiPendingAudioLogUserTranscript = aiUserTranscript;
        aiPendingAudioLogReplyTranscript = stripOriginTags(aiReplyTranscript);
        aiPendingAudioLogBase = audioBase;
      } else {
        aiLogWriteReceivedAudio();
        if (aiLogIsTranslator) {
          aiLogTurnEnd(audioBase);
        } else {
          aiLogTranscriptAccum += "Q: " + aiUserTranscript + "\nA: " + stripOriginTags(aiReplyTranscript) + "\n";
          if (aiRecordAiResponse) aiWriteResponseClip(audioBase);
        }
      }
    }
  }
  aiState = AI_IDLE;
  drawAiOrTranslatorPage();
}

void handleAiFunctionCall(JsonDocument& doc) {
  const char* name = doc["name"] | "";
  const char* callId = doc["call_id"] | "";
  const char* argsStr = doc["arguments"] | "{}";
  if (!name[0] || !callId[0]) return;

  DynamicJsonDocument argsDoc(1024);
  deserializeJson(argsDoc, argsStr);

  if (strcmp(name, "web_search") == 0 && !aiModelIsGemini(activeWebSearchModel)) {
    String argsPreview; serializeJson(argsDoc, argsPreview);
    aiStartWebSearchAsync(String((const char*)(argsDoc["query"] | "")), argsPreview, String(callId), false);
    return;
  }

  String result;
  if (!aiRunToolCall(name, argsDoc.as<JsonObject>(), result)) return;

  DynamicJsonDocument out(result.length() + 512);
  out["type"] = "conversation.item.create";
  JsonObject item = out.createNestedObject("item");
  item["type"] = "function_call_output";
  item["call_id"] = callId;
  item["output"] = result;
  String outStr; serializeJson(out, outStr);
  aiClient.send(outStr);

  aiResponseHadToolCall = true;
  sendAiResponseCreate();
}

static int geminiModalityTokens(JsonArray arr, const char* modality) {
  for (JsonObject m : arr) {
    if (strcmp(m["modality"] | "", modality) == 0) return m["tokenCount"] | 0;
  }
  return -1;
}

static bool geminiGroundingPresent(JsonVariantConst gm) {
  if (!gm.is<JsonObjectConst>()) return false;
  return gm.containsKey("groundingChunks") || gm.containsKey("webSearchQueries")
      || gm.containsKey("searchEntryPoint") || gm.containsKey("groundingSupports");
}
static bool geminiTurnWasGrounded(JsonObject sc) {
  return geminiGroundingPresent(sc["groundingMetadata"])
      || geminiGroundingPresent(sc["modelTurn"]["groundingMetadata"]);
}

static void accumulateGeminiGrounding(JsonObject sc) {
  if (saveHistoryMode < SAVE_TEXT) return;
  JsonVariantConst gm = sc["groundingMetadata"];
  if (!gm.is<JsonObjectConst>()) gm = sc["modelTurn"]["groundingMetadata"];
  if (!gm.is<JsonObjectConst>()) return;

  for (JsonVariantConst v : gm["webSearchQueries"].as<JsonArrayConst>()) {
    const char* s = v.as<const char*>();
    if (!s || !s[0]) continue;
    String q = s;
    if (("; " + aiGroundingQueries + "; ").indexOf("; " + q + "; ") >= 0) continue;
    if (aiGroundingQueries.length()) aiGroundingQueries += "; ";
    aiGroundingQueries += q;
  }
  for (JsonVariantConst c : gm["groundingChunks"].as<JsonArrayConst>()) {
    String title = (const char*)(c["web"]["title"] | "");
    String uri   = (const char*)(c["web"]["uri"]   | "");
    title.replace("\n", " ");
    title.replace("]", ")");
    if (title.length() == 0 && uri.length() == 0) continue;
    if (uri.length() && aiGroundingSources.indexOf(uri) >= 0) continue;
    aiGroundingSources += "\n\n- ";
    if (uri.length()) aiGroundingSources += "[" + (title.length() ? title : uri) + "](" + uri + ")";
    else              aiGroundingSources += title;
  }
}

static void emitGeminiGroundingToolLog() {
  if (aiGroundingQueries.length() || aiGroundingSources.length()) {
    aiToolCallLog += "\n\n<em>Tool : Web Search (Gemini)"
                     "\n\nModel : " + aiRealtimeModel
                   + (aiGroundingQueries.length() ? ("\n\nQuery : " + aiGroundingQueries) : String(""))
                   + (aiGroundingSources.length()
                        ? ("\n\nSources :" + aiGroundingSources)
                        : String("\n\nSources : (none returned for this search)"))
                   + "</em>\n";
  }
  aiGroundingQueries = "";
  aiGroundingSources = "";
}

void handleGeminiMessage(JsonDocument& doc) {
  if (doc.containsKey("setupComplete")) {
    Serial.println("[AI] recv: setupComplete");
    aiSessionReady = true;
    aiState = AI_IDLE;
    drawAiOrTranslatorPage();
    return;
  }

  if (doc.containsKey("toolCall")) {
    Serial.println("[AI] recv: toolCall");
    JsonArray calls = doc["toolCall"]["functionCalls"].as<JsonArray>();
    for (JsonObject call : calls) {
      const char* name = call["name"] | "";
      const char* callId = call["id"] | "";
      if (!name[0]) continue;
      JsonObject args = call["args"];
      if (strcmp(name, "web_search") == 0 && !aiModelIsGemini(activeWebSearchModel)) {
        String argsPreview; serializeJson(args, argsPreview);
        aiStartWebSearchAsync(String((const char*)(args["query"] | "")), argsPreview, String(callId), true);
        continue;
      }
      if (aiToolIsAsyncNetwork(name) && !aiNetToolActive) {
        String argsJson; serializeJson(args, argsJson);
        String argsPreviewAsync; serializeJson(args, argsPreviewAsync);
        aiStartNetToolAsync(name, argsJson, argsPreviewAsync, String(callId), true);
        continue;
      }
      String result;
      if (!aiRunToolCall(name, args, result)) continue;

      DynamicJsonDocument out(result.length() + 512);
      JsonObject toolResponse = out.createNestedObject("toolResponse");
      JsonArray funcResponses = toolResponse.createNestedArray("functionResponses");
      JsonObject fr = funcResponses.createNestedObject();
      if (callId[0]) fr["id"] = callId;
      fr["name"] = name;
      fr.createNestedObject("response")["result"] = result;
      String outStr; serializeJson(out, outStr);
      aiClient.send(outStr);

    }
    return;
  }

  if (doc.containsKey("goAway")) {
    Serial.print("[AI] recv: goAway, timeLeft=");
    Serial.println((const char*)(doc["goAway"]["timeLeft"] | "?"));
    return;
  }

  if (doc.containsKey("serverContent")) {
    JsonObject sc = doc["serverContent"];

    if (!translatorPageOpen && geminiTurnWasGrounded(sc)) {
      String wMark = originTagMark('W');
      if (aiReplyTranscript.indexOf(wMark) < 0) {
        aiReplyTranscript = wMark + aiReplyTranscript;
        Serial.println("[AI] recv: groundingMetadata -> [W]");
      }
      accumulateGeminiGrounding(sc);
    }

    if (sc.containsKey("modelTurn")) {
      JsonArray parts = sc["modelTurn"]["parts"].as<JsonArray>();
      for (JsonObject part : parts) {
        if (aiResponseCancelled) continue;
        if (part.containsKey("inlineData")) {
          const char* b64 = part["inlineData"]["data"] | "";
          if (!b64[0]) continue;
          if (aiState != AI_SPEAKING) {
            aiState = AI_SPEAKING;
            aiEnqueueDeltaReset();
            drawAiOrTranslatorPage();
            if (displayOn) gfx->flush();
          }
          aiEnqueueDelta(b64);
        }
      }
    }

    if (sc.containsKey("outputTranscription")) {
      aiReplyTranscript += (const char*)(sc["outputTranscription"]["text"] | "");
    }

    if (sc.containsKey("inputTranscription")) {
      aiUserTranscript += (const char*)(sc["inputTranscription"]["text"] | "");
      if (aiDisplayModeIndex != AI_DISPLAY_VOICE && aiPageOpen && !aiToolHistoryOpen) {
        bool hadText = aiTextLineCount > 0;
        aiRewrapTextLines();
        if (aiTextLineCount > 0) {
          if (!hadText) drawAiPage();
          else drawAiTextArea();
        }
      }
    }

    if (sc["turnComplete"] | false) {
      Serial.println("[AI] recv: turnComplete");
      if (doc.containsKey("usageMetadata")) {
        JsonObject usage = doc["usageMetadata"];
        int tcInTok = usage["promptTokenCount"] | 0;
        int tcOutTok = usage["responseTokenCount"] | 0;
        int tcTotalTok = usage["totalTokenCount"] | 0;
        int tcCachedTok = usage["cachedContentTokenCount"] | 0;
        int tcThoughtTok = usage["thoughtsTokenCount"] | 0;
        int tcToolTok = usage["toolUsePromptTokenCount"] | 0;
        int tcAudioIn = geminiModalityTokens(usage["promptTokensDetails"].as<JsonArray>(), "AUDIO");
        int tcTextIn = geminiModalityTokens(usage["promptTokensDetails"].as<JsonArray>(), "TEXT");
        int tcAudioOut = geminiModalityTokens(usage["responseTokensDetails"].as<JsonArray>(), "AUDIO");
        int tcTextOut = geminiModalityTokens(usage["responseTokensDetails"].as<JsonArray>(), "TEXT");
        Serial.printf("[AI] turnComplete: tokens input=%d (text=%d audio=%d tool=%d cached=%d) "
                      "output=%d (text=%d audio=%d) thoughts=%d total=%d\n",
                      tcInTok, tcTextIn, tcAudioIn, tcToolTok, tcCachedTok, tcOutTok, tcTextOut, tcAudioOut,
                      tcThoughtTok, tcTotalTok);
        logTokenUsage(translatorPageOpen ? "translator" : "assistant",
                      translatorPageOpen ? "" : AI_DISPLAY_MODE_NAMES[aiDisplayModeIndex], "gemini",
                      translatorPageOpen ? activeTranslatorRealtimeModel : aiRealtimeModel,
                      (!translatorPageOpen && AI_MAX_OUT_TOKENS_VALUES[aiMaxOutTokensIndex] > 0)
                        ? AI_MAX_OUT_TOKENS_VALUES[aiMaxOutTokensIndex] : -1,
                      tcInTok, tcOutTok, tcCachedTok, tcThoughtTok, tcToolTok, tcAudioIn, tcTextIn,
                      tcAudioOut, tcTextOut, tcTotalTok, (int)aiLastTalkMs,
                      (int)((aiResponseAudioBytes * 1000UL) / (AUDIO_SAMPLE_RATE * 4)));
      }
      aiFinalizeTurn(translatorPageOpen ? activeTranslatorRealtimeModel : aiRealtimeModel);
      aiVoiceBufferAutoTurnEnd();
      wispTrace("AI TURN END (Gemini) poolPeak=" + String((unsigned)aiDeltaPoolPeakUsedThisTurn) +
                "/" + String(aiDeltaPoolActiveSize) +
                " poolDropped=" + String((unsigned)aiDeltaDroppedThisTurn) +
                " decodeFail=" + String((unsigned)(aiDecodeEmptyCountThisTurn + aiDecodeFailCountThisTurn + aiDecodeZeroSamplesThisTurn + aiResampleZeroCountThisTurn)) +
                " ringOverflowMs=" + String((unsigned)(aiRingOverflowBytesThisTurn / 64)) +
                " underruns=" + String((unsigned)aiUnderrunCountThisTurn) +
                " audioBytes=" + String((unsigned)aiResponseAudioBytes) +
                " backlogMax=" + String((unsigned)aiDeltaBacklogMax) +
                " procMaxUs=" + String(aiDeltaProcUsMax) +
                " decodeUs=" + String(aiSlowDeltaDecodeUs) +
                " resampleUs=" + String(aiSlowDeltaResampleUs) +
                " ringWriteUs=" + String(aiSlowDeltaRingWriteUs) +
                " recCopyUs=" + String(aiSlowDeltaRecCopyUs) +
                " i2sMaxUs=" + String(aiI2sWriteMaxUs));
    }
  }
}

void onAiMessage(WebsocketsMessage message) {
  DynamicJsonDocument doc(8192);
  if (deserializeJson(doc, message.data()) != DeserializationError::Ok) {
    Serial.println("[AI] JSON parse failed");
    return;
  }
  if (aiActiveProviderIsGemini) {
    handleGeminiMessage(doc);
    return;
  }
  const char* type = doc["type"] | "";

  bool isNoisy = strcmp(type, "response.audio.delta") == 0 ||
                 strcmp(type, "response.output_audio.delta") == 0 ||
                 strcmp(type, "response.audio_transcript.delta") == 0 ||
                 strcmp(type, "response.output_audio_transcript.delta") == 0 ||
                 strcmp(type, "response.output_text.delta") == 0 ||
                 strcmp(type, "response.function_call_arguments.delta") == 0 ||
                 strcmp(type, "conversation.item.input_audio_transcription.delta") == 0;
  if (!isNoisy) {
    Serial.print("[AI] recv type/len: ");
    Serial.println(message.data().length());
    Serial.println(message.data().substring(0, 200));
  }

  if (strcmp(type, "session.created") == 0) {
    if (translatorPageOpen) {
      DynamicJsonDocument cfg(1024);
      cfg["type"] = "session.update";
      JsonObject session = cfg.createNestedObject("session");
      session["type"] = "realtime";
      session["instructions"] = translatorBuildInstructions();
      JsonArray outModalities = session.createNestedArray("output_modalities");
      outModalities.add("audio");
      JsonObject audio = session.createNestedObject("audio");
      JsonObject audioIn = audio.createNestedObject("input");
      JsonObject inFormat = audioIn.createNestedObject("format");
      inFormat["type"] = "audio/pcm";
      inFormat["rate"] = 24000;
      audioIn["turn_detection"] = nullptr;
      JsonObject audioOut = audio.createNestedObject("output");
      audioOut["voice"] = aiOpenAiVoice;
      JsonObject outFormat = audioOut.createNestedObject("format");
      outFormat["type"] = "audio/pcm";
      outFormat["rate"] = 24000;
      String out; serializeJson(cfg, out);
      aiClient.send(out);
      return;
    }
    unsigned long tSc0 = millis();
    BasicJsonDocument<PsramJsonAllocator> cfg(24576);
    unsigned long tAlloc = millis();
    cfg["type"] = "session.update";
    JsonObject session = cfg.createNestedObject("session");
    session["type"] = "realtime";
    session["instructions"] = getAiSystemPrompt();
    unsigned long tPrompt = millis();
    JsonArray outModalities = session.createNestedArray("output_modalities");
    outModalities.add("audio");

    String eff = aiEffortLevels[aiEffortIndex];
    bool effSent = (eff == "none" || eff == "minimal" || eff == "low" || eff == "medium" ||
                     eff == "high" || eff == "xhigh" || eff == "max");
    if (effSent) {
      JsonObject reasoning = session.createNestedObject("reasoning");
      reasoning["effort"] = eff;
    }

    JsonObject audio = session.createNestedObject("audio");
    JsonObject audioIn = audio.createNestedObject("input");
    JsonObject inFormat = audioIn.createNestedObject("format");
    inFormat["type"] = "audio/pcm";
    inFormat["rate"] = 24000;
    audioIn["turn_detection"] = nullptr;
    if (saveHistoryMode >= SAVE_TEXT && !aiModelIsGemini(activeVoiceToTextModel)) {
      JsonObject transcription = audioIn.createNestedObject("transcription");
      transcription["model"] = activeVoiceToTextModel;
    }

    JsonObject audioOut = audio.createNestedObject("output");
    audioOut["voice"] = aiOpenAiVoice;
    JsonObject outFormat = audioOut.createNestedObject("format");
    outFormat["type"] = "audio/pcm";
    outFormat["rate"] = 24000;

    JsonArray tools = session.createNestedArray("tools");
    aiBuildToolsArray(tools, true);
    session["tool_choice"] = "auto";
    unsigned long tTools = millis();

    Serial.printf("[AI] session.update: model=%s effort=%s voiceToTextModel=%s\n",
                  aiRealtimeModel.c_str(), effSent ? eff.c_str() : "not sent",
                  saveHistoryMode >= SAVE_TEXT ? activeVoiceToTextModel.c_str() : "not sent");
    Serial.printf("[AI] session.created timing: alloc=%lums prompt=%lums tools=%lums total=%lums\n",
                  tAlloc - tSc0, tPrompt - tAlloc, tTools - tPrompt, tTools - tSc0);
    if (cfg.overflowed()) {
      Serial.println("[AI] WARNING: session.update JsonDocument OVERFLOWED — payload sent to the server is truncated/invalid");
    }
    String out; serializeJson(cfg, out);
    Serial.printf("[AI] session.update payload size: %u bytes (doc capacity %u)\n", (unsigned)out.length(), (unsigned)cfg.capacity());
    aiClient.send(out);
  } else if (strcmp(type, "session.updated") == 0) {
    aiSessionReady = true;
    aiState = AI_IDLE;
    drawAiOrTranslatorPage();
  } else if (strcmp(type, "response.created") == 0) {
    aiResponseCancelled = false;
  } else if (strcmp(type, "conversation.item.input_audio_transcription.completed") == 0) {
    aiUserTranscript = String((const char*)(doc["transcript"] | ""));
    if (aiDisplayModeIndex != AI_DISPLAY_VOICE && aiPageOpen && !aiToolHistoryOpen) {
      bool hadText = aiTextLineCount > 0;
      aiRewrapTextLines();
      if (aiTextLineCount > 0) {
        if (!hadText) drawAiPage();
        else drawAiTextArea();
      }
    }
  } else if (strcmp(type, "response.audio_transcript.delta") == 0 || strcmp(type, "response.output_audio_transcript.delta") == 0) {
    aiReplyTranscript += (const char*)(doc["delta"] | "");
  } else if (strcmp(type, "response.output_text.delta") == 0) {
    aiReplyTranscript += (const char*)(doc["delta"] | "");
    if (aiState != AI_SPEAKING) {
      aiState = AI_SPEAKING;
      drawAiOrTranslatorPage();
    }
  } else if (strcmp(type, "response.audio.delta") == 0 || strcmp(type, "response.output_audio.delta") == 0) {
    if (!aiResponseCancelled) {
      const char* b64 = doc["delta"] | "";
      if (b64[0] && aiState != AI_SPEAKING) {
        aiState = AI_SPEAKING;
        wispTrace("AI first delta elapsedMs=" + String(millis() - aiTurnStartMs));
        aiEnqueueDeltaReset();
        drawAiOrTranslatorPage();
        if (displayOn) gfx->flush();
      }
      aiEnqueueDelta(b64);
    }
  } else if (strcmp(type, "response.function_call_arguments.done") == 0) {
    handleAiFunctionCall(doc);
  } else if (strcmp(type, "response.done") == 0) {
    JsonObject usage = doc["response"]["usage"];
    int rdInTok = usage["input_tokens"] | 0;
    int rdTextIn = usage["input_token_details"]["text_tokens"] | 0;
    int rdAudioIn = usage["input_token_details"]["audio_tokens"] | 0;
    int rdCachedTok = usage["input_token_details"]["cached_tokens"] | 0;
    int rdOutTok = usage["output_tokens"] | 0;
    int rdTextOut = usage["output_token_details"]["text_tokens"] | 0;
    int rdAudioOut = usage["output_token_details"]["audio_tokens"] | 0;
    int rdTotalTok = usage["total_tokens"] | 0;
    Serial.printf("[AI] response.done: tokens input=%d (text=%d audio=%d cached=%d) "
                  "output=%d (text=%d audio=%d) total=%d\n",
                  rdInTok, rdTextIn, rdAudioIn, rdCachedTok, rdOutTok, rdTextOut, rdAudioOut, rdTotalTok);
    logTokenUsage(translatorPageOpen ? "translator" : "assistant",
                  translatorPageOpen ? "" : AI_DISPLAY_MODE_NAMES[aiDisplayModeIndex], "openai",
                  translatorPageOpen ? activeTranslatorRealtimeModel : aiRealtimeModel,
                  (!translatorPageOpen && AI_MAX_OUT_TOKENS_VALUES[aiMaxOutTokensIndex] > 0)
                    ? AI_MAX_OUT_TOKENS_VALUES[aiMaxOutTokensIndex] : -1,
                  rdInTok, rdOutTok, rdCachedTok, -1, -1, rdAudioIn, rdTextIn, rdAudioOut, rdTextOut, rdTotalTok,
                  (int)aiLastTalkMs, (int)((aiResponseAudioBytes * 1000UL) / (AUDIO_SAMPLE_RATE * 4)));
    if (aiResponseHadToolCall) {
      aiResponseHadToolCall = false;
    } else {
      String logModel = translatorPageOpen ? activeTranslatorRealtimeModel : aiRealtimeModel;
      aiFinalizeTurn(logModel);
    }
  } else if (strcmp(type, "error") == 0) {
    const char* errCode = doc["error"]["code"] | "";
    if (strcmp(errCode, "response_cancel_not_active") == 0) {
      Serial.println("[AI] cancel arrived after response already finished — ignoring, nothing to do");
    } else {
      String fullErrMsg = String((const char*)(doc["error"]["message"] | "error"));
      Serial.println("[AI] error: " + fullErrMsg);
      aiErrorMsg = "Server error";
      aiErrorDetail = aiShortReason(fullErrMsg);
      aiState = AI_ERROR;
      drawAiOrTranslatorPage();
    }
  }
}

void drawAiOrTranslatorPage() {
  if (translatorPageOpen) drawTranslatorPage();
  else drawAiPage();
}

void sendGeminiSetup() {
  BasicJsonDocument<PsramJsonAllocator> flatToolsDoc(8192);
  JsonArray flatTools = flatToolsDoc.to<JsonArray>();
  aiBuildToolsArray(flatTools, true);

  BasicJsonDocument<PsramJsonAllocator> setupDoc(24576);
  JsonObject setup = setupDoc.createNestedObject("setup");
  setup["model"] = "models/" + aiRealtimeModel;

  JsonObject genCfg = setup.createNestedObject("generationConfig");
  JsonArray respModalities = genCfg.createNestedArray("responseModalities");
  respModalities.add("AUDIO");
  if (AI_MAX_OUT_TOKENS_VALUES[aiMaxOutTokensIndex] > 0) {
    genCfg["maxOutputTokens"] = AI_MAX_OUT_TOKENS_VALUES[aiMaxOutTokensIndex];
  }
  {
    String eff = aiEffortLevels[aiEffortIndex];
    if (eff == "minimal" || eff == "low" || eff == "medium" || eff == "high") {
      JsonObject thinkCfg = genCfg.createNestedObject("thinkingConfig");
      thinkCfg["thinkingLevel"] = eff;
    }
  }
  JsonObject speechCfg = genCfg.createNestedObject("speechConfig");
  JsonObject voiceCfg = speechCfg.createNestedObject("voiceConfig");
  voiceCfg.createNestedObject("prebuiltVoiceConfig")["voiceName"] = aiGeminiVoice;

  JsonObject sysInstr = setup.createNestedObject("systemInstruction");
  JsonArray sysParts = sysInstr.createNestedArray("parts");
  sysParts.createNestedObject()["text"] = getAiSystemPrompt();

  JsonArray geminiTools = setup.createNestedArray("tools");
  if (aiWebSearchEnabled && aiModelIsGemini(activeWebSearchModel)) {
    geminiTools.createNestedObject().createNestedObject("googleSearch");
  }
  JsonArray funcDecls = geminiTools.createNestedObject().createNestedArray("functionDeclarations");
  for (JsonObject t : flatTools) {
    JsonObject fd = funcDecls.createNestedObject();
    fd["name"] = t["name"];
    fd["description"] = t["description"];
    if (t.containsKey("parameters")) fd["parametersJsonSchema"] = t["parameters"];
  }

  JsonObject rtCfg = setup.createNestedObject("realtimeInputConfig");
  rtCfg.createNestedObject("automaticActivityDetection")["disabled"] = true;

  if (saveHistoryMode >= SAVE_TEXT) setup.createNestedObject("inputAudioTranscription");
  setup.createNestedObject("outputAudioTranscription");

  String out; serializeJson(setupDoc, out);
  aiClient.send(out);
}

