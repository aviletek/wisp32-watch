static bool passwordMeetsStrength(const String& pw) {
  if (pw.length() < 8) return false;
  bool hasUpper = false, hasLower = false, hasDigit = false, hasSpecial = false;
  for (size_t i = 0; i < pw.length(); i++) {
    char c = pw[i];
    if (isUpperCase(c)) hasUpper = true;
    else if (isLowerCase(c)) hasLower = true;
    else if (isDigit(c)) hasDigit = true;
    else hasSpecial = true;
  }
  return hasUpper && hasLower && hasDigit && hasSpecial;
}

static bool verifyEncryptionPassword(const String& password) {
  int32_t cid;
  if (!readSdCardSerial(&cid)) return false;
  uint8_t candidate[AES_KEY_LEN];
  deriveKeyFromCidAndPassword(cid, password, candidate);
  return memcmp(candidate, activeAesKey, AES_KEY_LEN) == 0;
}

static bool dirHasEncryptedFile(const String& dirPath, int* count = nullptr) {
  File dir = SD_MMC.open(dirPath);
  if (!dir || !dir.isDirectory()) { if (dir) dir.close(); return false; }
  File entry = dir.openNextFile();
  bool found = false;
  while (entry) {
    bool isDir = entry.isDirectory();
    String rawName = String(entry.name());
    String path = rawName.startsWith("/") ? rawName : (dirPath + "/" + rawName);
    if (isDir) {
      entry.close();
      if (dirHasEncryptedFile(path, count)) {
        found = true;
        if (!count) { dir.close(); return true; }
      }
    } else {
      uint8_t hdr[ENCRYPT_MAGIC_LEN];
      bool isEnc = entry.size() >= (size_t)ENCRYPT_MAGIC_LEN && entry.read(hdr, ENCRYPT_MAGIC_LEN) == ENCRYPT_MAGIC_LEN
                   && memcmp(hdr, ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN) == 0;
      entry.close();
      if (isEnc) {
        found = true;
        if (count) (*count)++;
        else { dir.close(); return true; }
      }
    }
    entry = dir.openNextFile();
  }
  dir.close();
  return found;
}

static void convertOneFile(const String& path, bool toEncrypted, int* ok, int* failed, String* okList, String* failedList) {
  File f = SD_MMC.open(path, FILE_READ);
  if (!f) return;
  bool isCurrentlyEncrypted = false;
  uint8_t hdr[ENCRYPT_MAGIC_LEN];
  if (f.size() >= ENCRYPT_MAGIC_LEN && f.read(hdr, ENCRYPT_MAGIC_LEN) == ENCRYPT_MAGIC_LEN
      && memcmp(hdr, ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN) == 0) isCurrentlyEncrypted = true;
  f.close();
  if (isCurrentlyEncrypted == toEncrypted) {
    (*ok)++; if (okList->length() > 0) *okList += ", "; *okList += path;
    return;
  }
  bool savedFlag = sdEncryptionActive;
  sdEncryptionActive = true;
  String content = readKnowledgeFile(path);
  sdEncryptionActive = toEncrypted;
  bool wrote = writeKnowledgeFile(path, content);
  sdEncryptionActive = savedFlag;
  if (wrote) { (*ok)++; if (okList->length() > 0) *okList += ", "; *okList += path; }
  else { (*failed)++; if (failedList->length() > 0) *failedList += ", "; *failedList += path; }
}

static void convertDirTree(const String& dirPath, bool toEncrypted, int* ok, int* failed, String* okList, String* failedList) {
  if (dirPath.endsWith("/Logs")) return;
  File dir = SD_MMC.open(dirPath);
  if (!dir || !dir.isDirectory()) { if (dir) dir.close(); return; }
  File entry = dir.openNextFile();
  while (entry) {
    bool isDir = entry.isDirectory();
    String rawName = String(entry.name());
    String path = rawName.startsWith("/") ? rawName : (dirPath + "/" + rawName);
    entry.close();
    if (isDir) convertDirTree(path, toEncrypted, ok, failed, okList, failedList);
    else if (path.endsWith(".pwd")) convertSecretFile(path, toEncrypted, ok, failed, okList, failedList);
    else convertOneFile(path, toEncrypted, ok, failed, okList, failedList);
    entry = dir.openNextFile();
  }
  dir.close();
}

static void convertCtrLog(const char* path, bool toEncrypted, int* ok, int* failed, String* okList, String* failedList) {
  if (!SD_MMC.exists(path)) return;
  sdEncryptionActive = !toEncrypted;
  ChatLogReader r;
  if (!r.open(path)) {
    sdEncryptionActive = toEncrypted;
    (*failed)++; if (failedList->length() > 0) *failedList += ", "; *failedList += path;
    return;
  }
  size_t sz = r.size();
  String content;
  if (sz > 0) {
    uint8_t* buf = (uint8_t*)ps_malloc(sz + 1);
    if (buf) {
      size_t got = r.read(buf, sz);
      buf[got] = 0;
      content = String((char*)buf);
      free(buf);
    }
  }
  r.close();

  sdEncryptionActive = toEncrypted;
  String tmpPath = String(path) + "_convtmp";
  SD_MMC.remove(tmpPath);
  bool ok2 = chatLogWriteFresh(tmpPath, content);
  if (ok2) { SD_MMC.remove(path); ok2 = SD_MMC.rename(tmpPath, path); }
  if (!ok2) SD_MMC.remove(tmpPath);
  if (ok2) { (*ok)++; if (okList->length() > 0) *okList += ", "; *okList += path; }
  else { (*failed)++; if (failedList->length() > 0) *failedList += ", "; *failedList += path; }
}

static void convertSecretFile(const String& path, bool toEncrypted, int* ok, int* failed, String* okList, String* failedList) {
  if (!SD_MMC.exists(path)) return;
  bool savedFlag = sdEncryptionActive;
  String content;
  if (toEncrypted) {
    sdEncryptionActive = false;
    bool wasPlaintext = false;
    content = readSecretFile(path, &wasPlaintext);
  } else {
    sdEncryptionActive = true;
    content = readKnowledgeFile(path);
  }
  sdEncryptionActive = toEncrypted;
  bool wrote = toEncrypted ? writeKnowledgeFile(path, content) : writeSecretFile(path, content);
  sdEncryptionActive = savedFlag;
  if (wrote) { (*ok)++; if (okList->length() > 0) *okList += ", "; *okList += path; }
  else { (*failed)++; if (failedList->length() > 0) *failedList += ", "; *failedList += path; }
}

static void convertAllFiles(bool toEncrypted, int* ok, int* failed, String* okList, String* failedList) {
  convertCtrLog("/chat_log.txt", toEncrypted, ok, failed, okList, failedList);
  convertCtrLog(KNOWLEDGE_DIR "/Logs/tool_calls.csv", toEncrypted, ok, failed, okList, failedList);
  convertCtrLog(KNOWLEDGE_DIR "/Logs/tokens.csv", toEncrypted, ok, failed, okList, failedList);
  convertCtrLog(KNOWLEDGE_DIR "/Logs/replays.csv", toEncrypted, ok, failed, okList, failedList);
  sdEncryptionActive = toEncrypted;
  convertDirTree(KNOWLEDGE_DIR, toEncrypted, ok, failed, okList, failedList);
  convertDirTree(IMAGES_DIR,    toEncrypted, ok, failed, okList, failedList);
  convertOneFile(PROMPT_AI_FILE,        toEncrypted, ok, failed, okList, failedList);
  convertOneFile(PROMPT_WEBSEARCH_FILE, toEncrypted, ok, failed, okList, failedList);
  convertSecretFile(CREDENTIALS_FILE, toEncrypted, ok, failed, okList, failedList);
  convertSecretFile(PAGE_TASKS_FILE,  toEncrypted, ok, failed, okList, failedList);
}

static bool activateEncryptionFirstTime(const String& password, int* ok, int* failed, String* okList, String* failedList) {
  int32_t cid;
  if (!readSdCardSerial(&cid)) return false;
  uint8_t newKey[AES_KEY_LEN];
  deriveKeyFromCidAndPassword(cid, password, newKey);
  memcpy(activeAesKey, newKey, AES_KEY_LEN);

  *ok = 0; *failed = 0; *okList = ""; *failedList = "";
  convertAllFiles(true, ok, failed, okList, failedList);

  if (*failed > 0) {
    int rbOk = 0, rbFailed = 0; String rbOkList, rbFailedList;
    convertAllFiles(false, &rbOk, &rbFailed, &rbOkList, &rbFailedList);
    sdEncryptionActive = false;
    memset(activeAesKey, 0, AES_KEY_LEN);
    if (rbFailed > 0) {
      *failedList += " — AND the automatic rollback of the " + String(rbOk) + " file(s) that had already been "
        "converted also couldn't fully finish (" + String(rbFailed) + " file(s): " + rbFailedList + "). "
        "Do NOT remove the SD card — try Remove Encryption again before doing anything else.";
    }
    return false;
  }

  saveEncryptionStateToNvs(cid, newKey);
  return true;
}

static bool activateEncryptionReactivate(const String& password) {
  int32_t cid;
  if (!readSdCardSerial(&cid)) return false;
  uint8_t key[AES_KEY_LEN];
  deriveKeyFromCidAndPassword(cid, password, key);
  memcpy(activeAesKey, key, AES_KEY_LEN);
  sdEncryptionActive = true;
  saveEncryptionStateToNvs(cid, key);
  return true;
}

static bool removeEncryption(const String& password, int* ok, int* failed, String* okList, String* failedList, String* blockedReason) {
  *ok = 0; *failed = 0; *okList = ""; *failedList = ""; *blockedReason = "";
  if (!sdEncryptionActive) return true;

  if (!verifyEncryptionPassword(password)) {
    *blockedReason = "Incorrect password.";
    return false;
  }
  int filesEncCount = 0;
  if (dirHasEncryptedFile(FILES_DIR, &filesEncCount)) {
    *blockedReason = String(filesEncCount) + " encrypted file(s) are still in the Files folder. Decrypt each one "
      "individually first (its own Decrypt link on the Files page), then try Remove Encryption again.";
    return false;
  }

  convertAllFiles(false, ok, failed, okList, failedList);

  if (*failed > 0) {
    int rbOk = 0, rbFailed = 0; String rbOkList, rbFailedList;
    convertAllFiles(true, &rbOk, &rbFailed, &rbOkList, &rbFailedList);
    sdEncryptionActive = true;
    if (rbFailed > 0) {
      *failedList += " — AND re-encrypting the " + String(rbOk) + " file(s) that had already been decrypted "
        "also couldn't fully finish (" + String(rbFailed) + " file(s): " + rbFailedList + "). "
        "Do NOT remove the SD card — try again before doing anything else.";
    }
    return false;
  }

  sdEncryptionActive = false;
  memset(activeAesKey, 0, AES_KEY_LEN);
  clearEncryptionStateFromNvs();
  return true;
}

static void countFilesForPreview(const String& dirPath, int* count) {
  if (dirPath.endsWith("/Logs")) return;
  File dir = SD_MMC.open(dirPath);
  if (!dir || !dir.isDirectory()) { if (dir) dir.close(); return; }
  File entry = dir.openNextFile();
  while (entry) {
    bool isDir = entry.isDirectory();
    String rawName = String(entry.name());
    String path = rawName.startsWith("/") ? rawName : (dirPath + "/" + rawName);
    entry.close();
    if (isDir) countFilesForPreview(path, count);
    else (*count)++;
    entry = dir.openNextFile();
  }
  dir.close();
}

