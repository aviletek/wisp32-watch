static int perceivedLuma565(uint16_t c) {
  int r = ((c >> 11) & 0x1F) * 255 / 31;
  int g = ((c >> 5)  & 0x3F) * 255 / 63;
  int b = (c & 0x1F) * 255 / 31;
  return (r * 299 + g * 587 + b * 114) / 1000;
}

static uint16_t ensureContrast565(uint16_t color, uint16_t bg) {
  const int MIN_DIFF = 90;
  int bgLuma = perceivedLuma565(bg);
  int cLuma  = perceivedLuma565(color);
  if (abs(cLuma - bgLuma) >= MIN_DIFF) return color;
  uint16_t target = (bgLuma < 128) ? 0xFFFF : 0x0000;
  int cr = (color >> 11) & 0x1F, cg = (color >> 5) & 0x3F, cb = color & 0x1F;
  int tr = (target >> 11) & 0x1F, tg = (target >> 5) & 0x3F, tb = target & 0x1F;
  int r = cr + (tr - cr) / 2, g = cg + (tg - cg) / 2, b = cb + (tb - cb) / 2;
  return (uint16_t)((r << 11) | (g << 5) | b);
}

static void recomputeDerivedColors() {
  {
    uint8_t r = (COLOR_WHITE >> 11) & 0x1F, g = (COLOR_WHITE >> 5) & 0x3F, b = COLOR_WHITE & 0x1F;
    COLOR_WHITE_DIM = (uint16_t)(((r * 3 / 4) << 11) | ((g * 3 / 4) << 5) | (b * 3 / 4));
  }
  {
    int r = ((COLOR_BLACK >> 11) & 0x1F) + 4; if (r > 31) r = 31;
    int g = ((COLOR_BLACK >> 5)  & 0x3F) + 8; if (g > 63) g = 63;
    int b = (COLOR_BLACK & 0x1F) + 4;         if (b > 31) b = 31;
    COLOR_DARK_GRAY = (uint16_t)((r << 11) | (g << 5) | b);
  }
  {
    int wr = (COLOR_WHITE >> 11) & 0x1F, wg = (COLOR_WHITE >> 5) & 0x3F, wb = COLOR_WHITE & 0x1F;
    int br = (COLOR_BLACK >> 11) & 0x1F, bg = (COLOR_BLACK >> 5) & 0x3F, bb = COLOR_BLACK & 0x1F;
    int r = br + (wr - br) * 26 / 100;
    int g = bg + (wg - bg) * 26 / 100;
    int b = bb + (wb - bb) * 26 / 100;
    COLOR_GRAY = (uint16_t)((r << 11) | (g << 5) | b);
  }
  COLOR_GREEN  = ensureContrast565(COLOR_GREEN_DEFAULT,  COLOR_BLACK);
  COLOR_YELLOW = ensureContrast565(COLOR_YELLOW_DEFAULT, COLOR_BLACK);
  COLOR_ORANGE = ensureContrast565(COLOR_ORANGE_DEFAULT, COLOR_BLACK);
  COLOR_RED    = ensureContrast565(COLOR_RED_DEFAULT,    COLOR_BLACK);
}

