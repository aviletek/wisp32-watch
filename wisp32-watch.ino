String aiToolSendEmail(String to, String subject, String body, String attachments, bool headless) {
  to.trim(); subject.trim(); body.trim(); attachments.trim();
  if (!headless && pendingEmailArmed) {
    return "Error: another email is still being sent — wait for that turn to finish before sending another.";
  }
  if (to.length() == 0) return "Error: no recipient given";
  if (body.length() == 0) return "Error: no message content given";
  String addr = aiToolResolveContact(to);
  if (addr.length() == 0) {
    return "Error: \"" + to + "\" isn't a saved contact. Email can only be sent to a name already saved on the "
           "Credentials page — never invent, guess, or spell out an address yourself, even one the user seems "
           "to be dictating letter-by-letter; it must be saved as a contact first, then sent to by that name. "
           "If there's no user present to tell (a headless task run), stop here and report that this contact "
           "doesn't exist rather than proceeding with any address of your own.";
  }
  if (subject.length() == 0) subject = activeEmailDefaultSubject;
  if (activeEmailSignature.length() > 0) body += "\n\n" + activeEmailSignature;

  SmtpAttachment files[AI_EMAIL_ATTACHMENTS_MAX_COUNT];
  int fileCount = 0;
  if (attachments.length() > 0) {
    if (!sdMounted) return "Error: SD card not mounted";
    size_t totalBytes = 0;
    int idx = 0;
    while (idx < (int)attachments.length()) {
      int comma = attachments.indexOf(',', idx);
      String piece = (comma < 0) ? attachments.substring(idx) : attachments.substring(idx, comma);
      idx = (comma < 0) ? attachments.length() : comma + 1;
      piece.trim();
      if (piece.length() == 0) continue;

      if (fileCount >= AI_EMAIL_ATTACHMENTS_MAX_COUNT) {
        return "Error: too many attachments — up to " + String(AI_EMAIL_ATTACHMENTS_MAX_COUNT) + " files per email.";
      }
      String resolvedName, path, suggestion;
      bool found = aiKbResolveFile(piece, &resolvedName, &path, &suggestion);
      if (!found) {
        if (suggestion.length() > 0) {
          return "Attachment \"" + piece + "\" wasn't found, but a similar file exists: '" + suggestion + "'. "
            "Ask the user if that's the one they meant, then call send_email again with that exact name.";
        }
        return "Error: attachment \"" + piece + "\" not found on this device.";
      }
      if (kbFindRestrictingPin(resolvedName).length() > 0) {
        return "Error: \"" + resolvedName + "\" is PIN-protected and can't be attached to an email.";
      }
      File f = SD_MMC.open(path, FILE_READ);
      if (!f) return "Error: could not read attachment \"" + resolvedName + "\".";
      size_t sz = f.size();
      f.close();
      if (sz > AI_EMAIL_ATTACHMENT_MAX_BYTES) {
        return "Error: \"" + resolvedName + "\" is " + String(sz / 1024) + "KB, over the "
          + String(AI_EMAIL_ATTACHMENT_MAX_BYTES / 1024) + "KB per-file attachment limit.";
      }
      totalBytes += sz;
      if (totalBytes > AI_EMAIL_ATTACHMENTS_TOTAL_MAX_BYTES) {
        return "Error: attachments total " + String(totalBytes / 1024) + "KB, over the "
          + String(AI_EMAIL_ATTACHMENTS_TOTAL_MAX_BYTES / 1024) + "KB combined limit.";
      }
      files[fileCount].filename = resolvedName;
      files[fileCount].content = readKnowledgeFile(path);
      fileCount++;
    }
  }

  if (headless) {
    String err = smtpSendMail(addr, subject, body, files, fileCount);
    if (err.length() > 0) return "Error: could not send email — " + err;
    return "Email sent to " + to + (fileCount > 0 ? " with " + String(fileCount) + " attachment(s)." : ".");
  }

  pendingEmailToAddr = addr;
  pendingEmailToName = to;
  pendingEmailSubject = subject;
  pendingEmailBody = body;
  pendingEmailAttachmentCount = pendingEmailAttachments ? fileCount : 0;
  for (int i = 0; pendingEmailAttachments && i < fileCount; i++) pendingEmailAttachments[i] = files[i];
  pendingEmailArmed = true;

  return "Tell the user, briefly, that you're sending the email now, then say goodbye — this conversation is "
         "about to end so the email can actually send, and it cannot narrate the result back to them once it "
         "does. Do not call any other tool after this one; end your turn right after the goodbye. They can "
         "check whether it went through afterward in the tool call log (Knowledge Base -> Logs).";
}

static int findPageTaskByName(const String& query) {
  String q = query; q.toLowerCase();
  for (int i = 0; i < activePageTaskCount; i++) {
    String nm = activePageTasks[i].name; nm.toLowerCase();
    if (nm == q) return i;
  }
  for (int i = 0; i < activePageTaskCount; i++) {
    String nm = activePageTasks[i].name; nm.toLowerCase();
    if (nm.indexOf(q) >= 0 || q.indexOf(nm) >= 0) return i;
  }
  return -1;
}

String aiToolRunTask(String name) {
  name.trim();
  if (name.length() == 0) return "Error: no task name given";

  int pageIdx = findPageTaskByName(name);
  if (pageIdx < 0) {
    return "Error: no task named \"" + name + "\" found on the Tasks page. This name likely didn't survive "
           "voice-to-text correctly. Call list_tasks to see what's actually available, compare it against what "
           "the user asked for, and call run_task again with whichever real name is the closest match.";
  }
  if (pageTaskNeedsModel(activePageTasks[pageIdx]) && !aiProviderHasKeyFor(activePageTasks[pageIdx].model, false)) {
    return "Error: no API key configured for " + activePageTasks[pageIdx].model;
  }

  pendingTaskRunIdx = pageIdx;
  return "Tell the user, briefly, that you're running the \"" + activePageTasks[pageIdx].name + "\" task now, "
         "then say goodbye — this conversation is about to end so the task can actually run, and it cannot "
         "narrate the result back to them once it does. Do not call any other tool after this one; end your "
         "turn right after the goodbye. They can check what happened afterward on the Tasks page, in History, "
         "or via a notify email if the task has one configured.";
}

String pageTaskScheduleLabel(const PageTask& t) {
  if (t.scheduleType == "once") {
    return "Once on " + t.scheduleDate + " at " + t.scheduleTime;
  }
  if (t.scheduleType == "weekly") {
    const char* dayNames[7] = {"Sun","Mon","Tue","Wed","Thu","Fri","Sat"};
    String days = "";
    String daysCsv = "," + t.scheduleDays + ",";
    for (int d = 0; d < 7; d++) {
      if (daysCsv.indexOf("," + String(d) + ",") >= 0) {
        if (days.length() > 0) days += ", ";
        days += dayNames[d];
      }
    }
    if (days.length() == 0) days = "no days selected";
    return "Weekly (" + days + ") at " + t.scheduleTime;
  }
  return "Manual only";
}

String timeSinceStr(time_t thenEpoch) {
  if (thenEpoch <= 0) return "";
  long diff = (long)(time(NULL) - thenEpoch);
  if (diff < 0) diff = 0;
  if (diff < 60) return "just now";
  if (diff < 3600) { long m = diff / 60; return String(m) + (m == 1 ? " minute ago" : " minutes ago"); }
  if (diff < 86400) { long h = diff / 3600; return String(h) + (h == 1 ? " hour ago" : " hours ago"); }
  if (diff < 7 * 86400) { long d = diff / 86400; return String(d) + (d == 1 ? " day ago" : " days ago"); }
  struct tm ti; localtime_r(&thenEpoch, &ti);
  char buf[13]; strftime(buf, sizeof(buf), "%b %d %Y", &ti);
  return String(buf);
}

String aiToolListTasks(String name) {
  name.trim();

  if (name.length() > 0) {
    int idx = findPageTaskByName(name);
    if (idx < 0) {
      return "Error: no task named \"" + name + "\" found. Call list_tasks with no name to see everything available.";
    }
    PageTask& t = activePageTasks[idx];
    String folderLabel = t.folder.length() == 0 ? "None" : (t.folder == PAGE_TASK_FOLDER_ROOT ? "Root" : t.folder);
    String out = "Task \"" + t.name + "\":\n";
    out += "Model: " + t.model + "\n";
    out += "Notify: " + (t.notify.length() > 0 ? t.notify : "None") + "\n";
    out += "Folder reference: " + folderLabel + "\n";
    out += "Retries on failure: " + String(t.retries) + "\n";
    out += "Schedule: " + pageTaskScheduleLabel(t) + "\n";
    out += "Last run: " + (t.lastRunAt.length() > 0 ? (t.lastRunStatus + " at " + t.lastRunAt) : "Never run") + "\n";
    out += "Steps:\n";
    for (int s = 0; s < t.stepCount; s++) {
      out += String(s + 1) + ". " + (t.steps[s].type == "action" ? ("[" + t.steps[s].action + "]") : t.steps[s].text) + "\n";
    }
    return out;
  }

  if (activePageTaskCount == 0) return "No tasks have been created on the Tasks page yet.";
  String out = "";
  for (int i = 0; i < activePageTaskCount; i++) {
    PageTask& t = activePageTasks[i];
    if (i > 0) out += ", ";
    out += "'" + t.name + "' (" + t.model + ", " + pageTaskScheduleLabel(t) + ")";
  }
  return String(activePageTaskCount) + (activePageTaskCount == 1 ? " task" : " tasks") + " on the Tasks page: " + out;
}

struct AiMathEval {
  const char* p;
  bool ok = true;
  AiMathEval(const char* s) : p(s) {}
  void skipSpace() { while (*p == ' ') p++; }
  double parseExpr() {
    double v = parseTerm();
    skipSpace();
    while (ok && (*p == '+' || *p == '-')) {
      char op = *p; p++;
      double rhs = parseTerm();
      v = (op == '+') ? v + rhs : v - rhs;
      skipSpace();
    }
    return v;
  }
  double parseTerm() {
    double v = parseUnary();
    skipSpace();
    while (ok && (*p == '*' || *p == '/')) {
      char op = *p; p++;
      double rhs = parseUnary();
      if (op == '*') v *= rhs; else v /= rhs;
      skipSpace();
    }
    return v;
  }
  double parseUnary() {
    skipSpace();
    if (*p == '-') { p++; return -parseUnary(); }
    if (*p == '+') { p++; return parseUnary(); }
    return parsePow();
  }
  double parsePow() {
    double base = parsePrimary();
    skipSpace();
    if (*p == '^') { p++; double e = parseUnary(); return pow(base, e); }
    return base;
  }
  double parsePrimary() {
    skipSpace();
    if (*p == '(') {
      p++;
      double v = parseExpr();
      skipSpace();
      if (*p == ')') p++; else ok = false;
      return v;
    }
    if (isalpha((unsigned char)*p) || *p == '_') {
      const char* start = p;
      while (isalnum((unsigned char)*p) || *p == '_') p++;
      String name; for (const char* q = start; q < p; q++) name += *q;
      name.toLowerCase();
      skipSpace();
      if (*p != '(') {
        if (name == "pi") return PI;
        if (name == "e") return 2.718281828459045;
        ok = false; return 0;
      }
      p++;
      double arg = parseExpr();
      skipSpace();
      if (*p == ')') p++; else ok = false;
      if (name == "sqrt") return sqrt(arg);
      if (name == "abs") return fabs(arg);
      if (name == "round") return round(arg);
      if (name == "floor") return floor(arg);
      if (name == "ceil") return ceil(arg);
      if (name == "sin") return sin(arg);
      if (name == "cos") return cos(arg);
      if (name == "tan") return tan(arg);
      if (name == "log10") return log10(arg);
      if (name == "log2") return log(arg) / log(2.0);
      if (name == "log") return log(arg);
      if (name == "exp") return exp(arg);
      if (name == "factorial") {
        if (arg < 0 || arg != floor(arg)) { ok = false; return 0; }
        double r = 1; for (int i = 2; i <= (int)arg; i++) r *= i;
        return r;
      }
      ok = false; return 0;
    }
    if (isdigit((unsigned char)*p) || *p == '.') {
      char* endp;
      double v = strtod(p, &endp);
      if (endp == p) { ok = false; return 0; }
      p = endp;
      return v;
    }
    ok = false; return 0;
  }
};
static double qcProgressiveTax(double amount, const double* upperBounds, const double* rates, int rateCount) {
  double tax = 0, prev = 0;
  for (int i = 0; i < rateCount; i++) {
    if (amount <= prev) break;
    double upper = (i < rateCount - 1) ? upperBounds[i] : amount;
    double taxable = fmin(amount, upper) - prev;
    if (taxable > 0) tax += taxable * rates[i];
    prev = upper;
  }
  return tax;
}

String aiToolCalculate(String expr) {
  expr.trim();
  if (expr.length() == 0) return "Error: empty expression";

  int lp = expr.indexOf('(');
  if (lp > 0 && expr.endsWith(")")) {
    String fname = expr.substring(0, lp); fname.trim(); fname.toLowerCase();
    String inner = expr.substring(lp + 1, expr.length() - 1);
    double a[8]; int an = 0; bool argOk = true;
    int start = 0;
    for (int i = 0; i <= inner.length() && an < 8; i++) {
      if (i == inner.length() || inner[i] == ',') {
        String piece = inner.substring(start, i); piece.trim();
        if (piece.length() == 0) { argOk = false; break; }
        char* ep; double v = strtod(piece.c_str(), &ep);
        if (ep == piece.c_str()) { argOk = false; break; }
        a[an++] = v;
        start = i + 1;
      }
    }
    if (argOk && an > 0) {
      double r = 0; bool matched = true;
      if (fname == "fv" && an >= 2) {
        double rate = a[0], n = a[1], p = an > 2 ? a[2] : 0, pv = an > 3 ? a[3] : 0;
        if (rate == 0) r = -(pv + p * n);
        else { double v = pow(1 + rate, n); r = -(pv * v + p * ((v - 1) / rate)); }
      } else if (fname == "pv" && an >= 2) {
        double rate = a[0], n = a[1], p = an > 2 ? a[2] : 0, fv = an > 3 ? a[3] : 0;
        if (rate == 0) r = -(fv + p * n);
        else { double v = pow(1 + rate, n); r = -(fv / v + p * ((1 - 1 / v) / rate)); }
      } else if (fname == "pmt" && an >= 3) {
        double rate = a[0], n = a[1], pv = a[2], fv = an > 3 ? a[3] : 0;
        if (rate == 0) r = -(pv + fv) / n;
        else { double v = pow(1 + rate, n); r = rate * (pv * v + fv) / (1 - v); }
      } else if (fname == "nper" && an >= 3) {
        double rate = a[0], p = a[1], pv = a[2], fv = an > 3 ? a[3] : 0;
        if (rate == 0) r = -(pv + fv) / p;
        else r = log((p - fv * rate) / (p + pv * rate)) / log(1 + rate);
      } else if (fname == "npv" && an >= 2) {
        double rate = a[0]; r = 0;
        for (int i = 1; i < an; i++) r += a[i] / pow(1 + rate, (double)(i - 1));
      } else if (fname == "cagr" && an >= 3) {
        r = pow(a[1] / a[0], 1.0 / a[2]) - 1;
      } else if (fname == "roi" && an >= 2) {
        r = (a[0] - a[1]) / a[1] * 100;
      } else if (fname == "rule72" && an >= 1) {
        r = 72.0 / a[0];
      } else if (fname == "inflation" && an >= 3) {
        r = a[0] * pow(1 + a[1], a[2]);
      } else if (fname == "needed_pmt" && an >= 3) {
        double rate = a[0], n = a[1], goal = a[2];
        r = (rate == 0) ? goal / n : (goal * rate / (pow(1 + rate, n) - 1));
      } else if (fname == "qc_tax" && an >= 1) {
        r = a[0] * 1.14975;
      } else if (fname == "qc_takehome" && an >= 1) {
        double gross = a[0];

        double fedUpper[4] = {58523, 117045, 181440, 258482};
        double fedRates[5] = {0.14, 0.205, 0.26, 0.29, 0.33};
        double fedRaw = qcProgressiveTax(gross, fedUpper, fedRates, 5);
        double fedTax = fmax(0.0, (fedRaw - 2303.28) * 0.835);

        double qcUpper[3] = {54345, 108680, 132245};
        double qcRates[4] = {0.14, 0.19, 0.24, 0.2575};
        double qcRaw = qcProgressiveTax(gross, qcUpper, qcRates, 4);
        double qcTax = fmax(0.0, qcRaw - 2405.62);

        double qppBase1 = fmin(fmax(gross - 3500.0, 0.0), 71100.0);
        double qppBase2 = fmin(fmax(gross - 74600.0, 0.0), 10400.0);
        double qpp = fmin(0.063 * qppBase1 + 0.04 * qppBase2, 4895.30);

        double ei = fmin(0.0130 * fmin(gross, 68900.0), 895.70);
        double qpip = fmin(0.00494 * fmin(gross, 98000.0), 484.12);

        r = gross - fedTax - qcTax - qpp - ei - qpip;
      } else {
        matched = false;
      }
      if (matched) {
        if (isnan(r) || isinf(r)) return "Error: result is undefined (check inputs)";
        double rounded = round(r * 100.0) / 100.0;
        return expr + " = " + String(rounded, 2);
      }
    }
  }

  AiMathEval ev(expr.c_str());
  double result = ev.parseExpr();
  ev.skipSpace();
  if (!ev.ok || *ev.p != '\0') return "Error: could not evaluate expression";
  if (isnan(result) || isinf(result)) return "Error: result is undefined or infinite";
  return expr + " = " + String(result, 6);
}

String sanitizeUtf8(const String& in) {
  String out;
  out.reserve(in.length());
  size_t i = 0, n = in.length();
  while (i < n) {
    uint8_t c = (uint8_t)in[i];
    int extra;
    uint32_t cp;
    if (c < 0x80) { out += (char)c; i++; continue; }
    else if ((c & 0xE0) == 0xC0) { extra = 1; cp = c & 0x1F; }
    else if ((c & 0xF0) == 0xE0) { extra = 2; cp = c & 0x0F; }
    else if ((c & 0xF8) == 0xF0) { extra = 3; cp = c & 0x07; }
    else { out += '?'; i++; continue; }

    bool ok = (i + extra < n);
    if (ok) {
      for (int k = 1; k <= extra; k++) {
        uint8_t cc = (uint8_t)in[i + k];
        if ((cc & 0xC0) != 0x80) { ok = false; break; }
        cp = (cp << 6) | (cc & 0x3F);
      }
    }
    if (ok) {
      if      (extra == 1 && cp < 0x80)    ok = false;
      else if (extra == 2 && cp < 0x800)   ok = false;
      else if (extra == 3 && cp < 0x10000) ok = false;
      if (cp >= 0xD800 && cp <= 0xDFFF)    ok = false;
      if (cp > 0x10FFFF)                   ok = false;
    }
    if (ok) {
      for (int k = 0; k <= extra; k++) out += in[i + k];
      i += extra + 1;
    } else {
      out += '?';
      i++;
    }
  }
  return out;
}

String aiKbSlug(String name) {
  name.trim(); name.toLowerCase();
  String out;
  for (size_t i = 0; i < name.length(); i++) {
    char c = name[i];
    if (c == ' ') out += '_';
    else if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '-') out += c;
  }
  return out;
}

static const char* AI_KB_TEXT_EXTENSIONS[] = { ".txt", ".md", ".csv", ".json" };
static const int AI_KB_TEXT_EXTENSIONS_COUNT = 4;

static String aiKbRecognizedExtension(const String& name) {
  String lower = name; lower.toLowerCase();
  for (int i = 0; i < AI_KB_TEXT_EXTENSIONS_COUNT; i++) {
    String ext = AI_KB_TEXT_EXTENSIONS[i];
    if (lower.endsWith(ext) && lower.length() > (size_t)ext.length()) return ext;
  }
  return "";
}

String aiToolFileCreate(String name) {
  String ext = aiKbRecognizedExtension(name);
  String base = ext.length() > 0 ? name.substring(0, name.length() - ext.length()) : name;
  String slug = aiKbSlug(base);
  if (slug.length() == 0) return "Error: invalid file name";
  if (!sdMounted) return "Error: SD card not mounted";
  if (ext.length() == 0) ext = ".txt";
  String fileName = (aiTaskActiveDir.length() > 0 ? aiTaskActiveDir + "/" : "") + slug + ext;
  String path = String(KNOWLEDGE_DIR) + "/" + fileName;
  if (!SD_MMC.exists(path)) {
    time_t now = time(nullptr); struct tm lt; localtime_r(&now, &lt);
    char hdrbuf[48]; strftime(hdrbuf, sizeof(hdrbuf), "Created %Y-%m-%d %H:%M\n\n", &lt);
    if (!writeKnowledgeFile(path, String(hdrbuf))) return "Error: could not create file";
  }
  aiActiveFile = fileName;
  reloadKnowledge();
  return "File created: " + fileName + ". Now active — say \"add note [text]\" to write to it.";
}

static bool aiKbResolveFile(const String& name, String* outResolvedName, String* outPath, String* outSuggestion) {
  if (aiTaskActiveDir.length() > 0 && name.indexOf('/') < 0) {
    String localName = aiTaskActiveDir + "/" + name;
    String localPath = String(KNOWLEDGE_DIR) + "/" + localName;
    if (isKnowledgeFile(name) && SD_MMC.exists(localPath)) {
      *outResolvedName = localName;
      *outPath = localPath;
      return true;
    }
    String localSlug = aiKbSlug(name);
    if (localSlug.length() > 0) {
      for (int i = 0; i < AI_KB_TEXT_EXTENSIONS_COUNT; i++) {
        localName = aiTaskActiveDir + "/" + localSlug + AI_KB_TEXT_EXTENSIONS[i];
        localPath = String(KNOWLEDGE_DIR) + "/" + localName;
        if (SD_MMC.exists(localPath)) {
          *outResolvedName = localName;
          *outPath = localPath;
          return true;
        }
      }
    }
  }

  String resolvedName = name;
  String path = String(KNOWLEDGE_DIR) + "/" + name;
  bool found = isKnowledgeFile(name) && SD_MMC.exists(path);

  if (!found) {
    String slug = aiKbSlug(name);
    if (slug.length() > 0) {
      for (int i = 0; i < AI_KB_TEXT_EXTENSIONS_COUNT && !found; i++) {
        resolvedName = slug + AI_KB_TEXT_EXTENSIONS[i];
        path = String(KNOWLEDGE_DIR) + "/" + resolvedName;
        found = SD_MMC.exists(path);
      }
    }
  }

  if (!found) {
    bool exact = false;
    String suggestion = aiFindSimilarKnowledgeFile(name, &exact);
    if (suggestion.length() > 0) {
      if (exact) {
        resolvedName = suggestion;
        path = String(KNOWLEDGE_DIR) + "/" + resolvedName;
        found = true;
      } else {
        *outSuggestion = suggestion;
        return false;
      }
    }
  }

  if (found) {
    *outResolvedName = resolvedName;
    *outPath = path;
  }
  return found;
}

String aiToolFileOpen(String name, String pin) {
  name.trim();
  pin.trim();
  if (name.length() == 0) return "Error: invalid file name";
  if (!sdMounted) return "Error: SD card not mounted";
  largeFileLastResponseId = "";
  largeFileLastInteractionId = "";

  String resolvedName, path, suggestion;
  bool found = aiKbResolveFile(name, &resolvedName, &path, &suggestion);

  if (!found && suggestion.length() > 0) {
    return "Found a similar file: '" + suggestion + "'. Tell the user you found that file and ask if it's "
      "the one they meant — do NOT say the file couldn't be found or that nothing matched; a close match "
      "WAS found, so lead with that. If they confirm, call file_open again with that exact name.";
  }

  if (!found) {
    return "File not found: '" + name + "'. This name likely didn't survive voice-to-text correctly. Call list_files now, "
      "compare its full list against what the user actually asked for, and call file_open again with whichever real "
      "filename is the closest match — don't ask the user to repeat themselves or to say \"list files\" themselves. "
      "Only tell the user no file was found if list_files comes back empty or truly nothing on it is plausibly related.";
  }

  String requiredPin = kbFindRestrictingPin(resolvedName);
  if (requiredPin.length() > 0 && pin != requiredPin) {
    largeFileActive = false;
    largeFileContent = "";
    largeFileContentReleased = false;
    largeFileName = "";
    largeFileLastResponseId = "";
    largeFileLastInteractionId = "";
    return "File '" + resolvedName + "' is restricted. Ask the user for the PIN, then call file_open again with the same name and the pin argument set to exactly what they say — never guess it.";
  }

  String content;

  String syncUrl; bool wipeAfterUse = false;
  kbSyncGet(resolvedName, &syncUrl, nullptr, nullptr, nullptr, nullptr, &wipeAfterUse);
  if (wipeAfterUse && syncUrl.length() > 0) {
    String body, err;
    if (!kbHttpGet(syncUrl, body, err)) {
      return "File '" + resolvedName + "' is a sync-on-use file and its live source couldn't be reached right now (" + err + "). "
        "Tell the user its source is currently unavailable (offline or not responding) and to try again shortly.";
    }
    kbSyncDecryptBodyIfNeeded(body);
    content = sanitizeUtf8(body);
    if (content.length() == 0) {
      return "File '" + resolvedName + "' fetched empty from its live source. Tell the user the source returned no content.";
    }
  } else {
  kbSyncFileIfStale(resolvedName);

  File _sizeCheck = SD_MMC.open(path, FILE_READ);
  size_t onDiskBytes = _sizeCheck ? _sizeCheck.size() : 0;
  if (_sizeCheck) _sizeCheck.close();

  content = sanitizeUtf8(readKnowledgeFile(path));
  if (content.length() == 0 && onDiskBytes > 0) {
    return "File '" + resolvedName + "' (" + String((unsigned)onDiskBytes) + " bytes) could not be loaded right now — "
      "likely low on memory during this session. Tell the user it couldn't be opened right now, possibly due to low memory, "
      "and suggest closing the AI Assistant and reopening it, or trying a smaller file.";
  }
  }

  aiActiveFile = "";
  if (!aiFileAnalysisEnabled) {
    largeFileActive = false;
    return "File Q&A is turned off in Settings, so files can't be opened right now. "
      "Turn on File Q&A in Settings to open and read files.";
  }
  largeFileActive = true;
  largeFileName = resolvedName;
  largeFileContent = content;
  largeFileContentReleased = false;
  {
    String kbPrefix = String(KNOWLEDGE_DIR) + "/";
    String ref = path.startsWith(kbPrefix) ? path.substring(kbPrefix.length()) : resolvedName;
    largeFileInstructions = kbAiMetaGetInstructions(ref);
    if (largeFileInstructions.length() > 0) {
      Serial.printf("[AI] file Q&A: using %u chars of per-file instructions for '%s'\n",
                    (unsigned)largeFileInstructions.length(), ref.c_str());
    }
  }
  return "File '" + resolvedName + "' is open. It's handled by the file analysis model — that model reads the file's entire content, in full, every time you ask it a question via ask_file_question, not just a portion of it. "
    + "If the user asked you to open this file, tell them it's open and ready. "
    + "If you opened it yourself to answer a question they already asked, say nothing about opening it — call ask_file_question now and give them the answer, as if you simply knew it. "
    + "Either way, answer their questions about it normally, exactly like any other open file. "
    + "Never say it's too big, that it didn't load, or that you can only see parts of it — none of that is true, and from the user's perspective it's simply open.";
}

String taskFileOpenContent(String name, String pin) {
  name.trim();
  pin.trim();
  if (name.length() == 0) return "Error: invalid file name";
  if (!sdMounted) return "Error: SD card not mounted";

  String resolvedName, path, suggestion;
  bool found = aiKbResolveFile(name, &resolvedName, &path, &suggestion);
  if (!found) {
    return suggestion.length() > 0
      ? "Error: file not found: '" + name + "' — closest match: '" + suggestion + "'"
      : "Error: file not found: '" + name + "'";
  }

  String requiredPin = kbFindRestrictingPin(resolvedName);
  if (requiredPin.length() > 0 && pin != requiredPin) {
    return "Error: file '" + resolvedName + "' is restricted — wrong or missing PIN";
  }

  String content = sanitizeUtf8(readKnowledgeFile(path));
  if (content.length() > AI_FILE_OPEN_MAX_CHARS) {
    return "Error: file '" + resolvedName + "' is too large (" + String(content.length())
      + " characters, limit " + String(AI_FILE_OPEN_MAX_CHARS) + ")";
  }
  return content;
}

static bool largeFileReloadContent() {
  if (largeFileContent.length() > 0) return true;
  if (!largeFileActive || largeFileName.length() == 0) return false;
  if (!sdMounted) return false;

  String resolvedName, path, suggestion;
  if (!aiKbResolveFile(largeFileName, &resolvedName, &path, &suggestion)) {
    Serial.print("[AI] file Q&A reload: '"); Serial.print(largeFileName);
    Serial.println("' no longer resolves on the card");
    return false;
  }
  File sizeCheck = SD_MMC.open(path, FILE_READ);
  size_t onDiskBytes = sizeCheck ? sizeCheck.size() : 0;
  if (sizeCheck) sizeCheck.close();
  String content = sanitizeUtf8(readKnowledgeFile(path));
  if (content.length() == 0) {
    Serial.printf("[AI] file Q&A reload FAILED (%u bytes on disk, 0 read back)\n", (unsigned)onDiskBytes);
    return false;
  }
  largeFileContent = content;
  largeFileContentReleased = false;
  Serial.printf("[AI] file Q&A: chain broke, reloaded '%s' from card (%u chars)\n",
                resolvedName.c_str(), (unsigned)content.length());
  return true;
}

String aiToolAskFileQuestion(String question) {
  question.trim();
  if (question.length() == 0) return "Error: no question provided";
  if (!largeFileActive) return "Error: no large file is currently loaded. Use file_open on a file first.";
  if (largeFileContentReleased && largeFileLastResponseId.length() == 0 && largeFileLastInteractionId.length() == 0) {
    if (!largeFileReloadContent()) {
      return "The file is no longer accessible on the device and the earlier conversation about it was lost. "
        "Tell the user plainly that you have lost access to the file and ask them to open it again — "
        "do not attempt to answer their question, and do not claim the file is still open.";
    }
  }

  if (aiModelIsGemini(activeFileQaModel)) return aiToolAskFileQuestionGemini(question);

  String instructions = "You are answering questions about a specific document the user has loaded on their "
                         "device. Answer concisely and directly based on the provided document content. If "
                         "the answer isn't in the document, say so clearly.";
  if (largeFileInstructions.length() > 0) {
    instructions += "\n\nThe user has provided these notes about this specific document:\n" + largeFileInstructions;
  }

  for (int attempt = 0; attempt < 2; attempt++) {
    bool useChain = (attempt == 0) && largeFileLastResponseId.length() > 0;

    String payload;
    payload.reserve(instructions.length() + largeFileName.length() + largeFileContent.length()
                     + question.length() + 320);
    payload = "{\"model\":\"";
    payload += activeFileQaModel;
    payload += "\",\"instructions\":\"";
    jsonEscapeAppendTo(payload, instructions);
    payload += "\",\"input\":\"";
    if (useChain) {
      jsonEscapeAppendTo(payload, question);
    } else {
      payload += "Document: ";
      jsonEscapeAppendTo(payload, largeFileName);
      payload += "\\n\\n";
      jsonEscapeAppendTo(payload, largeFileContent);
      payload += "\\n\\nQuestion: ";
      jsonEscapeAppendTo(payload, question);
    }
    payload += "\"";
    if (useChain) {
      payload += ",\"previous_response_id\":\"";
      jsonEscapeAppendTo(payload, largeFileLastResponseId);
      payload += "\"";
    }
    bool effortSent = (aiFileQaEffort != "none");
    if (effortSent) {
      payload += ",\"reasoning\":{\"effort\":\"";
      payload += aiFileQaEffort;
      payload += "\"}";
    }
    if (AI_MAX_OUT_TOKENS_VALUES[aiQaMaxTokIndex] > 0) {
      payload += ",\"max_output_tokens\":";
      payload += String(AI_MAX_OUT_TOKENS_VALUES[aiQaMaxTokIndex]);
    }
    payload += "}";

    Serial.printf("[AI] ask_file_question: model=%s effort=%s maxTok=%s attempt=%d chained=%s payload=%u bytes, free heap=%u, max alloc=%u, free psram=%u\n",
                  activeFileQaModel.c_str(), effortSent ? aiFileQaEffort.c_str() : "not sent",
                  AI_MAX_OUT_TOKENS_VALUES[aiQaMaxTokIndex] > 0 ? AI_MAX_OUT_TOKENS_NAMES[aiQaMaxTokIndex] : "not sent",
                  attempt, useChain ? "yes" : "no", (unsigned)payload.length(), (unsigned)ESP.getFreeHeap(),
                  (unsigned)ESP.getMaxAllocHeap(), (unsigned)ESP.getFreePsram());

    HTTPClient http;
    int code = -1;
    for (int netTry = 0; netTry < 2; netTry++) {
      http.begin("https://api.openai.com/v1/responses");
      http.setTimeout(30000);
      http.addHeader("Authorization", String("Bearer ") + activeOpenAiKey);
      http.addHeader("Content-Type", "application/json");
      code = http.POST(payload);
      taskRebootOnHttpDashOne(code);
      if (code >= 0) break;
      Serial.printf("[AI] ask_file_question connection failed, HTTP %d — retrying\n", code);
      http.end();
      delay(400);
    }
    if (code != 200) {
      String errBody = http.getString();
      http.end();
      Serial.print("[AI] ask_file_question failed, HTTP "); Serial.print(code);
      Serial.print(", body: "); Serial.println(errBody.substring(0, 500));
      if (useChain) {
        largeFileLastResponseId = "";
        if (!largeFileReloadContent()) {
          return "The file is no longer accessible on the device, so this question can't be answered. "
            "Tell the user plainly that you have lost access to the file and ask them to open it again — "
            "do not attempt to answer their question, and do not claim the file is still open.";
        }
        continue;
      }
      return "Error: file Q&A request failed (HTTP " + String(code) + ")";
    }
    auto& fqStream = http.getStream();
    unsigned long fqWaitStart = millis();
    while (fqStream.connected() && !fqStream.available() && (millis() - fqWaitStart) < 5000) {
      delay(10);
    }
    BasicJsonDocument<PsramJsonAllocator> res(24576);
    DeserializationError err = deserializeJson(res, fqStream);
    http.end();
    if (err != DeserializationError::Ok) {
      Serial.print("[AI] ask_file_question response parse failed: "); Serial.println(err.c_str());
      if (useChain) {
        largeFileLastResponseId = "";
        if (!largeFileReloadContent()) {
          return "The file is no longer accessible on the device, so this question can't be answered. "
            "Tell the user plainly that you have lost access to the file and ask them to open it again — "
            "do not attempt to answer their question, and do not claim the file is still open.";
        }
        continue;
      }
      return "Error: could not parse response";
    }

    String answer = "";
    for (JsonObject item : res["output"].as<JsonArray>()) {
      if (strcmp(item["type"] | "", "message") == 0) {
        for (JsonObject c : item["content"].as<JsonArray>()) {
          if (strcmp(c["type"] | "", "output_text") == 0) {
            answer = String((const char*)(c["text"] | ""));
            break;
          }
        }
        if (answer.length() > 0) break;
      }
    }

    if (useChain) {
      largeFileLastResponseId = String((const char*)(res["id"] | ""));
    } else if (largeFileContent.length() > 0) {
      largeFileLastResponseId = String((const char*)(res["id"] | ""));
      if (largeFileLastResponseId.length() > 0) {
        largeFileContent = "";
        largeFileContentReleased = true;
      }
    } else {
      Serial.println("[AI] file Q&A: fresh request carried no document — chain NOT anchored to it");
      largeFileLastResponseId = "";
    }
    int fqInTok = res["usage"]["input_tokens"] | 0;
    int fqCachedTok = res["usage"]["input_tokens_details"]["cached_tokens"] | 0;
    int fqOutTok = res["usage"]["output_tokens"] | 0;
    int fqReasonTok = res["usage"]["output_tokens_details"]["reasoning_tokens"] | 0;
    int fqTotalTok = res["usage"]["total_tokens"] | 0;
    Serial.printf("[AI] ask_file_question: tokens input=%d (cached=%d) output=%d (reasoning=%d) total=%d\n",
                  fqInTok, fqCachedTok, fqOutTok, fqReasonTok, fqTotalTok);
    logTokenUsage("fileqa", "", "openai", activeFileQaModel,
                  AI_MAX_OUT_TOKENS_VALUES[aiQaMaxTokIndex] > 0 ? AI_MAX_OUT_TOKENS_VALUES[aiQaMaxTokIndex] : -1,
                  fqInTok, fqOutTok, fqCachedTok, fqReasonTok, -1, -1, -1, -1, -1, fqTotalTok, -1, -1);
    return answer.length() > 0 ? answer : "No answer returned.";
  }
  return "Error: file Q&A request failed after retry";
}

