static bool aiToolIsSelfReferentialName(const String& name) {
  return name.equalsIgnoreCase("me") || name.equalsIgnoreCase("myself") ||
         name.equalsIgnoreCase("my email") || name.equalsIgnoreCase("self") ||
         name.equalsIgnoreCase("i");
}

static String aiToolResolveContact(const String& to) {
  for (int i = 0; i < activeContactCount; i++) {
    if (activeContacts[i].name.equalsIgnoreCase(to)) return activeContacts[i].email;
  }
  if (aiToolIsSelfReferentialName(to)) {
    String selfAddr = "";
    int selfMatches = 0;
    for (int i = 0; i < activeContactCount; i++) {
      if (aiToolIsSelfReferentialName(activeContacts[i].name)) { selfAddr = activeContacts[i].email; selfMatches++; }
    }
    if (selfMatches == 1) return selfAddr;
  }
  return "";
}

