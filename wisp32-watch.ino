static unsigned long fileTranscribeLastActivityMs = 0;
#define FILE_TRANSCRIBE_IDLE_TIMEOUT_MS 90000UL
#define FILE_TRANSCRIBE_CHUNK_MAX_BYTES (2UL * 1024 * 1024)

static uint8_t* fileTranscribeBuf = nullptr;
static size_t fileTranscribeBufFill = 0;
static bool fileTranscribeUploadOverflow = false;

static void fileTranscribeReleaseJob() {
  fileTranscribeActive = false;
  fileTranscribeBufFill = 0;
  fileTranscribeUploadOverflow = false;
  if (fileTranscribeBuf) { free(fileTranscribeBuf); fileTranscribeBuf = nullptr; }
}

static String fileTranscribeBusyReason() {
  if (noteState == NOTE_RECORDING) return "a note is recording";
  if (aiListening) return "AI Assistant or Translator is listening";
  if (fileTranscribeActive) return "another file is already being transcribed";
  return "";
}

void handleApiTranscribeStart() {
  if (!requireAuth()) return;
  String busy = fileTranscribeBusyReason();
  if (busy.length() > 0) {
    server.send(409, "application/json", "{\"ok\":false,\"reason\":\"" + busy + "\"}");
    return;
  }
  if (!fileTranscribeBuf) fileTranscribeBuf = (uint8_t*)ps_malloc(FILE_TRANSCRIBE_CHUNK_MAX_BYTES);
  if (!fileTranscribeBuf) {
    server.send(500, "application/json", "{\"ok\":false,\"reason\":\"Out of memory\"}");
    return;
  }
  fileTranscribeActive = true;
  fileTranscribeLastActivityMs = millis();
  server.send(200, "application/json", "{\"ok\":true}");
}

void handleApiTranscribeChunkUpload() {
  HTTPUpload& upload = server.upload();
  if (upload.status == UPLOAD_FILE_START) {
    fileTranscribeBufFill = 0;
    fileTranscribeUploadOverflow = false;
    fileTranscribeLastActivityMs = millis();
  } else if (upload.status == UPLOAD_FILE_WRITE) {
    if (fileTranscribeUploadOverflow || !fileTranscribeBuf) return;
    if (fileTranscribeBufFill + upload.currentSize > FILE_TRANSCRIBE_CHUNK_MAX_BYTES) {
      fileTranscribeUploadOverflow = true;
      return;
    }
    memcpy(fileTranscribeBuf + fileTranscribeBufFill, upload.buf, upload.currentSize);
    fileTranscribeBufFill += upload.currentSize;
    fileTranscribeLastActivityMs = millis();
  }
}

void handleApiTranscribeChunk() {
  if (!requireAuth()) return;
  if (!fileTranscribeActive) { server.send(409, "application/json", "{\"ok\":false,\"error\":\"no active job\"}"); return; }
  fileTranscribeLastActivityMs = millis();
  if (fileTranscribeUploadOverflow || fileTranscribeBufFill < 44) {
    server.send(200, "application/json", "{\"ok\":false,\"error\":\"bad chunk\"}");
    return;
  }
  if (_netMutex) xSemaphoreTake(_netMutex, portMAX_DELAY);
  String text = aiModelIsGemini(activeVoiceToTextModel)
    ? noteTranscribeAudioGemini(fileTranscribeBuf, fileTranscribeBufFill)
    : noteTranscribeAudio(fileTranscribeBuf, fileTranscribeBufFill);
  if (_netMutex) xSemaphoreGive(_netMutex);
  fileTranscribeLastActivityMs = millis();
  if (text.length() == 0) {
    server.send(200, "application/json", "{\"ok\":false,\"error\":\"transcription failed\"}");
    return;
  }
  DynamicJsonDocument doc(text.length() + 64);
  doc["ok"] = true;
  doc["text"] = text;
  String out; serializeJson(doc, out);
  server.send(200, "application/json", out);
}

void handleApiTranscribeCancel() {
  if (!requireAuth()) return;
  fileTranscribeReleaseJob();
  server.send(200, "application/json", "{\"ok\":true}");
}

void handleApiTranscribeEnd() {
  if (!requireAuth()) return;
  bool saved = false;
  String savedName;
  if (server.hasArg("file") && server.hasArg("text") && server.arg("text").length() > 0) {
    String srcRef = server.arg("file");
    String text = server.arg("text");
    int slash = srcRef.lastIndexOf('/');
    String dir = (slash >= 0) ? srcRef.substring(0, slash) : "";
    String base = (slash >= 0) ? srcRef.substring(slash + 1) : srcRef;
    int dot = base.lastIndexOf('.');
    if (dot > 0) base = base.substring(0, dot);
    savedName = base + ".transcript.txt";
    String path = String(FILES_DIR) + (dir.length() > 0 ? "/" + dir : "") + "/" + savedName;
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    File f = SD_MMC.open(path, "w");
    if (f) { f.print(text); f.close(); saved = true; }
    if (_sdMutex) xSemaphoreGive(_sdMutex);
  }
  fileTranscribeReleaseJob();
  DynamicJsonDocument doc(savedName.length() + 64);
  doc["ok"] = true;
  doc["saved"] = saved;
  if (saved) doc["filename"] = savedName;
  String out; serializeJson(doc, out);
  server.send(200, "application/json", out);
}

static String translatorBuildInstructions() {
  String src = TRANSLATOR_LANGS[translatorSourceIndex].name;
  String tgt = TRANSLATOR_LANGS[translatorTargetIndex].name;
  return "You are a real-time speech translator, not a conversational assistant. "
         "The user will speak in " + src + ". Translate what they say into " + tgt +
         ", and respond with ONLY the spoken translation in " + tgt + " — no commentary, "
         "no questions, no extra words, nothing except the translation itself. Do not answer "
         "questions, do not have a conversation, do not add pleasantries or greetings. If the "
         "input is unclear, silent, or not actually speech, respond with nothing at all.";
}

static void translatorReconnect() {
  if (!translatorPageOpen || !aiSessionReady) return;
  if (aiOpenAiSendActive) {
    unsigned long openAiSendWaitStart = millis();
    while (aiOpenAiSendActive && millis() - openAiSendWaitStart < 3000) delay(5);
  }
  aiClient.close();
  aiSessionReady = false;
  connectAiWebSocket();
}

static int translatorIncludedPos(int langIdx) {
  for (int i = 0; i < translatorIncludedCount; i++) {
    if (translatorIncludedIdx[i] == langIdx) return i;
  }
  return -1;
}

static void translatorStepLang(int* idx, int dir) {
  if (translatorIncludedCount <= 0) return;
  int pos = translatorIncludedPos(*idx);
  if (pos < 0) { *idx = translatorIncludedIdx[0]; return; }
  pos = (pos + dir + translatorIncludedCount) % translatorIncludedCount;
  *idx = translatorIncludedIdx[pos];
}

void cycleTranslatorSource(int dir) {
  translatorStepLang(&translatorSourceIndex, dir);
  saveSettings();
  translatorReconnect();
  drawTranslatorPage();
}

void cycleTranslatorTarget(int dir) {
  translatorStepLang(&translatorTargetIndex, dir);
  saveSettings();
  translatorReconnect();
  drawTranslatorPage();
}

void translatorReverseLangs() {
  int tmp = translatorSourceIndex;
  translatorSourceIndex = translatorTargetIndex;
  translatorTargetIndex = tmp;
  saveSettings();
  translatorReconnect();
  drawTranslatorPage();
}

void openTranslatorPage() {
  if (featureDisabled("translator")) return;
  wxYieldForUi();
  translatorPageOpen = true;
  if (!aiTranslatorEnabled) {
    aiState = AI_ERROR;
    aiErrorMsg = "Translator disabled";
    aiErrorDetail = "pick a model on /aimodels";
    drawTranslatorPage();
    return;
  }
  if (!aiProviderHasKeyFor(activeTranslatorRealtimeModel, false)) {
    translatorPageOpen = false;
    return;
  }
  aiState = AI_IDLE;
  aiErrorMsg = "";
  requestAudioServerStop();
  aiMemResetPending = true;
  { time_t _n = time(NULL);
    aiChatSessionId = (_n > 1000000000) ? String((unsigned long)_n)
                                        : ("b" + String(aiConnectCount + 1)); }
  aiChatTurnN = 0;
  aiLogSessionStart();
  micResumeForPage();
  ensureAiTasks();
  ensureAiPlayRing();
  ensureAiRecBuf();
  aiPlayRingReset();
  aiPlayActive = true;
  aiEnsureDeltaQueue();
  aiDeltaTaskActive = true;
  translatorReplaying = false;
  drawTranslatorPage();
  connectAiIfNeeded();
}

void closeTranslatorPage() {
  translatorPageOpen = false;
  sessionTurnsSet(aiChatSessionId, aiChatTurnN);
  aiFlushPendingAudioLogFinalize();
  aiLogSessionEnd();
  aiDeltaTaskActive = false;
  aiPlayActive = false;
  if (aiListening) aiListening = false;
  if (aiOpenAiSendActive) {
    unsigned long openAiSendWaitStart = millis();
    while (aiOpenAiSendActive && millis() - openAiSendWaitStart < 3000) delay(5);
  }
  delay(40);
  if (aiRecBuf) { free(aiRecBuf); aiRecBuf = nullptr; }
  aiDrainDeltaQueue();
  if (aiPlayRing) { free(aiPlayRing); aiPlayRing = nullptr; aiPlayRingCap = 0; aiPsramFreeCount++; }
  aiPlayRingReset();
  translatorReplaying = false;
  aiClient.close();
  aiSessionReady = false;
  aiState = AI_IDLE;
  micParkForPage();
  if (!sdMounted) { drawSdCardMissingScreen(); return; }
  drawClockScreen();
}

