static int naturalCompareCI(const String& a, const String& b) {
  int ia = 0, ib = 0;
  int la = a.length(), lb = b.length();
  while (ia < la && ib < lb) {
    char ca = a[ia], cb = b[ib];
    bool da = isDigit(ca), db = isDigit(cb);
    if (da && db) {
      int sa = ia, sb = ib;
      while (ia < la && isDigit(a[ia])) ia++;
      while (ib < lb && isDigit(b[ib])) ib++;
      String na = a.substring(sa, ia); while (na.length() > 1 && na[0] == '0') na.remove(0, 1);
      String nb = b.substring(sb, ib); while (nb.length() > 1 && nb[0] == '0') nb.remove(0, 1);
      if (na.length() != nb.length()) return na.length() - nb.length();
      int c = na.compareTo(nb);
      if (c != 0) return c;
    } else {
      char lca = tolower(ca), lcb = tolower(cb);
      if (lca != lcb) return lca - lcb;
      ia++; ib++;
    }
  }
  return (la - ia) - (lb - ib);
}

void handleRoot() {
  if (!requireAuth()) return;
  if (navRouteBlocked("knowledge")) return;

  String curPath = server.hasArg("path") ? sanitizeDirPath(server.arg("path")) : "";
  String kbDirPath = String(KNOWLEDGE_DIR) + (curPath.length() > 0 ? "/" + curPath : "");

  if (server.hasArg("sort") || server.hasArg("dir")) {
    String newSort = server.hasArg("sort") ? server.arg("sort") : fileSortCol;
    String newDir  = server.hasArg("dir")  ? server.arg("dir")  : fileSortDir;
    if (newSort != "name" && newSort != "size" && newSort != "date") newSort = "name";
    if (newDir != "asc" && newDir != "desc") newDir = "asc";
    if (newSort != fileSortCol || newDir != fileSortDir) {
      fileSortCol = newSort;
      fileSortDir = newDir;
      saveSettings();
    }
    server.sendHeader("Location", "/" + String(curPath.length() > 0 ? "?path=" + curPath : ""));
    server.send(303);
    return;
  }

  String curSort = fileSortCol;
  String curDir  = fileSortDir;
  const int PAGE = 40;
  int    pgNum   = server.hasArg("pg") ? server.arg("pg").toInt() : 1;
  String cDir    = server.hasArg("cdir")  ? server.arg("cdir")  : "";
  bool   cIsDir  = server.hasArg("cflag") && server.arg("cflag") == "1";
  long long cNum = server.hasArg("cnum")  ? strtoll(server.arg("cnum").c_str(), nullptr, 10) : 0LL;
  String cName   = server.hasArg("cname") ? server.arg("cname") : "";
  bool   hasCursor = (cDir == "a" || cDir == "b") && cName.length() > 0;
  if (!hasCursor) pgNum = 1;
  if (pgNum < 1)  pgNum = 1;

  String crumbHtml = "<div class='bc'>";
  if (curPath.length() == 0) {
  } else {
    crumbHtml += "<a href='/' class='bc-a'>Knowledge</a>";
    String built = "", remaining = curPath;
    while (remaining.length() > 0) {
      int sl = remaining.indexOf('/');
      String part = (sl >= 0) ? remaining.substring(0, sl) : remaining;
      remaining  = (sl >= 0) ? remaining.substring(sl + 1) : "";
      built += (built.length() > 0 ? "/" : "") + part;
      crumbHtml += "<span class='bc-sep'>&#8250;</span>";
      if (remaining.length() == 0)
        crumbHtml += "<span class='bc-cur'>" + part + "</span>";
      else
        crumbHtml += "<a href='/?path=" + built + "' class='bc-a'>" + part + "</a>";
    }
  }
  crumbHtml += "</div>";

  struct KBEntry { String name; bool isDir; uint32_t rawSize; String date; time_t rawDate; };
  static KBEntry entries[80]; int entryCount = 0;
  static String restrictedNames[80]; int restrictedCount = 0;
  for (int _i = 0; _i < 80; _i++) { entries[_i].name = ""; entries[_i].date = ""; entries[_i].isDir = false; entries[_i].rawSize = 0; entries[_i].rawDate = 0; }
  auto cmpDisp = [&](bool aDir, long long aNum, const String& aName,
                     bool bDir, long long bNum, const String& bName) -> int {
    int ra = aDir ? 0 : 1, rb = bDir ? 0 : 1;
    if (ra != rb) return ra - rb;
    int c = (curSort == "name") ? naturalCompareCI(aName, bName)
                                : (aNum < bNum ? -1 : (aNum > bNum ? 1 : 0));
    if (curDir == "desc") c = -c;
    if (c != 0) return c;
    return naturalCompareCI(aName, bName);
  };
  auto entNum = [&](const KBEntry& e) -> long long {
    return (curSort == "size") ? (long long)e.rawSize : (long long)e.rawDate;
  };

  long totalEntries = 0;
  auto fillPage = [&](bool useCur, bool wantAfter, bool doCount) {
    entryCount = 0;
    restrictedCount = 0;
    File dir = SD_MMC.open(kbDirPath);
    if (!dir || !dir.isDirectory()) { if (dir) dir.close(); return; }
    File f = dir.openNextFile();
    while (f) {
      bool isDir = f.isDirectory();
      String fullName = f.name();
      uint32_t sz = f.size();
      time_t wt = f.getLastWrite();
      String fdt = isDir ? "" : fileDateStr(wt);
      f.close();
      int lastSlash = fullName.lastIndexOf('/');
      String name = (lastSlash >= 0) ? fullName.substring(lastSlash + 1) : fullName;
      if (!isDir && name.endsWith(".pwd")) {
        if (restrictedCount < 80) restrictedNames[restrictedCount++] = name.substring(0, name.length() - 4);
        f = dir.openNextFile(); continue;
      }
      if (isDir) {
        if (name.startsWith("_") || name.startsWith(".")) { f = dir.openNextFile(); continue; }
      } else if (!isKnowledgeFile(name)) {
        f = dir.openNextFile(); continue;
      }
      uint32_t eSz = isDir ? 0 : sz;
      time_t   eWt = isDir ? 0 : wt;
      if (doCount) totalEntries++;
      long long num = (curSort == "size") ? (long long)eSz : (long long)eWt;
      bool inWindow = !useCur
        || (wantAfter ? cmpDisp(isDir, num, name, cIsDir, cNum, cName) > 0
                      : cmpDisp(isDir, num, name, cIsDir, cNum, cName) < 0);
      if (inWindow) {
        if (entryCount < PAGE) {
          entries[entryCount++] = {name, isDir, eSz, fdt, eWt};
        } else {
          int ext = 0;
          for (int k = 1; k < PAGE; k++) {
            int c = cmpDisp(entries[k].isDir, entNum(entries[k]), entries[k].name,
                            entries[ext].isDir, entNum(entries[ext]), entries[ext].name);
            if (wantAfter ? (c > 0) : (c < 0)) ext = k;
          }
          int c = cmpDisp(isDir, num, name,
                          entries[ext].isDir, entNum(entries[ext]), entries[ext].name);
          if (wantAfter ? (c < 0) : (c > 0)) entries[ext] = {name, isDir, eSz, fdt, eWt};
        }
      }
      f = dir.openNextFile();
    }
    dir.close();
  };
  auto sortPage = [&]() {
    for (int i = 1; i < entryCount; i++) {
      KBEntry key = entries[i];
      long long kNum = entNum(key);
      int j = i - 1;
      while (j >= 0 && cmpDisp(entries[j].isDir, entNum(entries[j]), entries[j].name,
                               key.isDir, kNum, key.name) > 0) {
        entries[j + 1] = entries[j];
        j--;
      }
      entries[j + 1] = key;
    }
  };

  if (sdMounted) { fillPage(hasCursor, cDir != "b", true); sortPage(); }

  int totalPages = (int)((totalEntries + (PAGE - 1)) / PAGE);
  if (totalPages < 1) totalPages = 1;
  if (pgNum > totalPages) pgNum = totalPages;

  if (entryCount == 0 && totalEntries > 0 && sdMounted && hasCursor) {
    server.sendHeader("Location", "/" + String(curPath.length() > 0 ? "?path=" + curPath : ""));
    server.send(303);
    return;
  }
  auto isNameRestricted = [&](const String& name) {
    for (int i = 0; i < restrictedCount; i++) if (restrictedNames[i] == name) return true;
    return false;
  };
  String kbSyncRaw = kbSyncReadRaw();
  auto isNameSynced = [&](const String& name) {
    return kbSyncRaw.length() > 0 && kbSyncRaw.indexOf("\"name\":\"" + name + "\"") >= 0;
  };
  DynamicJsonDocument kbSyncDoc(kbSyncRaw.length() + 2048);
  bool kbSyncDocOk = kbSyncRaw.length() > 0 && deserializeJson(kbSyncDoc, kbSyncRaw) == DeserializationError::Ok;
  auto isNameStreamed = [&](const String& name) {
    if (!kbSyncDocOk) return false;
    for (JsonObject o : kbSyncDoc["files"].as<JsonArray>())
      if (String((const char*)(o["name"] | "")) == name) return (bool)(o["wipeAfterUse"] | false);
    return false;
  };

  String sortButtonsHtml = "";
  {
    const char* sortColKeys[3]   = {"name", "size", "date"};
    const char* sortColLabels[3] = {"Name", "Size", "Date"};
    const char* sortColAbbrevs[3] = {"Na..", "Si..", "Da.."};
    for (int si = 0; si < 3; si++) {
      bool active = (curSort == sortColKeys[si]);
      String nextDir = active ? (curDir == "asc" ? "desc" : "asc") : "asc";
      String href = "/?sort=" + String(sortColKeys[si]) + "&dir=" + nextDir
                  + (curPath.length() > 0 ? "&path=" + curPath : "");
      String arrow = active ? (curDir == "asc" ? " &#9650;" : " &#9660;") : "";
      sortButtonsHtml += "<a href='" + href + "' class='srt" + String(active ? " on" : "") + "'>"
                        + "<span class='full'>" + sortColLabels[si] + "</span>"
                        + "<span class='abbr'>" + sortColAbbrevs[si] + "</span>"
                        + arrow + "</a>";
    }
  }

  String pagerTop = "", pagerBottom = "";
  if (totalPages > 1 && entryCount > 0) {
    auto llStr = [](long long v) { char b[24]; snprintf(b, sizeof(b), "%lld", v); return String(b); };
    String qbase = "/?path=" + curPath;
    String prevUrl = qbase + "&pg=" + String(pgNum - 1) + "&cdir=b&cflag=" + (entries[0].isDir ? "1" : "0")
                   + "&cnum=" + llStr(entNum(entries[0])) + "&cname=" + urlEncodeParam(entries[0].name);
    KBEntry& last = entries[entryCount - 1];
    String nextUrl = qbase + "&pg=" + String(pgNum + 1) + "&cdir=a&cflag=" + (last.isDir ? "1" : "0")
                   + "&cnum=" + llStr(entNum(last)) + "&cname=" + urlEncodeParam(last.name);
    bool hasPrev = pgNum > 1, hasNext = pgNum < totalPages;
    long sShow = (long)(pgNum - 1) * PAGE + 1;
    long eShow = (long)pgNum * PAGE; if (eShow > totalEntries) eShow = totalEntries;
    pagerTop  = "<div class='pgw'>";
    pagerTop += hasPrev ? "<a class='pgb' href='" + prevUrl + "' aria-label='Previous page'>&#8249;</a>"
                        : "<span class='pgb dis' aria-hidden='true'>&#8249;</span>";
    pagerTop += "<span class='pgn'>" + String(sShow) + "-" + String(eShow) + "/" + String(totalEntries) + "</span>";
    pagerTop += hasNext ? "<a class='pgb' href='" + nextUrl + "' aria-label='Next page'>&#8250;</a>"
                        : "<span class='pgb dis' aria-hidden='true'>&#8250;</span>";
    pagerTop += "</div>";
    pagerBottom  = "<div class='pgf'>";
    pagerBottom += hasPrev ? "<a class='pgfb' href='" + prevUrl + "'>&#8249; Prev</a>"
                           : "<span class='pgfb dis'>&#8249; Prev</span>";
    pagerBottom += "<span>Page " + String(pgNum) + " of " + String(totalPages)
                + " &middot; showing " + String(sShow) + "&#8211;" + String(eShow)
                + " of " + String(totalEntries) + "</span>";
    pagerBottom += hasNext ? "<a class='pgfb' href='" + nextUrl + "'>Next &#8250;</a>"
                           : "<span class='pgfb dis'>Next &#8250;</span>";
    pagerBottom += "</div>";
  }

  String curPathPin = curPath.length() > 0 ? kbFindRestrictingPin(curPath) : "";
  bool curCovered = curPathPin.length() > 0;
  String fl = "";
  fl.reserve(8192);
  for (int pass = 0; pass < 2; pass++) {
    for (int i = 0; i < entryCount; i++) {
      if (entries[i].isDir != (pass == 0)) continue;
      String name = entries[i].name;
      if (entries[i].isDir) {
        String subPath = curPath.length() > 0 ? curPath + "/" + name : name;
        String jpath = subPath; jpath.replace("\\","\\\\"); jpath.replace("\"","\\\""); jpath.replace("'","\\'");
        String encSubPath = urlEncodeParam(subPath);
        bool dirRestricted = curCovered || isNameRestricted(name);
        fl += "<li><div class='fi'>";
        bool isDevDir = isDeviceCreatedFolder(true, curPath, name);
        String dirIcon = dirRestricted ? restrictedFolderIconHtml(isDevDir) : (isDevDir ? String(DEVICE_FOLDER_ICON) : String(USER_FOLDER_ICON));
        fl += "<div class='fr'><a href='/?path=" + subPath + "' class='fn dir-fn'>" + dirIcon + name + "</a>";
        fl += "<div class='dmwrap'><button type='button' class='dmbtn' onclick='toggleDm(this,event)'>&#8942;</button><div class='dm'>";
        fl += "<button type='button' onclick='kbRenDir(\""+jpath+"\",\""+name+"\",this,"+(dirRestricted?"true":"false")+")'>Rename</button>";
        fl += "<button type='button' class='d' onclick='kbDirDel(\""+encSubPath+"\",\""+name+"\","+(dirRestricted?"true":"false")+")'>Delete</button>";
        if (!curCovered) fl += "<button type='button' onclick='kbRestrictOpen(\""+jpath+"\","+(dirRestricted?"true":"false")+")'>Restrict</button>";
        fl += "</div></div>";
        fl += "</div>";
        fl += "</div></li>";
      } else {
        String fileRef = curPath.length() > 0 ? curPath + "/" + name : name;
        uint32_t sz = entries[i].rawSize;
        String szs = sz<1024 ? String(sz)+"B" : sz<1048576 ? String(sz/1024)+"KB" : String(sz/1048576)+"MB";
        String jref = kbAiAttrJs(fileRef);
        String encRef = urlEncodeParam(fileRef);
        bool fileRestricted = curCovered || isNameRestricted(name);
        bool fileEnc = false;
        { File ef = SD_MMC.open(kbDirPath + "/" + name, FILE_READ);
          if (ef && ef.size() >= ENCRYPT_MAGIC_LEN) {
            uint8_t mag[ENCRYPT_MAGIC_LEN]; ef.read(mag, ENCRYPT_MAGIC_LEN);
            fileEnc = (memcmp(mag, ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN) == 0)
                   || (memcmp(mag, CTRLOG_MAGIC, CTRLOG_MAGIC_LEN) == 0);
          }
          if (ef) ef.close(); }
        bool fileIsTaskFlag = false;
        {
          String kbContent = readKnowledgeFile(kbDirPath + "/" + name);
          int firstNl = kbContent.indexOf('\n');
          fileIsTaskFlag = fileIsTask(firstNl >= 0 ? kbContent.substring(0, firstNl) : kbContent);
        }
        bool aiListed = true; String aiDesc;
        kbAiMetaGet(fileRef, &aiListed, &aiDesc);
        String aiDescJs  = kbAiAttrJs(aiDesc);
        String aiInstrJs = kbAiAttrJs(kbAiMetaGetInstructions(fileRef));
        bool isMemoryFile = (fileRef == AI_MEMORIES_FILE);
        fl += "<li data-fname=\"" + fileRef + "\" data-restricted=\"" + (fileRestricted ? "1" : "0") + "\"><input type='checkbox' class='kbsel' value='"+fileRef+"' onclick='event.stopPropagation();kbSync()'>";
        fl += "<div class='fi'>";
        fl += "<div class='fr'><span class='fn'>"+name+"</span>";
        fl += "<span class='fmeta'>"
            + String(fileIsTaskFlag ? "<form action='/runtask' method='POST' style='display:inline'><input type='hidden' name='file' value='"+fileRef+"'><button type='submit' class='tag run' style='padding:1.8px 6.3px;margin:0'>RUN</button></form>" : "")
            + String(fileRestricted ? "<span class='tag ht' title='PIN &mdash; this file needs a numeric PIN to open. Click for details.' onclick='kbTagHelp(\"pin\",event)'>PIN</span>" : "")
            + String(fileEnc ? "<span class='tag ht' title='AES &mdash; this file is encrypted on the SD card. Click for details.' onclick='kbTagHelp(\"aes\",event)'>AES</span>" : "")
            + String(isNameSynced(fileRef)
                       ? (isNameStreamed(fileRef)
                            ? "<span class='tag ht' title='STREAM &mdash; fetched fresh each open, never stored. Click for details.' onclick='kbTagHelp(\"stream\",event)'>STREAM</span>"
                            : "<span class='tag ht' title='SYNC &mdash; this file auto-updates from a URL. Click for details.' onclick='kbTagHelp(\"sync\",event)'>SYNC</span>")
                       : "")
            + String(isMemoryFile ? "<span class='tag aim ht' title='MEMORY &mdash; this file is always sent to the assistant. Click for details.' onclick='kbTagHelp(\"memory\",event)'>MEMORY</span>"
                                  : (aiListed ? "<span class='tag ail ht' title='LISTED &mdash; the assistant knows this file exists and can open it. Click for details.' onclick='kbTagHelp(\"listed\",event)'>LISTED</span>"
                                              : "<span class='tag aiu ht' title='UNLISTED &mdash; the assistant is not told about this file. Click for details.' onclick='kbTagHelp(\"unlisted\",event)'>UNLISTED</span>"))
            + "<span class='fs'>"+szs+"</span>";
        bool fileStreamed = isNameStreamed(fileRef);
        fl += "<div class='dmwrap'><button type='button' class='dmbtn' onclick='toggleDm(this,event)'>&#8942;</button><div class='dm'>";
        fl += fileStreamed
                ? "<button type='button' disabled style='opacity:.4;cursor:not-allowed' title='Not available for STREAM files &mdash; content is fetched fresh each open and never stored.'>Edit</button>"
                : "<a href='/view?file="+encRef+"'>Edit</a>";
        fl += "<button type='button' class='dlenc" + String(kbDownloadEncrypted ? " on" : "") + "' onclick='kbToggleDlEnc()'>" + String(kbDownloadEncrypted ? "&#10003; " : "") + "Encrypt downloads</button>";
        fl += "<a href='/kbdownload?file="+encRef+"'>Download</a>";
        fl += "<button type='button' onclick='kbDlWithMeta(\""+jref+"\")'>Download with instructions</button>";
        fl += "<button type='button' onclick='kbSyncOpen(\""+jref+"\")'>Sync from URL</button>";
        fl += fileStreamed
                ? "<button type='button' disabled style='opacity:.4;cursor:not-allowed' title='Not available for STREAM files &mdash; content is fetched fresh each open and never stored.'>Rename</button>"
                : "<button type='button' onclick='ren(\""+jref+"\",this)'>Rename</button>";
        fl += fileStreamed
                ? "<button type='button' disabled style='opacity:.4;cursor:not-allowed' title='Not available for STREAM files &mdash; content is fetched fresh each open and never stored.'>Move</button>"
                : "<button type='button' onclick='kbMv(\""+jref+"\")'>Move</button>";
        fl += "<button type='button' class='d' onclick='del(\""+jref+"\",this,"+(fileRestricted?"true":"false")+")'>Delete</button>";
        if (!curCovered) fl += "<button type='button' onclick='kbRestrictOpen(\""+jref+"\","+(fileRestricted?"true":"false")+")'>Restrict</button>";
        if (!isMemoryFile) {
          fl += "<button type='button' onclick='kbAiOpen(\""+jref+"\",\""+aiDescJs+"\",\""+aiInstrJs+"\")'>AI Instructions</button>";
          fl += "<button type='button' onclick='kbAiList(\""+jref+"\","+(aiListed?"false":"true")+")'>" + String(aiListed ? "Unlist from AI" : "Relist for AI") + "</button>";
        }
        fl += "</div></div>";
        fl += "</span></div>";
        fl += "<div class='fa'>";
        if (isMemoryFile) {
          fl += "<span class='aidesc none' style='cursor:default'>Always sent to the assistant</span>";
        } else {
          fl += "<span class='aidesc" + String(aiDesc.length() ? "" : " none") + "' onclick='kbAiOpen(\""+jref+"\",\""+aiDescJs+"\",\""+aiInstrJs+"\")'>"
              + String(aiDesc.length() ? kbAiHtmlText(aiDesc) : String("Add description")) + "</span>";
        }
        fl += (!entries[i].date.isEmpty() ? "<span class='fd'>"+entries[i].date+"</span>" : "");
        fl += "</div>";
        fl += "</div></li>";
      }
    }
  }
  if (!fl.length()) fl = "<li class='nil'>No files here</li>";

  String kbDirs[30]; int kbDirCount = 0;
  if (sdMounted) {
    String scanQ[30]; int qH = 0, qT = 0;
    scanQ[qT++] = "";
    while (qH < qT) {
      String scanRel = scanQ[qH++];
      String scanFull = String(FILES_DIR) + (scanRel.length() > 0 ? "/" + scanRel : "");
      File sdir = SD_MMC.open(scanFull);
      if (!sdir || !sdir.isDirectory()) { if (sdir) sdir.close(); continue; }
      File sf = sdir.openNextFile();
      while (sf) {
        bool sd_isDir = sf.isDirectory();
        String sfn = sf.name(); sf.close();
        if (sd_isDir) {
          int sls = sfn.lastIndexOf('/');
          String dn = (sls >= 0) ? sfn.substring(sls + 1) : sfn;
          if (!dn.startsWith("_") && !dn.startsWith(".") && kbDirCount < 30) {
            String childRel = scanRel.length() > 0 ? scanRel + "/" + dn : dn;
            kbDirs[kbDirCount++] = childRel;
            if (qT < 30) scanQ[qT++] = childRel;
          }
        }
        sf = sdir.openNextFile();
      }
      sdir.close();
    }
  }
  for (int i = 1; i < kbDirCount; i++) {
    String key = kbDirs[i];
    int j = i - 1;
    while (j >= 0 && naturalCompareCI(kbDirs[j], key) > 0) { kbDirs[j + 1] = kbDirs[j]; j--; }
    kbDirs[j + 1] = key;
  }
  String kbDirsJs = "var _dirs=[{p:\"\",l:\"Files (root)\"}";
  for (int i = 0; i < kbDirCount; i++) {
    String esc = kbDirs[i]; esc.replace("\"","\\\"");
    kbDirsJs += ",{p:\"" + esc + "\",l:\"" + esc + "\"}";
  }
  kbDirsJs += "];";

  String kbOwnDirs[30]; int kbOwnDirCount = 0;
  if (sdMounted) {
    String scanQ2[30]; int qH2 = 0, qT2 = 0;
    scanQ2[qT2++] = "";
    while (qH2 < qT2) {
      String scanRel = scanQ2[qH2++];
      String scanFull = String(KNOWLEDGE_DIR) + (scanRel.length() > 0 ? "/" + scanRel : "");
      File sdir = SD_MMC.open(scanFull);
      if (!sdir || !sdir.isDirectory()) { if (sdir) sdir.close(); continue; }
      File sf = sdir.openNextFile();
      while (sf) {
        bool sd_isDir = sf.isDirectory();
        String sfn = sf.name(); sf.close();
        if (sd_isDir) {
          int sls = sfn.lastIndexOf('/');
          String dn = (sls >= 0) ? sfn.substring(sls + 1) : sfn;
          if (!dn.startsWith("_") && !dn.startsWith(".") && kbOwnDirCount < 30) {
            String childRel = scanRel.length() > 0 ? scanRel + "/" + dn : dn;
            kbOwnDirs[kbOwnDirCount++] = childRel;
            if (qT2 < 30) scanQ2[qT2++] = childRel;
          }
        }
        sf = sdir.openNextFile();
      }
      sdir.close();
    }
  }
  for (int i = 1; i < kbOwnDirCount; i++) {
    String key = kbOwnDirs[i];
    int j = i - 1;
    while (j >= 0 && naturalCompareCI(kbOwnDirs[j], key) > 0) { kbOwnDirs[j + 1] = kbOwnDirs[j]; j--; }
    kbOwnDirs[j + 1] = key;
  }
  String kbOwnDirsJs = "var _kbowndirs=[{p:\"\",l:\"Knowledge (root)\"}";
  for (int i = 0; i < kbOwnDirCount; i++) {
    String esc = kbOwnDirs[i]; esc.replace("\"","\\\"");
    kbOwnDirsJs += ",{p:\"" + esc + "\",l:\"" + esc + "\"}";
  }
  kbOwnDirsJs += "];";

  String css =
    pageCss() +
    "textarea{height:150px;font-family:monospace;resize:vertical}"
    "input[type=file]{color:#888;font-size:13px;display:block;margin-top:8px}"
    "ul{background:#222;padding:16px;border-radius:4px;list-style:none}"
    "li{display:flex;align-items:flex-start;gap:8px;padding:9px 4px;border-bottom:1px solid #333;transition:opacity .3s,transform .2s}"
    "li:last-child{border-bottom:none}li.rm{opacity:0;transform:translateX(14px)}.nil{color:#555}"
    ".fi{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}"
    ".fr{display:flex;justify-content:space-between;align-items:baseline;gap:8px}"
    ".fn{font-weight:bold;color:#eee;word-break:break-all;text-decoration:none}.fs{font-size:.85em;color:#888;white-space:nowrap;flex-shrink:0}.fd{font-size:.75em;color:#555;white-space:nowrap;margin-left:auto}"
    ".fmeta{display:flex;align-items:center;gap:6px;flex-shrink:0}"
    ".tag{display:inline-flex;align-items:center;background:#262626;color:#aaa;border:1px solid #3a3a3a;border-radius:5px;padding:1.8px 6.3px;font-size:.67em;font-weight:700;letter-spacing:.03em;font-family:ui-monospace,'SF Mono',Consolas,monospace;white-space:nowrap;line-height:1.5}"
