    "var over=sc.scrollWidth>sc.clientWidth+1;"
    "l.style.display=over&&sc.scrollLeft>4?'flex':'none';"
    "r.style.display=over&&sc.scrollLeft<sc.scrollWidth-sc.clientWidth-4?'flex':'none';}"
    "sc.addEventListener('scroll',upd);window.addEventListener('resize',upd);"
    "l.addEventListener('click',function(){sc.scrollBy({left:-120,behavior:'smooth'});});"
    "r.addEventListener('click',function(){sc.scrollBy({left:120,behavior:'smooth'});});"
