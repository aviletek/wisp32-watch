static String tokCell(int v) { return v < 0 ? "" : String(v); }

static void logTokenUsage(const char* category, const char* mode, const char* provider, const String& model,
                           int maxTokCap, int inputTokens, int outputTokens, int cachedTokens, int reasoningTokens,
                           int toolUseTokens, int audioInTokens, int textInTokens, int audioOutTokens,
                           int textOutTokens, int totalTokens, int talkMs, int responseMs) {
  if (!sdMounted || !logEventsEnabled) return;
  ensureLogsDir();

  struct tm ti;
  char tsBuf[24] = "no time sync";
  if (getLocalTime(&ti)) strftime(tsBuf, sizeof(tsBuf), "%Y-%m-%d %H:%M:%S", &ti);

  String path = String(KNOWLEDGE_DIR) + "/Logs/tokens.csv";
  const char* expectedHeader = "Timestamp,Category,Mode,Provider,Model,Max Tok Cap,Input Tokens,Output Tokens,"
                                "Cached Tokens,Reasoning/Thought Tokens,Tool Use Tokens,Audio In Tokens,"
                                "Text In Tokens,Audio Out Tokens,Text Out Tokens,Total Tokens,"
                                "Talk Time (ms),Response Time (ms)";
  bool needsHeader = true;
  if (SD_MMC.exists(path)) {
    ChatLogReader check;
    if (check.open(path)) {
      String firstLine = check.readStringUntil('\n');
      firstLine.trim();
      check.close();
      if (firstLine == expectedHeader) needsHeader = false;
      else SD_MMC.remove(path);
    }
  }
  if (needsHeader) chatLogAppendEntry(path, String(expectedHeader) + "\n");
  String row = String(tsBuf) + "," + category + "," + mode + "," + provider + "," + csvEscape(model) + ","
    + tokCell(maxTokCap) + "," + tokCell(inputTokens) + "," + tokCell(outputTokens) + "," + tokCell(cachedTokens) + ","
    + tokCell(reasoningTokens) + "," + tokCell(toolUseTokens) + "," + tokCell(audioInTokens) + ","
    + tokCell(textInTokens) + "," + tokCell(audioOutTokens) + "," + tokCell(textOutTokens) + ","
    + tokCell(totalTokens) + "," + tokCell(talkMs) + "," + tokCell(responseMs);
  chatLogAppendEntry(path, row + "\n");
  trimTokensLogIfNeeded(path);
}

static String lastFiredAlarmNames = "";

bool checkAndClearDueAlarms() {
  time_t now = time(NULL);
  bool any = false;
  lastFiredAlarmNames = "";
  for (int i = 0; i < MAX_ALARMS; i++) {
    if (alarmEpochs[i] != 0 && alarmEpochs[i] <= now) {
      if (lastFiredAlarmNames.length() > 0) lastFiredAlarmNames += ", ";
      lastFiredAlarmNames += alarmNames[i];
      if (logEventsEnabled) {
        char buf[12] = "";
        struct tm tt; localtime_r(&alarmEpochs[i], &tt);
        strftime(buf, sizeof(buf), "%H:%M:%S", &tt);
        logToolCallEvent("system", "alarm_fired", 0, "name=" + String(alarmNames[i]) + ", time=" + buf, "Fired");
      }
      alarmEpochs[i] = 0;
      any = true;
    }
  }
  return any;
}

void triggerDeepSleepShutdown(bool forAiRetry) {
  Serial.println(forAiRetry ? "[Power] AI connection error — deep-sleep self-wake retry"
                             : "[Power] BOOT button held 3s — entering deep sleep");
  wispTrace(String("SHUTDOWN forAiRetry=") + (forAiRetry ? "1" : "0")
            + " btnPressStartMs=" + String(btnPressStartMs)
            + " shutdownCountdownShown=" + String(shutdownCountdownShown));
  aboutToSleep = true;
  if (forAiRetry) wokeFromAiConnectionError = true;
  gfx->fillScreen(COLOR_BLACK);
  _clockCenterPrint(TR(UISTR_SHUTTING_DOWN), SCREEN_HEIGHT / 2, 3, COLOR_GRAY);
  gfx->flush();
  unsigned long shutdownMsgUntil = millis() + 400;
  while ((long)(millis() - shutdownMsgUntil) < 0) { server.handleClient(); delay(5); }
  gfxPanel->displayOff();

  if (audioOk)    es8311_power_down(esHandle);
  if (micArrayOk) es7210_power_down();

  gpio_hold_en(GPIO_NUM_46);
  gpio_deep_sleep_hold_en();

  if (sdMounted) {
    SD_MMC.end();
    sdMounted = false;
  }

  while (digitalRead(WAKE_BUTTON_PIN) == LOW) delay(10);
  delay(50);

  esp_sleep_enable_ext0_wakeup((gpio_num_t)WAKE_BUTTON_PIN, 0);

  long alarmSecs = secondsUntilNextAlarm();
  long taskSecs = secondsUntilNextTaskDue();
  long wakeSecs = alarmSecs;
  if (taskSecs >= 0 && (wakeSecs < 0 || taskSecs < wakeSecs)) wakeSecs = taskSecs;
  if (forAiRetry && (wakeSecs < 0 || wakeSecs > 2)) wakeSecs = 2;
  if (wakeSecs >= 0) {
    if (wakeSecs < 1) wakeSecs = 1;
    esp_sleep_enable_timer_wakeup((uint64_t)wakeSecs * 1000000ULL);
  }

  esp_deep_sleep_start();
}

bool aiMemResetPending = false;

void aiSilentMemoryResetSleep() {
  Serial.println("[Power] silent memory reset — AI/Translator/Transcribe used under Auto Sleep = Never");
  wokeForSilentMemReset = true;
