  aiListenDots = 1;
  aiState = AI_LISTENING;
  drawAiOrTranslatorPage();
}

static void aiSendGeminiAudioChunk(const int16_t* samples, size_t sampleCount) {
  size_t rawBytes = sampleCount * sizeof(int16_t);
  size_t b64bufSize = ((rawBytes + 2) / 3) * 4 + 4;
  uint8_t* b64buf = (uint8_t*)malloc(b64bufSize);
  if (!b64buf) {
    Serial.println("[AI] base64 buffer alloc failed, dropping audio chunk");
    return;
  }
  size_t outLen = 0;
  int rc = mbedtls_base64_encode(b64buf, b64bufSize, &outLen, (const uint8_t*)samples, rawBytes);
  if (rc != 0) {
    Serial.print("[AI] base64 encode failed, rc=");
    Serial.println(rc);
    free(b64buf);
    return;
  }
  DynamicJsonDocument msg(4096);
  JsonObject msgInput = msg.createNestedObject("realtimeInput");
  JsonObject audio = msgInput.createNestedObject("audio");
  audio["data"] = String((const char*)b64buf, outLen);
  audio["mimeType"] = "audio/pcm;rate=16000";
  String out; serializeJson(msg, out);
  aiClient.send(out);
  free(b64buf);
}

void aiSendGeminiAudio(const int16_t* mono, size_t sampleCount) {
  DynamicJsonDocument start(64);
  JsonObject startInput = start.createNestedObject("realtimeInput");
  startInput.createNestedObject("activityStart");
  String startStr; serializeJson(start, startStr);
  aiClient.send(startStr);

  const size_t chunkSamples = 1024;
  for (size_t off = 0; off < sampleCount; off += chunkSamples) {
    size_t n = (sampleCount - off) > chunkSamples ? chunkSamples : (sampleCount - off);
    aiSendGeminiAudioChunk(mono + off, n);
  }

  DynamicJsonDocument end(64);
  JsonObject endInput = end.createNestedObject("realtimeInput");
  endInput.createNestedObject("activityEnd");
  String endStr; serializeJson(end, endStr);
  aiClient.send(endStr);
}

void aiSendOpenAiAudioTaskFn(void* pv) {
  int16_t* mono = aiOpenAiSendBuf;
  size_t stereoSamples = aiOpenAiSendSamples;
  aiOpenAiSendBuf = nullptr;

  size_t outSamples = stereoSamples * 3 / 2;
  int16_t* upsampled = (int16_t*)ps_malloc(outSamples * sizeof(int16_t));
  if (!upsampled) {
    free(mono);
    aiErrorMsg = "Out of memory"; aiErrorDetail = ""; aiState = AI_ERROR;
    aiOpenAiSendActive = false;
    aiOpenAiSendDone = true;
    aiOpenAiSendTaskHandle = nullptr;
    vTaskDelete(NULL);
    return;
  }
  for (size_t i = 0; i < outSamples; i++) {
    float srcPos = (float)i * 2.0f / 3.0f;
    size_t i0 = (size_t)srcPos;
    size_t i1 = (i0 + 1 < stereoSamples) ? i0 + 1 : i0;
    float frac = srcPos - i0;
    upsampled[i] = (int16_t)((1.0f - frac) * mono[i0] + frac * mono[i1]);
  }
  free(mono);

  const size_t chunkSamples = 1024;
  const size_t chunkRawBytes = chunkSamples * sizeof(int16_t);
  const size_t b64bufSize = ((chunkRawBytes + 2) / 3) * 4 + 4;
  uint8_t* b64buf = (uint8_t*)malloc(b64bufSize);
  if (!b64buf) {
    free(upsampled);
    aiErrorMsg = "Out of memory"; aiErrorDetail = ""; aiState = AI_ERROR;
    aiOpenAiSendActive = false;
    aiOpenAiSendDone = true;
    aiOpenAiSendTaskHandle = nullptr;
    vTaskDelete(NULL);
    return;
  }
  bool sendOk = true;
  for (size_t off = 0; off < outSamples && sendOk; off += chunkSamples) {
    size_t n = (outSamples - off) > chunkSamples ? chunkSamples : (outSamples - off);
    size_t outLen = 0;
    int rc = mbedtls_base64_encode(b64buf, b64bufSize, &outLen,
                                    (const uint8_t*)(upsampled + off), n * sizeof(int16_t));
    if (rc != 0) {
      Serial.print("[AI] base64 encode failed, rc=");
      Serial.println(rc);
      continue;
    }
    DynamicJsonDocument msg(4096);
    msg["type"] = "input_audio_buffer.append";
    msg["audio"] = String((const char*)b64buf, outLen);
    String out; serializeJson(msg, out);
    if (aiWsMutex) xSemaphoreTake(aiWsMutex, portMAX_DELAY);
    sendOk = aiClient.send(out);
    if (aiWsMutex) xSemaphoreGive(aiWsMutex);
    if (!sendOk) {
      Serial.println("[AI] audio chunk send failed — struggling connection, aborting rest of upload");
      wispTrace("AI upload chunk send FAILED off=" + String((unsigned)off) + "/" + String((unsigned)outSamples));
    }
  }
  free(b64buf);
  free(upsampled);

  if (sendOk) {
    DynamicJsonDocument commit(128);
    commit["type"] = "input_audio_buffer.commit";
    String commitStr; serializeJson(commit, commitStr);
    if (aiWsMutex) xSemaphoreTake(aiWsMutex, portMAX_DELAY);
    sendOk = aiClient.send(commitStr);
    if (aiWsMutex) xSemaphoreGive(aiWsMutex);
  }

  if (sendOk) {
    if (aiWsMutex) xSemaphoreTake(aiWsMutex, portMAX_DELAY);
    sendAiResponseCreate();
    if (aiWsMutex) xSemaphoreGive(aiWsMutex);
    wispTrace("AI upload done, response.create sent, elapsedMs=" + String(millis() - aiTurnStartMs));
  } else {
    aiErrorMsg = "Connection issue"; aiErrorDetail = ""; aiState = AI_ERROR;
    wispTrace("AI upload FAILED, elapsedMs=" + String(millis() - aiTurnStartMs));
  }

  aiOpenAiSendActive = false;
  aiOpenAiSendDone = true;
  aiOpenAiSendTaskHandle = nullptr;
  vTaskDelete(NULL);
}

#define AI_SILENCE_TRIM_DBFS (-40.0f)
#define AI_SILENCE_TRIM_WINDOW_MS 20
#define AI_SILENCE_TRIM_PADDING_MS 150
static void aiTrimSilence(int16_t* mono, size_t* sampleCount) {
  size_t windowSamples = (size_t)AUDIO_SAMPLE_RATE * AI_SILENCE_TRIM_WINDOW_MS / 1000;
  if (windowSamples == 0 || *sampleCount < windowSamples * 2) return;

  int32_t thresholdAmp = (int32_t)(32768.0f * powf(10.0f, AI_SILENCE_TRIM_DBFS / 20.0f));

  size_t windowCount = *sampleCount / windowSamples;
  size_t firstLoud = windowCount;
  size_t lastLoud = windowCount;

  for (size_t w = 0; w < windowCount; w++) {
    int32_t peak = 0;
    const int16_t* win = mono + w * windowSamples;
    for (size_t i = 0; i < windowSamples; i++) {
      int32_t a = win[i] < 0 ? -(int32_t)win[i] : (int32_t)win[i];
      if (a > peak) peak = a;
    }
    if (peak >= thresholdAmp) {
      if (firstLoud == windowCount) firstLoud = w;
      lastLoud = w;
    }
  }

  if (firstLoud == windowCount) return;

  size_t paddingSamples = (size_t)AUDIO_SAMPLE_RATE * AI_SILENCE_TRIM_PADDING_MS / 1000;
  size_t startSample = firstLoud * windowSamples;
  size_t endSample = (lastLoud + 1) * windowSamples;
  startSample = (startSample > paddingSamples) ? (startSample - paddingSamples) : 0;
  endSample = endSample + paddingSamples;
  if (endSample > *sampleCount) endSample = *sampleCount;

  if (startSample > 0 || endSample < *sampleCount) {
    size_t newCount = endSample - startSample;
    if (startSample > 0) memmove(mono, mono + startSample, newCount * sizeof(int16_t));
    Serial.printf("[AI] silence trim: %ums -> %ums (%u -> %u samples)\n",
                  (unsigned)(*sampleCount * 1000UL / AUDIO_SAMPLE_RATE),
                  (unsigned)(newCount * 1000UL / AUDIO_SAMPLE_RATE),
                  (unsigned)*sampleCount, (unsigned)newCount);
    *sampleCount = newCount;
  }
}

#define NVS_AILIMIT_NS "ailimit"

static int aiLimitTodayStamp() {
  time_t n = time(nullptr);
  struct tm lt;
  if (!localtime_r(&n, &lt)) return 0;
  if (lt.tm_year + 1900 < 2021) return 0;
  return (lt.tm_year + 1900) * 10000 + (lt.tm_mon + 1) * 100 + lt.tm_mday;
}

static void aiReadTurnUsage(int* limit, int* used, bool* timeOk) {
  Preferences p; p.begin(NVS_AILIMIT_NS, false);
  int lim = p.getInt("limit", 0);
  int cnt = p.getInt("cnt", 0);
  int storedDate = p.getInt("date", 0);
  int today = aiLimitTodayStamp();
  bool ok = (today != 0);
  if (ok && storedDate != today) { cnt = 0; p.putInt("cnt", 0); p.putInt("date", today); }
  p.end();
  if (limit)  *limit  = lim;
  if (used)   *used   = cnt;
  if (timeOk) *timeOk = ok;
}

int  aiGetTurnLimit()       { Preferences p; p.begin(NVS_AILIMIT_NS, true); int v = p.getInt("limit", 0); p.end(); return v; }
void aiSetTurnLimit(int v)  { if (v < 0) v = 0; Preferences p; p.begin(NVS_AILIMIT_NS, false); p.putInt("limit", v); p.end(); }
int  aiGetTurnsUsedToday()  { int u = 0; aiReadTurnUsage(nullptr, &u, nullptr); return u; }

void aiResetTurnsUsed() {
  Preferences p; p.begin(NVS_AILIMIT_NS, false);
  p.putInt("cnt", 0);
  int today = aiLimitTodayStamp();
  if (today) p.putInt("date", today);
  p.end();
}

bool aiTurnLimitReached() {
  int lim = 0, used = 0; bool ok = false;
  aiReadTurnUsage(&lim, &used, &ok);
  return ok && lim > 0 && used >= lim;
}

void aiRecordTurnUsed() {
  int lim = 0, used = 0; bool ok = false;
  aiReadTurnUsage(&lim, &used, &ok);
  if (!ok) return;
  Preferences p; p.begin(NVS_AILIMIT_NS, false);
  p.putInt("cnt", used + 1);
  p.end();
}

static String noteTranscribeAudio(const uint8_t* wavData, size_t wavLen);

static int replayLoadCandidates(String& listText, String& aKeysJoined) {
  listText = ""; aKeysJoined = "";
  String histPath = String(KNOWLEDGE_DIR) + "/history.txt";
  if (!SD_MMC.exists(histPath)) return 0;
  String content = readKnowledgeFile(histPath);
  if (content.length() == 0) return 0;
  int n = 0, pos = 0;
  String curAKey = "";
  bool haveHeader = false;
  while (pos < (int)content.length()) {
    int nl = content.indexOf('\n', pos);
    if (nl < 0) nl = content.length();
    String line = content.substring(pos, nl);
    pos = nl + 1;
    if (line.endsWith("\r")) line.remove(line.length() - 1);
    if (isChatLogHeader(line)) {
      curAKey = "";
      int ap = line.indexOf(" | a=");
      if (ap >= 0) {
        int start = ap + 5;
        int e1 = line.indexOf(" | ", start);
        int e2 = line.indexOf(']', start);
        int end = -1; if (e1 >= 0) end = e1; if (e2 >= 0 && (end < 0 || e2 < end)) end = e2;
        curAKey = (end >= 0) ? line.substring(start, end) : line.substring(start);
      }
      haveHeader = true;
    } else if (haveHeader && line.startsWith("Q: ") && curAKey.length() > 0) {
      String q = line.substring(3); q.trim();
      if (q.length() > 0) { n++; listText += String(n) + ". " + q + "\n"; aKeysJoined += curAKey + "\n"; }
      haveHeader = false;
    }
  }
  return n;
}

static String replayPickToAKey(const String& aKeysJoined, int pick) {
  if (pick < 1) return "";
  int p = 0, idx = 0;
  while (p < (int)aKeysJoined.length()) {
    int nl = aKeysJoined.indexOf('\n', p);
    if (nl < 0) nl = aKeysJoined.length();
    if (++idx == pick) return aKeysJoined.substring(p, nl);
    p = nl + 1;
  }
  return "";
}

static String replayFindMatch(const String& question) {
  String matchModel = aiReplayMatchModel.length() ? aiReplayMatchModel : activeVoiceToTextModel;
  if (!aiModelIsGemini(matchModel)) return "";
  if (activeGeminiKey.length() == 0) return "";
  String listText, aKeysJoined;
  int n = replayLoadCandidates(listText, aKeysJoined);
  if (n == 0) return "";

  String instr = customReplayMatchPrompt.length() ? customReplayMatchPrompt : String(DEFAULT_REPLAY_MATCH_PROMPT);
  String prompt = instr + "\n\nUser question: " + question + "\n\nEntries:\n" + listText;

  HTTPClient http;
  String url = "https://generativelanguage.googleapis.com/v1beta/models/" + matchModel
               + ":generateContent?key=" + activeGeminiKey;
  http.begin(url);
  http.setTimeout(15000);
  http.addHeader("Content-Type", "application/json");
  String payload; payload.reserve(prompt.length() + 200);
  payload += "{\"contents\":[{\"parts\":[{\"text\":\"";
  jsonEscapeAppendTo(payload, prompt);
  payload += "\"}]}],\"generationConfig\":{\"maxOutputTokens\":64}}";
  int code = http.POST(payload);
  if (code != 200) { http.end(); return ""; }
  String rb = http.getString(); http.end();
  DynamicJsonDocument res(2048);
  if (deserializeJson(res, rb) != DeserializationError::Ok) return "";
  String out = String((const char*)(res["candidates"][0]["content"]["parts"][0]["text"] | "")); out.trim();
  int pick = 0;
  for (int i = 0; i < (int)out.length(); i++) {
    if (isDigit(out[i])) { pick = out.substring(i).toInt(); break; }
  }
  if (pick < 1 || pick > n) return "";
  return replayPickToAKey(aKeysJoined, pick);
}

static String replayFindMatchOneShot(const uint8_t* wav, size_t wavLen, bool& ok, String& outTranscript) {
  ok = false; outTranscript = "";
  String matchModel = aiReplayMatchModel.length() ? aiReplayMatchModel : activeVoiceToTextModel;
  if (!aiModelIsGemini(matchModel)) return "";
  if (activeGeminiKey.length() == 0) return "";
  String listText, aKeysJoined;
  int n = replayLoadCandidates(listText, aKeysJoined);
  if (n == 0) { ok = true; return ""; }

  String instr = customReplayMatchPrompt.length() ? customReplayMatchPrompt : String(DEFAULT_REPLAY_MATCH_PROMPT);
  String promptText = instr
    + "\n\nThe user's question is the spoken audio provided below. Transcribe it, then apply the rule above to the numbered entries."
      "\n\nReply with ONLY a JSON object: {\"transcript\":\"<the exact words spoken>\",\"match\":<the entry number, or 0 if none clearly match>}."
      "\n\nEntries:\n" + listText;

  String head = "{\"contents\":[{\"parts\":[{\"text\":\"";
  jsonEscapeAppendTo(head, promptText);
  head += "\"},{\"inline_data\":{\"mime_type\":\"audio/wav\",\"data\":\"";
  static const char TAIL[] = "\"}}]}],\"generationConfig\":{\"responseMimeType\":\"application/json\",\"maxOutputTokens\":512}}";
  size_t tailLen = strlen(TAIL);
  size_t b64Cap = ((wavLen + 2) / 3) * 4 + 4;
  size_t payloadCap = head.length() + b64Cap + tailLen;
  uint8_t* payload = (uint8_t*)ps_malloc(payloadCap);
  if (!payload) return "";
  memcpy(payload, head.c_str(), head.length());
  size_t b64Len = 0;
  if (mbedtls_base64_encode(payload + head.length(), b64Cap, &b64Len, wav, wavLen) != 0) { free(payload); return ""; }
  memcpy(payload + head.length() + b64Len, TAIL, tailLen);
  size_t payloadLen = head.length() + b64Len + tailLen;

  HTTPClient http;
  String url = "https://generativelanguage.googleapis.com/v1beta/models/" + matchModel + ":generateContent?key=" + activeGeminiKey;
  http.begin(url);
  http.setTimeout(20000);
  http.addHeader("Content-Type", "application/json");
  int code = http.POST(payload, payloadLen);
  free(payload);
  if (code != 200) { http.end(); Serial.printf("[Replay] one-shot HTTP %d — falling back to two-step\n", code); return ""; }
  String rb = http.getString(); http.end();

  DynamicJsonDocument res(8192);
  if (deserializeJson(res, rb) != DeserializationError::Ok) return "";
  String jsonText = String((const char*)(res["candidates"][0]["content"]["parts"][0]["text"] | ""));
  jsonText.trim();
  if (jsonText.length() == 0) return "";
  DynamicJsonDocument inner(jsonText.length() + 256);
  if (deserializeJson(inner, jsonText) != DeserializationError::Ok) return "";
  outTranscript = String((const char*)(inner["transcript"] | "")); outTranscript.trim();
  int pick = inner["match"] | 0;
  if (pick == 0) {
    const char* ms = inner["match"] | "";
    for (int i = 0; ms[i]; i++) { if (isDigit(ms[i])) { pick = atoi(ms + i); break; } }
  }
  ok = true;
  if (pick < 1 || pick > n) return "";
  return replayPickToAKey(aKeysJoined, pick);
}

static File     replaySavedFile;
static uint8_t  replaySavedNonce[CTRLOG_NONCE_LEN];
static bool     replaySavedEnc = false;
static size_t   replaySavedPlainOff = 0;
static String   replaySavedLastRel = "";

static void replaySavedPump() {
  if (!replaySavedActive) return;
  const size_t MONO_CHUNK = 512;
  int16_t monoBuf[MONO_CHUNK];
  int16_t stereoBuf[MONO_CHUNK * 2];
  while (replaySavedFile.available() && aiPlayFreeBytes() >= MONO_CHUNK * 2 * sizeof(int16_t)) {
    size_t got = replaySavedFile.read((uint8_t*)monoBuf, MONO_CHUNK * sizeof(int16_t));
    if (got == 0) break;
    if (replaySavedEnc) aiLogDecryptBlock(replaySavedNonce, replaySavedPlainOff, (uint8_t*)monoBuf, got);
    replaySavedPlainOff += got;
    size_t samples = got / sizeof(int16_t);
    for (size_t i = 0; i < samples; i++) { stereoBuf[i * 2] = monoBuf[i]; stereoBuf[i * 2 + 1] = monoBuf[i]; }
    aiPlayRingWrite((const uint8_t*)stereoBuf, samples * 2 * sizeof(int16_t));
  }
  if (!replaySavedFile.available() && aiPlayUsedBytes() == 0) {
    replaySavedFile.close();
    replaySavedActive = false;
    aiPlayActive = false;
    aiState = AI_IDLE;
    drawAiOrTranslatorPage();
  }
}

static void replaySavedCancel() {
  if (!replaySavedActive) return;
  replaySavedFile.close();
  replaySavedActive = false;
}

static bool replayStartSavedClip(const String& rel) {
  String full = String(FILES_DIR) + "/" + rel;
  if (!SD_MMC.exists(full)) { Serial.printf("[Replay] matched, but clip is gone: %s\n", full.c_str()); return false; }
  if (!aiPlayRing) return false;
  replaySavedFile = SD_MMC.open(full, FILE_READ);
  if (!replaySavedFile) return false;
  size_t plainSize = 0;
  replaySavedEnc = aiLogOpenForRead(replaySavedFile, replaySavedNonce, &plainSize);
  uint8_t hdr[44];
  if (replaySavedFile.read(hdr, 44) != 44) { replaySavedFile.close(); return false; }
  replaySavedPlainOff = 44;
  replaySavedLastRel = rel;
  aiPlayRingReset();
  aiPlayActive = true;
  replaySavedActive = true;
  aiState = AI_SPEAKING;
  drawAiOrTranslatorPage();
  replaySavedPump();
  return true;
}

static bool replaySavedTryReplayLast() {
  if (replaySavedLastRel.length() == 0) return false;
  if (aiState != AI_IDLE && aiState != AI_ERROR) return false;
  return replayStartSavedClip(replaySavedLastRel);
}

static void appendReplayHistoryEntry(const String& question, const String& rel) {
  if (!sdMounted) return;
  if (saveHistoryMode != SAVE_TEXT && saveHistoryMode != SAVE_TEXT_AUDIO) return;
  struct tm ti; String ts = "";
  if (getLocalTime(&ti)) { char buf[20]; strftime(buf, sizeof(buf), "%Y-%m-%d %H:%M:%S", &ti); ts = String(buf); }
  String sTag = aiChatSessionId.length() ? (" | s=" + aiChatSessionId) : String("");
  appendChatLog("[" + ts + " | replay" + sTag + "]\nQ: " + question + "\nA: (Replayed saved answer: " + rel + ")\n");
}

static void logReplayEvent(const String& question, const String& rel) {
  if (!sdMounted) return;
  if (saveHistoryMode != SAVE_TEXT && saveHistoryMode != SAVE_TEXT_AUDIO) return;
  ensureLogsDir();
  String path = String(KNOWLEDGE_DIR) + "/Logs/replays.csv";
  struct tm ti; char tsBuf[24] = "no time sync";
  if (getLocalTime(&ti)) strftime(tsBuf, sizeof(tsBuf), "%Y-%m-%d %H:%M:%S", &ti);
  if (!SD_MMC.exists(path)) chatLogAppendEntry(path, "Timestamp,Question,Clip\n");
  chatLogAppendEntry(path, String(tsBuf) + "," + csvEscape(question) + "," + csvEscape(rel) + "\n");
}

static bool replayKbOnlyNoAnswer() {
  aiErrorMsg = TR(UISTR_NO_SAVED_ANSWER);
  aiState = AI_ERROR;
  drawAiOrTranslatorPage();
  return true;
}

static bool replayGateTryHandle(const int16_t* mono, size_t sampleCount) {
  if (aiReplayMode == REPLAY_OFF) return false;
  if (translatorPageOpen) return false;
  bool kbOnly = (aiReplayMode == REPLAY_KB_ONLY);

  if (!sdMounted || WiFi.status() != WL_CONNECTED || sampleCount == 0)
    return kbOnly ? replayKbOnlyNoAnswer() : false;

  size_t dataBytes = sampleCount * sizeof(int16_t);
  uint8_t* wav = (uint8_t*)ps_malloc(44 + dataBytes);
  if (!wav) return kbOnly ? replayKbOnlyNoAnswer() : false;
  noteBuildWavHeader(wav, dataBytes, AUDIO_SAMPLE_RATE, 1);
  memcpy(wav + 44, mono, dataBytes);

  String question;
  bool oneShotOk = false;
  String aKey = replayFindMatchOneShot(wav, 44 + dataBytes, oneShotOk, question);
  if (!oneShotOk) {
    question = noteTranscribeAudio(wav, 44 + dataBytes);
    question.trim();
    aKey = (question.length() > 0) ? replayFindMatch(question) : String("");
  }
  free(wav);
  if (aKey.length() < 3 || aKey.charAt(1) != ':') return kbOnly ? replayKbOnlyNoAnswer() : false;
  String folder = (aKey.charAt(0) == 'T') ? "Translator Audio" : "AI Assistant Audio";
  String rel = folder + "/" + aKey.substring(2) + ".wav";
  bool started = replayStartSavedClip(rel);
  if (started) {
    Serial.printf("[Replay] replaying saved answer: %s\n", rel.c_str());
    appendReplayHistoryEntry(question, rel);
    logReplayEvent(question, rel);
    return true;
  }
  return kbOnly ? replayKbOnlyNoAnswer() : false;
}

void aiStopListeningAndSend() {
  aiListening = false;
  replaySavedLastRel = "";

  delay(10);
  if (!aiRecBuf || aiRecFilled < AI_MIN_RECORD_BYTES) {
    if (aiRecFilled >= 4) {
      Serial.printf("[AI] recording too short (%u bytes, %ums) — discarded, nothing sent\n",
                    (unsigned)aiRecFilled, (unsigned)(millis() - aiRecordStartMs));
    }
    aiRecFilled = 0;
    aiRecBufAiReplyLogged = false;
    aiState = AI_IDLE;
    drawAiOrTranslatorPage();
    return;
  }

  if (aiPageOpen && !translatorPageOpen) {
    if (aiTurnLimitReached()) {
      Serial.println("[AI] daily turn limit reached — turn not sent (resets at midnight)");
      aiRecFilled = 0;
      aiRecBufAiReplyLogged = false;
      aiErrorMsg = "Daily AI limit reached";
      aiErrorDetail = "Resets at midnight";
      aiState = AI_ERROR;
      drawAiOrTranslatorPage();
      return;
    }
    aiRecordTurnUsed();
  }

  aiLastTalkMs = millis() - aiRecordStartMs;
  aiResponseAudioBytes = 0;
  aiUserTranscript = "";
  aiReplyTranscript = "";
  aiRevealedChars = 0;
  aiToolCallLog = "";
  aiGroundingQueries = "";
  aiGroundingSources = "";
  aiTextLineCount = 0;
  aiTextUserLineCount = 0;
  aiTextScrollLine = 0;
  aiResponseHadToolCall = false;
  aiResponseCancelled = false;

  int16_t* stereo = (int16_t*)aiRecBuf;
  size_t stereoSamples = aiRecFilled / 4;
  int16_t* mono = (int16_t*)ps_malloc(stereoSamples * sizeof(int16_t));
  if (!mono) {
    aiRecFilled = 0;
    aiRecBufAiReplyLogged = false;
    aiErrorMsg = "Out of memory"; aiErrorDetail = ""; aiState = AI_ERROR; drawAiOrTranslatorPage();
    return;
  }
  for (size_t i = 0; i < stereoSamples; i++) {
    mono[i] = (int16_t)(((int32_t)stereo[i * 2] + (int32_t)stereo[i * 2 + 1]) / 2);
  }
  aiRecFilled = 0;
  aiRecBufAiReplyLogged = false;

  aiTrimSilence(mono, &stereoSamples);

  if (stereoSamples > 0) {
    double sumSq = 0;
    for (size_t i = 0; i < stereoSamples; i++) {
      double s = (double)mono[i];
      sumSq += s * s;
    }
    double rms = sqrt(sumSq / (double)stereoSamples);
    if (rms < 1.0) rms = 1.0;
    const double TARGET_RMS = 6000.0;
    const float MAX_GAIN = 40.0f;
    float gain = (float)(TARGET_RMS / rms);
    if (gain > MAX_GAIN) gain = MAX_GAIN;
    for (size_t i = 0; i < stereoSamples; i++) {
      int32_t boosted = (int32_t)(mono[i] * gain);
      if (boosted > 32767) boosted = 32767;
      else if (boosted < -32768) boosted = -32768;
      mono[i] = (int16_t)boosted;
    }
  }

  if (replayGateTryHandle(mono, stereoSamples)) {
    free(mono);
    return;
  }

  aiListenDots = 2;
  drawAiOrTranslatorPage();
  gfx->flush();

  aiChatTurnN++;

  aiLogTurnStart();
  if (aiLogActive) {
    unsigned long _sdSaveT0 = millis();
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    size_t wrote = aiLogWriteMaybeEnc(aiLogFile, aiLogEncrypted, aiLogNonce,
                                      AILOG_PLAIN_BASE + 44 + aiLogBytesWritten,
                                      (const uint8_t*)mono, stereoSamples * sizeof(int16_t));
    if (_sdMutex) xSemaphoreGive(_sdMutex);
    Serial.printf("[Timing] sent-audio SD save: %lu bytes, %lums\n", (unsigned long)(stereoSamples * sizeof(int16_t)), millis() - _sdSaveT0);
    aiLogBytesWritten += (uint32_t)wrote;
    if (wrote != stereoSamples * sizeof(int16_t)) Serial.printf("[AILog] short write on sent audio: wanted=%u wrote=%u\n", (unsigned)(stereoSamples * sizeof(int16_t)), (unsigned)wrote);
  }

  if (aiActiveProviderIsGemini) {
    aiDeltaPoolPeakUsedThisTurn = 0;
    aiDeltaDroppedThisTurn = 0;
      aiVoiceBufferAutoTurnStart();
    aiDecodeEmptyCountThisTurn = 0;
    aiDecodeFailCountThisTurn = 0;
    aiDecodeZeroSamplesThisTurn = 0;
    aiResampleZeroCountThisTurn = 0;
    aiRingOverflowBytesThisTurn = 0;
    aiUnderrunCountThisTurn = 0;
    aiDeltaBacklogMax = 0;
    aiDeltaProcUsMax = 0;
    aiSlowDeltaDecodeUs = 0;
    aiSlowDeltaResampleUs = 0;
    aiSlowDeltaRingWriteUs = 0;
    aiSlowDeltaRecCopyUs = 0;
    aiI2sWriteMaxUs = 0;
    aiListenDots = 3;
    drawAiOrTranslatorPage();
    gfx->flush();

    aiSendGeminiAudio(mono, stereoSamples);
    free(mono);
    aiState = AI_THINKING;
    drawAiOrTranslatorPage();
    return;
  }

  aiState = AI_THINKING;
  drawAiOrTranslatorPage();
  aiTurnStartMs = millis();
  aiDeltaPoolPeakUsedThisTurn = 0;
  aiDeltaDroppedThisTurn = 0;
  aiDeltaBacklogMax = 0;
  aiDeltaProcUsMax = 0;
  aiUnderrunCountThisTurn = 0;
  aiSlowDeltaDecodeUs = 0;
  aiSlowDeltaResampleUs = 0;
  aiSlowDeltaRingWriteUs = 0;
  aiSlowDeltaRecCopyUs = 0;
  aiI2sWriteMaxUs = 0;
  aiDecodeEmptyCountThisTurn = 0;
  aiDecodeFailCountThisTurn = 0;
  aiDecodeZeroSamplesThisTurn = 0;
  aiResampleZeroCountThisTurn = 0;
  aiRingOverflowBytesThisTurn = 0;
  wispTrace("AI TURN START model=" + (translatorPageOpen ? activeTranslatorRealtimeModel : aiRealtimeModel));
  aiOpenAiSendBuf = mono;
  aiOpenAiSendSamples = stereoSamples;
  aiOpenAiSendActive = true;
  BaseType_t sendTaskOk = xTaskCreatePinnedToCore(aiSendOpenAiAudioTaskFn, "aiOpenAiSend", 8192, NULL, 1, &aiOpenAiSendTaskHandle, 1);
  if (sendTaskOk != pdPASS) {
    free(mono);
    aiOpenAiSendBuf = nullptr;
    aiOpenAiSendActive = false;
    aiOpenAiSendTaskHandle = nullptr;
    aiErrorMsg = "Out of memory"; aiErrorDetail = ""; aiState = AI_ERROR; drawAiOrTranslatorPage();
  }
}

void aiRecordTaskFn(void* pv) {
  for (;;) {
    if (!aiListening || !aiRecBuf) {
      vTaskDelay(pdMS_TO_TICKS(10));
      continue;
    }
    size_t want = aiRecCap - aiRecFilled;
    if (want == 0) {
      vTaskDelay(pdMS_TO_TICKS(10));
      continue;
    }
    size_t chunk = want > 2000 ? 2000 : want;
    size_t n = i2s.readBytes((char*)(aiRecBuf + aiRecFilled), chunk);
    aiRecFilled += n;
  }
}

#define AI_TASK_STACK_BYTES 3072
bool aiTasksStarted = false;
void ensureAiTasks() {
  if (aiTasksStarted) return;
  BaseType_t aiTaskOk = xTaskCreatePinnedToCore(aiPlaybackTaskFn, "aiPlayback", AI_TASK_STACK_BYTES, NULL, 3, &aiPlaybackTaskHandle, 1);
  Serial.println(aiTaskOk == pdPASS ? "[AI] playback task created" : "[AI] playback task creation FAILED");
  BaseType_t aiDeltaTaskOk = xTaskCreatePinnedToCore(aiDeltaTaskFn, "aiDelta", AI_TASK_STACK_BYTES, NULL, 3, &aiDeltaTaskHandle, 1);
  Serial.println(aiDeltaTaskOk == pdPASS ? "[AI] delta task created" : "[AI] delta task creation FAILED");
  BaseType_t aiRecordTaskOk = xTaskCreatePinnedToCore(aiRecordTaskFn, "aiRecord", AI_TASK_STACK_BYTES, NULL, 3, &aiRecordTaskHandle, 1);
  Serial.println(aiRecordTaskOk == pdPASS ? "[AI] record task created" : "[AI] record task creation FAILED");
  aiTasksStarted = true;
}

static AiMemStats aiComputeMemStats() {
  AiMemStats m;
  m.sramFree  = ESP.getFreeHeap();
  m.sramBlock = ESP.getMaxAllocHeap();
  m.psFree    = ESP.getFreePsram();
  m.psBlock   = ESP.getMaxAllocPsram();

  const long AI_CONN_SRAM_EST = 56L * 1024L;
  m.sramAi = 0;
  if (aiPlaybackTaskHandle)  m.sramAi += AI_TASK_STACK_BYTES;
  if (aiDeltaTaskHandle)     m.sramAi += AI_TASK_STACK_BYTES;
  if (aiRecordTaskHandle)    m.sramAi += AI_TASK_STACK_BYTES;
  if (aiWebSearchTaskHandle) m.sramAi += 8192;
  if (aiSessionReady)        m.sramAi += AI_CONN_SRAM_EST;

  m.psramAi = (long)aiPlayRingCap + (long)aiRecCap;
  if (aiDeltaPool[0])   m.psramAi += (long)aiDeltaPoolActiveSize * (long)AI_DELTA_MAX_B64_LEN;
  if (aiNetToolStack)   m.psramAi += AI_NETTOOL_STACK_BYTES;
  if (aiDecodeBuf)      m.psramAi += AI_DECODE_CAP_BYTES;
  if (aiResampleOutBuf) m.psramAi += (long)AI_RESAMPLE_MAX_OUT_SAMPLES * 2 * (long)sizeof(int16_t);
  if (aiLogCryptBuf)    m.psramAi += AILOG_CRYPT_CHUNK;
  return m;
}

void aiPumpRecording() {
  if (!aiListening || !aiRecBuf) return;
  if (millis() - aiRecordStartMs > AI_MAX_RECORD_MS) { aiStopListeningAndSend(); return; }
  if (aiRecFilled >= aiRecCap) { aiStopListeningAndSend(); return; }
}

static void noteBuildWavHeader(uint8_t* hdr, uint32_t dataLen, uint32_t sampleRate, uint16_t numChannels) {
  uint16_t blockAlign = numChannels * 2;
  uint32_t byteRate = sampleRate * blockAlign;
  uint32_t chunkSize = 36 + dataLen;
  memcpy(hdr, "RIFF", 4);
  hdr[4] = chunkSize & 0xFF; hdr[5] = (chunkSize >> 8) & 0xFF; hdr[6] = (chunkSize >> 16) & 0xFF; hdr[7] = (chunkSize >> 24) & 0xFF;
  memcpy(hdr + 8, "WAVE", 4);
  memcpy(hdr + 12, "fmt ", 4);
  hdr[16] = 16; hdr[17] = 0; hdr[18] = 0; hdr[19] = 0;
  hdr[20] = 1; hdr[21] = 0;
  hdr[22] = numChannels & 0xFF; hdr[23] = (numChannels >> 8) & 0xFF;
  hdr[24] = sampleRate & 0xFF; hdr[25] = (sampleRate >> 8) & 0xFF; hdr[26] = (sampleRate >> 16) & 0xFF; hdr[27] = (sampleRate >> 24) & 0xFF;
  hdr[28] = byteRate & 0xFF; hdr[29] = (byteRate >> 8) & 0xFF; hdr[30] = (byteRate >> 16) & 0xFF; hdr[31] = (byteRate >> 24) & 0xFF;
  hdr[32] = blockAlign & 0xFF; hdr[33] = (blockAlign >> 8) & 0xFF;
  hdr[34] = 16; hdr[35] = 0;
  memcpy(hdr + 36, "data", 4);
  hdr[40] = dataLen & 0xFF; hdr[41] = (dataLen >> 8) & 0xFF; hdr[42] = (dataLen >> 16) & 0xFF; hdr[43] = (dataLen >> 24) & 0xFF;
}

static String noteTranscribeAudioGemini(const uint8_t* wavData, size_t wavLen) {
  static const char PAYLOAD_PREFIX[] = "{\"contents\":[{\"parts\":[{\"text\":\"Transcribe this audio exactly. Reply with ONLY "
                                        "the transcription text, no extra commentary.\"},{\"inline_data\":{\"mime_type\":\"audio/wav\",\"data\":\"";
  static const char PAYLOAD_SUFFIX[] = "\"}}]}]}";
  size_t prefixLen = strlen(PAYLOAD_PREFIX);
  size_t suffixLen = strlen(PAYLOAD_SUFFIX);
  size_t b64Cap = ((wavLen + 2) / 3) * 4 + 4;
  size_t payloadCap = prefixLen + b64Cap + suffixLen;
  uint8_t* payload = (uint8_t*)ps_malloc(payloadCap);
  if (!payload) {
    Serial.printf("[Note] transcribe: payload buffer alloc failed, wanted=%u free PSRAM=%u\n",
                  (unsigned)payloadCap, (unsigned)ESP.getFreePsram());
    return "";
  }
  memcpy(payload, PAYLOAD_PREFIX, prefixLen);
  size_t b64Len = 0;
  int rc = mbedtls_base64_encode(payload + prefixLen, b64Cap, &b64Len, wavData, wavLen);
  if (rc != 0) {
    Serial.print("[Note] transcribe: base64 encode failed, rc=");
    Serial.println(rc);
    free(payload);
    return "";
  }
  memcpy(payload + prefixLen + b64Len, PAYLOAD_SUFFIX, suffixLen);
  size_t payloadLen = prefixLen + b64Len + suffixLen;

  HTTPClient http;
  String url = "https://generativelanguage.googleapis.com/v1beta/models/" + activeVoiceToTextModel
               + ":generateContent?key=" + activeGeminiKey;
  http.begin(url);
  http.setTimeout(30000);
  http.addHeader("Content-Type", "application/json");
  Serial.printf("[Note] transcribe: model=%s (gemini)\n", activeVoiceToTextModel.c_str());
  int code = http.POST(payload, payloadLen);
  free(payload);
  if (code != 200) {
    String errBody = http.getString();
    Serial.printf("[Note] transcribe failed, HTTP %d, body=%s\n", code, errBody.substring(0, 500).c_str());
    http.end();
    return "";
  }
  String rb = http.getString();
  http.end();
  DynamicJsonDocument doc(4096);
  if (deserializeJson(doc, rb) != DeserializationError::Ok) return "";
  int ntgPromptTok = doc["usageMetadata"]["promptTokenCount"] | 0;
  int ntgOutTok = doc["usageMetadata"]["candidatesTokenCount"] | 0;
  int ntgTotalTok = doc["usageMetadata"]["totalTokenCount"] | 0;
  Serial.printf("[Note] transcribe: tokens prompt=%d output=%d total=%d\n",
                ntgPromptTok, ntgOutTok, ntgTotalTok);
  logTokenUsage("voicetotext", "", "gemini", activeVoiceToTextModel, -1, ntgPromptTok, ntgOutTok, -1, -1,
                -1, -1, -1, -1, -1, ntgTotalTok, -1, -1);
  String text = String((const char*)(doc["candidates"][0]["content"]["parts"][0]["text"] | ""));
  text.trim();
  return text;
}

static String noteTranscribeAudio(const uint8_t* wavData, size_t wavLen) {
  if (WiFi.status() != WL_CONNECTED) return "";
  if (aiModelIsGemini(activeVoiceToTextModel)) return noteTranscribeAudioGemini(wavData, wavLen);
  WiFiClientSecure _wc;
  _wc.setInsecure();
  _wc.setHandshakeTimeout(10);
  HTTPClient http;
  http.begin(_wc, "api.openai.com", 443, "/v1/audio/transcriptions");
  http.setTimeout(30000);
  http.addHeader("Authorization", String("Bearer ") + activeOpenAiKey);

  String boundary = "----WaveshareBadgeNoteBoundary";
  String partHead1 = "--" + boundary + "\r\nContent-Disposition: form-data; name=\"model\"\r\n\r\n"
                      + activeVoiceToTextModel + "\r\n";
  String partHead2 = "--" + boundary + "\r\nContent-Disposition: form-data; name=\"file\"; filename=\"note.wav\"\r\n"
                      "Content-Type: audio/wav\r\n\r\n";
  String partTail  = "\r\n--" + boundary + "--\r\n";

  size_t totalLen = partHead1.length() + partHead2.length() + wavLen + partTail.length();
  uint8_t* body = (uint8_t*)ps_malloc(totalLen);
  if (!body) { http.end(); return ""; }
  size_t off = 0;
  memcpy(body + off, partHead1.c_str(), partHead1.length()); off += partHead1.length();
  memcpy(body + off, partHead2.c_str(), partHead2.length()); off += partHead2.length();
  memcpy(body + off, wavData, wavLen); off += wavLen;
  memcpy(body + off, partTail.c_str(), partTail.length()); off += partTail.length();

  http.addHeader("Content-Type", "multipart/form-data; boundary=" + boundary);
  Serial.printf("[Note] transcribe: model=%s\n", activeVoiceToTextModel.c_str());
  int code = http.POST(body, totalLen);
  free(body);
  if (code != 200) {
    Serial.printf("[Note] transcribe failed, HTTP %d\n", code);
    http.end();
    return "";
  }
  String rb = http.getString();
  http.end();
  DynamicJsonDocument doc(4096);
  if (deserializeJson(doc, rb) != DeserializationError::Ok) return "";
  int ntInTok = doc["usage"]["input_tokens"] | 0;
  int ntTextIn = doc["usage"]["input_token_details"]["text_tokens"] | 0;
  int ntAudioIn = doc["usage"]["input_token_details"]["audio_tokens"] | 0;
  int ntOutTok = doc["usage"]["output_tokens"] | 0;
  int ntTotalTok = doc["usage"]["total_tokens"] | 0;
  Serial.printf("[Note] transcribe: tokens input=%d (text=%d audio=%d) output=%d total=%d\n",
                ntInTok, ntTextIn, ntAudioIn, ntOutTok, ntTotalTok);
  logTokenUsage("voicetotext", "", "openai", activeVoiceToTextModel, -1, ntInTok, ntOutTok, -1, -1,
                -1, ntAudioIn, ntTextIn, -1, -1, ntTotalTok, -1, -1);
  return String((const char*)(doc["text"] | ""));
}

static String noteGenerateTitle(const String& transcript) {
  if (aiNoteTitleModelIndex == 0) return "note";
  if (WiFi.status() != WL_CONNECTED || transcript.length() == 0) return "note";

  String prompt = "Reply with ONLY a short 2-5 word title, IN ENGLISH regardless of what language the "
                   "note itself is written in, summarizing the note below — no punctuation, "
                   "no quotes, no extra text, just the title itself.\n\nNote: " + transcript;

  if (aiModelIsGemini(activeNoteTitleModel)) {
    HTTPClient http;
    String url = "https://generativelanguage.googleapis.com/v1beta/models/" + activeNoteTitleModel
                 + ":generateContent?key=" + activeGeminiKey;
    http.begin(url);
    http.setTimeout(15000);
    http.addHeader("Content-Type", "application/json");
    String payload;
    payload.reserve(prompt.length() + 200);
    payload += "{\"contents\":[{\"parts\":[{\"text\":\"";
    jsonEscapeAppendTo(payload, prompt);
    payload += "\"}]}],\"generationConfig\":{\"maxOutputTokens\":20}}";

    Serial.printf("[Note] title: model=%s (gemini)\n", activeNoteTitleModel.c_str());
    int code = http.POST(payload);
    if (code != 200) {
      String errBody = http.getString();
      Serial.printf("[Note] title failed, HTTP %d, body=%s\n", code, errBody.substring(0, 300).c_str());
      http.end();
      return "note";
    }
    String rb = http.getString();
    http.end();
    DynamicJsonDocument res(2048);
    if (deserializeJson(res, rb) != DeserializationError::Ok) {
      Serial.println("[Note] title: JSON parse failed");
      return "note";
    }
    String title = String((const char*)(res["candidates"][0]["content"]["parts"][0]["text"] | ""));
    title.trim();
    int ntlPromptTok = res["usageMetadata"]["promptTokenCount"] | 0;
    int ntlOutTok = res["usageMetadata"]["candidatesTokenCount"] | 0;
    int ntlTotalTok = res["usageMetadata"]["totalTokenCount"] | 0;
    Serial.printf("[Note] title: tokens prompt=%d output=%d total=%d\n",
                  ntlPromptTok, ntlOutTok, ntlTotalTok);
    logTokenUsage("autotext", "", "gemini", activeNoteTitleModel, 20, ntlPromptTok, ntlOutTok, -1, -1,
                  -1, -1, -1, -1, -1, ntlTotalTok, -1, -1);
    return title.length() > 0 ? title : "note";
  }

  HTTPClient http;
  http.begin("https://api.openai.com/v1/chat/completions");
  http.setTimeout(15000);
  http.addHeader("Authorization", String("Bearer ") + activeOpenAiKey);
  http.addHeader("Content-Type", "application/json");
  String payload;
  payload.reserve(prompt.length() + 200);
  payload = "{\"model\":\"";
  payload += activeNoteTitleModel;
  payload += "\",\"max_completion_tokens\":20,\"messages\":[{\"role\":\"user\",\"content\":\"";
  jsonEscapeAppendTo(payload, prompt);
  payload += "\"}]}";

  Serial.printf("[Note] title: model=%s\n", activeNoteTitleModel.c_str());
  int code = http.POST(payload);
  if (code != 200) {
    String errBody = http.getString();
    Serial.printf("[Note] title failed, HTTP %d, body=%s\n", code, errBody.substring(0, 300).c_str());
    http.end();
    return "note";
  }
  String rb = http.getString();
  http.end();
  DynamicJsonDocument res(2048);
  if (deserializeJson(res, rb) != DeserializationError::Ok) {
    Serial.println("[Note] title: JSON parse failed");
    return "note";
  }
  String title = String((const char*)(res["choices"][0]["message"]["content"] | ""));
  title.trim();
  int ntoPromptTok = res["usage"]["prompt_tokens"] | 0;
  int ntoCachedTok = res["usage"]["prompt_tokens_details"]["cached_tokens"] | 0;
  int ntoComplTok = res["usage"]["completion_tokens"] | 0;
  int ntoTotalTok = res["usage"]["total_tokens"] | 0;
  Serial.printf("[Note] title: tokens prompt=%d (cached=%d) completion=%d total=%d\n",
                ntoPromptTok, ntoCachedTok, ntoComplTok, ntoTotalTok);
  logTokenUsage("autotext", "", "openai", activeNoteTitleModel, 20, ntoPromptTok, ntoComplTok, ntoCachedTok, -1,
                -1, -1, -1, -1, -1, ntoTotalTok, -1, -1);
  return title.length() > 0 ? title : "note";
}

static unsigned long noteTaskCreateCount = 0;
static unsigned long noteTaskDeleteCount = 0;

void noteUploadTaskFn(void* pv) {
  for (;;) {
    if (noteState != NOTE_RECORDING && noteState != NOTE_PROCESSING) {
      if (noteReaderBuf) { free(noteReaderBuf); noteReaderBuf = nullptr; }
      noteUploadTaskHandle = nullptr;
      noteTaskDeleteCount++;
      vTaskDelete(NULL);
    }
    size_t written = noteBackupBytesWritten;
    bool stopped = noteCaptureStopped;
    size_t available = (written > noteTranscribeReadPos) ? (written - noteTranscribeReadPos) : 0;

    if (!stopped && available < NOTE_CHUNK_TARGET_BYTES) {
      vTaskDelay(pdMS_TO_TICKS(50));
      continue;
    }
    if (stopped && available < 4) {
      vTaskDelay(pdMS_TO_TICKS(50));
      continue;
    }

    size_t wantBytes = (available < NOTE_CHUNK_MAX_BYTES) ? available : NOTE_CHUNK_MAX_BYTES;
    String backupPath = String(NOTE_AUDIO_DIR) + "/" + noteProvisionalBase + ".wav";
    size_t gotBytes = 0;
    const size_t NOTE_READER_SUBCHUNK_BYTES = 16384;
    unsigned long tPullStart = millis();
    size_t encHdrSkip = noteBackupEncrypted ? CTRLOG_HEADER_LEN : 0;
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    File rf = SD_MMC.open(backupPath, FILE_READ);
    if (rf) rf.seek(encHdrSkip + 44 + noteTranscribeReadPos);
    if (_sdMutex) xSemaphoreGive(_sdMutex);
    if (rf) {
      while (gotBytes < wantBytes) {
        size_t remaining = wantBytes - gotBytes;
        size_t askBytes = (remaining < NOTE_READER_SUBCHUNK_BYTES) ? remaining : NOTE_READER_SUBCHUNK_BYTES;
        if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
        int got = rf.read(noteReaderBuf + gotBytes, askBytes);
        if (_sdMutex) xSemaphoreGive(_sdMutex);
        if (got <= 0) break;
        if (noteBackupEncrypted) {
          aiLogDecryptBlock(noteBackupNonce, 44 + noteTranscribeReadPos + gotBytes,
                            noteReaderBuf + gotBytes, (size_t)got);
        }
        gotBytes += (size_t)got;
        if ((size_t)got < askBytes) break;
      }
      if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
      rf.close();
      if (_sdMutex) xSemaphoreGive(_sdMutex);
    }
    Serial.printf("[Note][DIAG] SD pull: %lums for %u bytes\n", millis() - tPullStart, (unsigned)gotBytes);

    if (gotBytes < 4) {
      vTaskDelay(pdMS_TO_TICKS(50));
      continue;
    }

    bool isLastStretch = stopped && (noteTranscribeReadPos + gotBytes >= written);

    size_t useBytes = gotBytes;
    if (!isLastStretch && gotBytes > NOTE_CHUNK_TARGET_BYTES) {
      unsigned long tPauseStart = millis();
      int16_t* samples = (int16_t*)noteReaderBuf;
      size_t totalSamples = gotBytes / 2;
      size_t targetSamples = NOTE_CHUNK_TARGET_BYTES / 2;
      const size_t LEVEL_SAMPLE_STRIDE = 8;
      const size_t WINDOW_SAMPLES = 500;
      const double PAUSE_RELATIVE_THRESHOLD = 0.3;
      const int NOTE_PAUSE_MIN_CONSECUTIVE_WINDOWS = 4;

      int64_t levelSum = 0;
      size_t levelCount = 0;
      for (size_t i = 0; i < targetSamples; i += LEVEL_SAMPLE_STRIDE) {
        int32_t v = samples[i];
        levelSum += (v < 0) ? -v : v;
        levelCount++;
      }

      int consecutiveQuiet = 0;
      size_t cutAtSamples = 0;
      for (size_t pos = targetSamples; pos + WINDOW_SAMPLES <= totalSamples; pos += WINDOW_SAMPLES) {
        int64_t windowSum = 0;
        size_t windowCount = 0;
        for (size_t i = pos; i < pos + WINDOW_SAMPLES; i += LEVEL_SAMPLE_STRIDE) {
          int32_t v = samples[i];
          windowSum += (v < 0) ? -v : v;
          windowCount++;
        }
        double chunkAvg = levelCount ? ((double)levelSum / (double)levelCount) : 0;
        double windowAvg = windowCount ? ((double)windowSum / (double)windowCount) : 0;
        bool windowLooksQuiet = chunkAvg > 0 && windowAvg < chunkAvg * PAUSE_RELATIVE_THRESHOLD;
        if (windowLooksQuiet) consecutiveQuiet++; else consecutiveQuiet = 0;
        levelSum += windowSum;
        levelCount += windowCount;
        if (consecutiveQuiet >= NOTE_PAUSE_MIN_CONSECUTIVE_WINDOWS) {
          cutAtSamples = pos + WINDOW_SAMPLES;
          break;
        }
      }
      if (cutAtSamples > 0) useBytes = cutAtSamples * 2;
      Serial.printf("[Note][DIAG] pause search: %lums\n", millis() - tPauseStart);
    }

    if (useBytes >= 4 && noteWantsText()) {
      unsigned long tProcStart = millis();
      int16_t* stereo = (int16_t*)noteReaderBuf;
      size_t stereoSamples = useBytes / 4;
      for (size_t i = 0; i < stereoSamples; i++) {
        stereo[i] = (int16_t)(((int32_t)stereo[i * 2] + (int32_t)stereo[i * 2 + 1]) / 2);
      }
      int16_t* mono = stereo;

      double sumSq = 0;
      for (size_t i = 0; i < stereoSamples; i++) {
        double s = (double)mono[i];
        sumSq += s * s;
      }
      double rms = sqrt(sumSq / (double)stereoSamples);
      if (rms < 1.0) rms = 1.0;
      const double TARGET_RMS = 6000.0;
      float gain = (float)(TARGET_RMS / rms);
      const float MAX_GAIN = 40.0f;
      if (gain > MAX_GAIN) gain = MAX_GAIN;
      for (size_t i = 0; i < stereoSamples; i++) {
        int32_t boosted = (int32_t)(mono[i] * gain);
        if (boosted > 32767) boosted = 32767;
        else if (boosted < -32768) boosted = -32768;
        mono[i] = (int16_t)boosted;
      }

      size_t fadeSamples = (size_t)(AUDIO_SAMPLE_RATE * 0.015);
      if (fadeSamples * 2 > stereoSamples) fadeSamples = stereoSamples / 2;
      for (size_t i = 0; i < fadeSamples; i++) {
        float factor = (float)i / (float)fadeSamples;
        mono[i] = (int16_t)((float)mono[i] * factor);
        size_t tailIdx = stereoSamples - 1 - i;
        mono[tailIdx] = (int16_t)((float)mono[tailIdx] * factor);
      }

      size_t dataLen = stereoSamples * sizeof(int16_t);
      uint8_t* wav = (uint8_t*)ps_malloc(44 + dataLen);
      if (wav) {
        noteBuildWavHeader(wav, (uint32_t)dataLen, AUDIO_SAMPLE_RATE, 1);
        memcpy(wav + 44, mono, dataLen);

        Serial.printf("[Note][DIAG] downmix+rms+fade: %lums\n", millis() - tProcStart);

        unsigned long tNetStart = millis();
        if (_netMutex) xSemaphoreTake(_netMutex, portMAX_DELAY);
        String chunkText = noteTranscribeAudio(wav, 44 + dataLen);
        if (_netMutex) xSemaphoreGive(_netMutex);
        Serial.printf("[Note][DIAG] network transcribe: %lums\n", millis() - tNetStart);

        bool chunkOk = chunkText.length() > 0;
        if (chunkOk) noteRealTextChunks++;
        else Serial.println("[Note] a chunk failed to transcribe - marked in the note, raw audio is still in the backup file");
        if (noteAccumulatedTranscript.length() > 0) noteAccumulatedTranscript += " ";
        noteAccumulatedTranscript += chunkOk ? chunkText : String(NOTE_TRANSCRIBE_FAILED_MARKER);
        {
          time_t now = time(NULL);
          struct tm lt; localtime_r(&now, &lt);
          char hdrBuf[24]; strftime(hdrBuf, sizeof(hdrBuf), "%Y-%m-%d %H:%M", &lt);
          String content = String(hdrBuf) + "\n\n" + noteAccumulatedTranscript + "\n";
          if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
          ensureNoteTextDir();
          writeKnowledgeFile(String(NOTE_TEXT_DIR) + "/" + noteProvisionalBase + ".txt", content);
          if (_sdMutex) xSemaphoreGive(_sdMutex);
        }
        free(wav);
      } else {
        Serial.println("[Note] chunk downmix: out of memory, skipping this chunk's transcription");
      }
    }

    noteTranscribeReadPos += useBytes;
    if (isLastStretch) noteFinalizeRecording();
  }
}

void noteNormalizeBackupAudio() {
  String path = String(NOTE_AUDIO_DIR) + "/" + noteProvisionalBase + ".wav";
  String tmpPath = path + ".norm.tmp";

  double sumSq = 0;
  size_t sampleCount = 0;
  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  {
    File rf = SD_MMC.open(path, FILE_READ);
    if (rf) {
      rf.seek((noteBackupEncrypted ? CTRLOG_HEADER_LEN : 0) + 44);
      size_t got;
      size_t rmsPos = 44;
      while ((got = rf.read(noteReaderBuf, NOTE_CHUNK_MAX_BYTES)) > 0) {
        if (noteBackupEncrypted) aiLogDecryptBlock(noteBackupNonce, rmsPos, noteReaderBuf, got);
        rmsPos += got;
        int16_t* samples = (int16_t*)noteReaderBuf;
        size_t n = got / 2;
        for (size_t i = 0; i < n; i++) {
          double s = (double)samples[i];
          sumSq += s * s;
        }
        sampleCount += n;
      }
      rf.close();
    }
  }
  if (_sdMutex) xSemaphoreGive(_sdMutex);

  if (sampleCount < 1) return;

  double rms = sqrt(sumSq / (double)sampleCount);
  if (rms < 1.0) rms = 1.0;
  const double TARGET_RMS = 6000.0;
  const float MAX_GAIN = 40.0f;
  float gain = (float)(TARGET_RMS / rms);
  if (gain > MAX_GAIN) gain = MAX_GAIN;
  if (gain <= 1.0f) return;

  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  {
    File in = SD_MMC.open(path, FILE_READ);
    File out = SD_MMC.open(tmpPath, FILE_WRITE);
    bool ok = (bool)in && (bool)out;
    if (ok) {
      uint8_t outNonce[CTRLOG_NONCE_LEN];
      bool outEnc = false;
      if (noteBackupEncrypted) outEnc = aiLogBeginEncrypted(out, outNonce);
      in.seek(noteBackupEncrypted ? CTRLOG_HEADER_LEN : 0);
      uint8_t hdr[44];
      in.read(hdr, 44);
      if (noteBackupEncrypted) aiLogDecryptBlock(noteBackupNonce, 0, hdr, 44);
      aiLogWriteMaybeEnc(out, outEnc, outNonce, AILOG_PLAIN_BASE, hdr, 44);
      size_t got;
      size_t normPos = 44;
      while ((got = in.read(noteReaderBuf, NOTE_CHUNK_MAX_BYTES)) > 0) {
        if (noteBackupEncrypted) aiLogDecryptBlock(noteBackupNonce, normPos, noteReaderBuf, got);
        int16_t* samples = (int16_t*)noteReaderBuf;
        size_t n = got / 2;
        for (size_t i = 0; i < n; i++) {
          int32_t boosted = (int32_t)(samples[i] * gain);
          if (boosted > 32767) boosted = 32767;
          else if (boosted < -32768) boosted = -32768;
          samples[i] = (int16_t)boosted;
        }
        aiLogWriteMaybeEnc(out, outEnc, outNonce, AILOG_PLAIN_BASE + normPos, noteReaderBuf, got);
        normPos += got;
      }
      if (outEnc) memcpy(noteBackupNonce, outNonce, CTRLOG_NONCE_LEN);
    }
    if (in) in.close();
    if (out) out.close();
    if (ok) {
      SD_MMC.remove(path);
      SD_MMC.rename(tmpPath, path);
    } else {
      SD_MMC.remove(tmpPath);
    }
  }
  if (_sdMutex) xSemaphoreGive(_sdMutex);
}

void noteFinalizeRecording() {
  String transcript = noteAccumulatedTranscript;

  bool backupKept = noteWantsAudio();
  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  if (backupKept) {
    if (noteBackupFile) {
      noteBackupFile.seek(noteBackupEncrypted ? CTRLOG_HEADER_LEN : 0);
      uint8_t hdr[44];
      noteBuildWavHeader(hdr, (uint32_t)noteBackupBytesWritten, AUDIO_SAMPLE_RATE, 2);
      aiLogWriteMaybeEnc(noteBackupFile, noteBackupEncrypted, noteBackupNonce,
                         AILOG_PLAIN_BASE, hdr, 44);
      noteBackupFile.close();
    }
  } else {
    if (noteBackupFile) noteBackupFile.close();
    SD_MMC.remove(String(NOTE_AUDIO_DIR) + "/" + noteProvisionalBase + ".wav");
  }
  if (_sdMutex) xSemaphoreGive(_sdMutex);
  if (backupKept) noteNormalizeBackupAudio();

  if (!noteWantsText()) {
    String snippetTitle;
    if (aiVoiceToTextModelIndex != 0 && aiProviderHasKeyFor(activeVoiceToTextModel, false) && noteReaderBuf) {
      String path = String(NOTE_AUDIO_DIR) + "/" + noteProvisionalBase + ".wav";
      size_t got = 0;
      if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
      File sf = SD_MMC.open(path, FILE_READ);
      if (sf) {
        sf.seek((noteBackupEncrypted ? CTRLOG_HEADER_LEN : 0) + 44);
        size_t want = (noteBackupBytesWritten < NOTE_CHUNK_TARGET_BYTES) ? noteBackupBytesWritten : NOTE_CHUNK_TARGET_BYTES;
        got = sf.read(noteReaderBuf, want);
        if (noteBackupEncrypted && got > 0) aiLogDecryptBlock(noteBackupNonce, 44, noteReaderBuf, got);
        sf.close();
      }
      if (_sdMutex) xSemaphoreGive(_sdMutex);

      if (got >= 4) {
        int16_t* stereo = (int16_t*)noteReaderBuf;
        size_t stereoSamples = got / 4;
        for (size_t i = 0; i < stereoSamples; i++) {
          stereo[i] = (int16_t)(((int32_t)stereo[i * 2] + (int32_t)stereo[i * 2 + 1]) / 2);
        }
        size_t dataLen = stereoSamples * sizeof(int16_t);
        uint8_t* wav = (uint8_t*)ps_malloc(44 + dataLen);
        if (wav) {
          noteBuildWavHeader(wav, (uint32_t)dataLen, AUDIO_SAMPLE_RATE, 1);
          memcpy(wav + 44, stereo, dataLen);
          if (_netMutex) xSemaphoreTake(_netMutex, portMAX_DELAY);
          String snippetText = noteTranscribeAudio(wav, 44 + dataLen);
          if (_netMutex) xSemaphoreGive(_netMutex);
          free(wav);
          if (snippetText.length() > 0) {
            if (_netMutex) xSemaphoreTake(_netMutex, portMAX_DELAY);
            snippetTitle = noteGenerateTitle(snippetText);
            if (_netMutex) xSemaphoreGive(_netMutex);
          }
        }
      }
    }

    String finalBase = noteProvisionalBase;
    if (snippetTitle.length() > 0 && snippetTitle != "note") {
      String slug = aiKbSlug(snippetTitle);
      if (slug.length() > 0) {
        time_t now = time(NULL);
        struct tm lt; localtime_r(&now, &lt);
        char tsBuf[16]; strftime(tsBuf, sizeof(tsBuf), "%Y%m%d_%H%M", &lt);
        finalBase = slug + "_" + String(tsBuf);
        noteTitle = snippetTitle;
        String oldAudio = String(NOTE_AUDIO_DIR) + "/" + noteProvisionalBase + ".wav";
        String newAudio = String(NOTE_AUDIO_DIR) + "/" + finalBase + ".wav";
        if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
        SD_MMC.rename(oldAudio, newAudio);
        if (_sdMutex) xSemaphoreGive(_sdMutex);
      }
    }

    noteTranscript = "";
    noteSavedFilename = finalBase + ".wav";
    noteState = NOTE_SAVED;
    noteSavedAtMs = millis();
    if (noteRecordPageOpen) drawNoteRecordPage();
    return;
  }

  if (noteRealTextChunks == 0) {
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    SD_MMC.remove(String(NOTE_TEXT_DIR) + "/" + noteProvisionalBase + ".txt");
    if (_sdMutex) xSemaphoreGive(_sdMutex);
    noteErrorMsg = backupKept ? "Transcription failed, audio saved" : "Transcription failed";
    noteState = NOTE_ERROR;
    if (noteRecordPageOpen) drawNoteRecordPage();
    return;
  }

  if (_netMutex) xSemaphoreTake(_netMutex, portMAX_DELAY);
  String titleSource = transcript;
  titleSource.replace(NOTE_TRANSCRIBE_FAILED_MARKER, "");
  titleSource.trim();
  String title = noteGenerateTitle(titleSource);
  if (_netMutex) xSemaphoreGive(_netMutex);

  noteTranscript = transcript;
  noteTitle = title;

  String slug = aiKbSlug(title);
  if (slug.length() == 0) slug = "note";
  time_t now = time(NULL);
  struct tm lt; localtime_r(&now, &lt);
  char tsBuf[16]; strftime(tsBuf, sizeof(tsBuf), "%Y%m%d_%H%M", &lt);
  String finalBase = slug + "_" + String(tsBuf);
  String filename = finalBase + ".txt";
  String path = String(NOTE_TEXT_DIR) + "/" + filename;
  char hdrBuf[24]; strftime(hdrBuf, sizeof(hdrBuf), "%Y-%m-%d %H:%M", &lt);
  String content = String(hdrBuf) + "\n\n" + transcript + "\n";

  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  ensureNoteTextDir();
  writeKnowledgeFile(path, content);
  SD_MMC.remove(String(NOTE_TEXT_DIR) + "/" + noteProvisionalBase + ".txt");
  if (_sdMutex) xSemaphoreGive(_sdMutex);
  reloadKnowledge();

  if (backupKept) {
    String oldAudio = String(NOTE_AUDIO_DIR) + "/" + noteProvisionalBase + ".wav";
    String newAudio = String(NOTE_AUDIO_DIR) + "/" + finalBase + ".wav";
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    SD_MMC.rename(oldAudio, newAudio);
    if (_sdMutex) xSemaphoreGive(_sdMutex);
  }

  if (noteEmailToContact.length() > 0) {
    String addr = aiToolResolveContact(noteEmailToContact);
    if (addr.length() > 0) {
      SmtpAttachment att;
      att.filename = filename;
      att.content = content;
      String subject = "Voice Note: " + (title.length() > 0 ? title : String("Transcription"));
      String body = "Transcription attached.";
      if (activeEmailSignature.length() > 0) body += "\n\n" + activeEmailSignature;
      if (_netMutex) xSemaphoreTake(_netMutex, portMAX_DELAY);
      String err = smtpSendMail(addr, subject, body, &att, 1);
      if (_netMutex) xSemaphoreGive(_netMutex);
      if (err.length() > 0) {
        Serial.printf("[Note] email to \"%s\" failed: %s\n", noteEmailToContact.c_str(), err.c_str());
      }
    } else {
      Serial.printf("[Note] email skipped — \"%s\" is no longer a saved contact\n", noteEmailToContact.c_str());
    }
  }

  noteSavedFilename = filename;
  noteState = NOTE_SAVED;
  noteSavedAtMs = millis();
  if (noteRecordPageOpen) drawNoteRecordPage();
}

void noteStopRecordingAndProcess() {
  if (noteState != NOTE_RECORDING) return;
  if (noteBackupBytesWritten < 4 && millis() - noteRecordStartMs < 1000) {
    noteState = NOTE_IDLE;
    drawNoteRecordPage();
    return;
  }
  noteState = NOTE_PROCESSING;
  drawNoteRecordPage();
  gfx->flush();

  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  if (noteBackupFile) noteBackupFile.flush();
  if (_sdMutex) xSemaphoreGive(_sdMutex);
  noteCaptureStopped = true;
}

void noteStartRecording() {
  if (noteUploadTaskHandle != nullptr || noteCaptureTaskHandle != nullptr) {
    noteErrorMsg = "Still finishing previous note";
    noteState = NOTE_ERROR;
    drawNoteRecordPage();
    return;
  }
  if (fileTranscribeActive) {
    noteErrorMsg = "A file is being transcribed";
    noteState = NOTE_ERROR;
    drawNoteRecordPage();
    return;
  }
  if (!audioOk || !micArrayOk) {
    noteErrorMsg = "Mic not available";
    noteState = NOTE_ERROR;
    drawNoteRecordPage();
    return;
  }
  if (!noteReaderBuf && !allocNoteReaderBufInPsram()) {
    noteErrorMsg = "Out of memory";
    noteState = NOTE_ERROR;
    drawNoteRecordPage();
    return;
  }
  noteTranscribeReadPos = 0;
  noteCaptureStopped = false;
  noteCaptureRingHead = 0;
  noteCaptureRingTail = 0;
  if (!noteCaptureRing) noteCaptureRing = (uint8_t*)ps_malloc(NOTE_CAPTURE_RING_BYTES);
  if (!noteCaptureRing) {
    noteErrorMsg = "Out of memory";
    noteState = NOTE_ERROR;
    drawNoteRecordPage();
    return;
  }
  noteCaptureRingCap = NOTE_CAPTURE_RING_BYTES;
  noteAccumulatedTranscript = "";
  noteRealTextChunks = 0;
  noteTranscript = "";
  noteTitle = "";

  time_t now = time(NULL);
  struct tm lt; localtime_r(&now, &lt);
  char tsBuf[16]; strftime(tsBuf, sizeof(tsBuf), "%Y%m%d_%H%M", &lt);
  noteProvisionalBase = "note_" + String(tsBuf);

  noteBackupBytesWritten = 0;
  String backupPath = String(NOTE_AUDIO_DIR) + "/" + noteProvisionalBase + ".wav";
  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  if (!SD_MMC.exists(NOTE_AUDIO_DIR)) SD_MMC.mkdir(NOTE_AUDIO_DIR);
  noteBackupFile = SD_MMC.open(backupPath, "w");
  if (noteBackupFile) {
    noteBackupEncrypted = sdEncryptionActive && aiLogBeginEncrypted(noteBackupFile, noteBackupNonce);
    uint8_t placeholder[44];
    noteBuildWavHeader(placeholder, 0, AUDIO_SAMPLE_RATE, 2);
    aiLogWriteMaybeEnc(noteBackupFile, noteBackupEncrypted, noteBackupNonce,
                       AILOG_PLAIN_BASE, placeholder, 44);
  }
  if (_sdMutex) xSemaphoreGive(_sdMutex);
  if (!noteBackupFile) {
    noteErrorMsg = "SD write failed";
    noteState = NOTE_ERROR;
    drawNoteRecordPage();
    return;
  }

  noteRecordStartMs = millis();
  noteState = NOTE_RECORDING;

  BaseType_t noteUploadTaskOk = xTaskCreatePinnedToCore(noteUploadTaskFn, "noteUpload", 32768, NULL, 1, &noteUploadTaskHandle, 1);
  if (noteUploadTaskOk == pdPASS) noteTaskCreateCount++;
  if (noteUploadTaskOk != pdPASS) {
    noteUploadTaskHandle = nullptr;
    if (noteCaptureRing) { free(noteCaptureRing); noteCaptureRing = nullptr; noteCaptureRingCap = 0; }
    noteErrorMsg = "Out of memory";
    noteState = NOTE_ERROR;
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    noteBackupFile.close();
    SD_MMC.remove(backupPath);
    if (_sdMutex) xSemaphoreGive(_sdMutex);
    drawNoteRecordPage();
    return;
  }

  BaseType_t noteCaptureTaskOk = xTaskCreatePinnedToCore(noteCaptureTaskFn, "noteCapture", 4096, NULL, 3, &noteCaptureTaskHandle, 1);
  if (noteCaptureTaskOk != pdPASS) {
    noteCaptureTaskHandle = nullptr;
    if (noteCaptureRing) { free(noteCaptureRing); noteCaptureRing = nullptr; noteCaptureRingCap = 0; }
    noteErrorMsg = "Out of memory";
    noteState = NOTE_ERROR;
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    noteBackupFile.close();
    SD_MMC.remove(backupPath);
    if (_sdMutex) xSemaphoreGive(_sdMutex);
    drawNoteRecordPage();
    return;
  }

  drawNoteRecordPage();
}

void noteCaptureTaskFn(void* pv) {
  for (;;) {
    if (noteState != NOTE_RECORDING) {
      if (!noteCaptureRing || noteCaptureRingHead == noteCaptureRingTail) {
        if (noteCaptureRing) { free(noteCaptureRing); noteCaptureRing = nullptr; noteCaptureRingCap = 0; }
        noteCaptureTaskHandle = nullptr;
        vTaskDelete(NULL);
      }
      vTaskDelay(pdMS_TO_TICKS(10));
      continue;
    }
    static uint8_t* drainBuf = nullptr;
    if (!drainBuf) drainBuf = (uint8_t*)ps_malloc(2000);
    if (!drainBuf) {
      Serial.printf("[Note] capture: drain buffer alloc failed, free PSRAM=%u\n", (unsigned)ESP.getFreePsram());
      vTaskDelay(pdMS_TO_TICKS(50));
      continue;
    }
    size_t n = i2s.readBytes((char*)drainBuf, 2000);
    if (n == 0) continue;
    size_t i = 0;
    while (i + 4 <= n) {
      if (noteCaptureRingFreeBytes() < 4) break;
      size_t h = noteCaptureRingHead;
      for (int k = 0; k < 4; k++) {
        noteCaptureRing[h] = drainBuf[i + k];
        h = (h + 1) % noteCaptureRingCap;
      }
      noteCaptureRingHead = h;
      i += 4;
    }
  }
}

void notePumpRecording() {
  if (!noteBackupFile) return;

  size_t avail = noteCaptureRingUsedBytes();
  if (avail == 0) return;

  static unsigned long lastPumpMs = 0;
  unsigned long nowMs = millis();
  if (lastPumpMs != 0) {
    unsigned long gap = nowMs - lastPumpMs;
    if (gap > 60 && gap <= 2000) {
      Serial.printf("[Note][DIAG] SD-write stall: %lums since last pump (t=%lu, ring queued=%u)\n", gap, nowMs, (unsigned)avail);
    }
  }
  lastPumpMs = nowMs;

  size_t toDrain = avail < NOTE_CAPTURE_DRAIN_MAX_BYTES ? avail : NOTE_CAPTURE_DRAIN_MAX_BYTES;
  static uint8_t* drainBuf = nullptr;
  if (!drainBuf) drainBuf = (uint8_t*)ps_malloc(NOTE_CAPTURE_DRAIN_MAX_BYTES);
  if (!drainBuf) {
    Serial.printf("[Note] SD-write: drain buffer alloc failed, free PSRAM=%u\n", (unsigned)ESP.getFreePsram());
    return;
  }
  size_t t = noteCaptureRingTail;
  size_t firstPart = noteCaptureRingCap - t;
  if (firstPart > toDrain) firstPart = toDrain;
  memcpy(drainBuf, noteCaptureRing + t, firstPart);
  size_t remaining = toDrain - firstPart;
  if (remaining > 0) memcpy(drainBuf + firstPart, noteCaptureRing, remaining);
  noteCaptureRingTail = (t + toDrain) % noteCaptureRingCap;

  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  aiLogWriteMaybeEnc(noteBackupFile, noteBackupEncrypted, noteBackupNonce,
                     AILOG_PLAIN_BASE + 44 + noteBackupBytesWritten, drainBuf, toDrain);
  noteBackupBytesWritten += toDrain;
  if (noteState != NOTE_RECORDING) {
    noteBackupFile.flush();
  } else {
    static unsigned long lastFlushMs = 0;
    if (millis() - lastFlushMs > 1000) {
      noteBackupFile.flush();
      lastFlushMs = millis();
    }
  }
  if (_sdMutex) xSemaphoreGive(_sdMutex);
}

void cycleNoteSaveMode() {
  noteSaveMode = (noteSaveMode + 1) % 3;
  saveSettings();
  drawNoteRecordPage();
}

void cycleNoteEmailTo() {
  int cur = -1;
  for (int i = 0; i < activeContactCount; i++) {
    if (activeContacts[i].name == noteEmailToContact) { cur = i; break; }
  }
  cur++;
  noteEmailToContact = (cur < activeContactCount) ? activeContacts[cur].name : "";
  saveSettings();
  drawNoteRecordPage();
}

void openNoteRecordPage() {
  if (featureDisabled("transcribe")) return;
  wxYieldForUi();
  noteRecordPageOpen = true;
  settingsEditUnlocked = false;
  noteTranscript = ""; noteTitle = ""; noteErrorMsg = "";
  if (noteWantsText() && aiVoiceToTextModelIndex == 0) {
    noteState = NOTE_ERROR;
    noteErrorMsg = "Voice TT is off";
    drawNoteRecordPage();
    return;
  }
  if (noteWantsText() && !aiProviderHasKeyFor(activeVoiceToTextModel, false)) {
    noteRecordPageOpen = false;
    return;
  }
  noteState = NOTE_IDLE;
  aiMemResetPending = true;
  micResumeForPage();
  drawNoteRecordPage();
}

void closeNoteRecordPage() {
  noteRecordPageOpen = false;
  settingsEditUnlocked = false;
  if (noteState == NOTE_RECORDING) {
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    if (noteBackupFile) noteBackupFile.flush();
    if (_sdMutex) xSemaphoreGive(_sdMutex);
    noteCaptureStopped = true;
    noteState = NOTE_PROCESSING;
  }
  micParkForPage();
  if (!sdMounted) { drawSdCardMissingScreen(); return; }
  drawClockScreen();
}

