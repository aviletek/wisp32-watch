void handleKBAiGen() {
  if (!requireAuth()) return;
  if (!server.hasArg("file")) { server.send(400, "application/json", "{\"ok\":false,\"err\":\"No file\"}"); return; }
  String desc, instr, err;
  bool ok = kbAiGenerateMeta(server.arg("file"), server.arg("guide"),
                             server.arg("curdesc"), server.arg("curinstr"),
                             &desc, &instr, &err);
  String out = "{\"ok\":";
  out += ok ? "true" : "false";
  if (ok) {
    if (desc.length() > 0)  { out += ",\"desc\":\"";  jsonEscapeAppendTo(out, desc);  out += "\""; }
    if (instr.length() > 0) { out += ",\"instr\":\""; jsonEscapeAppendTo(out, instr); out += "\""; }
  } else {
    out += ",\"err\":\""; jsonEscapeAppendTo(out, err); out += "\"";
  }
  out += "}";
  server.send(200, "application/json", out);
}

void handleKBRestrict() {
  if (!requireAuth()) return;
  if (!server.hasArg("path")) { server.send(400, "application/json", "{\"ok\":false,\"err\":\"path\"}"); return; }
  String relPath = server.arg("path");
  int ls = relPath.lastIndexOf('/');
  String parentPath = (ls >= 0) ? relPath.substring(0, ls) : "";
  bool alreadyCovered = parentPath.length() > 0 && kbFindRestrictingPin(parentPath).length() > 0;
  if (alreadyCovered) { server.send(200, "application/json", "{\"ok\":false,\"err\":\"covered\"}"); return; }

  String pwPath = String(KNOWLEDGE_DIR) + "/" + relPath + ".pwd";
  bool isRestricted = SD_MMC.exists(pwPath);
  bool pwWasPlaintext = false;
  String storedPin = isRestricted ? readSecretFile(pwPath, &pwWasPlaintext) : "";

  bool curPinOk = !isRestricted || (server.hasArg("curpin") && server.arg("curpin") == storedPin);
  if (!curPinOk) { server.send(200, "application/json", "{\"ok\":false,\"err\":\"curpin\"}"); return; }

  String pin = server.hasArg("pin") ? server.arg("pin") : "";
  if (pin.length() == 0) {
    if (isRestricted) SD_MMC.remove(pwPath);
    server.send(200, "application/json", "{\"ok\":true}");
    return;
  }
  bool validPin = pin.length() >= 4 && pin.length() <= 8;
  for (size_t i = 0; validPin && i < pin.length(); i++) if (!isDigit(pin[i])) validPin = false;
  if (!validPin) { server.send(200, "application/json", "{\"ok\":false,\"err\":\"invalid\"}"); return; }
  if (!isRestricted) {
    String pin2 = server.hasArg("pin2") ? server.arg("pin2") : "";
    if (pin2 != pin) { server.send(200, "application/json", "{\"ok\":false,\"err\":\"mismatch\"}"); return; }
  }
  writeSecretFile(pwPath, pin);
  server.send(200, "application/json", "{\"ok\":true}");
}

