    "<div class='row'>"
    + (readOnlyLog ? "" : "<button class='btn' type='submit'>&#10003; Save</button>") +
    "<a class='btn btn-g' href='" + cancelHref + "'>Cancel</a>"
    "</div>"
    "</form>"
    "<script>"
    + schemaJs +
    "var rawTa=document.getElementById('rawTa'),"
    "edDiv=document.getElementById('edDiv'),"
    "rawDiv=document.getElementById('rawDiv'),"
    "ec=document.getElementById('edContent'),"
    "fn=document.querySelector('input[name=file]').value,"
    "mode='txt',csvRows=[],csvHeaders=[],csvHasHdr=false,jsonData=null,txtLines=[];"

    "function detectMode(){"
    "if(/\\.csv$/i.test(fn))return 'csv';"
    "if(/\\.json$/i.test(fn))return 'json';"
    "return 'txt';}"

    "function parseCSV(txt){"
    "var rows=[];"
    "var lines=txt.split('\\n');"
    "for(var li=0;li<lines.length;li++){"
    "var line=lines[li].replace(/\\r$/,'');"
    "if(!line.trim())continue;"
    "var row=[],cur='',inQ=false;"
    "for(var i=0;i<line.length;i++){"
    "var c=line[i];"
    "if(c==='\"'){if(inQ&&line[i+1]==='\"'){cur+='\"';i++;}else inQ=!inQ;}"
    "else if(c===','&&!inQ){row.push(cur);cur='';}"
    "else cur+=c;}"
    "row.push(cur);rows.push(row);}"
    "return rows;}"

    "function toCSV(rows){"
    "return rows.map(function(row){"
    "return row.map(function(f){"
    "f=String(f===undefined?'':f);"
    "if(f.indexOf(',')>=0||f.indexOf('\"')>=0||f.indexOf('\\n')>=0)"
    "return '\"'+f.split('\"').join('\"\"')+'\"';"
    "return f;}).join(',');}).join('\\n');}"

    "function looksLikeHdr(row){"
    "for(var i=0;i<row.length;i++)if(/^\\d/.test(row[i].trim()))return false;"
    "return true;}"

    "function renderCSVEditor(){"
    "ec.innerHTML='';"
    "var wrap=document.createElement('div');wrap.className='edwrap';"
    "var tbl=document.createElement('table');tbl.className='et';"
    "var thead=document.createElement('thead');"
    "var hr=document.createElement('tr');"
    "var rnh=document.createElement('th');rnh.textContent='#';hr.appendChild(rnh);"
    "csvHeaders.forEach(function(h){var th=document.createElement('th');th.textContent=h;hr.appendChild(th);});"
    "hr.appendChild(document.createElement('th'));"
    "thead.appendChild(hr);tbl.appendChild(thead);"
    "var tbody=document.createElement('tbody');"
    "csvRows.forEach(function(row,ri){"
    "var tr=document.createElement('tr');tr.dataset.ri=ri;"
    "var rntd=document.createElement('td');rntd.className='rn';rntd.textContent=ri+1;tr.appendChild(rntd);"
    "csvHeaders.forEach(function(h,ci){"
    "var td=document.createElement('td');"
    "var inp=document.createElement('textarea');inp.rows=1;"
    "inp.value=row[ci]!==undefined?row[ci]:'';"
    "inp.oninput=(function(r,c){return function(){csvRows[r][c]=this.value;};})(ri,ci);"
    "td.appendChild(inp);tr.appendChild(td);});"
    "var tdx=document.createElement('td');"
    "var btn=document.createElement('button');btn.type='button';btn.className='del';btn.textContent='\\u2715';btn.title='Delete row';"
    "btn.onclick=(function(r){return function(){if(confirm('Delete row '+(r+1)+'?')){csvRows.splice(r,1);renderCSVEditor();}};})(ri);"
    "tdx.appendChild(btn);tr.appendChild(tdx);tbody.appendChild(tr);});"
    "tbl.appendChild(tbody);wrap.appendChild(tbl);ec.appendChild(wrap);"
    "var ab=document.createElement('button');ab.type='button';ab.className='eadd';ab.textContent='+ Add row';"
    "ab.onclick=function(){"
    "csvRows.push(csvHeaders.map(function(){return '';}));"
    "renderCSVEditor();"
    "var ins=ec.querySelectorAll('tbody tr:last-child input');if(ins.length)ins[0].focus();};"
    "ec.appendChild(ab);}"

    "function serializeCSV(){"
    "ec.querySelectorAll('tbody tr').forEach(function(tr){"
    "var ri=parseInt(tr.dataset.ri);if(isNaN(ri))return;"
    "tr.querySelectorAll('input').forEach(function(inp,ci){if(csvRows[ri])csvRows[ri][ci]=inp.value;});});"
    "var all=csvHasHdr?[csvHeaders].concat(csvRows):csvRows;"
    "return toCSV(all);}"

    "function renderJSONEditor(){"
    "ec.innerHTML='';"
    "if(Array.isArray(jsonData)){"
    "var wrap=document.createElement('div');wrap.className='edwrap';"
    "jsonData.forEach(function(obj,oi){"
    "var card=document.createElement('div');card.className='jcard';"
    "var hdr=document.createElement('div');hdr.className='jcard-hdr';"
    "var sp=document.createElement('span');sp.textContent='Item '+(oi+1);"
    "var db=document.createElement('button');db.type='button';db.className='del';db.textContent='\\u2715';"
    "db.onclick=(function(i){return function(){if(confirm('Delete item '+(i+1)+'?')){jsonData.splice(i,1);renderJSONEditor();}};})(oi);"
    "hdr.appendChild(sp);hdr.appendChild(db);card.appendChild(hdr);"
    "var grid=document.createElement('div');grid.className='jgrid';"
    "Object.keys(obj).forEach(function(k){"
    "var lbl=document.createElement('label');lbl.textContent=k;"
    "var inp=document.createElement('textarea');inp.rows=1;inp.value=String(obj[k]);"
    "inp.oninput=(function(i,key){return function(){jsonData[i][key]=this.value;};})(oi,k);"
    "lbl.appendChild(inp);grid.appendChild(lbl);});"
    "card.appendChild(grid);wrap.appendChild(card);});"
    "ec.appendChild(wrap);"
    "var ab=document.createElement('button');ab.type='button';ab.className='eadd';ab.textContent='+ Add item';"
    "ab.onclick=function(){"
    "var tmpl=jsonData.length>0?JSON.parse(JSON.stringify(jsonData[0])):{};"
    "Object.keys(tmpl).forEach(function(k){tmpl[k]='';}); jsonData.push(tmpl);renderJSONEditor();};"
    "ec.appendChild(ab);"
    "}else if(jsonData&&typeof jsonData==='object'){"
    "var grid=document.createElement('div');grid.className='jgrid';"
    "Object.keys(jsonData).forEach(function(k){"
    "var lbl=document.createElement('label');lbl.textContent=k;"
    "var inp=document.createElement('textarea');inp.rows=1;inp.value=String(jsonData[k]);"
    "inp.oninput=(function(key){return function(){jsonData[key]=this.value;};})(k);"
    "lbl.appendChild(inp);grid.appendChild(lbl);});"
    "ec.appendChild(grid);"
    "}else{ec.innerHTML='<p style=\"color:#888;font-size:.85em\">Cannot parse JSON. Use Raw tab.</p>';}}"

    "function serializeJSON(){return JSON.stringify(jsonData,null,2);}"

    "function renderTxtEditor(){"
    "ec.innerHTML='';"
    "var wrap=document.createElement('div');wrap.className='edwrap';"
    "txtLines.forEach(function(line,i){"
    "var div=document.createElement('div');div.className='tline';div.dataset.i=i;"
    "var ta=document.createElement('textarea');ta.rows=2;ta.value=line;"
    "ta.oninput=(function(idx){return function(){txtLines[idx]=this.value;};})(i);"
    "var btn=document.createElement('button');btn.type='button';btn.className='del';btn.textContent='\\u2715';"
    "btn.onclick=(function(idx){return function(){txtLines.splice(idx,1);renderTxtEditor();};})(i);"
    "div.appendChild(ta);div.appendChild(btn);wrap.appendChild(div);});"
    "ec.appendChild(wrap);"
    "var ab=document.createElement('button');ab.type='button';ab.className='eadd';ab.textContent='+ Add entry';"
    "ab.onclick=function(){txtLines.push('');renderTxtEditor();"
    "var tas=ec.querySelectorAll('.tline textarea');if(tas.length)tas[tas.length-1].focus();};"
    "ec.appendChild(ab);}"

    "function serializeTxt(){"
    "ec.querySelectorAll('.tline').forEach(function(div){"
    "var i=parseInt(div.dataset.i);"
    "var ta=div.querySelector('textarea');"
    "if(ta&&!isNaN(i))txtLines[i]=ta.value;});"
    "return txtLines.join('\\n');}"

    "function serialize(){"
    "if(mode==='csv')return serializeCSV();"
    "if(mode==='json')return serializeJSON();"
    "return serializeTxt();}"

    "function initEditor(txt){"
    "mode=detectMode();"
    "if(mode==='csv'){"
    "var rows=parseCSV(txt);"
    "if(KS&&KS.h){"
    "csvHeaders=KS.h;csvHasHdr=false;csvRows=rows;"
    "}else{"
    "csvHasHdr=rows.length>0&&looksLikeHdr(rows[0]);"
    "if(csvHasHdr){csvHeaders=rows[0];csvRows=rows.slice(1);}"
    "else{"
    "var mc=0;rows.forEach(function(r){if(r.length>mc)mc=r.length;});"
    "csvHeaders=[];for(var i=0;i<mc;i++)csvHeaders.push('Field '+(i+1));"
    "csvRows=rows;}}}"
    "else if(mode==='json'){"
    "try{jsonData=JSON.parse(txt);}catch(e){jsonData=null;mode='txt';}}"
    "if(mode==='txt')txtLines=txt.split('\\n');}"

    "function renderEditor(){"
    "if(mode==='csv')renderCSVEditor();"
    "else if(mode==='json')renderJSONEditor();"
    "else renderTxtEditor();}"

    "function switchTab(t){"
    "if(t===0){"
    "rawTa.value=serialize();"
    "rawDiv.style.display='';edDiv.style.display='none';"
    "document.getElementById('traw').classList.add('on');"
    "document.getElementById('ted').classList.remove('on');"
    "}else{"
    "initEditor(rawTa.value);"
    "rawDiv.style.display='none';edDiv.style.display='';"
    "document.getElementById('traw').classList.remove('on');"
    "document.getElementById('ted').classList.add('on');"
    "renderEditor();}}"

    "function preSave(){"
    "if(edDiv.style.display!=='none')rawTa.value=serialize();"
    "return true;}"

    "document.addEventListener('keydown',function(e){"
    "if((e.ctrlKey||e.metaKey)&&e.key==='s'){e.preventDefault();"
    "document.getElementById('ef').submit();}});"
    "</script></body></html>";
  server.send(200, "text/html; charset=utf-8", html);
}
void handleKBDownload() {
  if (!requireAuth()) return;
  if (!server.hasArg("file")) { server.sendHeader("Location","/"); server.send(303); return; }
  String fn = server.arg("file");
  if (!sdMounted || !SD_MMC.exists(String(KNOWLEDGE_DIR) + "/" + fn)) { server.send(404, "text/plain", "Not found"); return; }

  String filePin = kbFindRestrictingPin(fn);
  if (filePin.length() > 0 && (!server.hasArg("pw") || server.arg("pw") != filePin)) {
    server.sendHeader("Location", "/view?file=" + urlEncodeParam(fn));
    server.send(303);
    return;
  }

  String fnBase = fn;
  { int fnSlash = fnBase.lastIndexOf('/'); if (fnSlash >= 0) fnBase = fnBase.substring(fnSlash + 1); }

  if (kbDownloadEncrypted && !isCtrLogFile(fnBase)) {
    String path = String(KNOWLEDGE_DIR) + "/" + fn;
    File rf = SD_MMC.open(path, FILE_READ);
    if (rf) {
      size_t sz = rf.size();
      bool enc = false;
      if (sz >= (size_t)(ENCRYPT_MAGIC_LEN + AES_IV_LEN + 16)) {
        uint8_t mag[ENCRYPT_MAGIC_LEN]; rf.read(mag, ENCRYPT_MAGIC_LEN);
        enc = (memcmp(mag, ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN) == 0);
      }
      if (enc) {
        uint8_t* raw = (uint8_t*)ps_malloc(sz);
        if (raw) {
          rf.seek(0);
          size_t got = rf.read(raw, sz);
          rf.close();
          bool devGen = isDeviceGeneratedDownload(fn) || fn == AI_MEMORIES_FILE;
          String dlName = devGen ? withDeviceSuffix(fnBase) : fnBase;
          server.sendHeader("Content-Disposition", "attachment; filename=\"" + dlName + "\"");
          server.setContentLength(got);
          server.send(200, "application/octet-stream", "");
          WiFiClient client = server.client();
          size_t written = 0;
          while (written < got && client.connected()) {
            size_t step = (got - written > 1460) ? 1460 : (got - written);
            size_t w = client.write(raw + written, step);
            if (w == 0) break;
            written += w;
            yield();
          }
          free(raw);
          return;
        }
      }
      rf.close();
    }
  }

  String content;
  if (isCtrLogFile(fnBase)) {
    ChatLogReader r;
    if (r.open(String(KNOWLEDGE_DIR) + "/" + fn)) {
      size_t sz = r.size();
      if (sz > 0) {
        uint8_t* buf = (uint8_t*)ps_malloc(sz + 1);
        if (buf) {
          size_t got = r.read(buf, sz);
          buf[got] = 0;
          content = String((char*)buf);
          free(buf);
        }
      }
      r.close();
    }
  } else {
    content = readKnowledgeFile(String(KNOWLEDGE_DIR) + "/" + fn);
  }
  if (!isValidUtf8(content)) content = win1252ToUtf8(content);

  bool deviceGen = isDeviceGeneratedDownload(fn) || fn == AI_MEMORIES_FILE;
  String dlName = deviceGen ? withDeviceSuffix(fnBase) : fnBase;
  server.sendHeader("Content-Disposition", "attachment; filename=\"" + dlName + "\"");
  server.send(200, "text/plain", content);
}
