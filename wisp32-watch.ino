static bool aiRunToolCall(const char* name, JsonVariantConst args, String& result, bool headless = false, bool deferLog = false) {
  String argsPreview;
  serializeJson(args, argsPreview);
  Serial.print("[AI] tool call: "); Serial.print(name); Serial.print(" args="); Serial.println(argsPreview);

  if (!headless) {
  aiInsertOriginTag(name);
  if      (strcmp(name, "web_search")     == 0) aiToolLabel = "Web Search";
  else if (strcmp(name, "convert")        == 0) aiToolLabel = "Unit Convert";
  else if (strcmp(name, "number_convert") == 0) aiToolLabel = "Number Convert";
  else if (strcmp(name, "calculate")      == 0) aiToolLabel = "Calculate";
  else if (strcmp(name, "file_create")    == 0) aiToolLabel = "File Create";
  else if (strcmp(name, "file_open")      == 0) aiToolLabel = "File Open";
  else if (strcmp(name, "file_append")    == 0) aiToolLabel = "File Append";
  else if (strcmp(name, "remember")       == 0) aiToolLabel = "Remembering...";
  else if (strcmp(name, "forget")         == 0) aiToolLabel = "Forgetting...";
  else if (strcmp(name, "ask_file_question") == 0) aiToolLabel = "Reading File...";
  else if (strcmp(name, "deep_think")     == 0) aiToolLabel = "Deep Thinking...";
  else if (strcmp(name, "list_files")     == 0) aiToolLabel = "List Files";
  else if (strcmp(name, "list_tasks")     == 0) aiToolLabel = "List Tasks";
  else if (strcmp(name, "set_volume")     == 0) aiToolLabel = "Setting Volume";
  else if (strcmp(name, "set_brightness") == 0) aiToolLabel = "Setting Brightness";
  else if (strcmp(name, "set_alarm")      == 0) aiToolLabel = "Set Alarm";
  else if (strcmp(name, "cancel_alarms")  == 0) aiToolLabel = "Cancel Alarms";
  else if (strcmp(name, "list_alarms")    == 0) aiToolLabel = "List Alarms";
  else if (strcmp(name, "start_timer")    == 0) aiToolLabel = "Starting Timer";
  else if (strcmp(name, "stop_timer")     == 0) aiToolLabel = "Stopping Timer";
  else if (strcmp(name, "reset_timer")    == 0) aiToolLabel = "Resetting Timer";
  else if (strcmp(name, "delete_timer")   == 0) aiToolLabel = "Deleting Timer";
  else if (strcmp(name, "list_timers")    == 0) aiToolLabel = "List Timers";
  else if (strcmp(name, "recall_history") == 0) aiToolLabel = "Recalling History";
  else if (strcmp(name, "send_email")     == 0) aiToolLabel = "Sending Email...";
  else if (strcmp(name, "run_task")       == 0) aiToolLabel = "Running Task...";
  else                                           aiToolLabel = "Tool Call...";
    aiState = AI_TOOL_CALL;
    drawAiPage();
    if (displayOn) gfx->flush();
  }

  unsigned long toolStartMs = millis();

  if (strcmp(name, "web_search") == 0) {
    netToolHeapBefore = ESP.getFreeHeap();
    netToolActive = true;
    netToolStartCount++;
    strncpy(netToolLastLabel, "Web Search", sizeof(netToolLastLabel) - 1);
    netToolLastLabel[sizeof(netToolLastLabel) - 1] = '\0';
    result = aiToolWebSearch(String((const char*)(args["query"] | "")));
    netToolSramDeltaBytes = (long)netToolHeapBefore - (long)ESP.getFreeHeap();
    netToolActive = false;
    netToolEndCount++;
  } else if (strcmp(name, "convert") == 0) {
    result = aiToolConvert(args["value"] | 0.0, String((const char*)(args["from"] | "")), String((const char*)(args["to"] | "")));
  } else if (strcmp(name, "number_convert") == 0) {
    result = aiToolNumberConvert(String((const char*)(args["value"] | "")), String((const char*)(args["from_base"] | "")), String((const char*)(args["to_base"] | "")));
  } else if (strcmp(name, "calculate") == 0) {
    result = aiToolCalculate(String((const char*)(args["expression"] | "")));
  } else if (strcmp(name, "file_create") == 0) {
    result = aiToolFileCreate(String((const char*)(args["name"] | "")));
  } else if (strcmp(name, "file_open") == 0) {
    fileOpenHeapBefore = ESP.getFreeHeap();
    fileOpenStartCount++;
    result = aiToolFileOpen(String((const char*)(args["name"] | "")), String((const char*)(args["pin"] | "")));
    fileOpenSramDeltaBytes = (long)fileOpenHeapBefore - (long)ESP.getFreeHeap();
    fileOpenEndCount++;
  } else if (strcmp(name, "file_append") == 0) {
    result = aiToolFileAppend(String((const char*)(args["content"] | "")));
  } else if (strcmp(name, "remember") == 0) {
    result = aiToolRemember(String((const char*)(args["content"] | "")));
  } else if (strcmp(name, "forget") == 0) {
    result = aiToolForget(String((const char*)(args["what"] | "")));
  } else if (strcmp(name, "ask_file_question") == 0) {
    netToolHeapBefore = ESP.getFreeHeap();
    netToolActive = true;
    netToolStartCount++;
    strncpy(netToolLastLabel, "File Q&A", sizeof(netToolLastLabel) - 1);
    netToolLastLabel[sizeof(netToolLastLabel) - 1] = '\0';
    result = aiToolAskFileQuestion(String((const char*)(args["question"] | "")));
    netToolSramDeltaBytes = (long)netToolHeapBefore - (long)ESP.getFreeHeap();
    netToolActive = false;
    netToolEndCount++;
  } else if (strcmp(name, "deep_think") == 0) {
    result = aiToolDeepThink(String((const char*)(args["question"] | "")));
  } else if (strcmp(name, "list_files") == 0) {
    result = aiToolListFiles();
  } else if (strcmp(name, "list_tasks") == 0) {
    result = aiToolListTasks(String((const char*)(args["name"] | "")));
  } else if (strcmp(name, "set_volume") == 0) {
    result = aiToolSetVolume(args["percent"] | speakerVolume);
  } else if (strcmp(name, "set_brightness") == 0) {
    result = aiToolSetBrightness(args["percent"] | screenBrightness);
  } else if (strcmp(name, "set_alarm") == 0) {
    result = aiToolSetAlarm(String((const char*)(args["name"] | "")), args["secondsFromNow"] | 0, String((const char*)(args["time"] | "")));
  } else if (strcmp(name, "cancel_alarms") == 0) {
    result = aiToolCancelAlarms(String((const char*)(args["time"] | "")), String((const char*)(args["name"] | "")));
  } else if (strcmp(name, "list_alarms") == 0) {
    result = aiToolListAlarms();
  } else if (strcmp(name, "start_timer") == 0) {
    result = aiToolStartTimer(String((const char*)(args["name"] | "")));
  } else if (strcmp(name, "stop_timer") == 0) {
    result = aiToolStopTimer(String((const char*)(args["name"] | "")));
  } else if (strcmp(name, "reset_timer") == 0) {
    result = aiToolResetTimer(String((const char*)(args["name"] | "")));
  } else if (strcmp(name, "delete_timer") == 0) {
    result = aiToolDeleteTimer(String((const char*)(args["name"] | "")));
  } else if (strcmp(name, "list_timers") == 0) {
    result = aiToolListTimers();
  } else if (strcmp(name, "recall_history") == 0) {
    result = aiToolRecallHistory(args["count"] | AI_RECALL_HISTORY_MAX);
  } else if (strcmp(name, "send_email") == 0) {
    result = aiToolSendEmail(String((const char*)(args["to"] | "")),
                              String((const char*)(args["subject"] | "")),
                              String((const char*)(args["body"] | "")),
                              String((const char*)(args["attachments"] | "")),
                              headless);
  } else if (strcmp(name, "run_task") == 0) {
    result = aiToolRunTask(String((const char*)(args["name"] | "")));
  } else {
    return false;
  }

  unsigned long toolDurationMs = millis() - toolStartMs;
  if (!deferLog) logToolCallEvent(headless ? "task" : "live", name, toolDurationMs, argsPreview, result);

  Serial.print("[AI] tool result: "); Serial.println(result);
  if (!headless) {
    String histLabel = aiToolLabel;
    if (strcmp(name, "ask_file_question") == 0 && largeFileName.length() > 0) {
      histLabel += " (" + largeFileName + ")";
    }
    logAiToolCall(histLabel, result);
  }

  const char* logLabel = nullptr;
  String logQuery, logModelName;
  if (strcmp(name, "web_search") == 0) {
    logLabel = "Web Search";
    logQuery = String((const char*)(args["query"] | ""));
    logModelName = activeWebSearchModel;
  } else if (strcmp(name, "ask_file_question") == 0) {
    logLabel = "File Q&A";
    logQuery = String((const char*)(args["question"] | ""));
    logModelName = activeFileQaModel;
  } else if (strcmp(name, "deep_think") == 0) {
    logLabel = "Deep Think";
    logQuery = String((const char*)(args["question"] | ""));
    logModelName = activeDeepThinkModel;
  } else if (strcmp(name, "run_task") == 0) {
    logLabel = "Run Task";
    logQuery = String((const char*)(args["name"] | ""));
    logModelName = "(task's own model)";
  } else if (strcmp(name, "calculate") == 0) {
    logLabel = "Calculate";
    logQuery = String((const char*)(args["expression"] | ""));
  } else if (strcmp(name, "convert") == 0) {
    logLabel = "Unit Convert";
    logQuery = String(args["value"] | 0.0) + " " + String((const char*)(args["from"] | "")) + " to " + String((const char*)(args["to"] | ""));
  } else if (strcmp(name, "number_convert") == 0) {
    logLabel = "Number Convert";
    logQuery = String((const char*)(args["value"] | "")) + " (" + String((const char*)(args["from_base"] | "")) + " to " + String((const char*)(args["to_base"] | "")) + ")";
  } else if (strcmp(name, "list_files") == 0) {
    logLabel = "List Files";
  } else if (strcmp(name, "file_open") == 0) {
    logLabel = "File Open";
    logQuery = String((const char*)(args["name"] | ""));
  }
  if (!headless && saveHistoryMode >= SAVE_TEXT && logLabel) {
    aiToolCallLog += "\n\n<em>Tool : " + String(logLabel)
                    + (logModelName.length() ? ("\n\nModel : " + logModelName) : String(""))
                    + (logQuery.length() ? ("\n\nQuery : " + logQuery) : String(""))
                    + "\n\nResponse : " + result + "</em>\n";
  }
  return true;
}

void aiWebSearchTaskFn(void* pv) {
  if (_netMutex) xSemaphoreTake(_netMutex, portMAX_DELAY);
