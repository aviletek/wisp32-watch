static void wispTrace(const String& msg) {
  if (!wispTraceEnabled || !sdMounted) return;
  if (!_sdMutex || xSemaphoreTake(_sdMutex, pdMS_TO_TICKS(20)) != pdTRUE) return;
  File f = SD_MMC.open(WISP_TRACE_PATH, FILE_APPEND);
  if (f) {
    f.print("[" + String(millis()) + "] " + msg + "\n");
    f.flush();
    f.close();
  }
  xSemaphoreGive(_sdMutex);
}
