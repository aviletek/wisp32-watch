static void parseTranslatorLangsList() {
  translatorIncludedCount = 0;
  String s = activeTranslatorLangsList;
  int start = 0;
  while (start < (int)s.length() && translatorIncludedCount < TRANSLATOR_INCLUDED_MAX) {
    int comma = s.indexOf(',', start);
    String tok = (comma < 0) ? s.substring(start) : s.substring(start, comma);
    tok.trim();
    tok.toLowerCase();
    if (tok.length() > 0) {
      for (size_t i = 0; i < TRANSLATOR_LANG_COUNT; i++) {
        if (tok == TRANSLATOR_LANGS[i].code) { translatorIncludedIdx[translatorIncludedCount++] = (int)i; break; }
      }
    }
    start = (comma < 0) ? (int)s.length() : comma + 1;
  }
  if (translatorIncludedCount == 0) {
    for (size_t i = 0; i < TRANSLATOR_LANG_COUNT; i++) translatorIncludedIdx[i] = (int)i;
    translatorIncludedCount = (int)TRANSLATOR_LANG_COUNT;
    for (int i = 1; i < translatorIncludedCount; i++) {
      int key = translatorIncludedIdx[i];
      int j = i - 1;
      while (j >= 0 && naturalCompareCI(TRANSLATOR_LANGS[translatorIncludedIdx[j]].name, TRANSLATOR_LANGS[key].name) > 0) {
        translatorIncludedIdx[j + 1] = translatorIncludedIdx[j];
        j--;
      }
      translatorIncludedIdx[j + 1] = key;
    }
  }
}

