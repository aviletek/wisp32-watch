class Arduino_Canvas_PSRAM : public Arduino_Canvas {
 public:
  Arduino_Canvas_PSRAM(int16_t w, int16_t h, Arduino_G *output, int16_t output_x = 0, int16_t output_y = 0, uint8_t rotation = 0)
    : Arduino_Canvas(w, h, output, output_x, output_y, rotation) {}
  bool begin(int32_t speed = GFX_NOT_DEFINED) override {
    if (!_framebuffer) {
      size_t s = (size_t)_width * (size_t)_height * 2;
      _framebuffer = (uint16_t*)ps_malloc(s);
      if (!_framebuffer) return false;
    }
    if (speed != GFX_SKIP_OUTPUT_BEGIN && _output) {
      if (!_output->begin(speed)) return false;
    }
    return true;
  }
};

