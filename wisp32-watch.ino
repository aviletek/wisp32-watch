}

void sleepDisplay() {
  if (!displayOn) return;
  Serial.println("[Display] sleeping");
  gfxPanel->displayOff();
  digitalWrite(AMOLED_PWR_EN, LOW);
  displayOn = false;
  emailNoticeActive = false;
  deviceLockedMsgActive = false;
  qrPageOpen = false;
  if (noteRecordPageOpen && noteState == NOTE_RECORDING) return;
  if (translatorPageOpen && aiListening) return;
  micParkForPage();
}

void wakeDisplay() {
  if (displayOn) return;
  Serial.println("[Display] waking");
  digitalWrite(AMOLED_PWR_EN, HIGH);
  delay(10);

  if (aiPageOpen || translatorPageOpen) micResumeForPage();

  if (devicePinPageOpen)    drawDevicePinPage();
  else if (settingsPageOpen)     drawSettingsPage();
  else if (aiPageOpen)      { if (aiToolHistoryOpen) drawAiToolHistoryPage(); else drawAiPage(); }
  else if (noteRecordPageOpen) drawNoteRecordPage();
  else if (translatorPageOpen) drawTranslatorPage();
  else if (!sdMounted)      drawSdCardMissingScreen();
  else if (wifiSetupMandatory) drawWifiSetupMandatoryScreen();
  else                    drawClockScreen();

  gfx->flush();
  gfxPanel->displayOn();
  displayOn = true;
  lastActivityTime = millis();
}

#define QR_MAX_VERSION 17
static uint8_t* qrTempBuf = nullptr;
static uint8_t* qrCodeBuf = nullptr;
bool allocQrBuffersInPsram() {
  qrTempBuf = (uint8_t*)ps_malloc(qrcodegen_BUFFER_LEN_FOR_VERSION(QR_MAX_VERSION));
  qrCodeBuf = (uint8_t*)ps_malloc(qrcodegen_BUFFER_LEN_FOR_VERSION(QR_MAX_VERSION));
  return qrTempBuf && qrCodeBuf;
}

#define QR_ENTRY_MAX 25
#define QR_ENTRIES_FILE "/qrcodes.txt"
struct QrEntry { char label[51]; char content[501]; };
static QrEntry* qrEntries = nullptr;
static int qrEntryCount = 0;
bool allocQrEntriesInPsram() {
  qrEntries = (QrEntry*)ps_malloc(sizeof(QrEntry) * QR_ENTRY_MAX);
  if (!qrEntries) return false;
  for (int i = 0; i < QR_ENTRY_MAX; i++) new (&qrEntries[i]) QrEntry();
  return true;
}

void loadQrEntries() {
  qrEntryCount = 0;
  if (!qrEntries) return;
  if (!sdMounted || !SD_MMC.exists(QR_ENTRIES_FILE)) return;
  File f = SD_MMC.open(QR_ENTRIES_FILE, FILE_READ);
  if (!f) return;
  while (f.available() && qrEntryCount < QR_ENTRY_MAX) {
    String line = f.readStringUntil('\n');
    line.trim();
    if (line.length() == 0) continue;
    int p1 = line.indexOf('|');
    if (p1 < 0) continue;
    line.substring(0, p1).toCharArray(qrEntries[qrEntryCount].label, sizeof(qrEntries[qrEntryCount].label));
    String content = line.substring(p1 + 1);
    content.replace("\x1E", "\n");
    content.toCharArray(qrEntries[qrEntryCount].content, sizeof(qrEntries[qrEntryCount].content));
    qrEntryCount++;
  }
  f.close();
}

static bool saveQrEntries() {
  if (!sdMounted) return false;
  File f = SD_MMC.open(QR_ENTRIES_FILE, "w");
  if (!f) return false;
  for (int i = 0; i < qrEntryCount; i++) {
    String escapedContent = qrEntries[i].content;
    escapedContent.replace("\n", "\x1E");
    f.print(qrEntries[i].label);
    f.print("|");
    f.println(escapedContent);
  }
  f.close();
  return true;
}

static String qrTitleText = "";
static int qrTitleTextWidth = 0;
static int qrTitleScrollX = 0;
static bool qrTitleScrolls = false;
static int qrTitleScrollPasses = 0;
#define QR_TITLE_MAX_PASSES 3
#define QR_TITLE_MARGIN_PX 20

static void drawQrTitleFrame() {
  gfx->fillRect(0, 50, SCREEN_WIDTH, 50, COLOR_BLACK);
  gfx->setTextSize(4);
  gfx->setTextWrap(false);
  gfx->setTextColor(COLOR_WHITE, COLOR_BLACK);
  int x = qrTitleScrolls ? qrTitleScrollX : (SCREEN_WIDTH - qrTitleTextWidth) / 2;
  gfx->setCursor(x, 60);
  gfx->print(qrTitleText);
}

void qrTickTitleMarquee() {
  if (qrTitleScrollPasses >= QR_TITLE_MAX_PASSES) return;
  qrTitleScrollX -= 4;
  if (qrTitleScrollX + qrTitleTextWidth <= SCREEN_WIDTH - QR_TITLE_MARGIN_PX) {
    qrTitleScrollX = QR_TITLE_MARGIN_PX;
    qrTitleScrollPasses++;
  }
  drawQrTitleFrame();
}

void drawQrPage() {
  if (qrPageIndex < 0 || qrPageIndex > qrEntryCount) qrPageIndex = 0;

  gfx->fillScreen(COLOR_BLACK);
  String title = (qrPageIndex == 0) ? "Web Server" : qrEntries[qrPageIndex - 1].label;
  gfx->setTextSize(4);
  int16_t tbx, tby; uint16_t tbw, tbh;
  gfx->getTextBounds(title.c_str(), 0, 0, &tbx, &tby, &tbw, &tbh);
  qrTitleText = title;
  qrTitleTextWidth = (int)tbw;
  qrTitleScrolls = qrTitleTextWidth > (SCREEN_WIDTH - 2 * QR_TITLE_MARGIN_PX);
  qrTitleScrollX = QR_TITLE_MARGIN_PX;
  qrTitleScrollPasses = 0;
  drawQrTitleFrame();
  if (!qrTempBuf || !qrCodeBuf) {
    _clockCenterPrint("QR unavailable", SCREEN_HEIGHT / 2, 2, COLOR_GRAY);
    return;
  }
  String content;
  if (qrPageIndex == 0) {
    if (WiFi.status() != WL_CONNECTED) {
      _clockCenterPrint("Not connected", SCREEN_HEIGHT / 2, 3, COLOR_GRAY);
      return;
    }
    content = "http://" + WiFi.localIP().toString() + "/";
  } else {
    content = qrEntries[qrPageIndex - 1].content;
  }
  bool ok = qrcodegen_encodeText(content.c_str(), qrTempBuf, qrCodeBuf,
                                 qrcodegen_Ecc_MEDIUM, qrcodegen_VERSION_MIN, QR_MAX_VERSION,
                                 qrcodegen_Mask_AUTO, true);
  if (!ok) {
    _clockCenterPrint("QR generation failed", SCREEN_HEIGHT / 2, 2, COLOR_GRAY);
    return;
  }
  int size = qrcodegen_getSize(qrCodeBuf);
  int avail = (SCREEN_WIDTH - 60) * 81 / 100;
  int moduleSize = avail / size;
  if (moduleSize < 1) moduleSize = 1;
  int qrPixels = moduleSize * size;
  int titleClearance = 110;
  int y0 = titleClearance + (SCREEN_HEIGHT - titleClearance - qrPixels) / 2 - 50;
  moduleSize = (avail * 11 + size * 10 - 1) / (size * 10);
  if (moduleSize < 1) moduleSize = 1;
  qrPixels = moduleSize * size;
  int x0 = (SCREEN_WIDTH - qrPixels) / 2;
  for (int y = 0; y < size; y++) {
    for (int x = 0; x < size; x++) {
      if (qrcodegen_getModule(qrCodeBuf, x, y)) {
        gfx->fillRect(x0 + x * moduleSize, y0 + y * moduleSize, moduleSize, moduleSize, COLOR_BLUE);
      }
    }
  }
}

void openQrPage() {
  qrPageOpen = true;
  qrPageIndex = 0;
  lastActivityTime = millis();
  drawQrPage();
}

