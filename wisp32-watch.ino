void handleKBRename() {
  if (!requireAuth()) return;
  if (!server.hasArg("old") || !server.hasArg("new")) {
    server.send(400,"application/json","{\"ok\":false,\"err\":\"params\"}"); return;
  }
  String oldName = server.arg("old");
  String newBase = server.arg("new");
  if (!isKnowledgeFile(newBase)) {
    int dot = oldName.lastIndexOf('.');
    newBase += (dot > 0 ? oldName.substring(dot) : String(".txt"));
  }
  int ls = oldName.lastIndexOf('/');
  String dirPrefix = (ls >= 0) ? oldName.substring(0, ls + 1) : "";
  String newName = dirPrefix + newBase;
  String oldPath = String(KNOWLEDGE_DIR)+"/"+oldName;
  String newPath = String(KNOWLEDGE_DIR)+"/"+newName;
  if (!SD_MMC.exists(oldPath)) { server.send(404,"application/json","{\"ok\":false,\"err\":\"not found\"}"); return; }
  bool samePathIgnoreCase = newPath.equalsIgnoreCase(oldPath);
  if (!samePathIgnoreCase && SD_MMC.exists(newPath)) { server.send(409,"application/json","{\"ok\":false,\"err\":\"name exists\"}"); return; }
  String content = readKnowledgeFile(oldPath);
  writeKnowledgeFile(newPath, content);
  if (!samePathIgnoreCase) {
    SD_MMC.remove(oldPath);
    String oldPw = oldPath + ".pwd";
    if (SD_MMC.exists(oldPw)) SD_MMC.rename(oldPw, newPath + ".pwd");
    {
      String kbPrefix = String(KNOWLEDGE_DIR) + "/";
      String oldRef = oldPath.startsWith(kbPrefix) ? oldPath.substring(kbPrefix.length()) : oldPath;
      String newRef = newPath.startsWith(kbPrefix) ? newPath.substring(kbPrefix.length()) : newPath;
      bool aiListed = true; String aiDesc;
      kbAiMetaGet(oldRef, &aiListed, &aiDesc);
      String aiInstr = kbAiMetaGetInstructions(oldRef);
      if (!aiListed || aiDesc.length() > 0 || aiInstr.length() > 0) {
        kbAiMetaSetIndex(newRef, aiListed, aiDesc);
        if (aiInstr.length() > 0) kbAiMetaSetInstructions(newRef, aiInstr);
      }
      kbAiMetaForget(oldRef);
    }
    kbSyncRename(oldName, newName);
  }
  reloadKnowledge();
  server.send(200,"application/json","{\"ok\":true,\"name\":\""+newName+"\"}");
}

