#define VOLUME_CURVE_FLOOR_REG 141
int speakerVolumeCurve(int pct) {
  if (pct <= 0) return 0;
  if (pct > 100) pct = 100;
  int targetReg = VOLUME_CURVE_FLOOR_REG + ((255 - VOLUME_CURVE_FLOOR_REG) * pct) / 100;
  if (targetReg > 255) targetReg = 255;
  int vEff = ((targetReg + 1) * 100) / 256;
  if (vEff < 1) vEff = 1;
  if (vEff > 100) vEff = 100;
  return vEff;
}

