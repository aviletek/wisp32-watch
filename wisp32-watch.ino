void handleDelete() {
  if (!requireAuth()) return;
  bool ok = true;
  String err = "";
  if (server.hasArg("file") && !server.arg("file").endsWith(".pwd")) {
    String fn = server.arg("file");
    String requiredPin = kbFindRestrictingPin(fn);
    String submittedPin = server.hasArg("pin") ? server.arg("pin") : "";
    if (requiredPin.length() > 0 && submittedPin != requiredPin) {
      ok = false;
      err = "Wrong PIN";
    } else {
      SD_MMC.remove(String(KNOWLEDGE_DIR)+"/"+fn);
      String pwPath = String(KNOWLEDGE_DIR)+"/"+fn+".pwd";
      if (SD_MMC.exists(pwPath)) SD_MMC.remove(pwPath);
      kbAiMetaForget(fn);
      kbSyncRemove(fn);
      reloadKnowledge();
    }
  }
  if (server.hasArg("json")) {
    server.send(ok ? 200 : 403, "application/json",
      ok ? "{\"ok\":true}" : "{\"ok\":false,\"err\":\"" + err + "\"}");
    return;
  }
  server.sendHeader("Location","/"); server.send(303);
}
void handleReload() {
  if (!requireAuth()) return;
  reloadKnowledge(); server.sendHeader("Location","/"); server.send(303);
}
void handleView() {
