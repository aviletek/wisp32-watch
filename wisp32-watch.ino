void drawInfinityIcon(int rightEdgeX, int centerY, uint16_t color) {
  const float a = 19.0f;
  const int STEPS = 72;
  int centerX = rightEdgeX - (int)a;

  int prevX = 0, prevY = 0;
  for (int i = 0; i <= STEPS; i++) {
    float t = (float)i / STEPS * 2.0f * PI;
    float s = sin(t), c = cos(t);
    float denom = 1.0f + s * s;
    int x = centerX + (int)roundf(a * c / denom);
    int y = centerY + (int)roundf(a * s * c / denom);
    if (i > 0) {
      gfx->drawLine(prevX, prevY, x, y, color);
      gfx->drawLine(prevX, prevY + 1, x, y + 1, color);
    }
    prevX = x;
    prevY = y;
  }
}

