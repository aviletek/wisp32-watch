static String appendCurrentTimeIfEnabled(String prompt, bool enabled) {
  if (!enabled) return prompt;
  struct tm ti;
  if (getLocalTime(&ti)) {
    char buf[40]; strftime(buf, sizeof(buf), "%A %B %d %Y, %H:%M", &ti);
    prompt += "\n\nCurrent date and time: " + String(buf);
  }
  return prompt;
}
