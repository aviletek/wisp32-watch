void handleSaveTools() {
  if (!requireAuth()) return;
  for (size_t i = 0; i < AI_TOOL_DESC_COUNT && activeToolDescs; i++) {
    String nm = AI_TOOL_DESCS[i].name;
    if (!server.hasArg(nm)) continue;
    String v = server.arg(nm);
    v.trim();
    if (v.length() == 0 || v == String(AI_TOOL_DESCS[i].defaultDesc)) {
      activeToolDescs[i] = AI_TOOL_DESCS[i].defaultDesc;
      if (sdMounted && SD_MMC.exists(AI_TOOL_DESCS[i].file)) SD_MMC.remove(AI_TOOL_DESCS[i].file);
    } else {
      activeToolDescs[i] = v;
      if (sdMounted) writeKnowledgeFile(AI_TOOL_DESCS[i].file, v);
    }
  }

  String disabled = "";
  for (size_t i = 0; i < AI_TOOL_DESC_COUNT; i++) {
    String nm = AI_TOOL_DESCS[i].name;
    if (!server.hasArg("en_" + nm)) {
      if (disabled.length() > 0) disabled += ",";
      disabled += nm;
    }
  }
  if (toolListHas(disabled, "file_open") && !toolListHas(disabled, "ask_file_question")) {
    disabled += ",ask_file_question";
  }
  if (toolListHas(disabled, "remember") && !toolListHas(disabled, "forget")) {
    disabled += ",forget";
  }
  toolsDisabledList = disabled;
  saveSettings();

  redirectWithSaveMessage("/tools", "Saved");
}

