}

void fileDecryptTaskFn(void* pv) {
  String fn = fileDecryptTargetRef;
  String srcPath = String(FILES_DIR) + "/" + fn;
  String tmpPath = srcPath + "_dtmp";
  bool ok = true;
  String errMsg = "";
  size_t fileSize = 0;

  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  File src = SD_MMC.open(srcPath, FILE_READ);
  if (_sdMutex) xSemaphoreGive(_sdMutex);
  if (!src) { ok = false; errMsg = "Cannot open file"; }
  if (ok) { fileSize = src.size(); fileDecryptBytesTotal = fileSize; }

  uint8_t iv[AES_IV_LEN];
  size_t origSize = 0;
  File dst;
  if (ok) {
    if (fileSize < (size_t)(ENCRYPT_MAGIC_LEN + AES_IV_LEN + 16)) { ok = false; errMsg = "File is not encrypted"; }
  }
  if (ok) {
    uint8_t mag[ENCRYPT_MAGIC_LEN];
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    src.read(mag, ENCRYPT_MAGIC_LEN);
    if (memcmp(mag, ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN) == 0) src.read(iv, AES_IV_LEN);
    if (_sdMutex) xSemaphoreGive(_sdMutex);
    if (memcmp(mag, ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN) != 0) { ok = false; errMsg = "File is not encrypted"; }
  }
  if (ok) {
    origSize = getStoredFileOrigSize(fn);
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    SD_MMC.remove(tmpPath);
    dst = SD_MMC.open(tmpPath, FILE_WRITE);
    if (_sdMutex) xSemaphoreGive(_sdMutex);
    if (!dst) { ok = false; errMsg = "Cannot create temp file"; }
  }

  if (ok) {
    mbedtls_aes_context aes; mbedtls_aes_init(&aes);
    mbedtls_aes_setkey_dec(&aes, activeAesKey, 256);

    const size_t CHUNK = 4096;
    uint8_t* encBuf = (uint8_t*)ps_malloc(CHUNK);
    uint8_t* decBuf = (uint8_t*)ps_malloc(CHUNK);
    if (!encBuf || !decBuf) { ok = false; errMsg = "Out of memory"; }

    if (ok) {
      uint8_t curIV[AES_IV_LEN]; memcpy(curIV, iv, AES_IV_LEN);
      size_t encRemaining = fileSize - ENCRYPT_MAGIC_LEN - AES_IV_LEN;
      size_t totalWritten = 0;
      while (encRemaining > 0) {
        size_t toRead = min(encRemaining, CHUNK);
        toRead = (toRead / 16) * 16;
        if (toRead == 0) break;
        if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
        size_t didRead = src.read(encBuf, toRead);
        if (_sdMutex) xSemaphoreGive(_sdMutex);
        if (didRead == 0) break;
        didRead = (didRead / 16) * 16;
        for (size_t blk = 0; blk < didRead; blk += 16) {
          uint8_t* eb = encBuf + blk; uint8_t* db = decBuf + blk;
          mbedtls_aes_crypt_ecb(&aes, MBEDTLS_AES_DECRYPT, eb, db);
          for (int i = 0; i < 16; i++) db[i] ^= curIV[i];
          memcpy(curIV, eb, 16);
        }
        encRemaining -= didRead;
        size_t toWrite = didRead;
        if (encRemaining == 0) {
          uint8_t padByte = decBuf[didRead - 1];
          if (padByte >= 1 && padByte <= 16) toWrite = didRead - padByte;
        }
        if (origSize > 0 && totalWritten + toWrite > origSize) toWrite = origSize - totalWritten;
        if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
        dst.write(decBuf, toWrite);
        if (_sdMutex) xSemaphoreGive(_sdMutex);
        totalWritten += toWrite;
        fileDecryptBytesDone = fileSize - encRemaining;
        vTaskDelay(1);
      }
    }
    free(encBuf); free(decBuf);
    mbedtls_aes_free(&aes);
  }

  if (src) {
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    src.close();
    if (_sdMutex) xSemaphoreGive(_sdMutex);
  }
  if (dst) {
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    dst.close();
    if (_sdMutex) xSemaphoreGive(_sdMutex);
  }

  if (!ok) {
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    SD_MMC.remove(tmpPath);
    if (_sdMutex) xSemaphoreGive(_sdMutex);
  } else {
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    SD_MMC.remove(srcPath);
    SD_MMC.rename(tmpPath, srcPath);
    SD_MMC.remove(srcPath + ".meta");
    if (_sdMutex) xSemaphoreGive(_sdMutex);
  }

  fileDecryptBytesDone = fileDecryptBytesTotal;
  fileDecryptFailed = !ok;
  if (!ok) fileDecryptFailedAcked = false;
  fileDecryptErrorMsg = errMsg;
  fileDecryptActive = false;
  fileDecryptTaskHandle = nullptr;
  vTaskDelete(NULL);
}

