static bool settingsEditAllowed() {
  if (activeDeviceLockPin.length() == 0) return true;
  if (settingsEditUnlocked) return true;
  openDevicePinPage(DEVICE_PIN_TARGET_SETTINGS_EDIT);
  return false;
}

void openDevicePinPage(int target) {
  devicePinTarget = target;
  pinLastDigitMs = 0;
  pinSuccessAtMs = 0;
  devicePinPageOpen = true;
  devicePinEntry = "";
  devicePinWrongAttempts = 0;
  drawDevicePinPage();
}

void closeDevicePinPage() {
  devicePinPageOpen = false;
  pinLastDigitMs = 0;
  pinSuccessAtMs = 0;
  devicePinEntry = "";
  devicePinTarget = DEVICE_PIN_TARGET_NONE;
  pinFlashRow = PIN_FLASH_NONE;
}

void drawPinDots() {
  int pinLen = activeDeviceLockPin.length();
  int dotGap = 34;
  int startX = (SCREEN_WIDTH - (pinLen - 1) * dotGap) / 2;
  int dotY = 155;
  int dotR = 10;
  int revealIdx = -1;
  if (devicePinEntry.length() > 0 && pinLastDigitMs != 0
      && millis() - pinLastDigitMs < PIN_DIGIT_REVEAL_MS) {
    revealIdx = (int)devicePinEntry.length() - 1;
  }
  gfx->fillRect(0, dotY - dotR - 12, SCREEN_WIDTH, (dotR + 12) * 2, COLOR_BLACK);
  for (int i = 0; i < pinLen; i++) {
    int cx = startX + i * dotGap;
    if (i == revealIdx) {
      char d[2] = { devicePinEntry.charAt(i), 0 };
      gfx->setTextSize(3);
      gfx->setTextColor(COLOR_BLUE, COLOR_BLACK);
      gfx->setCursor(cx - 8, dotY - 10);
      gfx->print(d);
    } else if (i < (int)devicePinEntry.length()) {
      gfx->fillCircle(cx, dotY, dotR, COLOR_BLUE);
    } else {
      gfx->drawCircle(cx, dotY, dotR, COLOR_GRAY);
    }
  }
}

static bool pinDigitMetricsCached = false;
static int16_t pinDigitBX = 0, pinDigitBY = 0;
static uint16_t pinDigitBW = 0, pinDigitBH = 0;
static bool pinBackspaceMetricsCached = false;
static int16_t pinBackspaceBX = 0, pinBackspaceBY = 0;
static uint16_t pinBackspaceBW = 0, pinBackspaceBH = 0;

void drawPinBackspace(uint16_t bgColor, uint16_t textColor) {
  gfx->fillRect(PIN_BACKSPACE_X0, PIN_BACKSPACE_Y0,
                PIN_BACKSPACE_X1 - PIN_BACKSPACE_X0, PIN_BACKSPACE_Y1 - PIN_BACKSPACE_Y0, bgColor);
  gfx->setTextSize(4);
  if (!pinBackspaceMetricsCached) {
    gfx->getTextBounds("<", 0, 0, &pinBackspaceBX, &pinBackspaceBY, &pinBackspaceBW, &pinBackspaceBH);
    pinBackspaceMetricsCached = true;
  }
  gfx->setTextColor(textColor, bgColor);
  int zoneCenterX = PIN_BACKSPACE_X0 + (PIN_BACKSPACE_X1 - PIN_BACKSPACE_X0) / 2;
  int zoneCenterY = PIN_BACKSPACE_Y0 + (PIN_BACKSPACE_Y1 - PIN_BACKSPACE_Y0) / 2;
  gfx->setCursor(zoneCenterX - pinBackspaceBX - (int)pinBackspaceBW / 2, zoneCenterY - pinBackspaceBY - (int)pinBackspaceBH / 2);
  gfx->print("<");
}

void drawPinKeypadCell(int row, int col, uint16_t bgColor, uint16_t textColor) {
  int cellX0 = col * PIN_KEYPAD_COL_W;
  int cellY0 = PIN_KEYPAD_Y0 + row * PIN_KEYPAD_ROW_H;
  const char* label = PIN_KEYPAD_LABELS[row][col];
  if (label[0] == '\0') return;
  gfx->setTextSize(4);
  if (!pinDigitMetricsCached) {
    gfx->getTextBounds("0", 0, 0, &pinDigitBX, &pinDigitBY, &pinDigitBW, &pinDigitBH);
    pinDigitMetricsCached = true;
  }
  gfx->setTextColor(textColor, bgColor);
  gfx->setCursor(cellX0 + (PIN_KEYPAD_COL_W - (int)pinDigitBW) / 2, cellY0 + (PIN_KEYPAD_ROW_H + (int)pinDigitBH) / 2);
  gfx->print(label);
}

void revertPinFlashIfPending() {
  if (pinFlashRow == PIN_FLASH_NONE) return;
  if (pinFlashRow == PIN_FLASH_BACKSPACE) drawPinBackspace(COLOR_BLACK, COLOR_WHITE);
  else                                    drawPinKeypadCell(pinFlashRow, pinFlashCol, COLOR_BLACK, COLOR_WHITE);
  pinFlashRow = PIN_FLASH_NONE;
}

void drawDevicePinPage() {
  bool lockedOut = millis() < devicePinLockedUntilMs;
  if (!lockedOut && devicePinLockedUntilMs != 0) {
    devicePinLockedUntilMs = 0;
    devicePinWrongAttempts = 0;
  }
  pinFlashRow = PIN_FLASH_NONE;

  gfx->fillScreen(COLOR_BLACK);
  _clockCenterPrint(TR(UISTR_ENTER_PIN), 60, 4, COLOR_WHITE);
  gfx->drawLine(30, 110, SCREEN_WIDTH - 30, 110, CLK_SEP_COLOR);

  drawPinDots();
  drawPinBackspace(COLOR_BLACK, lockedOut ? COLOR_GRAY : COLOR_WHITE);

  if (lockedOut) {
    unsigned long msLeft = devicePinLockedUntilMs - millis();
    int secsLeft = (int)((msLeft + 999) / 1000);
    String msg = "Try again in " + String(secsLeft) + "s";
    _clockCenterPrint(msg.c_str(), 195, 2, COLOR_BLUE);
  } else if (devicePinWrongAttempts > 0) {
    String msg = "Wrong PIN, " + String(DEVICE_PIN_MAX_ATTEMPTS - devicePinWrongAttempts) + " left";
    _clockCenterPrint(msg.c_str(), 195, 2, COLOR_BLUE);
  }

  for (int r = 0; r < PIN_KEYPAD_ROWS; r++) {
    for (int c = 0; c < PIN_KEYPAD_COLS; c++) {
      if (PIN_KEYPAD_LABELS[r][c][0] == '\0') continue;
      drawPinKeypadCell(r, c, COLOR_BLACK, lockedOut ? COLOR_GRAY : COLOR_WHITE);
    }
  }
}

static void pinApplySuccess(int target) {
    if (target == DEVICE_PIN_TARGET_NONE) {
      Serial.println("[DeviceLock] PIN correct, turning Device Lock off");
      deviceLockOn = false;
      saveSettings();
      drawSettingsPage();
    } else {
      if (target == DEVICE_PIN_TARGET_SETTINGS_EDIT) {
        Serial.println("[DeviceLock] PIN correct, settings editing unlocked for this visit");
        settingsEditUnlocked = true;
        if (noteRecordPageOpen) drawNoteRecordPage();
        else                    drawSettingsPage();
        return;
      }
      Serial.println("[DeviceLock] PIN correct, one-time access granted");
      switch (target) {
        case DEVICE_PIN_TARGET_AI:         openAiPage(); break;
        case DEVICE_PIN_TARGET_TRANSLATOR: openTranslatorPage(); break;
        case DEVICE_PIN_TARGET_NOTES:      openNoteRecordPage(); break;
        case DEVICE_PIN_TARGET_QR:         openQrPage(); break;
        default: drawClockScreen(); break;
      }
    }
}

void handleDevicePinTouch(int32_t tx, int32_t ty) {
  if (pinSuccessAtMs != 0) return;
  if (millis() < devicePinLockedUntilMs) return;

  if ((int)devicePinEntry.length() > activeDeviceLockPin.length()) devicePinEntry = "";

  if (tx >= PIN_BACKSPACE_X0 && tx <= PIN_BACKSPACE_X1 && ty >= PIN_BACKSPACE_Y0 && ty <= PIN_BACKSPACE_Y1) {
    if (devicePinEntry.length() > 0) devicePinEntry.remove(devicePinEntry.length() - 1);
    pinLastDigitMs = 0;
    drawPinDots();
    revertPinFlashIfPending();
    pinFlashRow = PIN_FLASH_BACKSPACE;
    pinFlashCol = -1;
    pinFlashSetMs = millis();
    drawPinBackspace(COLOR_BLACK, COLOR_BLUE);
    return;
  }
  if (ty < PIN_KEYPAD_Y0) return;
  int row = (ty - PIN_KEYPAD_Y0) / PIN_KEYPAD_ROW_H;
  int col = tx / PIN_KEYPAD_COL_W;
  if (row < 0 || row >= PIN_KEYPAD_ROWS || col < 0 || col >= PIN_KEYPAD_COLS) return;
  const char* key = PIN_KEYPAD_LABELS[row][col];
  if (key[0] < '0' || key[0] > '9') return;
  if ((int)devicePinEntry.length() >= activeDeviceLockPin.length()) return;

  devicePinEntry += key;
  pinLastDigitMs = millis();
  if ((int)devicePinEntry.length() < activeDeviceLockPin.length()) {
    drawPinDots();
    revertPinFlashIfPending();
    pinFlashRow = row;
    pinFlashCol = col;
    pinFlashSetMs = millis();
    drawPinKeypadCell(row, col, COLOR_BLACK, COLOR_BLUE);
  } else if (devicePinEntry == activeDeviceLockPin) {
    drawPinDots();
    revertPinFlashIfPending();
    pinFlashRow = row;
    pinFlashCol = col;
    pinFlashSetMs = millis();
    drawPinKeypadCell(row, col, COLOR_BLACK, COLOR_BLUE);
    pinSuccessTarget = devicePinTarget;
    pinSuccessAtMs = millis();
    suppressNextTouchRelease = true;
    return;
  } else {
    Serial.printf("[DeviceLock] PIN wrong (entered len %u vs stored len %u)\n",
                  (unsigned)devicePinEntry.length(), (unsigned)activeDeviceLockPin.length());
    devicePinWrongAttempts++;
    devicePinEntry = "";
    if (devicePinWrongAttempts >= DEVICE_PIN_MAX_ATTEMPTS) {
      devicePinLockedUntilMs = millis() + DEVICE_PIN_LOCKOUT_MS;
      closeDevicePinPage();
      closeSettingsPage();
      suppressNextTouchRelease = true;
    } else {
      drawDevicePinPage();
    }
  }
}

#define AI_MODE_ROW_Y0_TOP 148
#define AI_MODE_ROW_Y1_TOP 184
#define AI_MODE_ROW_Y0_IDLE 196
#define AI_MODE_ROW_Y1_IDLE 234
#define AI_TEXT_AREA_Y0 194
#define AI_TEXT_AREA_Y1 (SCREEN_HEIGHT - 14)
#define AI_TEXT_LINE_GAP 34
#define AI_TEXT_REVEAL_TICK_MS 90

static const char* const LATIN1_ASCII_FALLBACK[64] = {
    "A","A","A","A","A","A","AE","C","E","E","E","E","I","I","I","I",
    "D","N","O","O","O","O","O","x","O","U","U","U","U","Y","Th","ss",
    "a","a","a","a","a","a","ae","c","e","e","e","e","i","i","i","i",
    "d","n","o","o","o","o","o","/","o","u","u","u","u","y","th","y",
};

#define ORIGIN_TAG_LEAD '\x01'
static inline String originTagMark(char which) {
  String s; s += ORIGIN_TAG_LEAD; s += which; s += ORIGIN_TAG_LEAD; return s;
}
static void aiInsertOriginTag(const char* name) {
  if (translatorPageOpen) return;
  if      (strcmp(name, "ask_file_question") == 0) aiReplyTranscript += originTagMark('F');
  else if (strcmp(name, "web_search")        == 0) aiReplyTranscript += originTagMark('W');
}
static String stripOriginTags(const String& in) {
  if (in.indexOf(ORIGIN_TAG_LEAD) < 0) return in;
  String out; out.reserve(in.length());
  size_t i = 0, n = in.length();
  while (i < n) {
    if ((uint8_t)in[i] == (uint8_t)ORIGIN_TAG_LEAD && i + 2 < n
        && (uint8_t)in[i + 2] == (uint8_t)ORIGIN_TAG_LEAD) {
      i += 3;
      continue;
    }
    out += in[i++];
  }
  return out;
}

static String sanitizeForDisplay(const String& in) {
  String out;
  out.reserve(in.length());
  size_t i = 0, n = in.length();
  while (i < n) {
    uint8_t c = (uint8_t)in[i];
    if (c == (uint8_t)ORIGIN_TAG_LEAD) {
      if (i + 2 < n && (uint8_t)in[i + 2] == (uint8_t)ORIGIN_TAG_LEAD) {
        char w = in[i + 1];
        if (aiShowOriginTags) {
          if      (w == 'F') out += "[F] ";
          else if (w == 'W') out += "[W] ";
          else if (w == 'A') out += "[AI] ";
        }
        i += 3;
        continue;
      }
      i++;
      continue;
    }
    if (c < 0x80) { out += (char)c; i++; continue; }

    if (c == 0xE2 && i + 2 < n && (uint8_t)in[i + 1] == 0x80) {
      uint8_t c3 = (uint8_t)in[i + 2];
      if (c3 == 0x98 || c3 == 0x99) { out += '\''; i += 3; continue; }
      if (c3 == 0x9C || c3 == 0x9D) { out += '"';  i += 3; continue; }
      if (c3 == 0x93 || c3 == 0x94) { out += '-';  i += 3; continue; }
      if (c3 == 0xA6) { out += "...";              i += 3; continue; }
    }

    if (c == 0xC3 && i + 1 < n) {
      uint8_t c2 = (uint8_t)in[i + 1];
      if (c2 >= 0x80 && c2 <= 0xBF) { out += LATIN1_ASCII_FALLBACK[c2 - 0x80]; i += 2; continue; }
    }
    if (c == 0xC2 && i + 1 < n) {
      uint8_t c2 = (uint8_t)in[i + 1];
      if (c2 == 0xA1 || c2 == 0xBF) { i += 2; continue; }
    }
    if (c == 0xC5 && i + 1 < n) {
      uint8_t c2 = (uint8_t)in[i + 1];
      if (c2 == 0x92) { out += "OE"; i += 2; continue; }
      if (c2 == 0x93) { out += "oe"; i += 2; continue; }
    }

    int extra;
    if ((c & 0xE0) == 0xC0) extra = 1;
    else if ((c & 0xF0) == 0xE0) extra = 2;
    else if ((c & 0xF8) == 0xF0) extra = 3;
    else { i++; continue; }
    i += extra + 1;
  }
  return out;
}

void cycleAiDisplayMode() {
  aiDisplayModeIndex = (aiDisplayModeIndex + 1) % AI_DISPLAY_MODE_COUNT;
  if (aiDisplayModeIndex == AI_DISPLAY_SILENT && aiModelIsGemini(aiRealtimeModel)) {
    aiDisplayModeIndex = (aiDisplayModeIndex + 1) % AI_DISPLAY_MODE_COUNT;
  }
  saveSettings();
  drawAiPage();
}

static int aiTextLeftMargin() {
  int16_t bx, by; uint16_t bw, bh;
  gfx->getTextBounds("G", 0, 0, &bx, &by, &bw, &bh);
  return 20 + (int)bw;
}

static void aiRewrapTextLines(int replyCharsLimit = -1) {
  aiTextLineCount = 0;
  if (!aiTextLines) return;
  gfx->setTextSize(3);
  const int rightMargin = 20;
  const int maxWidth = SCREEN_WIDTH - aiTextLeftMargin() - rightMargin;
  int16_t bx, by; uint16_t bw, bh;
  auto wrapInto = [&](const String& text) {
    int len = (int)text.length();
    int start = 0;
    while (start < len && aiTextLineCount < AI_TEXT_MAX_LINES) {
      while (start < len && text[start] == ' ') start++;
      if (start >= len) break;
      int lineEnd = start;
      int scan = start;
      while (scan < len) {
        int wordEnd = scan;
        while (wordEnd < len && text[wordEnd] == ' ') wordEnd++;
        while (wordEnd < len && text[wordEnd] != ' ') wordEnd++;
        if (wordEnd == scan) break;
        String trial = text.substring(start, wordEnd);
        gfx->getTextBounds(trial.c_str(), 0, 0, &bx, &by, &bw, &bh);
        if ((int)bw > maxWidth) break;
        lineEnd = wordEnd;
        scan = wordEnd;
      }
      if (lineEnd == start) {
        int end = len;
        while (end > start + 1) {
          String trial = text.substring(start, end);
          gfx->getTextBounds(trial.c_str(), 0, 0, &bx, &by, &bw, &bh);
          if ((int)bw <= maxWidth) break;
          end--;
        }
        lineEnd = end;
      }
      String line = text.substring(start, lineEnd);
      while (line.length() > 0 && line[0] == ' ') line.remove(0, 1);
      aiTextLines[aiTextLineCount++] = line;
      start = lineEnd;
    }
  };
  if (aiUserTranscript.length() > 0) {
    wrapInto("You: " + sanitizeForDisplay(aiUserTranscript));
    if (aiTextLineCount < AI_TEXT_MAX_LINES) aiTextLines[aiTextLineCount++] = "";
  }
  aiTextUserLineCount = aiTextLineCount;
  bool limited = replyCharsLimit >= 0 && replyCharsLimit < (int)aiReplyTranscript.length();
  wrapInto(sanitizeForDisplay(limited ? aiReplyTranscript.substring(0, replyCharsLimit) : aiReplyTranscript));
}

static void aiAdvanceTextReveal() {
  int len = (int)aiReplyTranscript.length();
  if (aiRevealedChars >= len) return;
  int i = aiRevealedChars;
  while (i < len && aiReplyTranscript[i] != ' ') i++;
  if (i >= len) return;
  while (i < len && aiReplyTranscript[i] == ' ') i++;
  aiRevealedChars = i;
}

static void aiSilentModeAutoFollow() {
  int visibleLines = (AI_TEXT_AREA_Y1 - AI_TEXT_AREA_Y0) / AI_TEXT_LINE_GAP;
  if (visibleLines < 1) visibleLines = 1;
  aiTextScrollLine = aiTextLineCount > visibleLines ? aiTextLineCount - visibleLines : 0;
}

static void drawAiTextArea() {
  gfx->fillRect(0, AI_TEXT_AREA_Y0 - 6, SCREEN_WIDTH, AI_TEXT_AREA_Y1 - AI_TEXT_AREA_Y0 + 12, COLOR_BLACK);

  int visibleLines = (AI_TEXT_AREA_Y1 - AI_TEXT_AREA_Y0) / AI_TEXT_LINE_GAP;
  if (visibleLines < 1) visibleLines = 1;
  int maxTop = aiTextLineCount > visibleLines ? aiTextLineCount - visibleLines : 0;
  if (aiTextScrollLine > maxTop) aiTextScrollLine = maxTop;
  if (aiTextScrollLine < 0) aiTextScrollLine = 0;
  int top = aiTextScrollLine;

  gfx->setTextSize(3);
  int leftMargin = aiTextLeftMargin();
  int y = AI_TEXT_AREA_Y0;
  for (int i = top; i < aiTextLineCount && i < top + visibleLines; i++) {
    gfx->setTextColor(i < aiTextUserLineCount ? COLOR_BLUE : COLOR_WHITE, COLOR_BLACK);
    gfx->setCursor(leftMargin, y);
    gfx->print(aiTextLines[i]);
    y += AI_TEXT_LINE_GAP;
  }
}

static bool aiTextAreaVisible() {
  bool busyWithoutAnswer = (aiState == AI_CONNECTING || aiState == AI_LISTENING || aiState == AI_THINKING
                             || aiState == AI_STOPPING || aiState == AI_TOOL_CALL || aiState == AI_ERROR);
  return (aiDisplayModeIndex != AI_DISPLAY_VOICE) && aiTextLineCount > 0 && !busyWithoutAnswer;
}

void drawAiPage() {
  if (aiToolHistoryOpen) return;
  gfx->fillScreen(COLOR_BLACK);
  _clockCenterPrint(TR(UISTR_AI_ASSISTANT), 60, 4, COLOR_WHITE);
  String aiPageModelName = aiProviderDisplayLabel(aiRealtimeModel, false);
  _clockCenterPrint(aiPageModelName.c_str(), 112, 3, aiPageModelName == "No Key" ? COLOR_GRAY : COLOR_BLUE);

  gfx->drawLine(30, 146, SCREEN_WIDTH - 30, 146, CLK_SEP_COLOR);

  bool showText = aiTextAreaVisible();

  String modeLabel = String(TR(UISTR_MODE)) + ": " + uiModeName(aiDisplayModeIndex) + "  >";
  _clockCenterPrint(modeLabel.c_str(), showText ? 156 : 206, 3, COLOR_GRAY);

  if (showText) {
    drawAiTextArea();
  } else {
    const char* stateText = TR(UISTR_HOLD_TO_TALK);
    uint16_t stateColor = COLOR_GRAY;
    switch (aiState) {
      case AI_CONNECTING: stateText = TR(UISTR_CONNECTING);  stateColor = COLOR_BLUE;   break;
      case AI_LISTENING: {
        static char listenBuf[40];
        uint8_t dots = aiListenDots < 1 ? 1 : (aiListenDots > 3 ? 3 : aiListenDots);
        snprintf(listenBuf, sizeof(listenBuf), "%s%.*s", TR(UISTR_LISTENING), (int)dots, "...");
        stateText = listenBuf;   stateColor = COLOR_BLUE;   break;
      }
      case AI_THINKING:   stateText = TR(UISTR_THINKING);    stateColor = COLOR_BLUE;   break;
      case AI_SPEAKING:   stateText = replaySavedActive ? TR(UISTR_REPLAYING_SAVED)
                                    : (aiDisplayModeIndex == AI_DISPLAY_SILENT) ? TR(UISTR_REPLYING) : TR(UISTR_SPEAKING);
                          stateColor = COLOR_BLUE; break;
      case AI_STOPPING:   stateText = TR(UISTR_STOPPING);    stateColor = COLOR_ORANGE; break;
      case AI_TOOL_CALL:  stateText = aiToolLabel.c_str(); stateColor = COLOR_BLUE; break;
      case AI_ERROR:       stateText = aiErrorMsg.c_str(); stateColor = COLOR_ORANGE; break;
      default: break;
    }
    if (aiState == AI_ERROR) {
      int nextY = _clockCenterPrintWrapped(stateText, 265, 3, stateColor, 10, 28);
      if (aiErrorDetail.length() > 0) {
        bool isLimit = (aiErrorMsg == "Daily AI limit reached");
        int detailSize = isLimit ? 3 : 2;
        int detailY = nextY + 6 + (isLimit ? 20 : 0);
        uint16_t detailColor = isLimit ? stateColor : COLOR_GRAY;
        _clockCenterPrintWrapped(aiErrorDetail.c_str(), detailY, detailSize, detailColor, 10, 20);
      }
    } else {
      _clockCenterPrint(stateText, 281, 3, stateColor);
      if (aiState == AI_IDLE && aiRecordUserInput
          && (saveHistoryMode == SAVE_TEXT_AUDIO || saveHistoryMode == SAVE_AUDIO_ONLY))
        _clockCenterPrint("User input record ON", 350, 3, COLOR_GRAY);
    }
    if (aiState == AI_IDLE && aiRecFilled > 0) {
      _clockCenterPrint(TR(UISTR_SWIPE_REPLAY), SCREEN_HEIGHT - 76, 2, COLOR_GRAY);
    }
    _clockCenterPrint(TR(UISTR_SWIPE_TOOL_HISTORY), SCREEN_HEIGHT - 52, 2, COLOR_GRAY);
  }
}

