    else if (which == "fileqa")     activeFileQaModelsList    = AI_FILEQA_MODELS_DEFAULT;
    else if (which == "deepthink")  activeDeepThinkModelsList = AI_DEEPTHINK_MODELS_DEFAULT;
    else if (which == "voicetotext") activeVoiceToTextModelsList = AI_VOICE_TO_TEXT_MODELS_DEFAULT;
