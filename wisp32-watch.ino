long secondsUntilNextAlarm() {
  time_t now = time(NULL);
  long best = -1;
  for (int i = 0; i < MAX_ALARMS; i++) {
    if (alarmEpochs[i] == 0) continue;
    long secs = (long)(alarmEpochs[i] - now);
    if (secs < 0) secs = 0;
    if (best < 0 || secs < best) best = secs;
  }
  return best;
}

static time_t pageTaskNextEpoch(int idx, time_t now, const struct tm& nowTm) {
  const PageTask& t = activePageTasks[idx];
  int hh = 0, mm = 0;
  int colon = t.scheduleTime.indexOf(':');
  if (colon > 0) { hh = t.scheduleTime.substring(0, colon).toInt(); mm = t.scheduleTime.substring(colon + 1).toInt(); }

  if (t.scheduleType == "once") {
    int d1 = t.scheduleDate.indexOf('-');
    int d2 = (d1 >= 0) ? t.scheduleDate.indexOf('-', d1 + 1) : -1;
    if (d1 < 0 || d2 < 0) return 0;
    int y = t.scheduleDate.substring(0, d1).toInt();
    int mo = t.scheduleDate.substring(d1 + 1, d2).toInt();
    int d = t.scheduleDate.substring(d2 + 1).toInt();
    if (y < 2000 || mo < 1 || mo > 12 || d < 1 || d > 31) return 0;
    struct tm target = nowTm;
    target.tm_year = y - 1900; target.tm_mon = mo - 1; target.tm_mday = d;
    target.tm_hour = hh; target.tm_min = mm; target.tm_sec = 0;
    target.tm_isdst = -1;
    return mktime(&target);
  }

  if (t.scheduleType == "weekly") {
    if (t.scheduleDays.length() == 0) return 0;
    String daysCsv = "," + t.scheduleDays + ",";
    for (int ahead = 0; ahead <= 7; ahead++) {
      int dow = (nowTm.tm_wday + ahead) % 7;
      if (daysCsv.indexOf("," + String(dow) + ",") < 0) continue;
      struct tm target = nowTm;
      target.tm_mday += ahead;
      target.tm_hour = hh; target.tm_min = mm; target.tm_sec = 0;
      target.tm_isdst = -1;
      time_t epoch = mktime(&target);
      if (ahead == 0) {
        char epochDay[11];
        struct tm epochTm; localtime_r(&epoch, &epochTm);
        strftime(epochDay, sizeof(epochDay), "%Y-%m-%d", &epochTm);
        if (t.scheduleLastFiredDate == String(epochDay)) continue;
      }
      return epoch;
    }
    return 0;
  }

  return 0;
}

static long taskSecondsUntilDue(int idx, time_t now, const struct tm& nowTm) {
  time_t epoch = pageTaskNextEpoch(idx, now, nowTm);
  if (epoch == 0) return -1;
  long secs = (long)(epoch - now);
  if (secs < 0) secs = 0;
  return secs;
}

long secondsUntilNextTaskDue() {
  time_t now = time(NULL);
  struct tm nowTm;
  if (!getLocalTime(&nowTm)) return -1;
  long best = -1;
  for (int i = 0; i < activePageTaskCount; i++) {
    long secs = taskSecondsUntilDue(i, now, nowTm);
    if (secs < 0) continue;
    if (best < 0 || secs < best) best = secs;
  }
  return best;
}

static int nextDueTaskIndex() {
  time_t now = time(NULL);
  struct tm nowTm;
  if (!getLocalTime(&nowTm)) return -1;
  for (int i = 0; i < activePageTaskCount; i++) {
    if (taskSecondsUntilDue(i, now, nowTm) == 0) return i;
  }
  return -1;
}

static bool isCtrLogFile(const String& fnBase) {
  return fnBase == "tool_calls.csv" || fnBase == "tokens.csv" || fnBase == "replays.csv";
}

#define TOKENS_LOG_MAX_BYTES (min((size_t)(100UL * 1024UL), (size_t)AI_FILE_OPEN_MAX_CHARS))
static void trimTokensLogIfNeeded(const String& path) {
  ChatLogReader r;
  if (!r.open(path)) return;
  size_t sz = r.size();
  if (sz <= TOKENS_LOG_MAX_BYTES) { r.close(); return; }

  String content;
  uint8_t* buf = (uint8_t*)ps_malloc(sz + 1);
  if (buf) {
    size_t got = r.read(buf, sz);
    buf[got] = 0;
    content = String((char*)buf);
    free(buf);
  }
  r.close();
  if (content.length() == 0) return;

  int firstNl = content.indexOf('\n');
  if (firstNl < 0) return;
  String header = content.substring(0, firstNl + 1);
  String rows = content.substring(firstNl + 1);

  const size_t target = (TOKENS_LOG_MAX_BYTES * 4) / 5;
  while (header.length() + rows.length() > target) {
    int nl = rows.indexOf('\n');
    if (nl < 0) { rows = ""; break; }
    rows = rows.substring(nl + 1);
  }

  chatLogWriteFresh(path, header + rows);
}

#define TOOL_LOG_PENDING_CAP 8192
static char*    toolLogPending      = nullptr;
static size_t   toolLogPendingLen   = 0;
static uint16_t toolLogDroppedRows  = 0;

static bool toolLogShouldDefer() {
  return (aiPageOpen || translatorPageOpen) && aiState != AI_IDLE && aiState != AI_ERROR;
}

static void logToolCallEvent(const String& context, const char* name, unsigned long durationMs,
                              const String& args, const String& result) {
  if (!sdMounted || !logEventsEnabled) return;

  struct tm ti;
  char tsBuf[24] = "no time sync";
  if (getLocalTime(&ti)) strftime(tsBuf, sizeof(tsBuf), "%Y-%m-%d %H:%M:%S", &ti);

  String row = String(tsBuf) + "," + context + "," + name + "," + String(durationMs) + ","
             + csvEscape(args) + "," + csvEscape(aiToolHistorySummary(result)) + "\n";

  if (toolLogShouldDefer()) {
    if (!toolLogPending) {
      toolLogPending = (char*)ps_malloc(TOOL_LOG_PENDING_CAP);
      toolLogPendingLen = 0;
      if (!toolLogPending) {
        toolLogDroppedRows++;
        return;
      }
    }
    if (toolLogPendingLen + row.length() + 1 > TOOL_LOG_PENDING_CAP) {
      toolLogDroppedRows++;
      return;
    }
    memcpy(toolLogPending + toolLogPendingLen, row.c_str(), row.length());
    toolLogPendingLen += row.length();
    toolLogPending[toolLogPendingLen] = '\0';
    return;
  }

  ensureLogsDir();
  String path = String(KNOWLEDGE_DIR) + "/Logs/tool_calls.csv";
  bool needsHeader = !SD_MMC.exists(path);
  if (needsHeader) chatLogAppendEntry(path, "Timestamp,Context,Tool,Duration(ms),Args,Result\n");
  chatLogAppendEntry(path, row);
  trimTokensLogIfNeeded(path);
}

static void flushPendingToolLog() {
  if (!toolLogPending || toolLogPendingLen == 0) return;
  if (!sdMounted) return;
  ensureLogsDir();
  String path = String(KNOWLEDGE_DIR) + "/Logs/tool_calls.csv";
  if (!SD_MMC.exists(path)) chatLogAppendEntry(path, "Timestamp,Context,Tool,Duration(ms),Args,Result\n");
  chatLogAppendEntry(path, String(toolLogPending));
  if (toolLogDroppedRows > 0) {
    chatLogAppendEntry(path, String("(") + toolLogDroppedRows + " tool-call row(s) dropped: log buffer full)\n");
    toolLogDroppedRows = 0;
  }
  trimTokensLogIfNeeded(path);
  toolLogPendingLen = 0;
  toolLogPending[0] = '\0';
}

#define KB_AIMETA_INDEX_FILE "aimeta_index.dat"
#define KB_AIMETA_INSTR_FILE "aimeta_instr.dat"
#define KB_AIMETA_DESC_MAX   160
#define KB_AIMETA_INSTR_MAX  1000

static String kbAiMetaPath(const char* which) { return String(KNOWLEDGE_DIR) + "/" + which; }

static String kbAiAttrJs(const String& in) {
  String o; o.reserve(in.length() + 24);
  for (int i = 0; i < (int)in.length(); i++) {
    char c = in.charAt(i);
    if      (c == '\\') o += "\\\\";
    else if (c == '"')  o += "\\\"";
    else if (c == '\n') o += "\\n";
    else if (c == '\r') {   }
    else if (c == '&')  o += "&amp;";
    else if (c == '<')  o += "&lt;";
    else if (c == '>')  o += "&gt;";
    else if (c == '\'') o += "&#39;";
    else                o += c;
  }
  return o;
}

static String kbAiHtmlText(const String& in) {
  String o; o.reserve(in.length() + 16);
  for (int i = 0; i < (int)in.length(); i++) {
    char c = in.charAt(i);
    if      (c == '&') o += "&amp;";
    else if (c == '<') o += "&lt;";
    else if (c == '>') o += "&gt;";
    else               o += c;
  }
  return o;
}

static String kbAiMetaSanitize(const String& in, size_t maxLen) {
  String out;
  out.reserve(in.length());
  for (size_t i = 0; i < in.length() && out.length() < maxLen; i++) {
    char c = in.charAt(i);
    if (c == '\t' || c == '\n' || c == '\r') c = ' ';
    out += c;
  }
  out.trim();
  return out;
}

static String kbAiMetaLookup(const char* which, const String& name) {
  if (!sdMounted || name.length() == 0) return "";
  String path = kbAiMetaPath(which);
  if (!SD_MMC.exists(path)) return "";
  String all = readKnowledgeFile(path);
  String key = name + "\t";
  int at = all.startsWith(key) ? 0 : all.indexOf("\n" + key);
  if (at < 0) return "";
  if (at > 0) at++;
  int lineEnd = all.indexOf('\n', at);
  if (lineEnd < 0) lineEnd = all.length();
  return all.substring(at + key.length(), lineEnd);
}

static bool kbAiMetaStore(const char* which, const String& name, const String& value) {
  if (!sdMounted || name.length() == 0) return false;
  String path = kbAiMetaPath(which);
  String all = SD_MMC.exists(path) ? readKnowledgeFile(path) : String("");
  String key = name + "\t";
  String rebuilt;
  rebuilt.reserve(all.length() + value.length() + key.length() + 2);
  int pos = 0;
  while (pos < (int)all.length()) {
    int nl = all.indexOf('\n', pos);
    if (nl < 0) nl = all.length();
    String line = all.substring(pos, nl);
    if (line.length() > 0 && !line.startsWith(key)) rebuilt += line + "\n";
    pos = nl + 1;
  }
  if (value.length() > 0) rebuilt += key + value + "\n";
  return writeKnowledgeFile(path, rebuilt);
}

static void kbAiMetaGet(const String& name, bool* outListed, String* outDesc) {
  if (outListed) *outListed = true;
  if (outDesc) *outDesc = "";
  String rest = kbAiMetaLookup(KB_AIMETA_INDEX_FILE, name);
  if (rest.length() == 0) return;
  int tab = rest.indexOf('\t');
  String listedField = tab >= 0 ? rest.substring(0, tab) : rest;
  if (outListed) *outListed = (listedField != "0");
  if (outDesc && tab >= 0) *outDesc = rest.substring(tab + 1);
}

static bool kbAiMetaSetIndex(const String& name, bool listed, const String& desc) {
  String clean = kbAiMetaSanitize(desc, KB_AIMETA_DESC_MAX);
  if (listed && clean.length() == 0) return kbAiMetaStore(KB_AIMETA_INDEX_FILE, name, "");
  return kbAiMetaStore(KB_AIMETA_INDEX_FILE, name, String(listed ? "1" : "0") + "\t" + clean);
}

static String kbAiMetaGetInstructions(const String& name) {
  String raw = kbAiMetaLookup(KB_AIMETA_INSTR_FILE, name);
  raw.replace("\\n", "\n");
  return raw;
}

static bool kbAiMetaSetInstructions(const String& name, const String& instr) {
  String clean = instr;
  clean.replace("\r\n", "\n");
  String packed;
  packed.reserve(clean.length());
  for (size_t i = 0; i < clean.length() && packed.length() < KB_AIMETA_INSTR_MAX; i++) {
    char c = clean.charAt(i);
    if (c == '\n') packed += "\\n";
    else if (c == '\t') packed += ' ';
    else packed += c;
  }
  packed.trim();
  return kbAiMetaStore(KB_AIMETA_INSTR_FILE, name, packed);
}

static void kbAiMetaForget(const String& name) {
  kbAiMetaStore(KB_AIMETA_INDEX_FILE, name, "");
  kbAiMetaStore(KB_AIMETA_INSTR_FILE, name, "");
}

static String kbAiMetaToJson(const String& name) {
  bool listed = true; String desc;
  kbAiMetaGet(name, &listed, &desc);
  String instr = kbAiMetaGetInstructions(name);
  DynamicJsonDocument doc(KB_AIMETA_INSTR_MAX + KB_AIMETA_DESC_MAX + 512);
  doc["wispkb_aimeta"] = 1;
  doc["file"]          = name;
  doc["listed"]        = listed;
  doc["description"]   = desc;
  doc["instructions"]  = instr;
  String out; serializeJson(doc, out);
  return out;
}

static bool kbAiMetaApplyJson(const String& json, const String& targetName) {
  if (targetName.length() == 0) return false;
  DynamicJsonDocument doc(KB_AIMETA_INSTR_MAX + KB_AIMETA_DESC_MAX + 1024);
  if (deserializeJson(doc, json) != DeserializationError::Ok) return false;
  if (!((int)(doc["wispkb_aimeta"] | 0) == 1)) return false;
  bool listed  = doc["listed"] | true;
  String desc  = String((const char*)(doc["description"]  | ""));
  String instr = String((const char*)(doc["instructions"] | ""));
  kbAiMetaSetIndex(targetName, listed, desc);
  kbAiMetaSetInstructions(targetName, instr);
  return true;
}
#define KB_AIINDEX_MAX_CHARS 11500
#define KB_AIINDEX_MAX_FILES 60
String kbAiBuildFileIndex() {
  if (!sdMounted) return "";
  String out;
  int listed = 0;
  bool truncated = false;

  String metaAll;
  {
    String metaPath = kbAiMetaPath(KB_AIMETA_INDEX_FILE);
    if (SD_MMC.exists(metaPath)) metaAll = readKnowledgeFile(metaPath);
  }

  String queue[12]; int qHead = 0, qTail = 0;
  queue[qTail++] = "";
  while (qHead < qTail && !truncated) {
    String rel = queue[qHead++];
    String full = String(KNOWLEDGE_DIR) + (rel.length() > 0 ? "/" + rel : "");
    File dir = SD_MMC.open(full);
    if (!dir || !dir.isDirectory()) { if (dir) dir.close(); continue; }
    File f = dir.openNextFile();
    while (f) {
      bool isDir = f.isDirectory();
      String fname = f.name();
      f.close();
      int slash = fname.lastIndexOf('/');
      if (slash >= 0) fname = fname.substring(slash + 1);
      String ref = rel.length() > 0 ? rel + "/" + fname : fname;

      if (isDir) {
        if (qTail < 12) queue[qTail++] = ref;
      } else if (isKnowledgeFile(fname) && ref != AI_MEMORIES_FILE) {
        bool isListed = true; String desc;
        {
          String key = ref + "\t";
          int at = metaAll.startsWith(key) ? 0 : metaAll.indexOf("\n" + key);
          if (at >= 0) {
            if (at > 0) at++;
            int lineEnd = metaAll.indexOf('\n', at);
            if (lineEnd < 0) lineEnd = metaAll.length();
            String rest = metaAll.substring(at + key.length(), lineEnd);
            int tab = rest.indexOf('\t');
            isListed = ((tab >= 0 ? rest.substring(0, tab) : rest) != "0");
            if (tab >= 0) desc = rest.substring(tab + 1);
          }
        }
        if (isListed) {
          String line = "  " + ref + (desc.length() > 0 ? " - " + desc : "") + "\n";
          if (out.length() + line.length() > KB_AIINDEX_MAX_CHARS || listed >= KB_AIINDEX_MAX_FILES) {
            truncated = true;
            break;
          }
          out += line;
          listed++;
        }
      }
      f = dir.openNextFile();
    }
    dir.close();
  }

  if (listed == 0) return "";
  String header = "\n\nFiles saved on this device. Open one yourself with file_open when a question "
                  "needs it, then answer from it with ask_file_question - do not ask the user to open "
                  "a file first, and do not announce that you are opening it. Only open a file when the "
                  "question actually calls for one. Only ONE file is open at a time: opening another "
                  "replaces it. Before every ask_file_question, make sure the file you need is the one "
                  "you last opened - if the question is about a different file, call file_open for that "
                  "file first, even if another file is already open:\n";
  if (truncated) out += "  (more files exist than are listed here)\n";
  return header + out;
}

