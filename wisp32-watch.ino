bool writeSecretFile(const String& path, const String& content) {
  if (sdEncryptionActive) return writeKnowledgeFile(path, content);

  String tmpPath = path + "_tmp";
  SD_MMC.remove(tmpPath);
  File f = SD_MMC.open(tmpPath, FILE_WRITE);
  if (!f) return false;
  size_t written;
  if (secretsBaselineKeyReady) {
    size_t encLen;
    uint8_t* enc = aesEncryptWithKey((const uint8_t*)content.c_str(), content.length(), &encLen, secretsBaselineKey);
    if (!enc) { f.close(); SD_MMC.remove(tmpPath); return false; }
    written = f.write(enc, encLen);
    f.close();
    free(enc);
    if (written != encLen) { SD_MMC.remove(tmpPath); return false; }
  } else {
    written = f.write((const uint8_t*)content.c_str(), content.length());
    f.close();
    if (written != content.length()) { SD_MMC.remove(tmpPath); return false; }
  }
  SD_MMC.remove(path);
  return SD_MMC.rename(tmpPath, path);
}

String readSecretFile(const String& path, bool* wasPlaintext) {
  *wasPlaintext = false;

  File f = SD_MMC.open(path, FILE_READ);
  if (!f) return "";
  size_t fileSize = f.size();
  uint8_t* buf = (uint8_t*)ps_malloc(fileSize ? fileSize : 1);
  if (!buf) { f.close(); return ""; }
  f.read(buf, fileSize);
  f.close();

  if (!(fileSize >= ENCRYPT_MAGIC_LEN && memcmp(buf, ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN) == 0)) {
    *wasPlaintext = true;
    String result = String((char*)buf).substring(0, fileSize);
    free(buf);
    return result;
  }

  char* plain = nullptr;
  if (sdEncryptionActive) {
    plain = aesDecryptVerify(buf, fileSize, activeAesKey);
    if (!plain && secretsBaselineKeyReady) {
      plain = aesDecryptVerify(buf, fileSize, secretsBaselineKey);
      if (plain) *wasPlaintext = true;
    }
  } else {
    if (secretsBaselineKeyReady) plain = aesDecryptVerify(buf, fileSize, secretsBaselineKey);
  }
  free(buf);
  if (!plain) return "";
  String result = String(plain);
  free(plain);
  return result;
}

