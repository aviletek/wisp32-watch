void handleSaveAppKeys() {
  if (!requireAuth()) return;
  String kNames[MAX_CUSTOM_KEYS], kVals[MAX_CUSTOM_KEYS];
  int nameCount = 0, valCount = 0;
  for (int i = 0; i < server.args(); i++) {
    String an = server.argName(i);
    if (an == "keyName"  && nameCount < MAX_CUSTOM_KEYS) kNames[nameCount++] = server.arg(i);
    else if (an == "keyValue" && valCount < MAX_CUSTOM_KEYS) kVals[valCount++] = server.arg(i);
  }
  if (activeCustomKeys) {
    activeCustomKeyCount = 0;
    for (int i = 0; i < nameCount && activeCustomKeyCount < MAX_CUSTOM_KEYS; i++) {
      String nm = kNames[i]; nm.trim();
      if (nm.length() == 0) continue;
      bool dup = false;
      for (int j = 0; j < activeCustomKeyCount; j++) if (activeCustomKeys[j].name.equalsIgnoreCase(nm)) { dup = true; break; }
      if (dup) continue;
      activeCustomKeys[activeCustomKeyCount].name  = nm;
      activeCustomKeys[activeCustomKeyCount].value = (i < valCount) ? kVals[i] : String("");
      activeCustomKeyCount++;
    }
    saveCredentials();
  }
  server.sendHeader("Location", "/appkeys?saved=1");
  server.send(303);
}

void handleAppKeyRead() {
  if (!requireAuth()) return;
  if (!server.hasArg("name")) { server.send(400, "text/plain", ""); return; }
  String name = server.arg("name");
  for (int i = 0; i < activeCustomKeyCount; i++) {
    if (activeCustomKeys[i].name == name) {
      server.sendHeader("Cache-Control", "no-store");
      server.send(200, "text/plain", activeCustomKeys[i].value);
      return;
    }
  }
  server.send(404, "text/plain", "");
}

static void sendKbFileTooLargeError() {
  server.send(200, "text/html; charset=utf-8", "<!DOCTYPE html><html><body style='background:#111;color:#eee;"
    "font-family:sans-serif;text-align:center;padding:60px 20px'>"
    "<h2 style='color:#f66'>File too large</h2>"
    "<p>Knowledge base files must have a maximum size of 1MB.</p>"
    "<a href='/' style='color:#4af'>&larr; Back</a></body></html>");
}

static String kbUniqueFilename(String dir, String name) {
  String base_dir = String(KNOWLEDGE_DIR) + (dir.length() > 0 ? "/" + dir : "");
  if (!SD_MMC.exists(base_dir + "/" + name)) return name;
  int dot = name.lastIndexOf('.');
  String base = (dot > 0) ? name.substring(0, dot) : name;
  String ext  = (dot > 0) ? name.substring(dot) : "";
  for (int n = 1; n < 1000; n++) {
    String candidate = base + " (" + String(n) + ")" + ext;
    if (!SD_MMC.exists(base_dir + "/" + candidate)) return candidate;
  }
  return name;
}

void handleUpload() {
  HTTPUpload& upload=server.upload();
  if (upload.status==UPLOAD_FILE_START) {
    kbUploadTooLarge = false;
    kbLastUploadedRef = "";
    kbUploadUnauthorized = !isRequestAuthenticated();
    if (kbUploadUnauthorized) return;
    String uploadSubPath = server.hasArg("path") ? sanitizeDirPath(server.arg("path")) : "";
    String uploadDir = String(KNOWLEDGE_DIR) + (uploadSubPath.length() > 0 ? "/" + uploadSubPath : "");
    String fn=upload.filename; if (!isKnowledgeFile(fn)) fn+=".txt";
    uploadFile=SD_MMC.open(uploadDir+"/"+fn+".tmp",FILE_WRITE);
  } else if (upload.status==UPLOAD_FILE_WRITE) {
    if (kbUploadTooLarge || kbUploadUnauthorized) return;
    if (upload.totalSize > AI_FILE_OPEN_MAX_CHARS) {
      kbUploadTooLarge = true;
      if (uploadFile) uploadFile.close();
      String uploadSubPath = server.hasArg("path") ? sanitizeDirPath(server.arg("path")) : "";
      String uploadDir = String(KNOWLEDGE_DIR) + (uploadSubPath.length() > 0 ? "/" + uploadSubPath : "");
      String fn=upload.filename; if (!isKnowledgeFile(fn)) fn+=".txt";
      SD_MMC.remove(uploadDir+"/"+fn+".tmp");
      return;
    }
    if (uploadFile) uploadFile.write(upload.buf,upload.currentSize);
  } else if (upload.status==UPLOAD_FILE_END) {
    if (kbUploadTooLarge || kbUploadUnauthorized) return;
    if (uploadFile) {
      uploadFile.close();
      String uploadSubPath = server.hasArg("path") ? sanitizeDirPath(server.arg("path")) : "";
      String uploadDir = String(KNOWLEDGE_DIR) + (uploadSubPath.length() > 0 ? "/" + uploadSubPath : "");
      String fn=upload.filename; if (!isKnowledgeFile(fn)) fn+=".txt";
      String tmpPath=uploadDir+"/"+fn+".tmp";
      String finalFn = kbUniqueFilename(uploadSubPath, fn);
      String path=uploadDir+"/"+finalFn;
      File tmp=SD_MMC.open(tmpPath,FILE_READ);
      if (tmp) {
        size_t tmpSize = tmp.size();
        uint8_t* buf = (uint8_t*)ps_malloc(tmpSize + 1);
        String c = "";
        if (buf) {
          tmp.read(buf, tmpSize);
          buf[tmpSize] = 0;
          c = String((char*)buf);
          free(buf);
        }
        tmp.close(); SD_MMC.remove(tmpPath);
        if (fn.endsWith(KB_AIMETA_COMPANION_SUFFIX)) {
          String targetBase = fn.substring(0, fn.length() - String(KB_AIMETA_COMPANION_SUFFIX).length());
          String targetName = (uploadSubPath.length() > 0 ? uploadSubPath + "/" : "") + targetBase;
          kbAiMetaApplyJson(c, targetName);
        } else {
          writeKnowledgeFile(path,c);
          kbLastUploadedRef = (uploadSubPath.length() > 0 ? uploadSubPath + "/" : "") + finalFn;
        }
      }
    }
  }
}

void handleUploadComplete() {
  if (!requireAuth()) return;
  if (kbUploadTooLarge) {
    server.send(413, "text/plain", "File too large — Knowledge base files must have a maximum size of 1MB.");
    return;
  }
  kbAiAutoUnlistIfCapReached(kbLastUploadedRef);
  reloadKnowledge();
  server.send(200, "text/plain", "OK");
}
void handleCreate() {
  if (!requireAuth()) return;
  String subPath = server.hasArg("path") ? sanitizeDirPath(server.arg("path")) : "";
  if (server.hasArg("filename") && server.hasArg("content")) {
    String content = server.arg("content");
    if (content.length() > AI_FILE_OPEN_MAX_CHARS) { sendKbFileTooLargeError(); return; }
    String fn = server.arg("filename");
    String ext = server.hasArg("ext") ? server.arg("ext") : "txt";
    int dot = fn.lastIndexOf('.');
    if (dot > 0) fn = fn.substring(0, dot);
    fn += "." + ext;
    fn = kbUniqueFilename(subPath, fn);
    String path = String(KNOWLEDGE_DIR) + (subPath.length() > 0 ? "/" + subPath : "") + "/" + fn;
    writeKnowledgeFile(path, content);
    kbAiAutoUnlistIfCapReached((subPath.length() > 0 ? subPath + "/" : "") + fn);
    reloadKnowledge();
  }
  server.sendHeader("Location","/" + (subPath.length() > 0 ? "?path=" + subPath : String(""))); server.send(303);
}
void handleKBNote() {
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.sendHeader("Access-Control-Allow-Methods", "POST, OPTIONS");
  server.sendHeader("Access-Control-Allow-Headers", "Content-Type");
  if (server.method() == HTTP_OPTIONS) { server.send(204); return; }
  if (!requireAuth()) return;
  if (!server.hasArg("file") || !server.hasArg("content")) {
    server.send(400, "application/json", "{\"error\":\"missing args\"}"); return;
  }
  if (!sdMounted) { server.send(503, "application/json", "{\"error\":\"SD not mounted\"}"); return; }
  String fn = server.arg("file");
  fn.replace("/", ""); fn.replace("\\", ""); fn.replace("..", "");
  if (fn.length() == 0) { server.send(400, "application/json", "{\"error\":\"invalid filename\"}"); return; }
  if (!fn.endsWith(".txt")) fn += ".txt";
  String path = String(KNOWLEDGE_DIR) + "/" + fn;
  bool create = server.hasArg("create") && server.arg("create") == "1";
  time_t now = time(nullptr); struct tm lt; localtime_r(&now, &lt);
  char tsbuf[32]; strftime(tsbuf, sizeof(tsbuf), "[%Y-%m-%d %H:%M]", &lt);
  if (!SD_MMC.exists(path)) {
    if (!create) { server.send(404, "application/json", "{\"error\":\"File not found: " + fn + "\"}"); return; }
    char hdrbuf[48]; strftime(hdrbuf, sizeof(hdrbuf), "Created %Y-%m-%d %H:%M\n\n", &lt);
    writeKnowledgeFile(path, String(hdrbuf));
    kbAiAutoUnlistIfCapReached(fn);
  }
  String content = server.arg("content");
  if (content.length() > 0) {
    String entry = String(tsbuf) + " " + content;
    if (!appendKnowledgeFile(path, entry)) {
      server.send(500, "application/json", "{\"error\":\"write failed\"}"); return;
    }
  }
  reloadKnowledge();
  server.send(200, "application/json", "{\"ok\":true,\"file\":\"" + fn + "\"}");
}

