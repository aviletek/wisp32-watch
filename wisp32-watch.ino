  }
  int dtgInTok = res["usage"]["total_input_tokens"] | 0;
  int dtgCachedTok = res["usage"]["total_cached_tokens"] | 0;
  int dtgOutTok = res["usage"]["total_output_tokens"] | 0;
  int dtgThoughtTok = res["usage"]["total_thought_tokens"] | 0;
  int dtgTotalTok = res["usage"]["total_tokens"] | 0;
  Serial.printf("[AI] deep_think (gemini): status=%s tokens input=%d (cached=%d) output=%d (thought=%d) total=%d\n",
                (const char*)(res["status"] | "?"), dtgInTok, dtgCachedTok, dtgOutTok, dtgThoughtTok, dtgTotalTok);
  logTokenUsage("deepthink", "", "gemini", activeDeepThinkModel,
                AI_MAX_OUT_TOKENS_VALUES[aiThinkMaxTokIndex] > 0 ? AI_MAX_OUT_TOKENS_VALUES[aiThinkMaxTokIndex] : -1,
                dtgInTok, dtgOutTok, dtgCachedTok, dtgThoughtTok, -1, -1, -1, -1, -1, dtgTotalTok, -1, -1);
  return answer.length() > 0 ? answer : "No answer returned.";
}

