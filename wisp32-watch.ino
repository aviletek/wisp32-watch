        mdnsStarted = true;
        Serial.printf("[WiFi] Was already connected, t=%lums since boot\n", millis() - bootStartMs);
        if (_netMutex) xSemaphoreGive(_netMutex);
        wispTrace("WIFI already-connected, mDNS started");
      } else if (inFastPathGrace) {
      } else if (WiFi.status() != WL_CONNECTED && activeWifiNetworkCount == 0) {
      } else if (WiFi.status() != WL_CONNECTED && mdnsStarted && !directTriedThisDrop) {
        directTriedThisDrop = true;
        if (_netMutex) xSemaphoreTake(_netMutex, portMAX_DELAY);
        bool started = wifiTryDirectConnect();
        if (_netMutex) xSemaphoreGive(_netMutex);
        wispTrace(String("WIFI direct-connect attempt started=") + (started ? "1" : "0"));
        if (started) {
          wifiFastPathPending = true;
          wifiFastPathDeadlineMs = millis() + 6000;
        }
      } else if (WiFi.status() != WL_CONNECTED) {
        wifiFastPathPending = false;
        if (_netMutex) xSemaphoreTake(_netMutex, portMAX_DELAY);
        unsigned long wispScanStartMs = millis();
        WiFi.disconnect();
        bool wispScanConnected = (wifiMulti.run() == WL_CONNECTED);
        wispTrace("WIFI disconnect()+scan took " + String(millis() - wispScanStartMs) + "ms result=" + String(wispScanConnected ? 1 : 0));
        if (wispScanConnected) {
          WiFi.setSleep(false);
          wifiRememberSsid();
          if (!mdnsStarted) { MDNS.begin(deviceName.c_str()); Serial.printf("mDNS: %s.local\n", deviceName.c_str()); mdnsStarted = true; }
          else               { MDNS.end(); MDNS.begin(deviceName.c_str()); }
          Serial.printf("[WiFi] Connected, t=%lums since boot\n", millis() - bootStartMs);
        } else {
          static unsigned long lastFailLogMs = 0;
          if (millis() - lastFailLogMs > 30000) {
            lastFailLogMs = millis();
            int found = WiFi.scanComplete();
            if (found < 0) found = WiFi.scanNetworks(false, false);
            Serial.printf("[WiFi] connect FAILED, status=%d, %d network(s) visible\n",
                          (int)WiFi.status(), found);
            for (int c = 0; c < activeWifiNetworkCount; c++) {
              bool seen = false; int rssi = 0;
              for (int n = 0; n < found; n++) {
                if (WiFi.SSID(n) == activeWifiNetworks[c].ssid) { seen = true; rssi = WiFi.RSSI(n); break; }
              }
              if (seen) Serial.printf("[WiFi]   configured #%d: visible, rssi=%d — check the password\n", c + 1, rssi);
              else      Serial.printf("[WiFi]   configured #%d: NOT found in scan — wrong name, out of range, or a 5GHz-only network (this chip is 2.4GHz only)\n", c + 1);
            }
            WiFi.scanDelete();
          }
        }
        if (_netMutex) xSemaphoreGive(_netMutex);
      }
      if (WiFi.status() == WL_CONNECTED) directTriedThisDrop = false;
    }
    vTaskDelay(pdMS_TO_TICKS(50));
  }
}

