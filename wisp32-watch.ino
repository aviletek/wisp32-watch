static void _clockCenterPrint(const char* s, int y, int sz, uint16_t color, int margin = 0) {
  gfx->setTextSize(sz);
  gfx->setTextWrap(false);
  int16_t bx, by; uint16_t bw, bh;
  gfx->getTextBounds(s, 0, 0, &bx, &by, &bw, &bh);
  gfx->setTextColor(color, COLOR_BLACK);
  int x = (SCREEN_WIDTH - (int)bw) / 2;
  if (margin > 0) {
    int minX = margin;
    int maxX = SCREEN_WIDTH - margin - (int)bw;
    if (maxX < minX) {
      x = minX;
    } else {
      if (x < minX) x = minX;
      if (x > maxX) x = maxX;
    }
  }
  gfx->setCursor(x, y);
  gfx->print(s);
}

static int _clockCenterPrintWrapped(const char* s, int y, int sz, uint16_t color, int margin, int lineGap) {
  gfx->setTextSize(sz);
  gfx->setTextWrap(false);
  int maxWidth = SCREEN_WIDTH - 2 * margin;
  String text(s);
  int len = (int)text.length();
  int start = 0;
  int lineY = y;
  int16_t bx, by; uint16_t bw, bh;
  while (start < len) {
    int end = len;
    while (end > start + 1) {
      String trial = text.substring(start, end);
      gfx->getTextBounds(trial.c_str(), 0, 0, &bx, &by, &bw, &bh);
      if ((int)bw <= maxWidth) break;
      end--;
    }
    int breakAt = end;
    if (end < len) {
      int spaceBreak = -1;
      for (int i = end; i > start; i--) {
        if (text[i - 1] == ' ') { spaceBreak = i; break; }
      }
      if (spaceBreak > start) {
        breakAt = spaceBreak;
      } else {
        for (int i = end; i > start + (end - start) / 2; i--) {
          char c = text[i - 1];
          if (c == '_' || c == '.') { breakAt = i; break; }
        }
      }
    }
    String line = text.substring(start, breakAt);
    line.trim();
    gfx->getTextBounds(line.c_str(), 0, 0, &bx, &by, &bw, &bh);
    gfx->setTextColor(color, COLOR_BLACK);
    gfx->setCursor((SCREEN_WIDTH - (int)bw) / 2, lineY);
    gfx->print(line);
    lineY += lineGap;
    start = breakAt;
    while (start < len && text[start] == ' ') start++;
  }
  return lineY;
}

static String _fitTextWidth(const String& s, int maxWidth) {
  int16_t bx, by; uint16_t bw, bh;
  gfx->getTextBounds(s.c_str(), 0, 0, &bx, &by, &bw, &bh);
  if ((int)bw <= maxWidth || s.length() == 0) return s;
  String t = s;
  while (t.length() > 0) {
    t.remove(t.length() - 1);
    String withEllipsis = t + "...";
    gfx->getTextBounds(withEllipsis.c_str(), 0, 0, &bx, &by, &bw, &bh);
    if ((int)bw <= maxWidth) return withEllipsis;
  }
  return "...";
}

static int getBatteryPercent() {
  if (!pmuOk) return -1;
  if (lastBatRead != 0 && millis() - lastBatRead < 30000) return cachedBatPercent;
  lastBatRead = millis();
  int pct = pmu.getBatteryPercent();
  if (pct >= 0) cachedBatPercent = pct;
  return cachedBatPercent;
}

static String csvEscape(String s) {
  if (s.indexOf(',') < 0 && s.indexOf('"') < 0 && s.indexOf('\n') < 0) return s;
  s.replace("\"", "\"\"");
  return "\"" + s + "\"";
}

