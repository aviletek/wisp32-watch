void handleFileUpload() {
  HTTPUpload& upload = server.upload();
  if (upload.status == UPLOAD_FILE_START) {
    if (!isRequestAuthenticated()) { fsUp.active = false; return; }
    String uploadSubPath = server.hasArg("path") ? sanitizeDirPath(server.arg("path")) : "";
    String uploadDir = String(FILES_DIR) + (uploadSubPath.length() > 0 ? "/" + uploadSubPath : "");
    String path = uploadDir + "/" + upload.filename;
    SD_MMC.remove(path);
    fsUp.outFile = SD_MMC.open(path, FILE_WRITE);
    if (!fsUp.outFile) { fsUp.active = false; return; }
    if (webServerModeActive) {
      wsTransfer = WsTransfer(); wsTransfer.active=true; wsTransfer.isUpload=true; wsTransfer.filename=upload.filename; wsTransfer.startMs=millis();
    }
    fsUp.totalBytes = 0;
    fsUp.active = true;

  } else if (upload.status == UPLOAD_FILE_WRITE) {
    if (!fsUp.active) return;
    fsUp.outFile.write(upload.buf, upload.currentSize);
    fsUp.totalBytes += upload.currentSize;
    yield();
    if (webServerModeActive) {
      wsTransfer.bytes = fsUp.totalBytes;
      static unsigned long _lastUpStatDraw = 0;
      if (millis() - _lastUpStatDraw >= 2000) { _lastUpStatDraw = millis(); }
    }

  } else if (upload.status == UPLOAD_FILE_END) {
    if (!fsUp.active) return;
    fsUp.outFile.close();
    fsUp.active = false;
    if (webServerModeActive) { wsTransfer.active = false; }
  }
}

