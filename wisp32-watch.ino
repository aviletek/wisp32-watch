static String sanitizeDeviceName(String s) {
  s.trim();
  String out;
  for (int i = 0; i < (int)s.length() && (int)out.length() < 32; i++) {
    char c = s[i];
    if (isalnum((unsigned char)c)) out += (char)tolower((unsigned char)c);
    else if (c == '-' || c == '_' || c == ' ') out += '-';
  }
  while (out.length() > 0 && out[0] == '-') out.remove(0, 1);
  while (out.length() > 0 && out[out.length() - 1] == '-') out.remove(out.length() - 1);
  return out;
}

static String defaultDeviceName() {
  uint64_t mac = ESP.getEfuseMac();
  char buf[6];
  snprintf(buf, sizeof(buf), "%05x", (unsigned int)(mac & 0xFFFFF));
  return "watch-" + String(buf);
}

static String deviceIdSuffix() {
  String id = deviceName.startsWith("watch-") ? deviceName.substring(6) : deviceName;
  String safe = "";
  for (size_t i = 0; i < id.length(); i++) {
    char c = id[i];
    if (isAlphaNumeric(c) || c == '-' || c == '_') safe += c;
  }
  if (safe.length() > 5) safe = safe.substring(safe.length() - 5);
  return safe;
}

static String withDeviceSuffix(const String& basename) {
  String sfx = deviceIdSuffix();
  if (sfx.length() == 0) return basename;
  int dot = basename.lastIndexOf('.');
  if (dot <= 0) return basename + "-" + sfx;
  return basename.substring(0, dot) + "-" + sfx + basename.substring(dot);
}

static bool isDeviceGeneratedDownload(const String& relPath) {
