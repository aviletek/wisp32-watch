    "}"
    "document.getElementById('apiAuthTypeSel').addEventListener('change',apiAuthTypeChanged);"
    "function apiOpen(){"
    "document.getElementById('apiMethodSel').value=document.getElementById('apiMethodH').value||'';"
    "document.getElementById('apiUrlIn').value=document.getElementById('apiUrlH').value;"
    "document.getElementById('apiHeadersIn').value=document.getElementById('apiHeadersH').value;"
    "document.getElementById('apiAuthTypeSel').value=document.getElementById('apiAuthTypeH').value||'';"
