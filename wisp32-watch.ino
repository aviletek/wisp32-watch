}

#define AI_FILE_OPEN_MAX_CHARS (200UL * 1024UL)

bool appendKnowledgeFile(String path, String newContent) {
  String existing = "";
  if (SD_MMC.exists(path)) existing = readKnowledgeFile(path);
  String combined = existing;
  if (combined.length() > 0 && !combined.endsWith("\n")) combined += "\n";
  combined += newContent + "\n";
  if (combined.length() > AI_FILE_OPEN_MAX_CHARS) {
    size_t excess = combined.length() - AI_FILE_OPEN_MAX_CHARS;
    int cut = combined.indexOf('\n', excess);
    combined = (cut >= 0) ? combined.substring(cut + 1) : "";
  }
  return writeKnowledgeFile(path, combined);
}

