  auto isSettingsSubpage = [&]() -> bool {
    static const char* subpages[] = {
      "/prompts", "/aimodels", "/tools", "/languages",
      "/credentials", "/credentials/encryption-key", "/configuration"
    };
    for (const char* sp : subpages) if (strcmp(active, sp) == 0) return true;
