}

void aiStartWebSearchAsync(const String& query, const String& argsPreview, const String& callId, bool replyIsGemini) {
  aiInsertOriginTag("web_search");
  aiState = AI_TOOL_CALL;
  aiToolLabel = "Web Search";
  drawAiPage();
  Serial.print("[AI] tool call: web_search args="); Serial.println(argsPreview);
