void handleKbSyncGet() {
  if (!requireAuth()) return;
  String name = server.hasArg("file") ? server.arg("file") : "";
  String url, status; int interval = 60; long last = 0; bool syncInstr = false; bool wipeAfterUse = false;
  bool have = kbSyncGet(name, &url, &interval, &last, &status, &syncInstr, &wipeAfterUse);
  DynamicJsonDocument doc(1024);
  doc["configured"]  = have;
  doc["url"]         = have ? url : "";
  doc["intervalMin"] = have ? interval : 60;
  doc["lastSync"]    = have ? last : 0;
  doc["status"]      = have ? status : "";
  doc["syncInstr"]   = have ? syncInstr : false;
  doc["wipeAfterUse"] = have ? wipeAfterUse : false;
  String out; serializeJson(doc, out);
  server.send(200, "application/json", out);
}

void handleKbSyncSet() {
  if (!requireAuth()) return;
  String name = server.hasArg("file") ? server.arg("file") : "";
  String url  = server.hasArg("url") ? server.arg("url") : "";
  int interval = server.hasArg("intervalMin") ? server.arg("intervalMin").toInt() : 60;
  bool syncInstr = server.hasArg("syncInstr") && server.arg("syncInstr") == "1";
  bool wipeAfterUse = server.hasArg("wipeAfterUse") && server.arg("wipeAfterUse") == "1";
  if (name.length() == 0) { server.send(400, "text/plain", "no file"); return; }
  url.trim();
  if (interval < 1) interval = 1;
  if (url.length() == 0) { kbSyncRemove(name); server.send(200, "text/plain", "removed"); return; }
  kbSyncSet(name, url, interval, syncInstr, wipeAfterUse);
  if (wipeAfterUse) writeKnowledgeFile(String(KNOWLEDGE_DIR) + "/" + name, "");
  server.send(200, "text/plain", "ok");
}

void handleKbSyncRemove() {
  if (!requireAuth()) return;
  String name = server.hasArg("file") ? server.arg("file") : "";
  if (name.length()) kbSyncRemove(name);
  server.send(200, "text/plain", "ok");
}

void handleKbSyncNow() {
  if (!requireAuth()) return;
  String name = server.hasArg("file") ? server.arg("file") : "";
  if (name.length() == 0) { server.send(400, "text/plain", "no file"); return; }
  String err;
  bool ok = kbSyncFileNow(name, err);
  if (ok) reloadKnowledge();
  server.send(ok ? 200 : 502, "text/plain", ok ? "ok" : err);
}

void handleKbAiMetaDownload() {
  if (!requireAuth()) return;
  String fn = server.hasArg("file") ? server.arg("file") : "";
  if (fn.length() == 0) { server.send(400, "text/plain", "no file"); return; }
  String json = kbAiMetaToJson(fn);
  String base = fn; { int s = base.lastIndexOf('/'); if (s >= 0) base = base.substring(s + 1); }
  server.sendHeader("Content-Disposition",
                    "attachment; filename=\"" + base + KB_AIMETA_COMPANION_SUFFIX + "\"");
  server.send(200, "application/json", json);
}

void handleSaveColorTheme() {
  if (!requireAuth()) return;
  String name = server.hasArg("themeName") ? server.arg("themeName") : "";
  name.trim();
  name.replace("|", "");
  name.replace("\n", "");
  name.replace("\r", "");
  if (name.length() > 24) name = name.substring(0, 24);
  if (name.length() > 0) {
    int slot = -1;
    for (int i = 0; i < colorThemeCount; i++) {
      if (colorThemes[i].name == name) { slot = i; break; }
    }
    if (slot < 0 && colorThemes && colorThemeCount < COLOR_THEME_MAX) slot = colorThemeCount++;
    if (slot >= 0) {
      colorThemes[slot].name  = name;
      colorThemes[slot].white = COLOR_WHITE;
      colorThemes[slot].blue  = COLOR_BLUE;
      colorThemes[slot].black = COLOR_BLACK;
      saveColorThemes();
    }
  }
  server.sendHeader("Location", "/configuration"); server.send(303);
}

void handleSaveQrCode() {
  if (!requireAuth()) return;
  String label   = server.hasArg("qrLabel")   ? server.arg("qrLabel")   : "";
  String content = server.hasArg("qrContent") ? server.arg("qrContent") : "";
  label.trim();
  content.trim();
  label.replace("|", "");
  label.replace("\n", "");
  label.replace("\r", "");
  content.replace("\r", "");
  if (label.length() > 50) label = label.substring(0, 50);
  if (content.length() > 500) content = content.substring(0, 500);
  if (label.length() > 0 && content.length() > 0 && qrEntries && qrEntryCount < QR_ENTRY_MAX) {
    label.toCharArray(qrEntries[qrEntryCount].label, sizeof(qrEntries[qrEntryCount].label));
    content.toCharArray(qrEntries[qrEntryCount].content, sizeof(qrEntries[qrEntryCount].content));
    qrEntryCount++;
    saveQrEntries();
  }
  server.sendHeader("Location", "/configuration"); server.send(303);
}

bool aesVerifyRoundTrip(const String& encPath, File& plainSrc, size_t plainSize, const uint8_t* key) {
  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  File enc = SD_MMC.open(encPath, FILE_READ);
  if (_sdMutex) xSemaphoreGive(_sdMutex);
  if (!enc) return false;
  size_t encFileSize = enc.size();
  if (encFileSize < (size_t)(ENCRYPT_MAGIC_LEN + AES_IV_LEN + 16)) {
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    enc.close();
    if (_sdMutex) xSemaphoreGive(_sdMutex);
    return false;
  }
  uint8_t magic[ENCRYPT_MAGIC_LEN];
  uint8_t iv[AES_IV_LEN];
  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  enc.read(magic, ENCRYPT_MAGIC_LEN);
  if (memcmp(magic, ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN) == 0) enc.read(iv, AES_IV_LEN);
  if (_sdMutex) xSemaphoreGive(_sdMutex);
  if (memcmp(magic, ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN) != 0) {
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    enc.close();
    if (_sdMutex) xSemaphoreGive(_sdMutex);
    return false;
  }

  mbedtls_aes_context aes;
  mbedtls_aes_init(&aes);
  mbedtls_aes_setkey_dec(&aes, key, 256);

  const size_t CHUNK = 4096;
  uint8_t* encBuf  = (uint8_t*)ps_malloc(CHUNK);
  uint8_t* decBuf  = (uint8_t*)ps_malloc(CHUNK);
  uint8_t* origBuf = (uint8_t*)ps_malloc(CHUNK);
  bool ok = (encBuf && decBuf && origBuf);

  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  plainSrc.seek(0);
  if (_sdMutex) xSemaphoreGive(_sdMutex);
  size_t plainRemaining = plainSize;
  uint8_t curIV[AES_IV_LEN]; memcpy(curIV, iv, AES_IV_LEN);
  size_t encRemaining = encFileSize - ENCRYPT_MAGIC_LEN - AES_IV_LEN;
  if (ok && (encRemaining == 0 || encRemaining % 16 != 0)) ok = false;

  while (ok && encRemaining > 0) {
    size_t toRead = min(encRemaining, CHUNK);
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    size_t didRead = enc.read(encBuf, toRead);
    if (_sdMutex) xSemaphoreGive(_sdMutex);
    if (didRead == 0 || didRead % 16 != 0) { ok = false; break; }
    for (size_t blk = 0; blk < didRead; blk += 16) {
      uint8_t* eb = encBuf + blk; uint8_t* db = decBuf + blk;
      mbedtls_aes_crypt_ecb(&aes, MBEDTLS_AES_DECRYPT, eb, db);
      for (int i = 0; i < 16; i++) db[i] ^= curIV[i];
      memcpy(curIV, eb, 16);
    }
    encRemaining -= didRead;
    size_t thisChunkPlainLen = didRead;
    if (encRemaining == 0) {
      uint8_t padByte = decBuf[didRead - 1];
      if (padByte < 1 || padByte > 16 || (size_t)padByte > didRead) { ok = false; break; }
      thisChunkPlainLen = didRead - padByte;
    }
    if (thisChunkPlainLen > plainRemaining) { ok = false; break; }
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    size_t origRead = plainSrc.read(origBuf, thisChunkPlainLen);
    if (_sdMutex) xSemaphoreGive(_sdMutex);
    if (origRead != thisChunkPlainLen || memcmp(decBuf, origBuf, thisChunkPlainLen) != 0) { ok = false; break; }
    plainRemaining -= thisChunkPlainLen;
    vTaskDelay(1);
  }
  if (ok && plainRemaining != 0) ok = false;

  free(encBuf); free(decBuf); free(origBuf);
  mbedtls_aes_free(&aes);
  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  enc.close();
  if (_sdMutex) xSemaphoreGive(_sdMutex);
  return ok;
}

