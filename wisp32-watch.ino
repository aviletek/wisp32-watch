static String buildStatusBar() {
  int pct = getBatteryPercent();
  bool charging = pmuOk && pmu.isCharging();
  int rssi = WiFi.RSSI();

  String battClass = "neutral", battVal = "&mdash;";
  if (pct >= 0) {
    battVal = String(pct) + "%";
    battClass = (pct >= 50) ? "good" : (pct >= 20) ? "warn" : "crit";
  }

  String sigLabel = escapeHtmlAttr(WiFi.SSID());
  String sigClass, sigQuality;
  if (rssi >= -60)      { sigClass = "good";    sigQuality = "Strong"; }
  else if (rssi >= -75) { sigClass = "neutral"; sigQuality = "Good"; }
  else                  { sigClass = "warn";    sigQuality = "Weak"; }

  String out = "<div class='statusbar'>";
  out += "<a class='sb-device' href='" + String(firstNavTabHref()) + "' title='Open " + escapeHtmlAttr(String(firstNavTabLabel())) + "'>"
         "<span class='sb-dot'></span><span class='sb-name'>" + escapeHtmlAttr(deviceName) + "</span></a>";
  out += "<div class='sb-stats'>";
