void taskStampRestartingStatus(int idx) {
  activePageTasks[idx].lastRunStatus = "Restarting to free up memory - resuming automatically...";
  savePageTasks();
}

bool checkAndRunDueTasks() {
  if (WiFi.status() != WL_CONNECTED) return false;
  if (wxFetchRunning) return false;
  int idx = nextDueTaskIndex();
  if (idx < 0) return false;
  if (pageTaskNeedsModel(activePageTasks[idx]) && !aiProviderHasKeyFor(activePageTasks[idx].model, false)) return false;
  if (ESP.getMaxAllocHeap() < HEAP_HEALTH_MIN_ALLOC) {
    if (heapRestartStreak < 2) {
      Serial.printf("[Heap] max alloc %u below %u with task \"%s\" due — restarting first so it runs on a clean heap\n",
                    (unsigned)ESP.getMaxAllocHeap(), (unsigned)HEAP_HEALTH_MIN_ALLOC, activePageTasks[idx].name.c_str());
      taskStampRestartingStatus(idx);
      heapRestartStreak++;
      saveTaskRestartState(taskRunAfterRestartIdx, heapRestartStreak);
      delay(50);
      ESP.restart();
    }
    Serial.printf("[Heap] max alloc %u still below %u after %u restarts — running task \"%s\" anyway\n",
                  (unsigned)ESP.getMaxAllocHeap(), (unsigned)HEAP_HEALTH_MIN_ALLOC, (unsigned)heapRestartStreak, activePageTasks[idx].name.c_str());
  }
  runPageTaskByIndex(idx);
  return true;
}

