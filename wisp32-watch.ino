void handleDecryptFilesDir() {
  if (!requireAuth()) return;
  if (!sdMounted) { server.send(500, "text/plain", "SD not mounted"); return; }

  int decrypted = 0, skipped = 0, failed = 0;
  String log = "";

  File dir = SD_MMC.open(FILES_DIR);
  while (true) {
    File entry = dir.openNextFile();
    if (!entry) break;
    String name = String(entry.name());
    entry.close();
    if (name.endsWith(".meta")) continue;

    String srcPath = String(FILES_DIR) + "/" + name;
    File src = SD_MMC.open(srcPath, FILE_READ);
    if (!src) { failed++; log += name + ": open failed<br>"; continue; }

    size_t fileSize = src.size();
    if (fileSize < (size_t)(ENCRYPT_MAGIC_LEN + AES_IV_LEN + 16)) {
      src.close(); skipped++; continue;
    }
    uint8_t magic[ENCRYPT_MAGIC_LEN];
    src.read(magic, ENCRYPT_MAGIC_LEN);
    if (memcmp(magic, ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN) != 0) {
      src.close(); skipped++; continue;
    }

    uint8_t iv[AES_IV_LEN];
    src.read(iv, AES_IV_LEN);

    size_t origSize = getStoredFileOrigSize(name);

    String tmpPath = String(FILES_DIR) + "/_tmp_dec_";
    SD_MMC.remove(tmpPath);
    File dst = SD_MMC.open(tmpPath, FILE_WRITE);
    if (!dst) { src.close(); failed++; log += name + ": tmp open failed<br>"; continue; }

    mbedtls_aes_context aes;
    mbedtls_aes_init(&aes);
    mbedtls_aes_setkey_dec(&aes, activeAesKey, 256);

    const size_t CHUNK = 4096;
    uint8_t* encBuf = (uint8_t*)ps_malloc(CHUNK);
    uint8_t* decBuf = (uint8_t*)ps_malloc(CHUNK);
    bool ok = (encBuf && decBuf);

    if (ok) {
      uint8_t curIV[AES_IV_LEN];
      memcpy(curIV, iv, AES_IV_LEN);
      size_t encRemaining = fileSize - ENCRYPT_MAGIC_LEN - AES_IV_LEN;
      size_t totalWritten = 0;

      while (encRemaining > 0) {
        size_t toRead = min(encRemaining, CHUNK);
        toRead = (toRead / 16) * 16;
        if (toRead == 0) break;
        size_t didRead = src.read(encBuf, toRead);
        if (didRead == 0) break;
        didRead = (didRead / 16) * 16;

        for (size_t blk = 0; blk < didRead; blk += 16) {
          uint8_t* eb = encBuf + blk;
          uint8_t* db = decBuf + blk;
          mbedtls_aes_crypt_ecb(&aes, MBEDTLS_AES_DECRYPT, eb, db);
          for (int i = 0; i < 16; i++) db[i] ^= curIV[i];
          memcpy(curIV, eb, 16);
        }

        encRemaining -= didRead;
        size_t toWrite = didRead;
        if (encRemaining == 0) {
          uint8_t padByte = decBuf[didRead - 1];
          if (padByte >= 1 && padByte <= 16) toWrite = didRead - padByte;
        }
        if (origSize > 0 && totalWritten + toWrite > origSize) toWrite = origSize - totalWritten;
        dst.write(decBuf, toWrite);
        totalWritten += toWrite;
        yield();
      }
    }

    if (encBuf) free(encBuf);
    if (decBuf) free(decBuf);
    mbedtls_aes_free(&aes);
    src.close();
    dst.close();

    if (!ok) {
      SD_MMC.remove(tmpPath);
      failed++; log += name + ": malloc failed<br>"; continue;
    }

    SD_MMC.remove(srcPath);
    SD_MMC.rename(tmpPath, srcPath);
    SD_MMC.remove(String(FILES_DIR) + "/" + name + ".meta");
    decrypted++;
    log += name + ": OK<br>";
  }
  dir.close();

  String html = "<!DOCTYPE html><html><head><meta charset='UTF-8'><title>" + webTitleBrand() + "</title>" WEB_FAVICON
    "<style>body{font-family:sans-serif;background:#111;color:#eee;padding:20px}"
    "a{color:#4af}.ok{color:#4f4}.err{color:#f44}</style></head><body>"
    "<h2>Decrypt Files — Done</h2>"
    "<p>Decrypted: <b class='ok'>" + String(decrypted) + "</b> &nbsp; "
    "Skipped (already plain): <b>" + String(skipped) + "</b> &nbsp; "
    "Failed: <b class='err'>" + String(failed) + "</b></p>"
    "<pre style='font-size:.85em;line-height:1.6'>" + log + "</pre>"
    "<p><a href='/files'>&larr; Back to Files</a></p>"
    "</body></html>";
  server.send(200, "text/html; charset=utf-8", html);
}

void handleRunTask() {
  if (!requireAuth()) return;
  if (!server.hasArg("file")) { server.sendHeader("Location", "/"); server.send(303); return; }
  String fn = server.arg("file");

  String msg = taskExecute(fn);
  bool ok = (msg == "Task complete");

  int ls = fn.lastIndexOf('/');
  String pp = (ls > 0) ? fn.substring(0, ls) : "";
  String loc = String("/") + (pp.length() > 0 ? "?path=" + pp + "&" : "?")
             + "taskmsg=" + urlEncodeParam(msg) + "&taskok=" + (ok ? "1" : "0");
  server.sendHeader("Location", loc);
  server.send(303);
}

