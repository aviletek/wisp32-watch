void handleSavePrompts() {
  if (!requireAuth()) return;
  String aiPrompt = server.hasArg("aiPrompt") ? server.arg("aiPrompt") : "";
  String wsPrompt = server.hasArg("wsPrompt") ? server.arg("wsPrompt") : "";
  aiPrompt.replace("\r\n", "\n"); wsPrompt.replace("\r\n", "\n");
  aiPrompt.trim(); wsPrompt.trim();

  if (aiPrompt.length() == 0 || aiPrompt == String(DEFAULT_AI_PROMPT)) {
    customAiPrompt = "";
    if (sdMounted && SD_MMC.exists(PROMPT_AI_FILE)) SD_MMC.remove(PROMPT_AI_FILE);
  } else {
    customAiPrompt = aiPrompt;
    if (sdMounted) writeKnowledgeFile(PROMPT_AI_FILE, aiPrompt);
  }

  if (wsPrompt.length() == 0 || wsPrompt == String(DEFAULT_WEBSEARCH_PROMPT)) {
    customWebSearchPrompt = "";
    if (sdMounted && SD_MMC.exists(PROMPT_WEBSEARCH_FILE)) SD_MMC.remove(PROMPT_WEBSEARCH_FILE);
  } else {
    customWebSearchPrompt = wsPrompt;
    if (sdMounted) writeKnowledgeFile(PROMPT_WEBSEARCH_FILE, wsPrompt);
  }

  aiPromptAppendTime = server.hasArg("aiTime");
  webSearchPromptAppendTime = server.hasArg("wsTime");
  saveSettings();

  redirectWithSaveMessage("/prompts", "Saved");
}

