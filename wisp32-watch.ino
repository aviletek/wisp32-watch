String jsonEscape(String s) {
  s.replace("\\","\\\\"); s.replace("\"","\\\"");
  s.replace("\n","\\n"); s.replace("\r","\\r"); s.replace("\t"," ");
  String r = ""; r.reserve(s.length());
  for (int i=0;i<(int)s.length();i++) { if ((uint8_t)s[i]>=32) r+=s[i]; } return r;
}

void jsonEscapeAppendTo(String& out, const String& in) {
  size_t n = in.length();
  for (size_t i = 0; i < n; i++) {
    char c = in[i];
    switch (c) {
      case '\\': out += "\\\\"; break;
      case '"':  out += "\\\""; break;
      case '\n': out += "\\n"; break;
      case '\r': out += "\\r"; break;
      case '\t': out += ' '; break;
      default:
        if ((uint8_t)c >= 32) out += c;
        break;
    }
  }
}

String rgb565ToHex(uint16_t c) {
  uint8_t r = ((c >> 11) & 0x1F) * 255 / 31;
  uint8_t g = ((c >> 5)  & 0x3F) * 255 / 63;
  uint8_t b = (c & 0x1F) * 255 / 31;
  char buf[8];
  snprintf(buf, sizeof(buf), "#%02X%02X%02X", r, g, b);
  return String(buf);
}
uint16_t hexToRgb565(String hex) {
  hex.trim();
  if (hex.startsWith("#")) hex = hex.substring(1);
  if (hex.length() != 6) return COLOR_WHITE;
  long v = strtol(hex.c_str(), NULL, 16);
  uint8_t r = (v >> 16) & 0xFF, g = (v >> 8) & 0xFF, b = v & 0xFF;
  return ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3);
}

String stripCitations(String s) {
  String r = ""; bool inB = false;
  for (int i = 0; i < (int)s.length(); i++) {
    if (s[i]=='[') inB=true; else if (s[i]==']') inB=false; else if (!inB) r+=s[i];
  }
  return r;
}

bool requireAuth() {
  lastWebActivityMs = millis();
  lastWebRequestUri = server.uri();
  if (activeWebPassword.length() == 0) {
    if (!sdCardRecognized) authorizeCurrentSdCard();
    return true;
  }
  if (server.authenticate("admin", activeWebPassword.c_str())) {
    if (!sdCardRecognized) authorizeCurrentSdCard();
    return true;
  }
  bool hasAuthHeader = server.hasHeader("Authorization");
  Serial.printf("[Auth] FAILED for %s — Authorization header present=%d, stored password length=%u\n",
                server.uri().c_str(), (int)hasAuthHeader, (unsigned)activeWebPassword.length());
  server.requestAuthentication(BASIC_AUTH, "device", "Device access (username: admin)");
  return false;
}

