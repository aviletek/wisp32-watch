static String taskStackJson(TaskHandle_t h, size_t reserved) {
  if (!h) return "{\"running\":false,\"used\":0,\"reserved\":" + String((unsigned long)reserved) + "}";
  long used = (long)reserved - (long)uxTaskGetStackHighWaterMark(h);
  if (used < 0) used = 0;
  return "{\"running\":true,\"used\":" + String((unsigned long)used) + ",\"reserved\":" + String((unsigned long)reserved) + "}";
}

