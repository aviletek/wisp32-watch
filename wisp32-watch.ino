static String resetReasonName(esp_reset_reason_t r) {
  switch (r) {
    case ESP_RST_POWERON:   return "power-on";
    case ESP_RST_EXT:       return "external pin";
    case ESP_RST_SW:        return "software reset";
    case ESP_RST_PANIC:     return "panic/exception";
    case ESP_RST_INT_WDT:   return "interrupt watchdog";
    case ESP_RST_TASK_WDT:  return "task watchdog";
    case ESP_RST_WDT:       return "other watchdog";
    case ESP_RST_DEEPSLEEP: return "deep sleep wake";
    case ESP_RST_BROWNOUT:  return "brownout (power dip)";
    case ESP_RST_SDIO:      return "SDIO";
    default:                return "unknown(" + String((int)r) + ")";
  }
}

void setup() {
  Serial.begin(115200);
  Serial.setTxTimeoutMs(0);
  bootStartMs = millis();
  esp_sleep_wakeup_cause_t wakeupCause = esp_sleep_get_wakeup_cause();
  Serial.print("[Power] wakeup cause: ");
  Serial.println((int)wakeupCause);
  wokeFromDeepSleep = (wakeupCause == ESP_SLEEP_WAKEUP_EXT0 || wakeupCause == ESP_SLEEP_WAKEUP_TIMER);
  bool wokeForAlarm = (wakeupCause == ESP_SLEEP_WAKEUP_TIMER) && checkAndClearDueAlarms();
  bool keepScreenOffForMemReset = wokeForSilentMemReset;
  wokeForSilentMemReset = false;

  sntp_set_sync_interval(12UL * 3600UL * 1000UL);
  configTime(-4 * 3600, 0, "pool.ntp.org");
  sntp_set_time_sync_notification_cb(onNtpTimeSync);

  _wxStrMutex = xSemaphoreCreateMutex();
  _netMutex   = xSemaphoreCreateMutex();
  _sdMutex    = xSemaphoreCreateMutex();
  aiWsMutex   = xSemaphoreCreateMutex();

  if (!allocPageTasksInPsram()) {
    Serial.println("[Tasks] PSRAM allocation for activePageTasks failed — Tasks feature disabled this boot");
  }
  if (!allocToolDescsInPsram()) {
    Serial.println("[Tools] PSRAM allocation for activeToolDescs failed — description editing disabled this boot");
  }
  if (!allocContactsInPsram()) {
    Serial.println("[Contacts] PSRAM allocation for activeContacts failed — contacts disabled this boot");
  }
  if (!allocWifiNetworksInPsram()) {
    Serial.println("[WiFi] PSRAM allocation for activeWifiNetworks failed — no saved networks available this boot");
  }
  if (!allocCustomKeysInPsram()) {
    Serial.println("[Keys] PSRAM allocation for activeCustomKeys failed — user API keys disabled this boot");
  }
  if (!allocAiToolHistoryInPsram()) {
    Serial.println("[AI] PSRAM allocation for aiToolHistory failed — tool call history disabled this boot");
  }
  if (!allocColorThemesInPsram()) {
    Serial.println("[Display] PSRAM allocation for colorThemes failed — saved color themes disabled this boot");
  }
  if (!allocAiTextLinesInPsram()) {
    Serial.println("[AI] PSRAM allocation for aiTextLines failed — on-screen conversation text disabled this boot");
  }
  if (!allocPendingEmailAttachmentsInPsram()) {
    Serial.println("[AI] PSRAM allocation for pendingEmailAttachments failed — live-session email attachments disabled this boot");
  }
  if (!allocAppEntriesInPsram()) {
    Serial.println("[Apps] PSRAM allocation for appEntries failed — Apps tab disabled this boot");
  }
  if (!allocAppsScanBufInPsram()) {
    Serial.println("[Apps] PSRAM allocation for appsScanBuf failed — Apps tab disabled this boot");
  }
  if (!allocQrBuffersInPsram()) {
    Serial.println("[QR] PSRAM allocation for qrTempBuf/qrCodeBuf failed — QR page disabled this boot");
  }
  if (!allocQrEntriesInPsram()) {
    Serial.println("[QR] PSRAM allocation for qrEntries failed — saved QR codes disabled this boot");
  }

  MODEL_GPT.system_prompt = "You are a helpful multilingual assistant. "
                             "Keep responses under 50 words.";
  activeModel = MODEL_GPT;

  pinMode(AMOLED_PWR_EN, OUTPUT);
  digitalWrite(AMOLED_PWR_EN, HIGH);
  delay(10);

  IIC_Bus = std::make_shared<Arduino_HWIIC>(TP_SDA, TP_SCL, &Wire);
  touchFT3168.reset(new Arduino_FT3x68(
    IIC_Bus, FT3168_DEVICE_ADDRESS, TP_RST, TP_INT, Arduino_IIC_Touch_Interrupt));
  touchOk = touchFT3168->begin();
  if (touchOk) {
    touchFT3168->IIC_Write_Device_State(touchFT3168->Arduino_IIC_Touch::Device::TOUCH_POWER_MODE,
                                        touchFT3168->Arduino_IIC_Touch::Device_Mode::TOUCH_POWER_MONITOR);
  }

  pmuOk = pmu.begin(Wire, AXP2101_SLAVE_ADDRESS, SDA, SCL);
  if (pmuOk) {
    pmu.setPowerKeyPressOffTime(XPOWERS_POWEROFF_10S);
    pmu.enableIRQ(XPOWERS_AXP2101_PKEY_SHORT_IRQ);
    pmu.clearIrqStatus();
  }

  pcf85063SyncToSystemClock();

  {
    time_t nowEpoch = time(nullptr);
    long ageS = (long)(nowEpoch - weatherCacheEpoch);
    if (weatherCacheValid && ageS >= 0 && (unsigned long)ageS < WEATHER_CACHE_MAX_AGE_S) {
      clockTempC       = weatherCacheTempC;
      clockFeelsC      = weatherCacheFeelsC;
      clockTempMin     = weatherCacheTempMin;
      clockTempMax     = weatherCacheTempMax;
      clockRainPct     = weatherCacheRainPct;
      clockWeatherCode = weatherCacheWeatherCode;
      clockHumidity    = weatherCacheHumidity;
      clockWindSpeed   = weatherCacheWindSpeed;
      clockPressure    = weatherCachePressure;
      clockSunrise     = String(weatherCacheSunrise);
      clockSunset      = String(weatherCacheSunset);
      lastWeatherFetch = millis();
      Serial.printf("[Weather] restored from RTC cache, age=%lds — skipping boot fetch\n", ageS);
    }
  }

  gpio_hold_dis(GPIO_NUM_46);

  audioCodecInit();
  Serial.println(audioOk    ? "[Audio] ES8311 (speaker) ready" : "[Audio] ES8311 init failed");
  Serial.println(micArrayOk ? "[Audio] ES7210 (mic array) ready" : "[Audio] ES7210 init failed");

  if (gfx->begin()) {
    screenMirrorAvailable = true;
    Serial.println("[Display] PSRAM canvas ready — watch.local/screen available");
  } else {
    Serial.println("[Display] PSRAM canvas alloc failed — falling back to direct panel draw, no /screen mirror");
    gfx = gfxPanel;
    if (!gfx->begin()) {
      Serial.println("[Display] gfxPanel->begin() failed");
    }
  }
  if (keepScreenOffForMemReset && !wokeForAlarm) sleepDisplay();

  parseTranslatorLangsList();
  parseRealtimeModelsList();
  aiRealtimeModel = aiRealtimeModels[aiModelIndex];
  parseOpenAiVoicesList();
  aiOpenAiVoice = aiOpenAiVoices[aiOpenAiVoiceIndex];
  parseGeminiVoicesList();
  aiGeminiVoice = aiGeminiVoices[aiGeminiVoiceIndex];
  parseEffortLevelsList();
  parseFileQaModelsList();
  activeFileQaModel = aiFileQaModels[aiFileQaModelIndex - 1];
  parseDeepThinkModelsList();
  activeDeepThinkModel = aiDeepThinkModels[aiDeepThinkModelIndex - 1];
  parseTaskModelsList();
  parseWebSearchModelsList();
  activeWebSearchModel = aiWebSearchModels[aiWebSearchModelIndex - 1];
  parseTranslatorModelsList();
  activeTranslatorRealtimeModel = aiTranslatorModels[aiTranslatorModelIndex - 1];
  parseVoiceToTextModelsList();
  activeVoiceToTextModel = aiVoiceToTextModels[aiVoiceToTextModelIndex - 1];
  parseNoteTitleModelsList();
  activeNoteTitleModel = aiNoteTitleModels[aiNoteTitleModelIndex - 1];

  if (mountSD()) {
    wispTracePurgeIfDisabled();
    wispTrace("BOOT resetReason=" + String((int)esp_reset_reason()) + " wakeupCause=" + String((int)wakeupCause)
              + " wokeFromDeepSleep=" + String(wokeFromDeepSleep ? 1 : 0)
              + " heap=" + String(ESP.getFreeHeap()) + " psram=" + String(ESP.getFreePsram()));
    if (wokeForAlarm && logEventsEnabled && lastFiredAlarmNames.length() > 0) {
      logToolCallEvent("system", "alarm_fired", 0, "name=" + lastFiredAlarmNames, "Fired");
    }
    if (!wokeFromDeepSleep) {
      logToolCallEvent("system", "power_reset", 0,
                        "resetReason=" + resetReasonName(esp_reset_reason()),
                        "Device rebooted from power loss/reset (not sleep) -- any alarms or AI timers that were set did not survive and were cleared.");
    }
    checkSdCardIdentity();
    if (!SD_MMC.exists(KNOWLEDGE_DIR)) SD_MMC.mkdir(KNOWLEDGE_DIR);
    if (!SD_MMC.exists(FILES_DIR))     SD_MMC.mkdir(FILES_DIR);
    {
      String oldMemPath = String(KNOWLEDGE_DIR) + "/memory.txt";
      String newMemPath = String(KNOWLEDGE_DIR) + "/" + AI_MEMORIES_FILE;
      if (!SD_MMC.exists(newMemPath) && SD_MMC.exists(oldMemPath)) {
        SD_MMC.rename(oldMemPath, newMemPath);
        Serial.println("[Memory] migrated memory.txt -> memory.md");
      }
    }
    loadEncryptionState();
    loadSecretsBaselineKey();
    loadSettings();
  }

  if (deviceName.length() == 0) {
    deviceName = defaultDeviceName();
    if (sdMounted) saveSettings();
  }

  if (wokeForAlarm) {
    Serial.println("[Power] woke for alarm");
    fireAlarm();
  }

  if (wokeFromAiConnectionError) {
    Serial.println("[Power] woke to retry AI connection");
    pendingAiReopenAfterWake = true;
    wokeFromAiConnectionError = false;
  }

  if (sdMounted) {
    loadPrompts();
    loadToolDescriptions();
    loadColorThemes();
    applyActiveTheme();
    loadQrEntries();
    loadCredentials();
    seedUiLangs();
    loadUiLang(uiLangIndex);
    loadContacts();
    loadPageTasks();
    loadAndClearTaskRestartState(taskRunAfterRestartIdx, heapRestartStreak);
    if (taskRunAfterRestartIdx >= 0 && taskRunAfterRestartIdx < activePageTaskCount) {
      Serial.printf("[Heap] resuming task \"%s\" deferred across the restart\n",
                    activePageTasks[taskRunAfterRestartIdx].name.c_str());
      pendingWebTaskRunIdx = taskRunAfterRestartIdx;
    }
    taskRunAfterRestartIdx = -1;
    if (audioOk) es8311_voice_volume_set(esHandle, speakerVolumeCurve(speakerVolume), NULL);
    applyScreenBrightness();
    reloadKnowledge();
    Serial.printf("[KB] loaded %u bytes\n", (unsigned)knowledgeSize);
  }
  MODEL_GPT.api_key = activeOpenAiKey;

  drawClockScreen();
  if (keepScreenOffForMemReset) sleepDisplay();
  lastActivityTime = millis();
  Serial.printf("[Boot] Pre-WiFi init done, t=%lums\n", millis() - bootStartMs);

  startWebServer();

  if (!sdMounted) {
    Serial.println("[Boot] No SD card detected");
    drawSdCardMissingScreen();
  } else if (activeWifiNetworkCount == 0) {
    Serial.println("[Boot] No WiFi networks configured — entering mandatory WiFi Setup");
    wifiSetupMandatory = true;
    wifiSetupPortalActive = true;
    wifiSetupSubmitted = false;
    WiFi.mode(WIFI_AP_STA);
    WiFi.softAP("Watch-Setup");
    drawWifiSetupMandatoryScreen();
  } else {
    for (int i = 0; i < activeWifiNetworkCount; i++) {
      wifiMulti.addAP(activeWifiNetworks[i].ssid.c_str(), activeWifiNetworks[i].pass.c_str());
    }
    if (wifiTryDirectConnect()) {
      wifiFastPathPending = true;
      wifiFastPathDeadlineMs = millis() + 6000;
    } else {
      wifiMulti.run(0);
    }
    WiFi.setSleep(false);
    Serial.printf("[Boot] WiFi connect kicked off, t=%lums\n", millis() - bootStartMs);
  }

  if (!wifiTaskStack) wifiTaskStack = (StackType_t*)ps_malloc(WIFI_TASK_STACK_BYTES);
  if (wifiTaskStack) {
    wifiTaskHandle = xTaskCreateStaticPinnedToCore(_wifiReconnectTask, "wifi_reconnect", WIFI_TASK_STACK_BYTES, NULL, 2, wifiTaskStack, &wifiTaskTCB, 1);
    Serial.println("[Mem] wifi_reconnect stack allocated in PSRAM (4KB kept out of SRAM)");
  } else {
    Serial.println("[Mem] wifi_reconnect PSRAM stack alloc failed — falling back to internal");
    xTaskCreatePinnedToCore(_wifiReconnectTask, "wifi_reconnect", WIFI_TASK_STACK_BYTES, NULL, 2, &wifiTaskHandle, 1);
  }

  Serial.printf("%s.local ready\n", deviceName.c_str());

  pinMode(WAKE_BUTTON_PIN, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(WAKE_BUTTON_PIN), wakeButtonISR, CHANGE);

  Serial.println("[Mem] ── Boot memory breakdown ──");
  Serial.printf("[Mem] Internal heap: total=%u free=%u min-ever-free=%u max-contiguous=%u\n",
                (unsigned)ESP.getHeapSize(), (unsigned)ESP.getFreeHeap(),
                (unsigned)ESP.getMinFreeHeap(), (unsigned)ESP.getMaxAllocHeap());
  Serial.printf("[Mem] PSRAM: total=%u free=%u\n",
                (unsigned)ESP.getPsramSize(), (unsigned)ESP.getFreePsram());
  Serial.printf("[Mem] Gap between 512KB silicon and the heap above (WiFi/TCP-IP "
                "stack buffers, IRAM code, other ESP-IDF-reserved regions — not "
                "further breakable down without full heap tracing): ~%d bytes\n",
                (int)(512 * 1024) - (int)ESP.getHeapSize());
  if (aiPlaybackTaskHandle) {
    Serial.printf("[Mem] aiPlayback task stack: reserved=%d unused-floor=%u (peak usage so far ~%d)\n",
                  AI_TASK_STACK_BYTES, (unsigned)uxTaskGetStackHighWaterMark(aiPlaybackTaskHandle),
                  AI_TASK_STACK_BYTES - (int)uxTaskGetStackHighWaterMark(aiPlaybackTaskHandle));
  }
  if (aiDeltaTaskHandle) {
    Serial.printf("[Mem] aiDelta task stack: reserved=%d unused-floor=%u (peak usage so far ~%d)\n",
                  AI_TASK_STACK_BYTES, (unsigned)uxTaskGetStackHighWaterMark(aiDeltaTaskHandle),
                  AI_TASK_STACK_BYTES - (int)uxTaskGetStackHighWaterMark(aiDeltaTaskHandle));
  }
  if (aiRecordTaskHandle) {
    Serial.printf("[Mem] aiRecord task stack: reserved=%d unused-floor=%u (peak usage so far ~%d)\n",
                  AI_TASK_STACK_BYTES, (unsigned)uxTaskGetStackHighWaterMark(aiRecordTaskHandle),
                  AI_TASK_STACK_BYTES - (int)uxTaskGetStackHighWaterMark(aiRecordTaskHandle));
  }
  if (wxTaskHandle) {
    Serial.printf("[Mem] wx_fetch task stack: reserved=%u unused-floor=%u (peak usage so far ~%d)\n",
                  (unsigned)WX_TASK_STACK_BYTES, (unsigned)uxTaskGetStackHighWaterMark(wxTaskHandle),
                  (int)WX_TASK_STACK_BYTES - (int)uxTaskGetStackHighWaterMark(wxTaskHandle));
  } else {
    Serial.printf("[Mem] wx_fetch task stack: reserved=%u (task not created yet — no weather fetch has run this boot)\n",
                  (unsigned)WX_TASK_STACK_BYTES);
  }
  {
    size_t loopStackTotal = getArduinoLoopTaskStackSize();
    UBaseType_t loopUnusedFloor = uxTaskGetStackHighWaterMark(NULL);
    Serial.printf("[Mem] Arduino loop() task stack: reserved=%u unused-floor=%u (touched-so-far ~%d)\n",
                  (unsigned)loopStackTotal, (unsigned)loopUnusedFloor,
                  (int)loopStackTotal - (int)loopUnusedFloor);
  }
  Serial.println("[Mem] ── End memory breakdown ──");
  sramFreeAfterBoot = ESP.getFreeHeap();
}

void loop() {

  if (WiFi.status() == WL_CONNECTED) {
    wifiDisconnectedSinceMs = 0;
  } else if (wifiDisconnectedSinceMs == 0) {
    wifiDisconnectedSinceMs = millis();
  }

  if (aiPageOpen || translatorPageOpen) {
    if (aiWsMutex) xSemaphoreTake(aiWsMutex, portMAX_DELAY);
    aiClient.poll();
    if (aiWsMutex) xSemaphoreGive(aiWsMutex);
    if (aiListening) aiPumpRecording();
  }
  if (aiOpenAiSendDone) {
    aiOpenAiSendDone = false;
    drawAiOrTranslatorPage();
  }
  if (aiWebSearchDone) {
    aiWebSearchDone = false;
    netToolSramDeltaBytes = (long)netToolHeapBefore - (long)ESP.getFreeHeap();
    netToolActive = false;
    netToolEndCount++;

    unsigned long toolDurationMs = millis() - aiWebSearchStartMs;
    logToolCallEvent("live", "web_search", toolDurationMs, aiWebSearchArgsPreview, aiWebSearchResult);
    Serial.print("[AI] tool result: "); Serial.println(aiWebSearchResult);
    logAiToolCall("Web Search", aiWebSearchResult);
    if (saveHistoryMode >= SAVE_TEXT) {
      aiToolCallLog += "\n\n<em>Tool : Web Search\n\nModel : " + activeWebSearchModel
                      + "\n\nQuery : " + aiWebSearchQuery + "\n\nResponse : " + aiWebSearchResult + "</em>\n";
    }

    if (aiWebSearchReplyIsGemini) {
      DynamicJsonDocument out(aiWebSearchResult.length() + 512);
      JsonObject toolResponse = out.createNestedObject("toolResponse");
      JsonArray funcResponses = toolResponse.createNestedArray("functionResponses");
      JsonObject fr = funcResponses.createNestedObject();
      if (aiWebSearchCallId.length() > 0) fr["id"] = aiWebSearchCallId;
      fr["name"] = "web_search";
      fr.createNestedObject("response")["result"] = aiWebSearchResult;
      String outStr; serializeJson(out, outStr);
      aiClient.send(outStr);
    } else {
      DynamicJsonDocument out(aiWebSearchResult.length() + 512);
      out["type"] = "conversation.item.create";
      JsonObject item = out.createNestedObject("item");
      item["type"] = "function_call_output";
      item["call_id"] = aiWebSearchCallId;
      item["output"] = aiWebSearchResult;
      String outStr; serializeJson(out, outStr);
      aiClient.send(outStr);
      aiResponseHadToolCall = true;
      sendAiResponseCreate();
    }
  }
  if (aiNetToolDone) {
    aiNetToolDone = false;
    netToolSramDeltaBytes = (long)netToolHeapBefore - (long)ESP.getFreeHeap();
    netToolActive = false;
    netToolEndCount++;

    unsigned long toolDurationMs = millis() - aiNetToolStartMs;
    logToolCallEvent("live", aiNetToolName.c_str(), toolDurationMs, aiNetToolArgsPreview, aiNetToolResult);
    Serial.print("[AI] tool result (async): "); Serial.println(aiNetToolResult);
    String histToolLabel = aiNetToolLabel;
    if (aiNetToolName == "ask_file_question" && largeFileName.length() > 0) {
      histToolLabel += " (" + largeFileName + ")";
    }
    logAiToolCall(histToolLabel, aiNetToolResult);
    if (saveHistoryMode >= SAVE_TEXT) {
      aiToolCallLog += "\n\n<em>Tool : " + histToolLabel
                      + "\n\nResponse : " + aiNetToolResult + "</em>\n";
    }

    if (aiNetToolReplyIsGemini) {
      DynamicJsonDocument out(aiNetToolResult.length() + 512);
      JsonObject toolResponse = out.createNestedObject("toolResponse");
      JsonArray funcResponses = toolResponse.createNestedArray("functionResponses");
      JsonObject fr = funcResponses.createNestedObject();
      if (aiNetToolCallId.length() > 0) fr["id"] = aiNetToolCallId;
      fr["name"] = aiNetToolName;
      fr.createNestedObject("response")["result"] = aiNetToolResult;
      String outStr; serializeJson(out, outStr);
      aiClient.send(outStr);
    } else {
      DynamicJsonDocument out(aiNetToolResult.length() + 512);
      out["type"] = "conversation.item.create";
      JsonObject item = out.createNestedObject("item");
      item["type"] = "function_call_output";
      item["call_id"] = aiNetToolCallId;
      item["output"] = aiNetToolResult;
      String outStr; serializeJson(out, outStr);
      aiClient.send(outStr);
      aiResponseHadToolCall = true;
      sendAiResponseCreate();
    }
  }
  if (!toolLogShouldDefer()) flushPendingToolLog();

  if (aiPendingAudioLogFinalize && aiDeltaQueue &&
      (uxQueueMessagesWaiting(aiDeltaQueue) == 0 || millis() - aiPendingAudioLogSetMs > 5000)) {
    aiFlushPendingAudioLogFinalize();
  }

  if (aiPageOpen && !aiToolHistoryOpen && aiState == AI_SPEAKING
      && aiDisplayModeIndex != AI_DISPLAY_VOICE
      && aiRevealedChars < (int)aiReplyTranscript.length() && displayOn) {
    static unsigned long lastAiTextReveal = 0;
    if (millis() - lastAiTextReveal > AI_TEXT_REVEAL_TICK_MS) {
      lastAiTextReveal = millis();
      aiAdvanceTextReveal();
      bool hadText = aiTextLineCount > 0;
      aiRewrapTextLines(aiRevealedChars);
      if (aiDisplayModeIndex == AI_DISPLAY_SILENT) aiSilentModeAutoFollow();
      if (aiTextLineCount > 0) {
        if (!hadText) drawAiPage();
        else drawAiTextArea();
      }
    }
  }

  unsigned long wispHcStartMs = millis();
  auto wispWifiMode = WiFi.getMode();
  bool wispApUp = (wispWifiMode == WIFI_AP || wispWifiMode == WIFI_AP_STA);
  if (WiFi.status() == WL_CONNECTED || wispApUp) server.handleClient();
  unsigned long wispHcMs = millis() - wispHcStartMs;
  if (wispHcMs > 100) wispTrace("handleClient() took " + String(wispHcMs) + "ms lastUri=" + lastWebRequestUri);

  bool noteRecordingActive = noteRecordPageOpen && noteState == NOTE_RECORDING;
  bool aiSpeakingNow = (aiPageOpen || translatorPageOpen) && aiState == AI_SPEAKING;
  if (screenMirrorAvailable && displayOn) {
    static unsigned long lastFlushMs = 0;
    unsigned long nowFlushMs = millis();
    unsigned long flushIntervalMs = noteRecordingActive ? 1000 : (aiSpeakingNow ? 350 : 120);
    if (nowFlushMs - lastFlushMs >= flushIntervalMs) {
      lastFlushMs = nowFlushMs;
      if (devicePlaybackRedrawPending) {
        devicePlaybackRedrawPending = false;
        if (!settingsPageOpen && !aiPageOpen && !translatorPageOpen && !noteRecordPageOpen && !qrPageOpen && !devicePinPageOpen) drawClockScreen();
      }
      if (qrPageOpen && qrTitleScrolls) qrTickTitleMarquee();
      if (devicePlaybackActive && devicePlaybackScrolls && !settingsPageOpen && !aiPageOpen && !translatorPageOpen && !noteRecordPageOpen && !qrPageOpen && !devicePinPageOpen) devicePlaybackTickMarquee();
      gfx->flush();
    }
  }

  {
    static bool lastBtn = HIGH;
    static unsigned long lastBtnChange = 0;
    static unsigned long lastHoldCheckMs = 0;
    while (wakeBtnEdgeTail != wakeBtnEdgeHead) {
    bool btn = wakeBtnEdgeLevel[wakeBtnEdgeTail];
    unsigned long btnChangeMs = wakeBtnEdgeMs[wakeBtnEdgeTail];
    wakeBtnEdgeTail = (wakeBtnEdgeTail + 1) % WAKE_BTN_EDGE_QUEUE_LEN;
    if (btn != lastBtn && btnChangeMs - lastBtnChange > 40) {
      lastBtnChange = btnChangeMs;
      lastBtn = btn;
      if (scrRecActive && scrBtnEvents && btn == LOW && scrBtnEventCount < SCR_BTN_MAX_EVENTS) {
        scrBtnEvents[scrBtnEventCount].ms = btnChangeMs - scrRecStartMs;
        scrBtnEvents[scrBtnEventCount].button = 0;
        scrBtnEvents[scrBtnEventCount].durationMs = 0;
        scrBtnEventCount++;
        scrBtnPressEdgeMs = btnChangeMs;
      }
      if (scrRecActive && scrBtnEvents && btn == HIGH && scrBtnEventCount > 0) {
        ScrButtonEvent &lastBtnEvt = scrBtnEvents[scrBtnEventCount - 1];
        if (lastBtnEvt.button == 0 && lastBtnEvt.durationMs == 0) {
          unsigned long heldMs = btnChangeMs - scrBtnPressEdgeMs;
          lastBtnEvt.durationMs = (uint16_t)(heldMs > 65535UL ? 65535UL : heldMs);
        }
      }
      if (emailNoticeActive) {
        if (btn == LOW) {
          emailNoticeActive = false;
          drawClockScreen();
          lastActivityTime = millis();
        }
      } else if (qrPageOpen) {
        if (btn == LOW) {
          qrPageOpen = false;
          drawClockScreen();
          gfx->flush();
          lastActivityTime = millis();
        }
      } else if (settingsPageOpen) {
        if (btn == LOW) {
          closeSettingsPage();
          gfx->flush();
          lastActivityTime = millis();
        }
      } else if (aiPageOpen && aiState == AI_ERROR) {
        if (btn == LOW) triggerDeepSleepShutdown(true);
      } else if (aiPageOpen) {
        if (btn == LOW) {
          if (aiState == AI_SPEAKING || aiState == AI_THINKING) {
            stopAiResponse();
          } else {
            aiStartListening();
          }
        } else {
          aiStopListeningAndSend();
        }
        lastActivityTime = millis();
      } else if (translatorPageOpen) {
        if (btn == LOW) {
          if (aiState == AI_SPEAKING || aiState == AI_THINKING) {
            stopAiResponse();
          } else {
            aiStartListening();
          }
        } else {
          aiStopListeningAndSend();
        }
        lastActivityTime = millis();
      } else if (btn == LOW) {
        btnHeld = true;
        btnPressStartMs = btnChangeMs;
        shutdownCountdownShown = -1;
        lastHoldCheckMs = 0;
        wispTrace("BTN press edgeMs=" + String(btnChangeMs));
      } else if (btnHeld) {
        btnHeld = false;
        unsigned long heldMs = btnChangeMs - btnPressStartMs;
        wispTrace("BTN release edgeMs=" + String(btnChangeMs) + " heldMs=" + String(heldMs));
        if (heldMs < LONGPRESS_QUICKTAP_MS) {
          if (!displayOn) wakeDisplay();
          else             sleepDisplay();
        } else if (shutdownCountdownShown != -1) {
          if (settingsPageOpen) drawSettingsPage();
          else if (!sdMounted) drawSdCardMissingScreen();
          else if (wifiSetupMandatory) drawWifiSetupMandatoryScreen();
          else drawClockScreen();
        }
        lastActivityTime = millis();
      }
    }
    }

    if (btnHeld && !aiPageOpen && !translatorPageOpen) {
      lastActivityTime = millis();
      unsigned long nowMs = millis();
      if (digitalRead(WAKE_BUTTON_PIN) == HIGH) {
        wispTrace("PIN CHECK stale btnHeld cleared — pin already HIGH");
        btnHeld = false;
        shutdownCountdownShown = -1;
        if (settingsPageOpen) drawSettingsPage();
        else if (!sdMounted) drawSdCardMissingScreen();
        else if (wifiSetupMandatory) drawWifiSetupMandatoryScreen();
        else drawClockScreen();
      } else {
      const unsigned long HOLD_STALL_GAP_MS = 400;
      if (lastHoldCheckMs != 0 && (nowMs - lastHoldCheckMs) > HOLD_STALL_GAP_MS) {
        unsigned long wispStalledGapMs = nowMs - lastHoldCheckMs;
        btnPressStartMs = nowMs;
        shutdownCountdownShown = -1;
        wispTrace("STALL GUARD engaged gapMs=" + String(wispStalledGapMs));
      }
      lastHoldCheckMs = nowMs;
      unsigned long heldMs = nowMs - btnPressStartMs;
      if (heldMs >= LONGPRESS_SHUTDOWN_MS) {
        btnHeld = false;
        triggerDeepSleepShutdown(false);
      } else if (heldMs >= LONGPRESS_QUICKTAP_MS) {
        if (!displayOn) wakeDisplay();
        int secLeft = 3 - (int)(heldMs / 1000);
        if (secLeft < 1) secLeft = 1;
        if (secLeft != shutdownCountdownShown) {
          drawShutdownCountdown(secLeft);
          shutdownCountdownShown = secLeft;
        }
      }
      }
    }

    if (aiListening && (aiPageOpen || translatorPageOpen) && digitalRead(WAKE_BUTTON_PIN) == HIGH) {
      wispTrace("AI PIN CHECK stale aiListening cleared — pin already HIGH");
      aiStopListeningAndSend();
    }
  }

  if (pmuOk) {
    pmu.getIrqStatus();
    bool pekeyShortPress = pmu.isPekeyShortPressIrq();
    pmu.clearIrqStatus();
    if (pekeyShortPress) {
      if (scrRecActive && scrBtnEvents && scrBtnEventCount < SCR_BTN_MAX_EVENTS) {
        scrBtnEvents[scrBtnEventCount].ms = millis() - scrRecStartMs;
        scrBtnEvents[scrBtnEventCount].button = 1;
        scrBtnEvents[scrBtnEventCount].durationMs = 0;
        scrBtnEventCount++;
      }
      if (devicePlaybackActive) {
        requestDevicePlaybackStop();
      } else if (emailNoticeActive) {
        emailNoticeActive = false;
        drawClockScreen();
      } else if (!displayOn) {
        wakeDisplay();
      } else if (aiPageOpen) {
        if (aiListening) aiStopListeningAndSend();
        closeAiPage();
      } else if (translatorPageOpen) {
        if (aiListening) aiStopListeningAndSend();
        closeTranslatorPage();
      } else if (noteRecordPageOpen) {
        closeNoteRecordPage();
      } else if (qrPageOpen) {
        qrPageIndex = (qrPageIndex + 1) % (qrEntryCount + 1);
        lastActivityTime = millis();
        drawQrPage();
        gfx->flush();
      } else if (devicePinPageOpen) {
        bool wasQuickAccess = (devicePinTarget != DEVICE_PIN_TARGET_NONE);
        closeDevicePinPage();
        if (wasQuickAccess) drawClockScreen(); else drawSettingsPage();
      } else if (deviceLockedForAuth()) {
      } else if (!settingsPageOpen) {
        openSettingsPage();
      } else {
        int nextPage = nextEnabledSettingsPage(settingsPageNum + 1);
        if (nextPage == 0) {
          closeSettingsPage();
        } else {
          settingsPageNum = nextPage;
          drawSettingsPage();
        }
      }
      lastActivityTime = millis();
    }
  }

  if (pmuOk) {
    static unsigned long lastChargeCheck = 0;
    static bool lastKnownVbusIn = false;
    static bool vbusPrimed = false;
    if (millis() - lastChargeCheck > 2000) {
      lastChargeCheck = millis();
      bool curVbusIn = pmu.isVbusIn();
      if (vbusPrimed && curVbusIn && !lastKnownVbusIn && !displayOn) {
        wakeDisplay();
      }
      lastKnownVbusIn = curVbusIn;
      vbusPrimed = true;
    }
  }

  if (touchOk && displayOn) {
    if (touchFT3168->IIC_Interrupt_Flag) {
      touchFT3168->IIC_Interrupt_Flag = false;
      int32_t tx = (int32_t)touchFT3168->IIC_Read_Device_Value(touchFT3168->Arduino_IIC_Touch::Value_Information::TOUCH_COORDINATE_X);
      int32_t ty = (int32_t)touchFT3168->IIC_Read_Device_Value(touchFT3168->Arduino_IIC_Touch::Value_Information::TOUCH_COORDINATE_Y);
      if (!touchTracking) {
        touchTracking = true; touchStartX = tx; touchStartY = ty;
        touchStartMs = millis();
        qrLongPressFired = false;
        if (devicePinPageOpen) handleDevicePinTouch(tx, ty);
        if (scrRecActive && scrTapEvents && scrTapEventCount < SCR_TAP_MAX_EVENTS) {
          scrTapEvents[scrTapEventCount].ms = millis() - scrRecStartMs;
          scrTapEvents[scrTapEventCount].x = (uint16_t)tx;
          scrTapEvents[scrTapEventCount].y = (uint16_t)ty;
          scrTapEventCount++;
        }
      }
      touchLastX = tx; touchLastY = ty;
      touchLastSeenMs = millis();

      if (!qrPageOpen && !settingsPageOpen && !aiPageOpen && !noteRecordPageOpen && !translatorPageOpen &&
          !devicePinPageOpen && !deviceLockedForAuth() && !wifiSetupMandatory && !qrLongPressFired &&
          millis() - touchStartMs >= LONGPRESS_QR_MS &&
          abs(tx - touchStartX) <= LONGPRESS_QR_DEADZONE && abs(ty - touchStartY) <= LONGPRESS_QR_DEADZONE) {
        qrLongPressFired = true;
        suppressNextTouchRelease = true;
        if (deviceLockOn) {
          if (activeDeviceLockPin.length() > 0) openDevicePinPage(DEVICE_PIN_TARGET_QR);
          else showDeviceLockedMessage();
        } else {
          openQrPage();
        }
      }

      if (settingsPageOpen && settingsPageNum == 1 && !devicePinPageOpen && ty >= SETTINGS_VOLSLIDER_ROW_Y0 && ty <= SETTINGS_VOLSLIDER_ROW_Y1) {
        setVolumeFromTouchX(tx);
        lastActivityTime = millis();
      }
      if (settingsPageOpen && settingsPageNum == 1 && !devicePinPageOpen && ty >= SETTINGS_BRIGHTNESS_ROW_Y0 && ty <= SETTINGS_BRIGHTNESS_ROW_Y1) {
        setBrightnessFromTouchX(tx);
        lastActivityTime = millis();
      }

      if (aiPageOpen && !aiToolHistoryOpen && aiTextAreaVisible() && aiState == AI_IDLE
          && touchStartY >= AI_TEXT_AREA_Y0 && touchStartY <= AI_TEXT_AREA_Y1) {
        if (!aiTextDragActive) {
          aiTextDragActive = true;
          aiTextDragPrevY = ty;
        } else {
          int32_t dyDrag = ty - aiTextDragPrevY;
          int lineDelta = -dyDrag / AI_TEXT_LINE_GAP;
          if (lineDelta != 0) {
            aiTextDragPrevY += -lineDelta * AI_TEXT_LINE_GAP;
            int visibleLines = (AI_TEXT_AREA_Y1 - AI_TEXT_AREA_Y0) / AI_TEXT_LINE_GAP;
            if (visibleLines < 1) visibleLines = 1;
            int maxTop = aiTextLineCount > visibleLines ? aiTextLineCount - visibleLines : 0;
            aiTextScrollLine += lineDelta;
            if (aiTextScrollLine < 0) aiTextScrollLine = 0;
            if (aiTextScrollLine > maxTop) aiTextScrollLine = maxTop;
            drawAiTextArea();
            lastActivityTime = millis();
          }
        }
      } else {
        aiTextDragActive = false;
      }
    }

    if (touchTracking && millis() - touchLastSeenMs > TOUCH_RELEASE_TIMEOUT_MS) {
      touchTracking = false;
      aiTextDragActive = false;

      if (suppressNextTouchRelease) {
        suppressNextTouchRelease = false;
      } else {
      int32_t dy = touchLastY - touchStartY;
      int32_t dx = touchLastX - touchStartX;
      bool isVSwipe = (abs(dx) <= SWIPE_MAX_DX) && (abs(dy) >= SWIPE_MIN_DY);
      bool isHSwipe = (abs(dy) <= SWIPE_MAX_DX) && (abs(dx) >= SWIPE_MIN_DX);

      if (scrRecActive && scrSwipeEvents && (isVSwipe || isHSwipe) && scrSwipeEventCount < SCR_SWIPE_MAX_EVENTS) {
        scrSwipeEvents[scrSwipeEventCount].ms = touchStartMs - scrRecStartMs;
        scrSwipeEvents[scrSwipeEventCount].x0 = (int16_t)touchStartX;
        scrSwipeEvents[scrSwipeEventCount].y0 = (int16_t)touchStartY;
        scrSwipeEvents[scrSwipeEventCount].x1 = (int16_t)touchLastX;
        scrSwipeEvents[scrSwipeEventCount].y1 = (int16_t)touchLastY;
        scrSwipeEventCount++;
      }

      if (qrPageOpen) {
        int qrN = qrEntryCount + 1;
        if (isHSwipe && qrN > 1) {
          if (dx > 0) qrPageIndex = (qrPageIndex + 1) % qrN;
          else        qrPageIndex = (qrPageIndex - 1 + qrN) % qrN;
          drawQrPage();
          gfx->flush();
        }
        lastActivityTime = millis();
      } else if (!settingsPageOpen && !aiPageOpen && !noteRecordPageOpen && !translatorPageOpen && !devicePinPageOpen && !deviceLockedForAuth() && isVSwipe && dy > 0 && touchStartY <= SWIPE_TOP_ZONE_Y) {
        openSettingsPage();
        lastActivityTime = millis();
      } else if (devicePinPageOpen) {
        lastActivityTime = millis();
      } else if (settingsPageOpen && isVSwipe && dy < 0) {
        closeSettingsPage();
        lastActivityTime = millis();
      } else if (!settingsPageOpen && !aiPageOpen && !noteRecordPageOpen && !translatorPageOpen && !wifiSetupMandatory && sdMounted && !deviceLockedForAuth() && !deviceLockOn && isHSwipe && dx < 0) {
        openAiPage();
        lastActivityTime = millis();
      } else if (!settingsPageOpen && !aiPageOpen && !noteRecordPageOpen && !translatorPageOpen && !wifiSetupMandatory && sdMounted && !deviceLockedForAuth() && deviceLockOn && isHSwipe && dx < 0) {
        if (activeDeviceLockPin.length() > 0) openDevicePinPage(DEVICE_PIN_TARGET_AI);
        else showDeviceLockedMessage();
        lastActivityTime = millis();
      } else if (aiPageOpen && isHSwipe && dx > 0) {
        if (aiListening) aiStopListeningAndSend();
        closeAiPage();
        lastActivityTime = millis();
      } else if (aiPageOpen && !aiToolHistoryOpen && isVSwipe && dy < 0
                 && (!aiTextAreaVisible()
                     || touchStartY < AI_TEXT_AREA_Y0
                     || aiTextLineCount <= (AI_TEXT_AREA_Y1 - AI_TEXT_AREA_Y0) / AI_TEXT_LINE_GAP)) {
        openAiToolHistoryPage();
        lastActivityTime = millis();
      } else if (aiToolHistoryOpen && isVSwipe && dy > 0) {
        closeAiToolHistoryPage();
        lastActivityTime = millis();
      } else if (aiPageOpen && !aiToolHistoryOpen && isVSwipe && dy > 0 && touchStartY < AI_TEXT_AREA_Y0) {
        if (!replaySavedTryReplayLast()) replayLastTranslation();
        lastActivityTime = millis();
      } else if (!settingsPageOpen && !aiPageOpen && !noteRecordPageOpen && !translatorPageOpen && !wifiSetupMandatory && sdMounted && !deviceLockedForAuth() && !deviceLockOn && isVSwipe && dy < 0) {
        openNoteRecordPage();
        lastActivityTime = millis();
      } else if (!settingsPageOpen && !aiPageOpen && !noteRecordPageOpen && !translatorPageOpen && !wifiSetupMandatory && sdMounted && !deviceLockedForAuth() && deviceLockOn && isVSwipe && dy < 0) {
        if (activeDeviceLockPin.length() > 0) openDevicePinPage(DEVICE_PIN_TARGET_NOTES);
        else showDeviceLockedMessage();
        lastActivityTime = millis();
      } else if (noteRecordPageOpen && isVSwipe && dy > 0) {
        closeNoteRecordPage();
        lastActivityTime = millis();
      } else if (!settingsPageOpen && !aiPageOpen && !noteRecordPageOpen && !translatorPageOpen && !wifiSetupMandatory && sdMounted && !deviceLockedForAuth() && !deviceLockOn && isHSwipe && dx > 0) {
        openTranslatorPage();
        lastActivityTime = millis();
      } else if (!settingsPageOpen && !aiPageOpen && !noteRecordPageOpen && !translatorPageOpen && !wifiSetupMandatory && sdMounted && !deviceLockedForAuth() && deviceLockOn && isHSwipe && dx > 0) {
        if (activeDeviceLockPin.length() > 0) openDevicePinPage(DEVICE_PIN_TARGET_TRANSLATOR);
        else showDeviceLockedMessage();
        lastActivityTime = millis();
      } else if (translatorPageOpen && isHSwipe && dx < 0) {
        if (aiListening) aiStopListeningAndSend();
        closeTranslatorPage();
        lastActivityTime = millis();
      } else if (translatorPageOpen && isVSwipe && dy > 0) {
        replayLastTranslation();
        lastActivityTime = millis();
      } else if (translatorPageOpen && !isVSwipe && !isHSwipe) {
        if (aiState == AI_IDLE || aiState == AI_ERROR) {
          int dir = (touchStartX >= SCREEN_WIDTH / 2) ? 1 : -1;
          if (touchStartY >= TRANSLATOR_SOURCE_ROW_Y0 && touchStartY <= TRANSLATOR_SOURCE_ROW_Y1) {
            cycleTranslatorSource(dir);
          } else if (touchStartY >= TRANSLATOR_TARGET_ROW_Y0 && touchStartY <= TRANSLATOR_TARGET_ROW_Y1) {
            cycleTranslatorTarget(dir);
          } else if (touchStartY >= TRANSLATOR_REVERSE_ROW_Y0 && touchStartY <= TRANSLATOR_REVERSE_ROW_Y1) {
            translatorReverseLangs();
          }
        }
        lastActivityTime = millis();
      } else if (aiPageOpen && !aiToolHistoryOpen && !isVSwipe && !isHSwipe
                 && touchStartY >= (aiTextAreaVisible() ? AI_MODE_ROW_Y0_TOP : AI_MODE_ROW_Y0_IDLE)
                 && touchStartY <= (aiTextAreaVisible() ? AI_MODE_ROW_Y1_TOP : AI_MODE_ROW_Y1_IDLE)) {
        cycleAiDisplayMode();
        lastActivityTime = millis();
      } else if (noteRecordPageOpen && !devicePinPageOpen && !isVSwipe && !isHSwipe) {
        if ((noteState == NOTE_IDLE || noteState == NOTE_RECORDING)
            && touchStartY >= NOTE_TAP_ROW_Y0 && touchStartY <= NOTE_TAP_ROW_Y1) {
          if (noteState == NOTE_IDLE) noteStartRecording();
          else noteStopRecordingAndProcess();
        } else if (noteState == NOTE_IDLE && !featureDisabled("trmail")
                   && touchStartY >= noteMailTapY0() && touchStartY <= noteMailTapY0() + NOTE_SETTING_ROW_H) {
          if (noteSaveMode != NOTE_SAVE_AUDIO_ONLY && settingsEditAllowed()) cycleNoteEmailTo();
        } else if (noteState == NOTE_IDLE && !featureDisabled("trsave")
                   && touchStartY >= noteSaveTapY0() && touchStartY <= noteSaveTapY0() + NOTE_SETTING_ROW_H) {
          if (settingsEditAllowed()) cycleNoteSaveMode();
        } else if (noteState == NOTE_ERROR) {
          noteState = NOTE_IDLE;
          drawNoteRecordPage();
        }
        lastActivityTime = millis();
      } else if (settingsPageOpen && !devicePinPageOpen && !isVSwipe && !isHSwipe) {
        if (settingsPageNum == 1 && touchStartY >= SETTINGS_THEME_ROW_Y0 && touchStartY <= SETTINGS_THEME_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (settingsEditAllowed()) cycleColorTheme();
        } else if (settingsPageNum == 1 && touchStartY >= SETTINGS_WAKETO_ROW_Y0 && touchStartY <= SETTINGS_WAKETO_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (settingsEditAllowed()) toggleDeviceLock();
        } else if (settingsPageNum == 2 && touchStartY >= SETTINGS_MODEL_ROW_Y0 && touchStartY <= SETTINGS_MODEL_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (settingsEditAllowed()) cycleAiModel();
        } else if (settingsPageNum == 2 && touchStartY >= SETTINGS_EFFORT_ROW_Y0 && touchStartY <= SETTINGS_EFFORT_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (settingsEditAllowed()) cycleAiEffort();
        } else if (settingsPageNum == 2 && touchStartY >= SETTINGS_VOICE_ROW_Y0 && touchStartY <= SETTINGS_VOICE_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (settingsEditAllowed()) cycleAiVoice();
        } else if (settingsPageNum == 2 && touchStartY >= SETTINGS_SAVEHISTORY_ROW_Y0 && touchStartY <= SETTINGS_SAVEHISTORY_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (settingsEditAllowed()) toggleSaveAiHistory();
        } else if (settingsPageNum == 3 && touchStartY >= SETTINGS_FILEANALYSIS_ROW_Y0 && touchStartY <= SETTINGS_FILEANALYSIS_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (settingsEditAllowed()) cycleFileQaModel();
        } else if (settingsPageNum == 3 && touchStartY >= SETTINGS_DEEPTHINK_ROW_Y0 && touchStartY <= SETTINGS_DEEPTHINK_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (settingsEditAllowed()) cycleFileQaEffort();
        } else if (settingsPageNum == 3 && touchStartY >= SETTINGS_DTEFFORT_ROW_Y0 && touchStartY <= SETTINGS_DTEFFORT_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (settingsEditAllowed()) cycleDeepThinkModel();
        } else if (settingsPageNum == 3 && touchStartY >= SETTINGS_QAEFFORT_ROW_Y0 && touchStartY <= SETTINGS_QAEFFORT_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (settingsEditAllowed()) cycleDeepThinkEffort();
        } else if (settingsPageNum == 4 && touchStartY >= SETTINGS_WEBSEARCH_ROW_Y0 && touchStartY <= SETTINGS_WEBSEARCH_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (settingsEditAllowed()) cycleWebSearchModel();
        } else if (settingsPageNum == 4 && touchStartY >= SETTINGS_TRMODEL_ROW_Y0 && touchStartY <= SETTINGS_TRMODEL_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (settingsEditAllowed()) cycleTranslatorModel();
        } else if (settingsPageNum == 4 && touchStartY >= SETTINGS_VOICETT_ROW_Y0 && touchStartY <= SETTINGS_VOICETT_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (!aiRealtimeNeedsOpenAiVoiceToText()) cycleVoiceToTextModel();
        } else if (settingsPageNum == 4 && touchStartY >= SETTINGS_AUTOTEXT_ROW_Y0 && touchStartY <= SETTINGS_AUTOTEXT_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (settingsEditAllowed()) cycleNoteTitleModel();
        } else if (settingsPageNum == 5 && touchStartY >= SETTINGS_MAXOUTTOKENS_ROW_Y0 && touchStartY <= SETTINGS_MAXOUTTOKENS_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (settingsEditAllowed()) cycleAiMaxOutTokens();
        } else if (settingsPageNum == 5 && touchStartY >= SETTINGS_QAMAXTOK_ROW_Y0 && touchStartY <= SETTINGS_QAMAXTOK_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (settingsEditAllowed()) cycleAiQaMaxTok();
        } else if (settingsPageNum == 5 && touchStartY >= SETTINGS_THINKMAXTOK_ROW_Y0 && touchStartY <= SETTINGS_THINKMAXTOK_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (settingsEditAllowed()) cycleAiThinkMaxTok();
        } else if (settingsPageNum == 5 && touchStartY >= SETTINGS_VOICEBUF_ROW_Y0 && touchStartY <= SETTINGS_VOICEBUF_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (settingsEditAllowed()) cycleAiVoiceBuffer();
        } else if (settingsPageNum == 6 && touchStartY >= SETTINGS_AUTOSLEEP_ROW_Y0 && touchStartY <= SETTINGS_AUTOSLEEP_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (settingsEditAllowed()) cycleAutoSleep();
        } else if (settingsPageNum == 6 && touchStartY >= SETTINGS_SKIPHOME_ROW_Y0 && touchStartY <= SETTINGS_SKIPHOME_ROW_Y1) {
          if (settingsEditAllowed()) {
            if (touchStartX >= SCREEN_WIDTH - 130) toggleSkipAtHome();
            else cycleSkipHomeNetwork();
          }
        } else if (settingsPageNum == 6 && touchStartY >= SETTINGS_SKIPCHARGE_ROW_Y0 && touchStartY <= SETTINGS_SKIPCHARGE_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          if (settingsEditAllowed()) toggleSkipCharging();
        } else if (settingsPageNum == 6 && WiFi.status() != WL_CONNECTED && touchStartY >= SETTINGS_WIFISETUP_ROW_Y0 && touchStartY <= SETTINGS_WIFISETUP_ROW_Y1 && touchStartX >= SETTINGS_ROW_VALUE_X0) {
          enterWifiSetupPortal();
        }
        lastActivityTime = millis();
      } else if (!settingsPageOpen && !aiPageOpen && !noteRecordPageOpen && !translatorPageOpen && !isVSwipe && !isHSwipe
                 && wifiSetupTapActive && touchStartY >= wifiSetupTapY0 && touchStartY <= wifiSetupTapY1) {
        enterWifiSetupPortal();
        lastActivityTime = millis();
      }

      if (settingsPageOpen && settingsPageNum == 1 && !devicePinPageOpen && touchStartY >= SETTINGS_VOLSLIDER_ROW_Y0 && touchStartY <= SETTINGS_VOLSLIDER_ROW_Y1) {
        saveSettings();
      }
      if (settingsPageOpen && settingsPageNum == 1 && !devicePinPageOpen && touchStartY >= SETTINGS_BRIGHTNESS_ROW_Y0 && touchStartY <= SETTINGS_BRIGHTNESS_ROW_Y1) {
        saveSettings();
      }
      }
    }
  }

  if (noteState == NOTE_RECORDING || noteCaptureTaskHandle) {
    notePumpRecording();
  }

  if (scrRecActive || scrRecTaskHandle) {
    scrPumpRecording();
  }
  if (noteRecordPageOpen) {
    if (noteState == NOTE_RECORDING) {
      if (displayOn) {
        static unsigned long lastNoteTimerDraw = 0;
        if (millis() - lastNoteTimerDraw > 1000) {
          lastNoteTimerDraw = millis();
          drawNoteRecordPage();
        }
      }
    } else if (noteState == NOTE_SAVED && millis() - noteSavedAtMs > 3800) {
      closeNoteRecordPage();
    }
  }

  if (fileTranscribeActive && millis() - fileTranscribeLastActivityMs > FILE_TRANSCRIBE_IDLE_TIMEOUT_MS) {
    Serial.println("[FileTranscribe] idle timeout — releasing lock");
    fileTranscribeReleaseJob();
  }

  if (translatorPageOpen && aiState == AI_LISTENING && displayOn) {
    static unsigned long lastTranslatorTimerDraw = 0;
    if (millis() - lastTranslatorTimerDraw > 1000) {
      lastTranslatorTimerDraw = millis();
      drawTranslatorPage();
    }
  }

  if (displayOn && !aiPageOpen && !noteRecordPageOpen && !translatorPageOpen && !wifiSetupMandatory && !demoForceScreenOn && millis() - lastActivityTime > DISPLAY_SLEEP_MS) {
    sleepDisplay();
  }

  if (!displayOn && !aiPageOpen && !noteRecordPageOpen && !translatorPageOpen && !wifiSetupMandatory) {
    static unsigned long lastTaskCheck = 0;
    if (millis() - lastTaskCheck > 1000) {
      lastTaskCheck = millis();
      checkAndRunDueTasks();
    }
  }

  if (!displayOn && autoSleepIndex != AUTO_SLEEP_NEVER_INDEX) {
    bool atHome = skipAutoSleepAtHome && WiFi.status() == WL_CONNECTED && activeWifiNetworkCount > 0
                  && WiFi.SSID() == activeWifiNetworks[skipHomeNetworkIndex % activeWifiNetworkCount].ssid;
    bool onCharger = skipAutoSleepCharging && pmuOk && pmu.isVbusIn();
    bool noteRecordActive = noteRecordPageOpen;
    bool translatorActive = translatorPageOpen;
    bool wifiSetupActive = wifiSetupMandatory;
    bool webSessionActive = millis() - lastWebActivityMs < WEB_SESSION_GRACE_MS;
    if (!atHome && !onCharger && !noteRecordActive && !translatorActive && !wifiSetupActive && !webSessionActive) {
      triggerDeepSleepShutdown(false);
    }
  }

  bool memResetWebSessionActive = millis() - lastWebActivityMs < WEB_SESSION_GRACE_MS;
  if (!displayOn && aiMemResetPending && !memResetWebSessionActive
      && !aiPageOpen && !noteRecordPageOpen && !translatorPageOpen && !wifiSetupMandatory) {
    aiMemResetPending = false;
    aiSilentMemoryResetSleep();
  }

  {
    bool anyWxSlotActive = wxSlot1 != WX_NONE || wxSlot2 != WX_NONE || wxSlot3 != WX_NONE || wxSlot4 != WX_NONE;
    if (anyWxSlotActive && !featureDisabled("weather") && WiFi.status() == WL_CONNECTED) {
      unsigned long wxInterval = (clockTempC == -999) ? 10000UL : 30UL * 60UL * 1000UL;
      if (!wxFetchRunning && (lastWeatherFetch == 0 || millis() - lastWeatherFetch > wxInterval))
        triggerWxFetch();
    }
  }

  {
    static unsigned long lastAlarmCheck = 0;
    if (millis() - lastAlarmCheck > 1000) {
      lastAlarmCheck = millis();
      if (checkAndClearDueAlarms()) {
        if (!displayOn) {
          digitalWrite(AMOLED_PWR_EN, HIGH);
          delay(10);
          gfxPanel->displayOn();
          displayOn = true;
        }
        fireAlarm();
        lastActivityTime = millis();
        if (settingsPageOpen)  drawSettingsPage();
        else if (aiPageOpen)   { if (aiToolHistoryOpen) drawAiToolHistoryPage(); else drawAiPage(); }
        else if (translatorPageOpen) drawTranslatorPage();
        else if (!sdMounted)   drawSdCardMissingScreen();
        else if (wifiSetupMandatory) drawWifiSetupMandatoryScreen();
        else                   drawClockScreen();
      }
    }
  }

  static unsigned long lastClockUpdate = 0;
  static bool wasFetchingWx = false;
  bool fetchJustFinished = wasFetchingWx && !wxFetchRunning;
  wasFetchingWx = wxFetchRunning;
  static bool wasWifiConnectedForRedraw = false;
  bool wifiConnected = WiFi.status() == WL_CONNECTED;
  bool wifiJustConnected = wifiConnected && !wasWifiConnectedForRedraw;
  wasWifiConnectedForRedraw = wifiConnected;
  bool timeJustSynced = ntpJustSynced;
  ntpJustSynced = false;
  if (timeJustSynced) pcf85063SyncFromSystemClock();
  if (displayOn && !settingsPageOpen && !aiPageOpen && !noteRecordPageOpen && !translatorPageOpen && !devicePinPageOpen && !qrPageOpen && !wifiSetupMandatory && !emailNoticeActive && !deviceLockedMsgActive && sdMounted &&
      (millis() - lastClockUpdate > 60000 || lastClockUpdate == 0 || fetchJustFinished || wifiJustConnected || timeJustSynced)) {
    lastClockUpdate = millis();
    drawClockScreen();
  }

  if (deviceLockedMsgActive && displayOn && millis() - deviceLockedMsgShownAt >= DEVICE_LOCKED_MSG_MS) {
    deviceLockedMsgActive = false;
    drawClockScreen();
  }

  if (devicePinPageOpen && displayOn && devicePinLockedUntilMs != 0) {
    static unsigned long lastPinLockoutRedraw = 0;
    if (millis() - lastPinLockoutRedraw >= 1000) {
      lastPinLockoutRedraw = millis();
      drawDevicePinPage();
    }
  }

  if (devicePinPageOpen && pinFlashRow != PIN_FLASH_NONE && millis() - pinFlashSetMs >= PIN_KEY_FLASH_MS) {
    revertPinFlashIfPending();
  }

  if (devicePinPageOpen && pinLastDigitMs != 0 && millis() - pinLastDigitMs >= PIN_DIGIT_REVEAL_MS) {
    pinLastDigitMs = 0;
    drawPinDots();
  }

  if (devicePinPageOpen && pinSuccessAtMs != 0 && millis() - pinSuccessAtMs >= PIN_SUCCESS_HOLD_MS) {
    int target = pinSuccessTarget;
    closeDevicePinPage();
    pinApplySuccess(target);
  }

  if (!sdMounted) {
    static unsigned long lastSdRetry = 0;
    if (millis() - lastSdRetry > 2000) {
      lastSdRetry = millis();
      if (mountSD()) {
        const int SD_FOUND_CONFIRM_PASSES = 4;
        const unsigned long SD_FOUND_CONFIRM_GAP_MS = 500;
        bool confirmed = true;
        for (int i = 0; i < SD_FOUND_CONFIRM_PASSES; i++) {
          delay(SD_FOUND_CONFIRM_GAP_MS);
          if (!sdCardStillPresent()) { confirmed = false; break; }
        }
        if (!confirmed) {
          Serial.println("[SDCard] mount didn't hold — still unstable, continuing to wait");
          SD_MMC.end();
          sdMounted = false;
        } else {
          Serial.println("[SDCard] card detected — restarting to complete boot");
          gfx->fillScreen(COLOR_BLACK);
          _clockCenterPrint("SD Card Found", SCREEN_HEIGHT / 2 - 20, 3, COLOR_GREEN);
          _clockCenterPrint("Restarting...", SCREEN_HEIGHT / 2 + 20, 2, COLOR_GRAY);
          gfx->flush();
          delay(1000);
          ESP.restart();
        }
      }
    }
  }

  if (sdMounted) {
    static unsigned long lastSdPresenceCheck = 0;
    if (millis() - lastSdPresenceCheck > 5000) {
      lastSdPresenceCheck = millis();
      if (!sdCardStillPresent()) {
        Serial.println("[SDCard] card no longer detected — treating as removed");
        sdMounted = false;
        if (wifiSetupMandatory) {
          wifiSetupMandatory = false;
          wifiSetupPortalActive = false;
          WiFi.softAPdisconnect(true);
          WiFi.mode(WIFI_STA);
        }
        if (settingsPageOpen) closeSettingsPage();
        else if (aiPageOpen) closeAiPage();
        else if (noteRecordPageOpen) closeNoteRecordPage();
        else if (translatorPageOpen) closeTranslatorPage();
        else drawSdCardMissingScreen();
      }
    }
  }

  if (wifiSetupMandatory && wifiSetupSubmitted) {
    WiFi.softAPdisconnect(true);
    WiFi.mode(WIFI_STA);
    applyWifiSetupSubmission();
  }

  if (translatorReplaying && aiPlayUsedBytes() == 0) {
    translatorReplaying = false;
    aiState = AI_IDLE;
    drawAiOrTranslatorPage();
  }

  replaySavedPump();

  if (pendingTaskRunIdx >= 0 && aiState == AI_IDLE && !wxFetchRunning) {
    static unsigned long taskGoodbyeEmptySinceMs = 0;
    if (aiPlayUsedBytes() == 0) {
      if (taskGoodbyeEmptySinceMs == 0) taskGoodbyeEmptySinceMs = millis();
      if (millis() - taskGoodbyeEmptySinceMs > 300) {
        int idx = pendingTaskRunIdx;
        pendingTaskRunIdx = -1;
        taskGoodbyeEmptySinceMs = 0;
        if (aiPageOpen) closeAiPage();
        else if (translatorPageOpen) closeTranslatorPage();
        if (idx < activePageTaskCount) {
          if (ESP.getMaxAllocHeap() < HEAP_HEALTH_MIN_ALLOC && heapRestartStreak < 2) {
            Serial.printf("[Heap] max alloc %u below %u with voice task \"%s\" pending — restarting first, resuming it after boot\n",
                          (unsigned)ESP.getMaxAllocHeap(), (unsigned)HEAP_HEALTH_MIN_ALLOC, activePageTasks[idx].name.c_str());
            taskStampRestartingStatus(idx);
            taskRunAfterRestartIdx = idx;
            heapRestartStreak++;
            saveTaskRestartState(taskRunAfterRestartIdx, heapRestartStreak);
            delay(50);
            ESP.restart();
          }
          runPageTaskByIndex(idx);
        }
      }
    } else {
      taskGoodbyeEmptySinceMs = 0;
    }
  }

  if (pendingEmailArmed && aiState == AI_IDLE && !wxFetchRunning) {
    static unsigned long emailGoodbyeEmptySinceMs = 0;
    if (aiPlayUsedBytes() == 0) {
      if (emailGoodbyeEmptySinceMs == 0) emailGoodbyeEmptySinceMs = millis();
      if (millis() - emailGoodbyeEmptySinceMs > 300) {
        pendingEmailArmed = false;
        emailGoodbyeEmptySinceMs = 0;
        if (aiPageOpen) closeAiPage();
        else if (translatorPageOpen) closeTranslatorPage();

        unsigned long emailStartMs = millis();
        String err = smtpSendMail(pendingEmailToAddr, pendingEmailSubject, pendingEmailBody,
                                   pendingEmailAttachments, pendingEmailAttachmentCount);
        unsigned long emailDurationMs = millis() - emailStartMs;
        String emailResult = err.length() > 0
          ? ("Error: could not send email — " + err)
          : ("Email sent to " + pendingEmailToName
             + (pendingEmailAttachmentCount > 0 ? " with " + String(pendingEmailAttachmentCount) + " attachment(s)." : "."));
        logToolCallEvent("live-deferred", "send_email", emailDurationMs, pendingEmailToName, emailResult);
        Serial.print("[SMTP] deferred send: "); Serial.println(emailResult);

        for (int i = 0; i < pendingEmailAttachmentCount; i++) pendingEmailAttachments[i] = SmtpAttachment();
        pendingEmailAttachmentCount = 0;

        bool emailNoticeWasAsleep = !displayOn;
        if (emailNoticeWasAsleep) { digitalWrite(AMOLED_PWR_EN, HIGH); delay(10); }
        gfx->fillScreen(COLOR_BLACK);
        int emailNoticeY = SCREEN_HEIGHT / 2 - 30;
        _clockCenterPrint(err.length() == 0 ? "Email Sent" : "Email Failed", emailNoticeY, 4, COLOR_BLUE);

        gfx->setTextSize(3);
        String emailToLine = _fitTextWidth("To : " + pendingEmailToName, SCREEN_WIDTH - 40);
        _clockCenterPrint(emailToLine.c_str(), emailNoticeY + 55, 3, COLOR_WHITE);

        char emailTsBuf[24] = "no time sync";
        struct tm emailTi;
        if (getLocalTime(&emailTi)) strftime(emailTsBuf, sizeof(emailTsBuf), "%Y-%m-%d %Hh%M:%S", &emailTi);
        _clockCenterPrint(emailTsBuf, emailNoticeY + 95, 3, COLOR_WHITE);
        gfx->flush();
        if (emailNoticeWasAsleep) { gfxPanel->displayOn(); displayOn = true; }
        lastActivityTime = millis();
        emailNoticeActive = true;
      }
    } else {
      emailGoodbyeEmptySinceMs = 0;
    }
  }

  if (pendingWebTaskRunIdx >= 0 && WiFi.status() == WL_CONNECTED && !wxFetchRunning) {
    int idx = pendingWebTaskRunIdx;
    pendingWebTaskRunIdx = -1;
    if (idx < activePageTaskCount) {
      if (ESP.getMaxAllocHeap() < HEAP_HEALTH_MIN_ALLOC) {
        if (heapRestartStreak < 2) {
          Serial.printf("[Heap] max alloc %u below %u with task \"%s\" pending — restarting first, resuming it after boot\n",
                        (unsigned)ESP.getMaxAllocHeap(), (unsigned)HEAP_HEALTH_MIN_ALLOC, activePageTasks[idx].name.c_str());
          taskStampRestartingStatus(idx);
          taskRunAfterRestartIdx = idx;
          heapRestartStreak++;
          saveTaskRestartState(taskRunAfterRestartIdx, heapRestartStreak);
          delay(50);
          ESP.restart();
        }
        Serial.printf("[Heap] max alloc %u still below %u after %u restarts — running task \"%s\" anyway\n",
                      (unsigned)ESP.getMaxAllocHeap(), (unsigned)HEAP_HEALTH_MIN_ALLOC, (unsigned)heapRestartStreak, activePageTasks[idx].name.c_str());
      }
      runPageTaskByIndex(idx);
    }
  }

  if (pendingAiReopenAfterWake && WiFi.status() == WL_CONNECTED) {
    pendingAiReopenAfterWake = false;
    if (!settingsPageOpen && !aiPageOpen && !translatorPageOpen && !noteRecordPageOpen && !wifiSetupMandatory && sdMounted && !deviceLockedForAuth() && !deviceLockOn) {
      openAiPage();
    }
  }

  if (!displayOn && !aiPageOpen && !translatorPageOpen && !noteRecordPageOpen && !wifiSetupMandatory
      && aiState == AI_IDLE && pendingTaskRunIdx < 0 && pendingWebTaskRunIdx < 0
      && !wxFetchRunning) {
    static unsigned long lastHeapHealthCheckMs = 0;
    if (millis() - lastHeapHealthCheckMs > 30000) {
      lastHeapHealthCheckMs = millis();
      unsigned maxAlloc = (unsigned)ESP.getMaxAllocHeap();
      if (maxAlloc >= HEAP_HEALTH_MIN_ALLOC) {
        heapRestartStreak = 0;
      } else if (heapRestartStreak < 2 && millis() - lastWebActivityMs > 120000) {
        Serial.printf("[Heap] max alloc %u below %u — restarting to clear fragmentation\n",
                      maxAlloc, (unsigned)HEAP_HEALTH_MIN_ALLOC);
        heapRestartStreak++;
        saveTaskRestartState(taskRunAfterRestartIdx, heapRestartStreak);
        delay(50);
        ESP.restart();
      }
    }
  }

  {
    static unsigned long lastBatCheck = 0;
    static int lastDrawnBatPercent = -999;
    static bool lastDrawnCharging = false;
    if (displayOn && !settingsPageOpen && !aiPageOpen && !translatorPageOpen && !noteRecordPageOpen
        && !devicePinPageOpen && !qrPageOpen && !wifiSetupMandatory && sdMounted && millis() - lastBatCheck > 2000) {
      lastBatCheck = millis();
      int curBat = getBatteryPercent();
      bool curCharging = pmuOk && pmu.isCharging();
      if (curBat != lastDrawnBatPercent || curCharging != lastDrawnCharging) {
        lastDrawnBatPercent = curBat;
        lastDrawnCharging = curCharging;
        _drawStatusRow();
      }
    }
  }

  delay(10);
}
