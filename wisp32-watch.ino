  else if (wifiSetupMandatory) drawWifiSetupMandatoryScreen();
  else drawClockScreen();
}

#define COLOR_THEME_MAX 10
#define COLOR_THEMES_FILE "/colorthemes.txt"
struct ColorTheme { String name; uint16_t white, blue, black; };
static ColorTheme* colorThemes = nullptr;
static int colorThemeCount = 0;
bool allocColorThemesInPsram() {
  colorThemes = (ColorTheme*)ps_malloc(sizeof(ColorTheme) * COLOR_THEME_MAX);
  if (!colorThemes) return false;
  for (int i = 0; i < COLOR_THEME_MAX; i++) new (&colorThemes[i]) ColorTheme();
  return true;
}

void loadColorThemes() {
  colorThemeCount = 0;
  if (!colorThemes) return;
  if (!sdMounted || !SD_MMC.exists(COLOR_THEMES_FILE)) return;
  File f = SD_MMC.open(COLOR_THEMES_FILE, FILE_READ);
  if (!f) return;
  while (f.available() && colorThemeCount < COLOR_THEME_MAX) {
    String line = f.readStringUntil('\n');
    line.trim();
    if (line.length() == 0) continue;
    int p1 = line.indexOf('|');
    int p2 = (p1 >= 0) ? line.indexOf('|', p1 + 1) : -1;
    int p3 = (p2 >= 0) ? line.indexOf('|', p2 + 1) : -1;
    if (p1 < 0 || p2 < 0 || p3 < 0) continue;
    colorThemes[colorThemeCount].name  = line.substring(0, p1);
    colorThemes[colorThemeCount].white = hexToRgb565(line.substring(p1 + 1, p2));
    colorThemes[colorThemeCount].blue  = hexToRgb565(line.substring(p2 + 1, p3));
    colorThemes[colorThemeCount].black = hexToRgb565(line.substring(p3 + 1));
    colorThemeCount++;
  }
  f.close();
}

static int activeThemeIndex() {
  if (activeThemeName.length() == 0 || !colorThemes) return -1;
  for (int i = 0; i < colorThemeCount; i++) {
    if (colorThemes[i].name == activeThemeName) return i;
  }
  return -1;
}

static void applyActiveTheme() {
  int idx = activeThemeIndex();
  if (idx < 0) {
    COLOR_WHITE = COLOR_WHITE_DEFAULT;
    COLOR_BLUE  = COLOR_BLUE_DEFAULT;
    COLOR_BLACK = COLOR_BLACK_DEFAULT;
    activeThemeName = "";
  } else {
    COLOR_WHITE = colorThemes[idx].white;
    COLOR_BLUE  = colorThemes[idx].blue;
    COLOR_BLACK = colorThemes[idx].black;
  }
  recomputeDerivedColors();
}

void cycleColorTheme() {
  int pos = activeThemeIndex() + 1;
  pos = (pos + 1) % (colorThemeCount + 1);
  activeThemeName = (pos == 0) ? String("") : colorThemes[pos - 1].name;
  applyActiveTheme();
  saveSettings();
  drawSettingsPage();
}

static String themeRowLabel() {
  int idx = activeThemeIndex();
  if (idx < 0) return "Default";
  String n = colorThemes[idx].name;
  if ((int)n.length() > THEME_ROW_MAX_CHARS) return n.substring(0, THEME_ROW_MAX_CHARS - 2) + "..";
  return n;
}

static bool saveColorThemes() {
  if (!sdMounted) return false;
  File f = SD_MMC.open(COLOR_THEMES_FILE, "w");
  if (!f) return false;
  for (int i = 0; i < colorThemeCount; i++) {
    f.println(colorThemes[i].name + "|" + rgb565ToHex(colorThemes[i].white)
               + "|" + rgb565ToHex(colorThemes[i].blue) + "|" + rgb565ToHex(colorThemes[i].black));
  }
  f.close();
  return true;
}

