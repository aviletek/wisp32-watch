  _drawWifiSetupInstructions(false);
}

void drawSdCardMissingScreen() {
  gfx->fillScreen(COLOR_BLACK);
  _clockCenterPrint("Insert SD Card", SCREEN_HEIGHT / 2 - 20, 3, COLOR_WHITE);
  _clockCenterPrint("Swipe down for Settings", SCREEN_HEIGHT - 50, 2, COLOR_GRAY);
}

void showDeviceLockedMessage() {
  deviceLockedMsgActive = true;
  deviceLockedMsgShownAt = millis();

  gfx->fillScreen(COLOR_BLACK);
  const char* msg = "Device Locked";
  const int margin = 20;
  int16_t bx, by; uint16_t bw, bh;
  int sz = 8;
  for (; sz > 1; sz--) {
    gfx->setTextSize(sz);
    gfx->getTextBounds(msg, 0, 0, &bx, &by, &bw, &bh);
    if ((int)bw <= SCREEN_WIDTH - 2 * margin) break;
  }
  _clockCenterPrint(msg, SCREEN_HEIGHT / 2, sz, COLOR_BLUE);
}

void applyWifiSetupSubmission() {
  bool replaced = false;
  for (int i = 0; i < activeWifiNetworkCount; i++) {
    if (activeWifiNetworks[i].ssid == wifiSetupNewSsid) { activeWifiNetworks[i].pass = wifiSetupNewPass; replaced = true; break; }
  }
  if (!replaced && activeWifiNetworks && activeWifiNetworkCount < MAX_WIFI_NETWORKS) {
    activeWifiNetworks[activeWifiNetworkCount].ssid = wifiSetupNewSsid;
    activeWifiNetworks[activeWifiNetworkCount].pass = wifiSetupNewPass;
    activeWifiNetworkCount++;
  }
  saveCredentials();
  gfx->fillScreen(COLOR_BLACK);
  _clockCenterPrint("Saved!", SCREEN_HEIGHT / 2 - 20, 3, COLOR_GREEN);
  _clockCenterPrint("Restarting...", SCREEN_HEIGHT / 2 + 20, 2, COLOR_GRAY);
  gfx->flush();
  delay(1500);
  ESP.restart();
}

void enterWifiSetupPortal() {
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP("Watch-Setup");
  _drawWifiSetupInstructions(true);
  gfx->flush();

  wifiSetupSubmitted = false;
  wifiSetupPortalActive = true;
  if (touchOk) touchFT3168->IIC_Interrupt_Flag = false;

  unsigned long startMs = millis();
  const unsigned long WIFI_SETUP_TIMEOUT_MS = 5UL * 60UL * 1000UL;
  unsigned long lastSdPresenceCheck = millis();
  while (!wifiSetupSubmitted && millis() - startMs < WIFI_SETUP_TIMEOUT_MS) {
    server.handleClient();
    if (touchOk && touchFT3168->IIC_Interrupt_Flag) {
      touchFT3168->IIC_Interrupt_Flag = false;
      break;
    }
    if (sdMounted && millis() - lastSdPresenceCheck > 5000) {
      lastSdPresenceCheck = millis();
      if (!sdCardStillPresent()) {
        Serial.println("[SDCard] card no longer detected — treating as removed (WiFi Setup portal)");
        sdMounted = false;
        break;
      }
    }
    delay(10);
  }
  wifiSetupPortalActive = false;

  if (wifiSetupSubmitted) {
    WiFi.softAPdisconnect(true);
    WiFi.mode(WIFI_STA);
    applyWifiSetupSubmission();
  }
  WiFi.softAPdisconnect(true);
  WiFi.mode(WIFI_STA);
  if (!sdMounted) {
    drawSdCardMissingScreen();
  } else if (settingsPageOpen) {
    drawSettingsPage();
  } else {
    drawClockScreen();
  }
}

