void savePageTasks() {
  if (!sdMounted) return;
  BasicJsonDocument<PsramJsonAllocator> doc(32768);
  JsonArray arr = doc.to<JsonArray>();
  for (int i = 0; i < activePageTaskCount; i++) {
    JsonObject t = arr.createNestedObject();
    t["name"] = activePageTasks[i].name;
    t["model"] = activePageTasks[i].model;
    t["notify"] = activePageTasks[i].notify;
    t["folder"] = activePageTasks[i].folder;
    JsonArray steps = t.createNestedArray("steps");
    for (int s = 0; s < activePageTasks[i].stepCount; s++) {
      JsonObject so = steps.createNestedObject();
      so["type"] = activePageTasks[i].steps[s].type;
      so["text"] = activePageTasks[i].steps[s].text;
      so["action"] = activePageTasks[i].steps[s].action;
      JsonArray params = so.createNestedArray("param");
      for (int p = 0; p < TASK_STEP_PARAM_MAX; p++) params.add(activePageTasks[i].steps[s].param[p]);
      so["saveAs"] = activePageTasks[i].steps[s].saveAs;
    }
    JsonArray extracts = t.createNestedArray("apiExtracts");
    for (int e = 0; e < activePageTasks[i].apiExtractCount; e++) {
      JsonObject eo = extracts.createNestedObject();
      eo["name"] = activePageTasks[i].apiExtracts[e].name;
      eo["path"] = activePageTasks[i].apiExtracts[e].path;
    }
    t["lastRunAt"] = activePageTasks[i].lastRunAt;
    t["lastRunStatus"] = activePageTasks[i].lastRunStatus;
    t["retries"] = activePageTasks[i].retries;
    t["scheduleType"] = activePageTasks[i].scheduleType;
    t["scheduleDate"] = activePageTasks[i].scheduleDate;
    t["scheduleTime"] = activePageTasks[i].scheduleTime;
    t["scheduleDays"] = activePageTasks[i].scheduleDays;
    t["scheduleLastFiredDate"] = activePageTasks[i].scheduleLastFiredDate;
    t["beepOnCompletion"] = activePageTasks[i].beepOnCompletion;
    t["apiMethod"] = activePageTasks[i].apiMethod;
    t["apiUrl"] = activePageTasks[i].apiUrl;
    t["apiHeaders"] = activePageTasks[i].apiHeaders;
    t["apiAuthType"] = activePageTasks[i].apiAuthType;
    t["apiAuthKeyName"] = activePageTasks[i].apiAuthKeyName;
    t["apiAuthValue"] = activePageTasks[i].apiAuthValue;
    t["apiBody"] = activePageTasks[i].apiBody;
    t["lastRunEpoch"] = (long)activePageTasks[i].lastRunEpoch;
  }
  String out; serializeJson(doc, out);
  writeSecretFile(PAGE_TASKS_FILE, out);
}

void loadPageTasks() {
  activePageTaskCount = 0;
  if (!activePageTasks) return;
  if (!sdMounted || !SD_MMC.exists(PAGE_TASKS_FILE)) return;
  bool wasPlaintext = false;
  String raw = readSecretFile(PAGE_TASKS_FILE, &wasPlaintext);
  BasicJsonDocument<PsramJsonAllocator> doc(32768);
  if (deserializeJson(doc, raw) != DeserializationError::Ok) return;
  for (JsonObject t : doc.as<JsonArray>()) {
    if (activePageTaskCount >= MAX_PAGE_TASKS) break;
    activePageTasks[activePageTaskCount].name         = String((const char*)(t["name"]         | ""));
    activePageTasks[activePageTaskCount].model        = String((const char*)(t["model"]        | ""));
    activePageTasks[activePageTaskCount].notify       = String((const char*)(t["notify"]       | ""));
    activePageTasks[activePageTaskCount].folder       = String((const char*)(t["folder"]       | ""));
    activePageTasks[activePageTaskCount].stepCount = 0;
    for (JsonObject so : t["steps"].as<JsonArray>()) {
      if (activePageTasks[activePageTaskCount].stepCount >= PAGE_TASK_STEP_MAX) break;
      TaskStep& step = activePageTasks[activePageTaskCount].steps[activePageTasks[activePageTaskCount].stepCount];
      step.type   = String((const char*)(so["type"]   | ""));
      step.text   = String((const char*)(so["text"]   | ""));
      step.action = String((const char*)(so["action"] | ""));
      int p = 0;
      for (JsonVariant pv : so["param"].as<JsonArray>()) {
        if (p >= TASK_STEP_PARAM_MAX) break;
        step.param[p++] = String((const char*)(pv | ""));
      }
      step.saveAs = String((const char*)(so["saveAs"] | ""));
      activePageTasks[activePageTaskCount].stepCount++;
    }
    activePageTasks[activePageTaskCount].apiExtractCount = 0;
    for (JsonObject eo : t["apiExtracts"].as<JsonArray>()) {
      if (activePageTasks[activePageTaskCount].apiExtractCount >= API_EXTRACT_MAX) break;
      int e = activePageTasks[activePageTaskCount].apiExtractCount;
      activePageTasks[activePageTaskCount].apiExtracts[e].name = String((const char*)(eo["name"] | ""));
      activePageTasks[activePageTaskCount].apiExtracts[e].path = String((const char*)(eo["path"] | ""));
      activePageTasks[activePageTaskCount].apiExtractCount++;
    }
    activePageTasks[activePageTaskCount].lastRunAt     = String((const char*)(t["lastRunAt"]     | ""));
    activePageTasks[activePageTaskCount].lastRunStatus = String((const char*)(t["lastRunStatus"] | ""));
    activePageTasks[activePageTaskCount].retries        = (int)(t["retries"] | 0);
    activePageTasks[activePageTaskCount].scheduleType   = String((const char*)(t["scheduleType"] | ""));
    activePageTasks[activePageTaskCount].scheduleDate   = String((const char*)(t["scheduleDate"] | ""));
    activePageTasks[activePageTaskCount].scheduleTime   = String((const char*)(t["scheduleTime"] | ""));
    activePageTasks[activePageTaskCount].scheduleDays   = String((const char*)(t["scheduleDays"] | ""));
    activePageTasks[activePageTaskCount].scheduleLastFiredDate = String((const char*)(t["scheduleLastFiredDate"] | ""));
    activePageTasks[activePageTaskCount].beepOnCompletion = t["beepOnCompletion"] | false;
    activePageTasks[activePageTaskCount].apiMethod      = String((const char*)(t["apiMethod"]      | ""));
    activePageTasks[activePageTaskCount].apiUrl         = String((const char*)(t["apiUrl"]         | ""));
    activePageTasks[activePageTaskCount].apiHeaders     = String((const char*)(t["apiHeaders"]     | ""));
    activePageTasks[activePageTaskCount].apiAuthType    = String((const char*)(t["apiAuthType"]    | ""));
    activePageTasks[activePageTaskCount].apiAuthKeyName = String((const char*)(t["apiAuthKeyName"] | ""));
    activePageTasks[activePageTaskCount].apiAuthValue   = String((const char*)(t["apiAuthValue"]   | ""));
    activePageTasks[activePageTaskCount].apiBody        = String((const char*)(t["apiBody"]        | ""));
    activePageTasks[activePageTaskCount].lastRunEpoch   = (time_t)(long)(t["lastRunEpoch"] | 0);
    activePageTaskCount++;
  }
  if (wasPlaintext) {
    Serial.println("[Tasks] page_tasks.json under the wrong/legacy key — re-saving under the current key");
    savePageTasks();
  }
}

