static bool isChatLogHeader(const String& line) {
  return line.startsWith("[") && line.endsWith("]") && line.indexOf(" | ") > 0;
}

static int parseChatLog(String* ts, String* qs, String* as, int maxE, int skip = 0) {
  if (!sdMounted || !SD_MMC.exists("/chat_log.txt")) return 0;
  ChatLogReader f;
  if (!f.open("/chat_log.txt")) return 0;
  int count = 0, skipped = 0;
  String ct = "", cq = "", ca = "";
  int state = 0;
  while (f.available()) {
    String line = f.readStringUntil('\n');
    if (line.endsWith("\r")) line.remove(line.length() - 1);
    if (isChatLogHeader(line)) {
      if (cq.length() > 0 || ca.length() > 0) {
        if (skipped < skip) { skipped++; cq = ""; ca = ""; }
        else if (count < maxE) { ts[count]=ct; qs[count]=cq; as[count]=ca; count++; cq=""; ca=""; }
        else { cq = ""; ca = ""; break; }
      }
      ct = line.substring(1, line.length() - 1);
      state = 0;
    } else if (state == 0 && line.startsWith("Q: ")) { cq = line.substring(3); state = 1; }
    else if (state == 1 && line.startsWith("A: ")) { ca = line.substring(3); state = 2; }
    else if (state == 2) { ca += "\n" + line; }
    else if (state == 1) { cq += "\n" + line; }
  }
  f.close();
  if ((cq.length() > 0 || ca.length() > 0) && skipped >= skip && count < maxE) { ts[count]=ct; qs[count]=cq; as[count]=ca; count++; }
  return count;
}

static String chatHdrField(const String& hdr, int idx) {
  int start = 0;
  for (int i = 0; i < idx; i++) {
    int sep = hdr.indexOf(" | ", start);
    if (sep < 0) return "";
    start = sep + 3;
  }
  int end = hdr.indexOf(" | ", start);
  return (end < 0) ? hdr.substring(start) : hdr.substring(start, end);
}
static String chatHdrTag(const String& hdr, const char* key) {
  String needle = String(" | ") + key;
  int p = hdr.indexOf(needle);
  if (p < 0) return "";
  int start = p + needle.length();
  int end = hdr.indexOf(" | ", start);
  return (end < 0) ? hdr.substring(start) : hdr.substring(start, end);
}

void handleApiSessions() {
  if (!requireAuth()) return;
  server.setContentLength(CONTENT_LENGTH_UNKNOWN);
  server.send(200, "application/json; charset=utf-8", "");

  String out; out.reserve(1400);
  auto push = [&](const String& s) { out += s; if (out.length() >= 1024) { server.sendContent(out); out = ""; } };

  push("{\"sessions\":[");

  ChatLogReader f;
  if (!sdMounted || !SD_MMC.exists("/chat_log.txt") || !f.open("/chat_log.txt")) {
    push("]}");
    if (out.length()) server.sendContent(out);
    server.sendContent("");
    return;
  }

  String ct = "", cq = "", ca = "";
  int state = 0;
  bool sessionOpen = false, firstSession = true, firstTurn = false;
  String curSid = "\x01";

  auto emitTurn = [&]() {
    String ts   = chatHdrField(ct, 0);
    String model = chatHdrField(ct, 1);
    String sid  = chatHdrTag(ct, "s=");
    String nStr = chatHdrTag(ct, "n=");
    String aTag = chatHdrTag(ct, "a=");
    String audio = "";
    if (aTag.length() > 2 && aTag.charAt(1) == ':') {
      String dir = (aTag.charAt(0) == 'T') ? "Translator Audio" : "AI Assistant Audio";
      audio = dir + "/" + aTag.substring(2) + ".wav";
    }
    bool newSession = !sessionOpen || sid.length() == 0 || sid != curSid;
    if (newSession) {
      if (sessionOpen) push("]}");
      push(firstSession ? "" : ",");
      firstSession = false; curSid = sid; sessionOpen = true; firstTurn = true;
      push("{\"id\":\"" + jsonEscape(sid) + "\",\"start\":\"" + jsonEscape(ts)
         + "\",\"model\":\"" + jsonEscape(model) + "\",\"turns\":[");
    }
    push(firstTurn ? "" : ",");
    firstTurn = false;
    push("{\"ts\":\"" + jsonEscape(ts) + "\",\"model\":\"" + jsonEscape(model)
       + "\",\"n\":\"" + jsonEscape(nStr) + "\",\"q\":\"" + jsonEscape(cq)
       + "\",\"a\":\"" + jsonEscape(ca) + "\",\"audio\":\"" + jsonEscape(audio) + "\"}");
  };

  while (f.available()) {
    String line = f.readStringUntil('\n');
    if (line.endsWith("\r")) line.remove(line.length() - 1);
    if (isChatLogHeader(line)) {
      if (cq.length() > 0 || ca.length() > 0) { emitTurn(); cq = ""; ca = ""; }
      ct = line.substring(1, line.length() - 1);
      state = 0;
    } else if (state == 0 && line.startsWith("Q: ")) { cq = line.substring(3); state = 1; }
    else if (state == 1 && line.startsWith("A: ")) { ca = line.substring(3); state = 2; }
    else if (state == 2) { ca += "\n" + line; }
    else if (state == 1) { cq += "\n" + line; }
  }
  f.close();
  if (cq.length() > 0 || ca.length() > 0) emitTurn();

  if (sessionOpen) push("]}");
  push("]}");
  if (out.length()) server.sendContent(out);
  server.sendContent("");
}

static int countChatLog() {
  if (!sdMounted || !SD_MMC.exists("/chat_log.txt")) return 0;
  ChatLogReader f;
  if (!f.open("/chat_log.txt")) return 0;
  int count = 0;
  String cq = "";
  bool sawAnswer = false;
  int state = 0;
  while (f.available()) {
    String line = f.readStringUntil('\n');
    if (line.endsWith("\r")) line.remove(line.length() - 1);
    if (isChatLogHeader(line)) {
      if (cq.length() > 0 || sawAnswer) count++;
      cq = ""; sawAnswer = false;
      state = 0;
    } else if (state == 0 && line.startsWith("Q: ")) { cq = line.substring(3); state = 1; }
    else if (state == 1 && line.startsWith("A: ")) { state = 2; sawAnswer = true; }
    else if (state == 1) { cq += "\n" + line; }
  }
  f.close();
  if (cq.length() > 0 || sawAnswer) count++;
  return count;
}

static int parseChatLogFromEnd(String* ts, String* qs, String* as, int maxCount, int skipFromEnd) {
  if (!sdMounted || !SD_MMC.exists("/chat_log.txt")) return 0;
  ChatLogReader f;
  if (!f.open("/chat_log.txt")) return 0;
  size_t fileSize = f.size();
  if (fileSize == 0) { f.close(); return 0; }

  const size_t CHUNK = 1024;
  size_t pos = fileSize;
  String buffer = "";
  buffer.reserve(CHUNK * 2);

  const int MAX_ENTRY_LINES = 200;
  static String curLines[MAX_ENTRY_LINES];
  int curLineCount = 0;

  int entriesSkipped = 0, entriesCaptured = 0;
  bool done = false;

  auto closeEntry = [&](const String& headerLine) {
    String ct = headerLine.substring(1, headerLine.length() - 1);
    String cq = "", ca = "";
    int state = 0;
    for (int li = curLineCount - 1; li >= 0; li--) {
      const String& l = curLines[li];
      if      (state == 0 && l.startsWith("Q: ")) { cq = l.substring(3); state = 1; }
      else if (state == 1 && l.startsWith("A: ")) { ca = l.substring(3); state = 2; }
      else if (state == 2)                        { ca += "\n" + l; }
      else if (state == 1)                        { cq += "\n" + l; }
    }
    curLineCount = 0;
    if (cq.length() == 0 && ca.length() == 0) return;
    if (entriesSkipped < skipFromEnd) { entriesSkipped++; return; }
    if (entriesCaptured < maxCount) {
      ts[entriesCaptured] = ct; qs[entriesCaptured] = cq; as[entriesCaptured] = ca;
      entriesCaptured++;
    }
    if (entriesCaptured >= maxCount) done = true;
  };

  while (!done && pos > 0) {
    size_t readSize = min(CHUNK, pos);
    pos -= readSize;
    f.seek(pos);
    uint8_t chunkBuf[CHUNK];
    size_t got = f.read(chunkBuf, readSize);
    if (got != readSize) break;
    String chunkStr;
    chunkStr.reserve(got);
    chunkStr.concat((const char*)chunkBuf, (unsigned int)got);
    buffer = chunkStr + buffer;

    while (true) {
      int nl = buffer.lastIndexOf('\n');
      if (nl < 0) break;
      String line = buffer.substring(nl + 1);
      buffer = buffer.substring(0, nl);
      if (line.endsWith("\r")) line.remove(line.length() - 1);
      if (isChatLogHeader(line)) {
        closeEntry(line);
        if (done) break;
      } else if (curLineCount < MAX_ENTRY_LINES) {
        curLines[curLineCount++] = line;
      }
    }
  }
  f.close();

  if (!done && buffer.length() > 0) {
    String line = buffer;
    if (line.endsWith("\r")) line.remove(line.length() - 1);
    if (isChatLogHeader(line)) closeEntry(line);
    else if (curLineCount < MAX_ENTRY_LINES) curLines[curLineCount++] = line;
  }

  for (int i = 0; i < entriesCaptured / 2; i++) {
    int j = entriesCaptured - 1 - i;
    String t = ts[i]; ts[i] = ts[j]; ts[j] = t;
    String q = qs[i]; qs[i] = qs[j]; qs[j] = q;
    String a = as[i]; as[i] = as[j]; as[j] = a;
  }
  return entriesCaptured;
}

String aiToolRecallHistory(int count) {
  if (count <= 0) count = AI_RECALL_HISTORY_MAX;
  if (count > AI_RECALL_HISTORY_MAX) count = AI_RECALL_HISTORY_MAX;

  int total = countChatLog();
  if (total == 0) return "No past conversation history is available yet.";

  int n = min(count, total);
  int skip = total - n;
  static String ts[AI_RECALL_HISTORY_MAX], qs[AI_RECALL_HISTORY_MAX], as[AI_RECALL_HISTORY_MAX];
  int got = parseChatLog(ts, qs, as, AI_RECALL_HISTORY_MAX, skip);
  if (got == 0) return "No past conversation history is available yet.";

  String out = "Here " + String(got == 1 ? "is" : "are") + " the last " + String(got) + (got == 1 ? " exchange" : " exchanges") + " from before this session (oldest first):\n\n";
  for (int i = 0; i < got; i++) {
    String h = ts[i];
    { int sp = h.indexOf(" | s="); int ap = h.indexOf(" | a=");
      int cut = sp; if (ap >= 0 && (cut < 0 || ap < cut)) cut = ap;
      if (cut >= 0) h = h.substring(0, cut); }
    out += "[" + h + "]\nQ: " + qs[i] + "\nA: " + as[i] + "\n\n";
  }
  return out;
}

