static String appsTileTitle(const String& filename) {
  String base = filename;
  int dot = base.lastIndexOf('.');
  if (dot > 0) base = base.substring(0, dot);
  base.replace("_", " ");
  base.replace("-", " ");
  bool startOfWord = true;
  for (size_t i = 0; i < base.length(); i++) {
    if (base[i] == ' ') { startOfWord = true; continue; }
    if (startOfWord) { base[i] = toupper(base[i]); startOfWord = false; }
  }
  return base;
}

static bool appsBufContainsCI(const uint8_t* buf, size_t len, const char* needle) {
  size_t nlen = strlen(needle);
  if (nlen == 0 || len < nlen) return false;
  for (size_t i = 0; i + nlen <= len; i++) {
    size_t j = 0;
    while (j < nlen && tolower(buf[i + j]) == tolower((unsigned char)needle[j])) j++;
    if (j == nlen) return true;
  }
  return false;
}

#define APPS_SCAN_CHUNK 4096
#define APPS_SCAN_OVERLAP 10
static uint8_t* appsScanBuf = nullptr;
bool allocAppsScanBufInPsram() {
  appsScanBuf = (uint8_t*)ps_malloc(APPS_SCAN_CHUNK + APPS_SCAN_OVERLAP);
  return appsScanBuf != nullptr;
}

static bool appsFileQualifies(const String& path) {
  if (!appsScanBuf) return false;
  File f = SD_MMC.open(path, FILE_READ);
  if (!f) return false;
  size_t carry = 0, scanned = 0;
  const size_t MAX_SCAN = 1024UL * 1024UL;
  bool hasScript = false, hasStyle = false;
  while (f.available() && scanned < MAX_SCAN && !(hasScript && hasStyle)) {
    size_t got = f.read(appsScanBuf + carry, APPS_SCAN_CHUNK);
    if (got == 0) break;
    size_t total = carry + got;
    if (!hasScript && appsBufContainsCI(appsScanBuf, total, "<script")) hasScript = true;
    if (!hasStyle  && (appsBufContainsCI(appsScanBuf, total, "<style") ||
                        appsBufContainsCI(appsScanBuf, total, "stylesheet"))) hasStyle = true;
    carry = (total < APPS_SCAN_OVERLAP) ? total : APPS_SCAN_OVERLAP;
    memmove(appsScanBuf, appsScanBuf + (total - carry), carry);
    scanned += got;
  }
  f.close();
  return hasScript && hasStyle;
}

static const char* APPS_TILE_COLORS[] = { "#4af", "#a78bfa", "#2dd4bf", "#f472b6", "#fa4", "#5b8cff" };
#define APPS_TILE_COLOR_COUNT 6

struct AppEntry { String relPath; String title; };
#define APPS_ENTRIES_MAX 40
static AppEntry* appEntries = nullptr;
bool allocAppEntriesInPsram() {
  appEntries = (AppEntry*)ps_malloc(sizeof(AppEntry) * APPS_ENTRIES_MAX);
  if (!appEntries) return false;
  for (int i = 0; i < APPS_ENTRIES_MAX; i++) new (&appEntries[i]) AppEntry();
  return true;
}

void handleAppsPage() {
  if (!requireAuth()) return;
  if (navRouteBlocked("apps")) return;

  int entryCount = 0;
  if (sdMounted && appEntries) {
    String scanQ[30]; int qH = 0, qT = 0;
    scanQ[qT++] = "";
    while (qH < qT && entryCount < APPS_ENTRIES_MAX) {
      String rel = scanQ[qH++];
      String full = String(FILES_DIR) + (rel.length() > 0 ? "/" + rel : "");
      File dir = SD_MMC.open(full);
      if (!dir || !dir.isDirectory()) { if (dir) dir.close(); continue; }
      File f = dir.openNextFile();
      while (f) {
        bool isDir = f.isDirectory();
        String fullName = f.name();
        f.close();
        int lastSlash = fullName.lastIndexOf('/');
        String name = (lastSlash >= 0) ? fullName.substring(lastSlash + 1) : fullName;
        if (isDir) {
          if (!name.startsWith("_") && !name.startsWith(".") && qT < 30) {
            scanQ[qT++] = rel.length() > 0 ? rel + "/" + name : name;
          }
        } else if (entryCount < APPS_ENTRIES_MAX) {
          String lower = name; lower.toLowerCase();
          if (lower.endsWith(".html") || lower.endsWith(".htm")) {
            String relPath = rel.length() > 0 ? rel + "/" + name : name;
            if (appsFileQualifies(String(FILES_DIR) + "/" + relPath)) {
              appEntries[entryCount].relPath = relPath;
              appEntries[entryCount].title = appsTileTitle(name);
              entryCount++;
            }
          }
        }
        f = dir.openNextFile();
      }
      dir.close();
    }
  }
  for (int i = 1; i < entryCount; i++) {
    AppEntry key = appEntries[i];
    int j = i - 1;
    while (j >= 0 && appEntries[j].title.compareTo(key.title) > 0) { appEntries[j + 1] = appEntries[j]; j--; }
    appEntries[j + 1] = key;
  }

  String tiles = "";
  for (int i = 0; i < entryCount; i++) {
    String encRef = urlEncodeParam(appEntries[i].relPath);
    const char* color = APPS_TILE_COLORS[i % APPS_TILE_COLOR_COUNT];
    char initial = appEntries[i].title.length() > 0 ? toupper(appEntries[i].title[0]) : '?';
    tiles += "<a class='apptile' href='/fileview?file=" + encRef + "' target='_blank' rel='noopener'>"
             "<div class='apptile-icon' style='background:" + String(color) + "'>" + String(initial) + "</div>"
             "<div class='apptile-name'>" + escapeHtmlAttr(appEntries[i].title) + "</div>"
             "<div class='apptile-file'>" + escapeHtmlAttr(appEntries[i].relPath) + "</div>"
             "</a>";
  }

  String css = pageCss() + navCss() +
    ".intro{color:#999;font-size:.88em;line-height:1.5;margin:0 0 20px;background:#1a1a1a;"
    "border:1px solid #2a2a2a;border-radius:8px;padding:14px 16px}"
    ".appgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}"
    "@media (max-width:520px){.appgrid{grid-template-columns:repeat(2,1fr)}}"
    ".apptile{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:12px;padding:18px 14px;"
    "display:flex;flex-direction:column;align-items:center;gap:10px;text-decoration:none;text-align:center;"
    "transition:border-color .12s;min-width:0}"
    ".apptile:hover{border-color:#4af}"
    ".apptile-icon{width:44px;height:44px;border-radius:10px;display:flex;align-items:center;justify-content:center;"
    "font-weight:700;font-size:1.1em;color:#04101c;flex:none}"
    ".apptile-name{color:#eee;font-size:.86em;font-weight:600;line-height:1.3;word-break:break-word}"
    ".apptile-file{color:#777;font-size:.68em;font-family:monospace;word-break:break-word}"
    ".appempty{color:#777;font-size:.85em;text-align:center;padding:40px 20px;background:#1a1a1a;"
    "border:1px dashed #2a2a2a;border-radius:10px}";

  String body = entryCount > 0
    ? "<div class='appgrid'>" + tiles + "</div>"
    : "<div class='appempty'>No apps yet &mdash; drop a self-contained .html file (with its own CSS and JavaScript) anywhere in the Files folder, then come back here.</div>";

  String html = "<!DOCTYPE html><html><head><meta charset='UTF-8'>"
    "<meta name='viewport' content='width=device-width,initial-scale=1'>"
    "<title>" + webTitleBrand() + "</title>" WEB_FAVICON
    "<style>" + applyWebTheme(css) + "</style></head><body>"
    + buildNav("/apps") +
    "<p class='intro'>Tap a tile to open .html apps (with their own CSS and JavaScript), in the Files folder. <strong>Apps run with full access to the device</strong> &mdash; a poorly written or malicious .html app can freeze, crash, or otherwise make the device unresponsive. Only open apps you trust.</p>"
    + body +
    "</body></html>";
  server.send(200, "text/html; charset=utf-8", html);
}

static bool isAudioFileName(const String& name) {
  String lower = name; lower.toLowerCase();
  return lower.endsWith(".mp3") || lower.endsWith(".wav") || lower.endsWith(".ogg") ||
         lower.endsWith(".oga") || lower.endsWith(".m4a") || lower.endsWith(".aac") ||
         lower.endsWith(".flac") || lower.endsWith(".opus");
}

extern unsigned long lastAudioServerActivityMs;
void handleApiAudioFiles() {
  if (!requireAuth()) return;
  ensureAudioStreamingServer();
  lastAudioServerActivityMs = millis();
  server.setContentLength(CONTENT_LENGTH_UNKNOWN);
  server.send(200, "application/json", "");
  server.sendContent("[");
  bool first = true;
  if (sdMounted) {
    String scanQ[30]; int qH = 0, qT = 0;
    scanQ[qT++] = "";
    while (qH < qT) {
      String rel = scanQ[qH++];
      String full = String(FILES_DIR) + (rel.length() > 0 ? "/" + rel : "");
      File dir = SD_MMC.open(full);
      if (!dir || !dir.isDirectory()) { if (dir) dir.close(); continue; }
      File f = dir.openNextFile();
      while (f) {
        bool isDir = f.isDirectory();
        String fullName = f.name();
        size_t entrySize = f.size();
        f.close();
        int lastSlash = fullName.lastIndexOf('/');
        String name = (lastSlash >= 0) ? fullName.substring(lastSlash + 1) : fullName;
        if (isDir) {
          if (!name.startsWith("_") && !name.startsWith(".") && qT < 30) {
            scanQ[qT++] = rel.length() > 0 ? rel + "/" + name : name;
          }
        } else if (isAudioFileName(name)) {
          String relPath = rel.length() > 0 ? rel + "/" + name : name;
          if (!first) server.sendContent(",");
          first = false;
          server.sendContent("{\"path\":\"" + jsonEscape(relPath) + "\",\"name\":\"" + jsonEscape(name)
                              + "\",\"size\":" + String((unsigned long)entrySize) + "}");
        }
        f = dir.openNextFile();
      }
      dir.close();
    }
  }
  server.sendContent("]");
}

