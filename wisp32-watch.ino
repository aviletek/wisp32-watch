         "<svg viewBox='0 0 24 24'><rect x='2' y='7' width='17' height='10' rx='2'/><line x1='22' y1='10' x2='22' y2='14'/></svg>"
         "<span class='val'>" + battVal + "</span>";
  if (charging) {
    out += "<span class='sb-charge' title='Charging'><svg viewBox='0 0 24 24'><polygon points='13 2 4 14 11 14 9 22 20 9 13 9'/></svg></span>";
  }
  out += "</div>";
  out += "<div class='sb-div'></div>";
  out += "<div class='sb-stat " + sigClass + "' title='" + sigQuality + " signal'>"
         "<svg viewBox='0 0 24 24'><path d='M5 12.55a11 11 0 0 1 14.08 0'/><path d='M1.42 9a16 16 0 0 1 21.16 0'/><path d='M8.53 16.11a6 6 0 0 1 6.95 0'/><line x1='12' y1='20' x2='12.01' y2='20'/></svg>"
         "<span class='val'>" + sigLabel + "</span></div>";
  out += "</div></div>";

  out += "<script>(function(){"
         "var dot=document.querySelector('.sb-dot');if(!dot)return;"
         "var FAST=500,GRACE=20000,EVERY=4000,failSince=null;"
         "function setState(c){dot.className='sb-dot'+(c?(' '+c):'');}"
         "function markFail(){var now=Date.now();if(failSince===null)failSince=now;"
         "setState((now-failSince>=GRACE)?'unreachable':'away');}"
         "function ping(){"
         "if(document.visibilityState!=='visible')return;"
         "var t0=Date.now(),ctrl=new AbortController();"
         "var to=setTimeout(function(){ctrl.abort();},3000);"
         "fetch('/ping',{signal:ctrl.signal,cache:'no-store'}).then(function(r){return r.text();}).then(function(txt){"
         "clearTimeout(to);"
         "if(txt==='sleep'){failSince=Date.now();setState('unreachable');return;}"
         "if(Date.now()-t0<=FAST){failSince=null;setState('');}else{markFail();}"
         "}).catch(function(){clearTimeout(to);markFail();});"
         "}"
         "setInterval(ping,EVERY);"
         "document.addEventListener('visibilitychange',function(){if(document.visibilityState==='visible')ping();});"
         "ping();"
         "})();</script>";

  return out;
