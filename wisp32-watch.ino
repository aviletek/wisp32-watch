    "var TASK_STEPS = " + stepsJs + ";"
    "var API_EXTRACTS = " + extractsJs + ";"
    "var CONVERT_UNITS=['m','km','mile','ft','inch','yard','cm','mm','nm',"
    "'g','kg','lb','oz','mg','stone','tonne','short ton',"
    "'j','kj','mj','cal','kcal','kwh','wh','btu'];"
    "var FILE_CREATE_EXTS=['.txt','.md','.csv','.json'];"
    "var ACTIONS = {"
    "set_alarm:{label:'Set alarm',params:['Name','Time - 24-hour, leave empty to fire the moment this step runs'],placeholders:{1:'HH:MM or HH:MM:SS, e.g. 17:30 or 17:30:15'},noBtnParams:[0,1],saveAsExample:'waketime'},"
    "cancel_alarms:{label:'Cancel alarm(s)',params:['Name filter (leave empty to cancel every pending alarm)'],liveParam:{index:0,kind:'alarms',emptyLabel:'All alarms'},saveAsExample:'cancelresult'},"
    "start_timer:{label:'Start timer',params:['Name'],noBtnParams:[0],saveAsExample:'timerstatus'},"
    "stop_timer:{label:'Stop timer(s)',params:['Name'],liveParam:{index:0,kind:'timers',emptyLabel:'Auto (only if exactly one timer is running)'},saveAsExample:'elapsed'},"
    "reset_timer:{label:'Reset timer',params:['Name'],liveParam:{index:0,kind:'timers'},saveAsExample:'resetresult'},"
    "delete_timer:{label:'Delete timer(s)',params:['Name'],liveParam:{index:0,kind:'timers'},saveAsExample:'deleteresult'},"
    "set_volume:{label:'Set volume (0-100)',params:['Percent'],placeholders:{0:'e.g. 50 - whole number 0-100, not 0.1'},noBtnParams:[0],saveAsExample:'volumeresult'},"
    "set_brightness:{label:'Set brightness (0-100)',params:['Percent'],placeholders:{0:'e.g. 50 - whole number 0-100, not 0.1'},noBtnParams:[0],saveAsExample:'brightnessresult'},"
    "calculate:{label:'Calculate',params:['Expression'],noBtnParams:[0],saveAsExample:'total'},"
    "convert:{label:'Convert units',params:['Value','From unit','To unit'],staticParams:{1:CONVERT_UNITS,2:CONVERT_UNITS},saveAsExample:'converted'},"
    "remember:{label:'Remember',params:['What to remember'],textareaParams:[0],saveAsExample:'memoryresult'},"
    "send_email:{label:'Send email',params:['To (contact name)','Subject','Body','Attachments (optional)'],liveParam:{index:0,kind:'contacts'},fileParam:3,textareaParams:[2],saveAsExample:'emailstatus'},"
    "file_create:{label:'Create file',params:['File name'],noBtnParams:[0],extParam:{index:0,options:FILE_CREATE_EXTS},saveAsExample:'filename'},"
    "file_open:{label:'Read file',params:['File name','PIN (optional, if this file is protected)'],fileParam:0,noBtnParams:[1],pinParams:[1],saveAsExample:'filecontent'},"
    "file_append:{label:'Write to file',params:['Content to write \\u2014 requires a Create file step earlier in this task'],textareaParams:[0],saveAsExample:'writeresult'},"
    "read_webpage:{label:'Read webpage (advanced)',params:['URL \\u2014 not every site allows automated access, so only point this at ones you own or that permit it','Look for (word or phrase)','Offset (characters to skip from the start \\u2014 not every site supports this)','Range (characters to fetch after the offset)','Context length (characters)'],placeholders:{0:'e.g. example.com \\u2014 https:// added automatically if left off',1:'Leave empty to preview the fetched range instead, using the length and side below',2:'e.g. 0',3:'e.g. 200000, capped at 2,000,000',4:'e.g. 4'},noBtnParams:[2,3,4],radiusParam:{index:4,options:['both','above','below'],labels:{both:'Both sides',above:'Above',below:'Below'}},saveAsExample:'webresult'}"
    "};"
    "var LIVE_NAMES={alarms:[],timers:[],contacts:[]};"
    "function refreshLiveNames(cb){"
    "fetch('/tasks/livenames').then(function(r){return r.json();}).then(function(d){LIVE_NAMES=d;if(cb)cb();}).catch(function(){if(cb)cb();});}"
    "function availableNames(){"
    "var names=[];"
    "API_EXTRACTS.forEach(function(e){if(e.name)names.push(e.name);});"
    "if(document.getElementById('apiMethodH').value)names.push('api_response');"
    "TASK_STEPS.forEach(function(s){if(s.saveAs)names.push(s.saveAs);});"
    "return names;}"
    "function insertName(input,name){input.value+='{{'+name+'}}';input.dispatchEvent(new Event('input'));}"
    "function buildNameBtn(input){"
    "var wrap=document.createElement('span');wrap.style.cssText='position:relative;display:inline-block';"
    "var btn=document.createElement('button');btn.type='button';btn.textContent='{}';"
    "btn.title='Insert a value from an earlier step';"
    "btn.style.cssText='flex-shrink:0;background:#222;border:1px solid #444;color:#8ab;border-radius:6px;padding:0 10px;height:38px;cursor:pointer;font-family:monospace;font-size:12px';"
    "btn.addEventListener('click',function(e){"
    "e.stopPropagation();"
    "var existing=wrap.querySelector('.namepick');if(existing){existing.remove();return;}"
    "var names=availableNames();"
    "var menu=document.createElement('div');menu.className='namepick';"
    "menu.style.cssText='position:absolute;top:42px;right:0;background:#1e1e1e;border:1px solid #444;border-radius:6px;padding:4px;z-index:30;min-width:140px';"
    "if(!names.length){menu.innerHTML=\"<div style='padding:6px 10px;color:#777;font-size:11px;max-width:180px'>No earlier results yet — add Extracted values on the API call, or a Save result as name on an earlier step.</div>\";}"
    "names.forEach(function(n){"
    "var opt=document.createElement('div');opt.textContent=n;"
    "opt.style.cssText='padding:6px 10px;color:#eee;font-size:12px;cursor:pointer;border-radius:4px';"
    "opt.addEventListener('mouseenter',function(){opt.style.background='#2a2a2a';});"
    "opt.addEventListener('mouseleave',function(){opt.style.background='';});"
    "opt.addEventListener('click',function(){insertName(input,n);menu.remove();});"
    "menu.appendChild(opt);});"
    "wrap.appendChild(menu);});"
    "wrap.appendChild(btn);return wrap;}"
    "function buildFileAttachBtn(input){"
    "var wrap=document.createElement('span');wrap.style.cssText='position:relative;display:inline-block';"
    "var folderSel=document.getElementById('folder');"
    "var folderVal=folderSel?folderSel.value:'';"
    "var hasFolder=folderVal!=='';"
    "var folderKey=folderVal==='/'?'':folderVal;"
    "var files=hasFolder?(folderFiles[folderKey]||[]):[];"
    "var btn=document.createElement('button');btn.type='button';btn.textContent='{}';btn.disabled=!hasFolder;"
    "btn.title=hasFolder?'Insert a filename from this task\\'s Folder reference':'Set a Folder reference above to attach files from it';"
    "btn.style.cssText='flex-shrink:0;background:#222;border:1px solid #444;color:#8ab;border-radius:6px;padding:0 10px;height:38px;font-family:monospace;font-size:12px;'"
    "+(hasFolder?'cursor:pointer;opacity:1':'cursor:not-allowed;opacity:.4');"
    "if(hasFolder){"
    "btn.addEventListener('click',function(e){"
    "e.stopPropagation();"
    "var existing=wrap.querySelector('.namepick');if(existing){existing.remove();return;}"
    "var menu=document.createElement('div');menu.className='namepick';"
    "menu.style.cssText='position:absolute;top:42px;right:0;background:#1e1e1e;border:1px solid #444;border-radius:6px;padding:4px;z-index:30;min-width:140px';"
    "if(!files.length){menu.innerHTML=\"<div style='padding:6px 10px;color:#777;font-size:11px;max-width:180px'>No files in this folder yet.</div>\";}"
    "files.forEach(function(n){"
    "var opt=document.createElement('div');opt.textContent=n;"
    "opt.style.cssText='padding:6px 10px;color:#eee;font-size:12px;cursor:pointer;border-radius:4px';"
    "opt.addEventListener('mouseenter',function(){opt.style.background='#2a2a2a';});"
    "opt.addEventListener('mouseleave',function(){opt.style.background='';});"
    "opt.addEventListener('click',function(){"
    "var cur=input.value.trim();input.value=cur.length?cur+', '+n:n;input.dispatchEvent(new Event('input'));menu.remove();"
    "});"
    "menu.appendChild(opt);});"
    "wrap.appendChild(menu);});"
    "}"
    "wrap.appendChild(btn);return wrap;}"
    "function buildStepRow(step,i){"
    "var card=document.createElement('div');"
    "card.style.cssText='background:#161616;border:1px solid #2a2a2a;border-radius:8px;padding:14px;margin-bottom:10px';"
    "var top=document.createElement('div');top.style.cssText='display:flex;gap:6px;margin-bottom:10px;align-items:center';"
    "var typeTag=document.createElement('span');typeTag.textContent=step.type==='action'?'Action':'AI instruction';"
    "typeTag.style.cssText='display:inline-flex;align-items:center;padding:6px 12px;border-radius:6px;font-size:12px;font-weight:700;border:1px solid #2a5080;background:#1a2530;color:#4af';"
    "top.appendChild(typeTag);"
    "var upBtn=document.createElement('button');upBtn.type='button';upBtn.textContent='▲';upBtn.title='Move step up';"
    "upBtn.disabled=i===0;"
    "upBtn.style.cssText='margin-left:auto;background:none;border:none;font-size:14px;padding:0 4px;'"
    "+(i===0?'color:#444;cursor:default':'color:#888;cursor:pointer');"
    "upBtn.addEventListener('click',function(){if(i>0){var tmp=TASK_STEPS[i-1];TASK_STEPS[i-1]=TASK_STEPS[i];TASK_STEPS[i]=tmp;renderAllSteps();}});"
    "var downBtn=document.createElement('button');downBtn.type='button';downBtn.textContent='▼';downBtn.title='Move step down';"
    "downBtn.disabled=i===TASK_STEPS.length-1;"
    "downBtn.style.cssText='background:none;border:none;font-size:14px;padding:0 4px;'"
    "+(i===TASK_STEPS.length-1?'color:#444;cursor:default':'color:#888;cursor:pointer');"
    "downBtn.addEventListener('click',function(){if(i<TASK_STEPS.length-1){var tmp=TASK_STEPS[i+1];TASK_STEPS[i+1]=TASK_STEPS[i];TASK_STEPS[i]=tmp;renderAllSteps();}});"
    "var rm=document.createElement('button');rm.type='button';rm.textContent='×';"
    "rm.style.cssText='background:none;border:none;color:#888;font-size:18px;cursor:pointer';"
    "rm.addEventListener('click',function(){TASK_STEPS.splice(i,1);renderAllSteps();});"
    "top.appendChild(upBtn);top.appendChild(downBtn);top.appendChild(rm);card.appendChild(top);"
    "if(step.type==='action'){"
    "var selLbl=document.createElement('label');selLbl.textContent='Choose action';selLbl.style.cssText='display:block;font-size:.78em;color:#aaa;margin:0 0 4px';"
    "var sel=document.createElement('select');sel.style.cssText='width:100%;margin-bottom:10px';"
    "Object.keys(ACTIONS).forEach(function(id){var o=document.createElement('option');o.value=id;o.textContent=ACTIONS[id].label;if(id===step.action)o.selected=true;sel.appendChild(o);});"
    "sel.addEventListener('change',function(){step.action=this.value;step.param=['','','','',''];renderAllSteps();});"
    "card.appendChild(selLbl);card.appendChild(sel);"
    "var meta=ACTIONS[step.action]||ACTIONS[Object.keys(ACTIONS)[0]];"
    "meta.params.forEach(function(plabel,pi){"
    "var lbl=document.createElement('label');lbl.textContent=plabel;lbl.style.cssText='display:block;font-size:.78em;color:#aaa;margin:0 0 4px';"
    "var isTextarea=meta.textareaParams&&meta.textareaParams.indexOf(pi)>=0;"
    "var row=document.createElement('div');"
    "row.style.cssText='display:flex;gap:6px;margin-bottom:10px'+(isTextarea?';align-items:flex-start':'');"
    "var live=meta.liveParam&&meta.liveParam.index===pi;"
    "var staticOpts=meta.staticParams&&meta.staticParams[pi];"
    "var extMeta=meta.extParam&&meta.extParam.index===pi?meta.extParam:null;"
    "var radiusMeta=meta.radiusParam&&meta.radiusParam.index===pi?meta.radiusParam:null;"
    "var inp;"
    "if(live||staticOpts){"
    "inp=document.createElement('select');inp.style.cssText='flex:1;margin-top:0';"
    "var optList=live?(LIVE_NAMES[meta.liveParam.kind]||[]):staticOpts;"
    "var emptyLabel=live?meta.liveParam.emptyLabel:null;"
    "if(emptyLabel){"
    "var eo=document.createElement('option');eo.value='';eo.textContent=emptyLabel;inp.appendChild(eo);"
    "}else if(!optList.length){"
    "var no=document.createElement('option');no.value='';no.textContent='(none currently set)';inp.appendChild(no);"
    "}"
    "optList.forEach(function(n){"
    "var o=document.createElement('option');o.value=n;o.textContent=n;if(step.param[pi]===n)o.selected=true;inp.appendChild(o);"
    "});"
    "if(step.param[pi]&&optList.indexOf(step.param[pi])<0){"
    "var co=document.createElement('option');co.value=step.param[pi];co.textContent=step.param[pi]+' (not in this list)';co.selected=true;inp.appendChild(co);"
    "}"
    "if(!step.param[pi]&&!emptyLabel&&optList.length)step.param[pi]=optList[0];"
    "inp.addEventListener('change',function(){step.param[pi]=this.value;});"
