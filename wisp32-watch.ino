    gfx->print(val);
  };

  int y = 150; const int step = 44;
  row("SRAM Free",   kb(m.sramFree),          y, COLOR_WHITE); y += step;
  row("SRAM Block",  kb(m.sramBlock),         y, COLOR_WHITE); y += step;
  row("SRAM AI",     kb((uint32_t)m.sramAi),  y, COLOR_BLUE);  y += step + 8;
  row("PSRAM Free",  mb((double)m.psFree),    y, COLOR_WHITE); y += step;
  row("PSRAM Block", mb((double)m.psBlock),   y, COLOR_WHITE); y += step;
  row("PSRAM AI",    mb((double)m.psramAi),   y, COLOR_BLUE);

  _clockCenterPrint(TR(UISTR_SWIPE_RETURN), SCREEN_HEIGHT - 28, 2, COLOR_GRAY);
