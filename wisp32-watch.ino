void handleTasksMove() {
  if (!requireAuth()) return;
  int idx = server.hasArg("idx") ? server.arg("idx").toInt() : -1;
  String dir = server.hasArg("dir") ? server.arg("dir") : "";
  if (activePageTasks && idx >= 0 && idx < activePageTaskCount) {
    int swapWith = (dir == "up") ? idx - 1 : (dir == "down") ? idx + 1 : -1;
    if (swapWith >= 0 && swapWith < activePageTaskCount) {
      PageTask tmp = activePageTasks[idx];
      activePageTasks[idx] = activePageTasks[swapWith];
      activePageTasks[swapWith] = tmp;
      savePageTasks();
    }
  }
  server.sendHeader("Location", "/tasks");
  server.send(303);
}

void handleTasksSave() {
  if (!requireAuth()) return;
  if (!activePageTasks) {
    server.sendHeader("Location", "/tasks?taskmsg=" + urlEncodeParam("Tasks are unavailable this boot (a PSRAM allocation failed) - restart the device.") + "&taskok=0");
    server.send(303);
    return;
  }
  int idx = -1;
  if (server.hasArg("idx")) {
    int i = server.arg("idx").toInt();
    if (i >= 0 && i < activePageTaskCount) idx = i;
  }
  if (idx < 0 && activePageTaskCount >= MAX_PAGE_TASKS) {
    server.sendHeader("Location", "/tasks?taskmsg=" + urlEncodeParam("Task list is full (" + String(MAX_PAGE_TASKS) + " max).") + "&taskok=0");
    server.send(303);
    return;
  }
  PageTask t;
  if (idx >= 0) { t.lastRunAt = activePageTasks[idx].lastRunAt; t.lastRunStatus = activePageTasks[idx].lastRunStatus; }
  t.name = server.hasArg("name") ? server.arg("name") : "";
  t.name.trim();
  t.model = server.hasArg("model") ? server.arg("model") : "";
  t.notify = server.hasArg("notify") ? server.arg("notify") : "";
  t.folder = server.hasArg("folder") ? server.arg("folder") : "";
  t.retries = server.hasArg("retries") ? server.arg("retries").toInt() : 3;
  if (t.retries < 0) t.retries = 0;
  if (t.retries > 5) t.retries = 5;
  if (t.name.length() == 0) {
    server.sendHeader("Location", idx >= 0 ? "/tasks/edit?idx=" + String(idx) : "/tasks/edit");
    server.send(303);
    return;
  }
  String stepTypes[PAGE_TASK_STEP_MAX], stepTexts[PAGE_TASK_STEP_MAX], stepActions[PAGE_TASK_STEP_MAX], stepSaveAs[PAGE_TASK_STEP_MAX];
  String stepParams[PAGE_TASK_STEP_MAX][TASK_STEP_PARAM_MAX];
  int typeCount = 0, textCount = 0, actionCount = 0, saveAsCount = 0, paramCount[TASK_STEP_PARAM_MAX] = {0};
  for (int i = 0; i < server.args(); i++) {
    String an = server.argName(i);
    if (an == "stepType"   && typeCount   < PAGE_TASK_STEP_MAX) stepTypes[typeCount++]     = server.arg(i);
    else if (an == "stepText"   && textCount   < PAGE_TASK_STEP_MAX) stepTexts[textCount++]     = server.arg(i);
    else if (an == "stepAction" && actionCount < PAGE_TASK_STEP_MAX) stepActions[actionCount++] = server.arg(i);
    else if (an == "stepSaveAs" && saveAsCount < PAGE_TASK_STEP_MAX) stepSaveAs[saveAsCount++]  = server.arg(i);
    else if (an == "stepParam0" && paramCount[0] < PAGE_TASK_STEP_MAX) stepParams[paramCount[0]++][0] = server.arg(i);
    else if (an == "stepParam1" && paramCount[1] < PAGE_TASK_STEP_MAX) stepParams[paramCount[1]++][1] = server.arg(i);
    else if (an == "stepParam2" && paramCount[2] < PAGE_TASK_STEP_MAX) stepParams[paramCount[2]++][2] = server.arg(i);
    else if (an == "stepParam3" && paramCount[3] < PAGE_TASK_STEP_MAX) stepParams[paramCount[3]++][3] = server.arg(i);
    else if (an == "stepParam4" && paramCount[4] < PAGE_TASK_STEP_MAX) stepParams[paramCount[4]++][4] = server.arg(i);
  }
  t.stepCount = 0;
  for (int i = 0; i < typeCount && t.stepCount < PAGE_TASK_STEP_MAX; i++) {
    bool isAction = (stepTypes[i] == "action");
    if (isAction && stepActions[i].length() == 0) continue;
    if (!isAction && stepTexts[i].length() == 0 && stepSaveAs[i].length() == 0) continue;
    TaskStep& step = t.steps[t.stepCount];
    step.type   = isAction ? "action" : "ai";
    step.text   = stepTexts[i];
    step.action = stepActions[i];
    for (int p = 0; p < TASK_STEP_PARAM_MAX; p++) step.param[p] = stepParams[i][p];
    step.saveAs = stepSaveAs[i];
    step.saveAs.trim();
    t.stepCount++;
  }

  String extractNames[API_EXTRACT_MAX], extractPaths[API_EXTRACT_MAX];
  int enCount = 0, epCount = 0;
  for (int i = 0; i < server.args(); i++) {
    String an = server.argName(i);
    if (an == "extractName" && enCount < API_EXTRACT_MAX) extractNames[enCount++] = server.arg(i);
    else if (an == "extractPath" && epCount < API_EXTRACT_MAX) extractPaths[epCount++] = server.arg(i);
  }
  t.apiExtractCount = 0;
  for (int i = 0; i < enCount && i < epCount && t.apiExtractCount < API_EXTRACT_MAX; i++) {
    String nm = extractNames[i]; nm.trim();
    if (nm.length() == 0 || extractPaths[i].length() == 0) continue;
    t.apiExtracts[t.apiExtractCount].name = nm;
    t.apiExtracts[t.apiExtractCount].path = extractPaths[i];
    t.apiExtractCount++;
  }

  t.scheduleType = server.hasArg("scheduleType") ? server.arg("scheduleType") : "";
  t.scheduleDate = server.hasArg("scheduleDate") ? server.arg("scheduleDate") : "";
  t.scheduleTime = server.hasArg("scheduleTime") ? server.arg("scheduleTime") : "";
  String scheduleDays = "";
  for (int i = 0; i < server.args(); i++) {
    if (server.argName(i) != "scheduleDay") continue;
    if (scheduleDays.length() > 0) scheduleDays += ",";
    scheduleDays += server.arg(i);
  }
  t.scheduleDays = scheduleDays;
  t.beepOnCompletion = server.hasArg("beepOnCompletion");

  t.apiMethod      = server.hasArg("apiMethod")      ? server.arg("apiMethod")      : "";
  t.apiUrl         = server.hasArg("apiUrl")         ? server.arg("apiUrl")         : "";
  t.apiHeaders     = server.hasArg("apiHeaders")     ? server.arg("apiHeaders")     : "";
  t.apiAuthType    = server.hasArg("apiAuthType")    ? server.arg("apiAuthType")    : "";
  t.apiAuthKeyName = server.hasArg("apiAuthKeyName") ? server.arg("apiAuthKeyName") : "";
  t.apiAuthValue   = server.hasArg("apiAuthValue")   ? server.arg("apiAuthValue")   : "";
  t.apiBody        = server.hasArg("apiBody")        ? server.arg("apiBody")        : "";
  t.apiUrl.trim();

  lastTaskModel = t.model;
  saveSettings();

  if (idx >= 0) activePageTasks[idx] = t;
  else activePageTasks[activePageTaskCount++] = t;
  savePageTasks();
  server.sendHeader("Location", "/tasks");
  server.send(303);
}

