void handleKBFolderRename() {
  if (!requireAuth()) return;
  if (!server.hasArg("path") || !server.hasArg("newname")) {
    server.send(400, "application/json", "{\"ok\":false,\"err\":\"Missing parameters\"}"); return;
  }
  String oldPath = sanitizeDirPath(server.arg("path"));
  String newName = server.arg("newname"); newName.trim();
  if (oldPath.length() == 0) { server.send(400, "application/json", "{\"ok\":false,\"err\":\"Invalid path\"}"); return; }
  if (newName.length() == 0 || newName.indexOf('/') >= 0 || newName.indexOf("..") >= 0) {
    server.send(400, "application/json", "{\"ok\":false,\"err\":\"Invalid name\"}"); return;
  }
  int lastSlash = oldPath.lastIndexOf('/');
  String parentDir = (lastSlash >= 0) ? oldPath.substring(0, lastSlash) : "";
  String newRelPath = (parentDir.length() > 0) ? parentDir + "/" + newName : newName;
  String oldSD = String(KNOWLEDGE_DIR) + "/" + oldPath;
  String newSD = String(KNOWLEDGE_DIR) + "/" + newRelPath;
  if (!sdMounted || !SD_MMC.exists(oldSD)) { server.send(404, "application/json", "{\"ok\":false,\"err\":\"Folder not found\"}"); return; }
  String requiredPin = kbFindRestrictingPin(oldPath);
  if (requiredPin.length() > 0) {
    String givenPin = server.hasArg("pin") ? server.arg("pin") : "";
    if (givenPin != requiredPin) { server.send(200, "application/json", "{\"ok\":false,\"err\":\"pin\"}"); return; }
  }
  if (!newSD.equalsIgnoreCase(oldSD) && SD_MMC.exists(newSD)) { server.send(409, "application/json", "{\"ok\":false,\"err\":\"Name already exists\"}"); return; }
  if (SD_MMC.rename(oldSD, newSD)) {
    String oldPw = oldSD + ".pwd";
    if (SD_MMC.exists(oldPw)) SD_MMC.rename(oldPw, newSD + ".pwd");
    kbSyncRenameUnder(oldPath, newRelPath);
    reloadKnowledge();
    server.send(200, "application/json",
      "{\"ok\":true,\"name\":\"" + newRelPath + "\",\"display\":\"" + newName + "\"}");
  } else {
    server.send(500, "application/json", "{\"ok\":false,\"err\":\"Rename failed\"}");
  }
}

