void loadSettings() {
  if (!sdMounted || !SD_MMC.exists(SETTINGS_FILE)) return;
  File f = SD_MMC.open(SETTINGS_FILE, FILE_READ);
  if (!f) return;
  String savedEffortName = "";
  while (f.available()) {
    String line = f.readStringUntil('\n');
    line.trim();
    int eq = line.indexOf('=');
    if (eq < 0) continue;
    String key = line.substring(0, eq);
    String val = line.substring(eq + 1);
    if      (key == "tts")      ttsEnabled        = (val == "1");
    else if (key == "saveTts")  saveTTSEnabled    = (val == "1");
    else if (key == "beep")     beepEnabled       = (val == "1");
    else if (key == "recUserIn") aiRecordUserInput  = (val == "1");
    else if (key == "recAiResp") aiRecordAiResponse = (val == "1");
    else if (key == "showTags")  aiShowOriginTags   = (val == "1");
    else if (key == "kbdlenc")   kbDownloadEncrypted = (val == "1");
    else if (key == "uiLang")      uiLangIndex = (uint8_t)constrain(val.toInt(), 0, UI_LANG_COUNT - 1);
    else if (key == "replayMode")  aiReplayMode = (uint8_t)constrain(val.toInt(), 0, 2);
    else if (key == "replaySaved") aiReplayMode = (val == "1") ? REPLAY_REUSE : REPLAY_OFF;
    else if (key == "replayModel") aiReplayMatchModel = val;
    else if (key == "model") {
      activeModel = MODEL_GPT; activeModel.model_name = val.c_str();
    } else if (key == "vol") {
      int v = val.toInt();
      if (v >= 0 && v <= 100) speakerVolume = v;
    } else if (key == "openaiVoice") {
      aiOpenAiVoice = val;
    } else if (key == "geminiVoice") {
      aiGeminiVoice = val;
    } else if (key == "openaiVoices") {
      if (val.length() > 0) activeOpenAiVoicesList = val;
    } else if (key == "geminiVoices") {
      if (val.length() > 0) activeGeminiVoicesList = val;
    } else if (key == "aiDisplayMode") {
      for (int i = 0; i < AI_DISPLAY_MODE_COUNT; i++) {
        if (val == AI_DISPLAY_MODE_NAMES[i]) { aiDisplayModeIndex = i; break; }
      }
    } else if (key == "aimodel") {
      aiRealtimeModel = val;
    } else if (key == "realtimeModels") {
      if (val.length() > 0) activeRealtimeModelsList = val;
    } else if (key == "effort") {
      savedEffortName = val;
    } else if (key == "effortLevels") {
      if (val.length() > 0) activeEffortLevelsList = val;
    } else if (key == "saveAiHistory") {
      bool matched = false;
      for (int i = 0; i < (int)SAVE_HISTORY_MODE_COUNT; i++) {
        if (val == SAVE_HISTORY_MODE_NAMES[i]) { saveHistoryMode = i; matched = true; break; }
      }
      if (!matched) saveHistoryMode = (val == "1") ? SAVE_TEXT : SAVE_OFF;
    } else if (key == "theme") {
      activeThemeName = val;
    } else if (key == "voiceBuffer") {
      if (val == "Auto") {
        aiVoiceBufferIndex = AI_VOICE_BUFFER_AUTO;
      } else {
        for (size_t i = 0; i < AI_VOICE_BUFFER_COUNT; i++) {
          if (val == AI_VOICE_BUFFER_NAMES[i]) { aiVoiceBufferIndex = (int)i; break; }
        }
      }
    } else if (key == "fileAnalysis") {
      aiFileAnalysisEnabled = (val == "1");
    } else if (key == "deepThink") {
      aiDeepThinkEnabled = (val == "1");
    } else if (key == "dtEffort") {
      if (val.length() > 0) aiDeepThinkEffort = val;
    } else if (key == "maxOutTokens") {
      for (size_t i = 0; i < AI_MAX_OUT_TOKENS_COUNT; i++) {
        if (val == AI_MAX_OUT_TOKENS_NAMES[i]) { aiMaxOutTokensIndex = (int)i; break; }
      }
    } else if (key == "qaMaxTok") {
      for (size_t i = 0; i < AI_MAX_OUT_TOKENS_COUNT; i++) {
        if (val == AI_MAX_OUT_TOKENS_NAMES[i]) { aiQaMaxTokIndex = (int)i; break; }
      }
    } else if (key == "thinkMaxTok") {
      for (size_t i = 0; i < AI_MAX_OUT_TOKENS_COUNT; i++) {
        if (val == AI_MAX_OUT_TOKENS_NAMES[i]) { aiThinkMaxTokIndex = (int)i; break; }
      }
    } else if (key == "aiPromptTime") {
      aiPromptAppendTime = (val == "1");
    } else if (key == "wsPromptTime") {
      webSearchPromptAppendTime = (val == "1");
    } else if (key == "bri") {
      int v = val.toInt();
      if (v >= 5 && v <= 100) screenBrightness = v;
    } else if (key == "deviceLock") {
      deviceLockOn = (val == "1");
    } else if (key == "autoSleep") {
      int v = val.toInt();
      if (v >= 0 && v < (int)AUTO_SLEEP_COUNT) autoSleepIndex = v;
    } else if (key == "skipHome") {
      skipAutoSleepAtHome = (val == "1");
    } else if (key == "skipHomeIdx") {
      skipHomeNetworkIndex = val.toInt();
    } else if (key == "skipCharge") {
      skipAutoSleepCharging = (val == "1");
    } else if (key == "clockLat") {
      clockLat = val.toDouble();
    } else if (key == "clockLon") {
      clockLon = val.toDouble();
    } else if (key == "wxSlot1" || key == "wxSlot2" || key == "wxSlot3" || key == "wxSlot4") {
      int found = -1;
      for (int i = 0; i < WX_COUNT; i++) { if (val == WX_DATAPOINT_NAMES[i]) { found = i; break; } }
      if (found >= 0) {
        if (key == "wxSlot1") wxSlot1 = found;
        else if (key == "wxSlot2") wxSlot2 = found;
        else if (key == "wxSlot3") wxSlot3 = found;
        else wxSlot4 = found;
      }
    } else if (key == "clockIdMode") {
      int v = val.toInt();
      if (v >= CLOCK_ID_NAME && v <= CLOCK_ID_CUSTOM) clockIdMode = v;
    } else if (key == "ipCustomText") {
      clockIpCustomText = val;
    } else if (key == "deviceName") {
      deviceName = val;
    } else if (key == "webBg") {
      if (val.startsWith("#") && val.length() == 7) webBgColor = val;
    } else if (key == "webCard") {
      if (val.startsWith("#") && val.length() == 7) webCardColor = val;
    } else if (key == "webAccent") {
      if (val.startsWith("#") && val.length() == 7) webAccentColor = val;
    } else if (key == "webAccent2") {
      if (val.startsWith("#") && val.length() == 7) webAccent2Color = val;
    } else if (key == "chatLogPerPage") {
      int v = val.toInt();
      if (v == 25 || v == 50 || v == 75 || v == 100) chatLogPerPage = v;
    } else if (key == "fileSortCol") {
      if (val == "name" || val == "size" || val == "date") fileSortCol = val;
    } else if (key == "fileSortDir") {
      if (val == "asc" || val == "desc") fileSortDir = val;
    } else if (key == "colorWhite") {
      long v = val.toInt();
      if (v >= 0 && v <= 0xFFFF) COLOR_WHITE = (uint16_t)v;
    } else if (key == "colorBlue") {
      long v = val.toInt();
      if (v >= 0 && v <= 0xFFFF) COLOR_BLUE = (uint16_t)v;
    } else if (key == "colorBlack") {
      long v = val.toInt();
      if (v >= 0 && v <= 0xFFFF) COLOR_BLACK = (uint16_t)v;
    } else if (key == "noteSaveAudio") {
      int v = val.toInt();
      noteSaveMode = (v >= NOTE_SAVE_TEXT && v <= NOTE_SAVE_AUDIO_ONLY) ? v : NOTE_SAVE_TEXT;
    } else if (key == "noteEmailTo") {
      noteEmailToContact = val;
    } else if (key == "webSearchModel") {
      if (val.length() > 0) activeWebSearchModel = val;
    } else if (key == "webSearchModels") {
      if (val.length() > 0) activeWebSearchModelsList = val;
    } else if (key == "taskModels") {
      if (val.length() > 0) activeTaskModelsList = val;
    } else if (key == "lastTaskModel") {
      lastTaskModel = val;
    } else if (key == "webSearchEnabled") {
      aiWebSearchEnabled = (val == "1");
    } else if (key == "fileQaModel") {
      if (val.length() > 0) activeFileQaModel = val;
    } else if (key == "fileQaModels") {
      if (val.length() > 0) activeFileQaModelsList = val;
    } else if (key == "fileQaEffort") {
      if (val.length() > 0) aiFileQaEffort = val;
    } else if (key == "deepThinkModel") {
      if (val.length() > 0) activeDeepThinkModel = val;
    } else if (key == "deepThinkModels") {
      if (val.length() > 0) activeDeepThinkModelsList = val;
    } else if (key == "voiceToTextModel") {
      if (val.length() > 0) activeVoiceToTextModel = val;
    } else if (key == "voiceToTextModels") {
      if (val.length() > 0) activeVoiceToTextModelsList = val;
    } else if (key == "voiceToTextEnabled") {
      aiVoiceToTextEnabled = (val == "1");
    } else if (key == "noteTitleModel") {
      if (val.length() > 0) activeNoteTitleModel = val;
    } else if (key == "noteTitleModels") {
      if (val.length() > 0) activeNoteTitleModelsList = val;
    } else if (key == "noteTitleEnabled") {
      aiNoteTitleEnabled = (val == "1");
    } else if (key == "translatorModel") {
      if (val.length() > 0) activeTranslatorRealtimeModel = val;
    } else if (key == "translatorModels") {
      if (val.length() > 0) activeTranslatorModelsList = val;
    } else if (key == "translatorEnabled") {
      aiTranslatorEnabled = (val == "1");
    } else if (key == "translatorSrc") {
      int v = val.toInt();
      if (v >= 0 && v < (int)TRANSLATOR_LANG_COUNT) translatorSourceIndex = v;
    } else if (key == "translatorTgt") {
      int v = val.toInt();
      if (v >= 0 && v < (int)TRANSLATOR_LANG_COUNT) translatorTargetIndex = v;
    } else if (key == "translatorLangs") {
      activeTranslatorLangsList = val;
    } else if (key == "toolsDisabled") {
      toolsDisabledList = val;
    } else if (key == "navOrder") {
      activeNavOrder = val;
    } else if (key == "navHidden") {
      activeNavHidden = val;
    } else if (key == "featuresOff") {
      activeFeaturesDisabled = val;
    }
  }
  recomputeDerivedColors();
  parseRealtimeModelsList();
  for (int i = 0; i < aiRealtimeModelCount; i++) {
    if (aiRealtimeModel == aiRealtimeModels[i]) { aiModelIndex = i; break; }
  }
  aiRealtimeModel = aiRealtimeModels[aiModelIndex];
  if (aiDisplayModeIndex == AI_DISPLAY_SILENT && aiModelIsGemini(aiRealtimeModel)) {
    aiDisplayModeIndex = AI_DISPLAY_VOICE;
  }
  parseOpenAiVoicesList();
  for (int i = 0; i < aiOpenAiVoiceCount; i++) {
    if (aiOpenAiVoice == aiOpenAiVoices[i]) { aiOpenAiVoiceIndex = i; break; }
  }
  aiOpenAiVoice = aiOpenAiVoices[aiOpenAiVoiceIndex];
  parseGeminiVoicesList();
  for (int i = 0; i < aiGeminiVoiceCount; i++) {
    if (aiGeminiVoice == aiGeminiVoices[i]) { aiGeminiVoiceIndex = i; break; }
  }
  aiGeminiVoice = aiGeminiVoices[aiGeminiVoiceIndex];
  parseEffortLevelsList();
  for (int i = 0; i < aiEffortLevelCount; i++) {
    if (savedEffortName == aiEffortLevels[i]) { aiEffortIndex = i; break; }
  }
  parseFileQaModelsList();
  if (!aiFileAnalysisEnabled) {
    aiFileQaModelIndex = 0;
  } else {
    aiFileQaModelIndex = 1;
    for (int i = 0; i < aiFileQaModelCount; i++) {
      if (activeFileQaModel == aiFileQaModels[i]) { aiFileQaModelIndex = i + 1; break; }
