    if (editFolder.length() > 0) backLocation = "/?path=" + editFolder;
    String filePin = kbFindRestrictingPin(server.arg("file"));
    if (filePin.length() > 0) {
      String submittedPin = server.hasArg("pw") ? server.arg("pw") : "";
      if (submittedPin != filePin) {
