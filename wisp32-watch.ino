bool runPageTaskByIndex(int idx) {
  time_t nowForSchedule = time(NULL);
  struct tm nowTmForSchedule;
  if (getLocalTime(&nowTmForSchedule) && taskSecondsUntilDue(idx, nowForSchedule, nowTmForSchedule) == 0) {
    if (activePageTasks[idx].scheduleType == "once") {
      activePageTasks[idx].scheduleType = "";
    } else if (activePageTasks[idx].scheduleType == "weekly") {
      char buf[11]; strftime(buf, sizeof(buf), "%Y-%m-%d", &nowTmForSchedule);
      activePageTasks[idx].scheduleLastFiredDate = String(buf);
    }
    savePageTasks();
  }

  PageTask t = activePageTasks[idx];
  currentlyRunningTaskIdx = idx;

  String folderForDir = (t.folder == PAGE_TASK_FOLDER_ROOT) ? "" : t.folder;
  AiTaskDirGuard dirGuard(folderForDir, t.retries);

  unsigned long startMs = millis();
  NamedValue values[TASK_NAMED_VALUE_MAX];
  int valueCount = 0;
  String status = "ok", result = "";
  bool apiCallOk = true;
  if (t.apiMethod.length() > 0) {
    bool apiOk = false;
    String apiResponse = taskFireConfiguredApiCall(t, apiOk);
    if (!apiOk) {
      apiCallOk = false;
      status = "error: API call failed - " + apiResponse;
    } else if (valueCount < TASK_NAMED_VALUE_MAX) {
      values[valueCount].name = "api_response";
      values[valueCount].value = apiResponse;
      valueCount++;
      valueCount = taskExtractApiValues(t, apiResponse, values, valueCount, TASK_NAMED_VALUE_MAX);
    }
  }

  if (apiCallOk) {
    for (int s = 0; s < t.stepCount; s++) {
      const TaskStep& step = t.steps[s];
      String stepResult;
      bool stepFailed;
      if (step.type == "action") {
        stepResult = taskRunActionStep(step, values, valueCount);
        stepFailed = stepResult.startsWith("Error:");
      } else {
        String stepText = resolvePlaceholders(step.text, values, valueCount);
        String stepStatus;
        stepResult = aiModelIsGemini(t.model) ? taskRunGemini(t.model, stepText, &stepStatus)
                                               : taskRunOpenAI(t.model, stepText, &stepStatus);
        stepFailed = (stepStatus != "ok");
      }
      result += (result.length() > 0 ? "\n\n" : "") + stepResult;
      if (step.saveAs.length() > 0 && valueCount < TASK_NAMED_VALUE_MAX) {
        values[valueCount].name = step.saveAs;
        values[valueCount].value = stepResult;
        valueCount++;
      }
      if (stepFailed) {
        status = "error: step " + String(s + 1) + " failed - " + stepResult;
        break;
      }
    }
  }
  unsigned long durationMs = millis() - startMs;

  logToolCallEvent("page", "task_run", durationMs, t.name, status);

  String ts = "";
  struct tm ti;
  if (getLocalTime(&ti)) { char buf[20]; strftime(buf, sizeof(buf), "%Y-%m-%d %H:%M:%S", &ti); ts = String(buf); }

  bool ok = (status == "ok");

  if (saveHistoryMode >= SAVE_TEXT && saveHistoryMode != SAVE_AUDIO_ONLY) {
    String stepsSummary = "";
    for (int s = 0; s < t.stepCount; s++) {
      stepsSummary += "Step " + String(s + 1) + ": "
                     + (t.steps[s].type == "action" ? ("[" + t.steps[s].action + "]") : t.steps[s].text) + "\n";
    }
    String sTag = " | s=t" + String((unsigned long)time(NULL));
    String entry = "[" + ts + " | " + t.model + sTag + "]\nQ: Task \"" + t.name + "\":\n" + stepsSummary
                 + "\nA: " + (result.length() > 0 ? result : ("Task " + status)) + "\n";
    appendChatLog(entry);
  }

  activePageTasks[idx].lastRunAt = ts;
  activePageTasks[idx].lastRunEpoch = time(NULL);
  activePageTasks[idx].lastRunStatus = ok ? "Completed" : ("Failed: " + status);
  savePageTasks();

  if (t.notify.length() > 0) {
    String addr = aiToolResolveContact(t.notify);
    if (addr.length() > 0) {
      String subject = (ok ? "Task complete: " : "Task failed: ") + t.name;
      String body = "Task: " + t.name + "\nStatus: " + status + "\n\n" + (result.length() > 0 ? result : "(no output)");
      smtpSendMail(addr, subject, body);
    }
  }

  if (t.beepOnCompletion && ok) playTaskCompletionBeep();

  heapRestartStreak = 0;
  currentlyRunningTaskIdx = -1;

  return ok;
}

void handleTasksStatus() {
  if (!requireAuth()) return;
  int idx = currentlyRunningTaskIdx;
  if (idx < 0) idx = pendingWebTaskRunIdx;
  if (idx < 0) idx = pendingTaskRunIdx;
  bool running = (idx >= 0 && idx < activePageTaskCount);
  String json = "{\"running\":" + String(running ? "true" : "false");
  if (running) {
    String nm = activePageTasks[idx].name;
    nm.replace("\\", "\\\\"); nm.replace("\"", "\\\"");
    json += ",\"name\":\"" + nm + "\"";
  }
  json += "}";
  server.send(200, "application/json", json);
}

bool pageTaskNeedsModel(const PageTask& t) {
  for (int i = 0; i < t.stepCount; i++) {
    if (t.steps[i].type == "ai") return true;
  }
  return false;
}

void handleTasksRun() {
  if (!requireAuth()) return;
  if (!server.hasArg("idx")) { server.sendHeader("Location", "/tasks"); server.send(303); return; }
  int idx = server.arg("idx").toInt();
  if (idx < 0 || idx >= activePageTaskCount) {
    server.sendHeader("Location", "/tasks?taskmsg=" + urlEncodeParam("Task not found.") + "&taskok=0");
    server.send(303);
    return;
  }
  String name = activePageTasks[idx].name;
  if (pageTaskNeedsModel(activePageTasks[idx]) && !aiProviderHasKeyFor(activePageTasks[idx].model, false)) {
    server.sendHeader("Location", "/tasks?taskmsg=" + urlEncodeParam("No API key configured for " + activePageTasks[idx].model) + "&taskok=0");
    server.send(303);
    return;
  }

  pendingWebTaskRunIdx = idx;
  bool willRestartFirst = (ESP.getMaxAllocHeap() < HEAP_HEALTH_MIN_ALLOC);
  String msg = willRestartFirst
    ? (name + ": device needs to restart to free up memory first — it'll reboot in a few seconds, then run this automatically. Check back in about a minute.")
    : (name + ": started - check back shortly for the result.");
  server.sendHeader("Location", "/tasks?taskmsg=" + urlEncodeParam(msg) + "&taskok=1");
  server.send(303);
}

