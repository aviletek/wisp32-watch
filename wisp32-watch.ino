String fileMimeType(const String& fn) {
  String lower = fn; lower.toLowerCase();
  if (lower.endsWith(".pdf"))  return "application/pdf";
  if (lower.endsWith(".mp3"))  return "audio/mpeg";
  if (lower.endsWith(".mp4"))  return "video/mp4";
  if (lower.endsWith(".webm")) return "video/webm";
  if (lower.endsWith(".ogg") || lower.endsWith(".oga")) return "audio/ogg";
  if (lower.endsWith(".wav"))  return "audio/wav";
  if (lower.endsWith(".m4a"))  return "audio/mp4";
  if (lower.endsWith(".aac"))  return "audio/aac";
  if (lower.endsWith(".flac")) return "audio/flac";
  if (lower.endsWith(".opus")) return "audio/opus";
  if (lower.endsWith(".jpg") || lower.endsWith(".jpeg")) return "image/jpeg";
  if (lower.endsWith(".png"))  return "image/png";
  if (lower.endsWith(".gif"))  return "image/gif";
  if (lower.endsWith(".svg"))  return "image/svg+xml";
  if (lower.endsWith(".txt"))  return "text/plain";
  if (lower.endsWith(".csv"))  return "text/csv";
  if (lower.endsWith(".html") || lower.endsWith(".htm")) return "text/html; charset=utf-8";
  if (lower.endsWith(".json")) return "application/json";
  if (lower.endsWith(".css"))                            return "text/css";
  if (lower.endsWith(".js") || lower.endsWith(".mjs"))  return "application/javascript";
  if (lower.endsWith(".woff"))                           return "font/woff";
  if (lower.endsWith(".woff2"))                          return "font/woff2";
  if (lower.endsWith(".ico"))                            return "image/x-icon";
  if (lower.endsWith(".webmanifest"))                    return "application/manifest+json";
  if (lower.endsWith(".xml"))                            return "application/xml";
  return "application/octet-stream";
}

void handleStaticAsset() {
  if (!requireAuth()) return;
  if (server.method() != HTTP_GET) {
    server.send(405, "text/plain", "Method not allowed");
    return;
  }

  String path = server.urlDecode(server.uri());

  if (path.indexOf("..") >= 0) {
    server.send(403, "text/plain", "Forbidden");
    return;
  }

  while (path.indexOf("//") >= 0) path.replace("//", "/");

  String lower = path; lower.toLowerCase();
  if (lower.startsWith("/knowledge") ||
      lower.startsWith("/images")    ||
      lower == "/chat_log.txt"       ||
      lower.endsWith(".pwd")         ||
      lower.endsWith(".meta")) {
    server.send(403, "text/plain", "Forbidden");
    return;
  }

  if (!sdMounted || !SD_MMC.exists(path)) {
    server.send(404, "text/plain", "Not found");
    return;
  }

  File f = SD_MMC.open(path, FILE_READ);
  if (!f || f.isDirectory()) {
    if (f) f.close();
    server.send(404, "text/plain", "Not found");
    return;
  }

  server.streamFile(f, fileMimeType(path));
  f.close();
}

void _serveFile(bool download) {
  if (!requireAuth()) return;
  if (webServerModeActive && wsAbortBlock) { wsAbortBlock = false; server.send(503, "text/plain", "Download stopped by device."); return; }
  if (!server.hasArg("file")) { server.sendHeader("Location", "/files"); server.send(303); return; }
  String fn = server.arg("file");

  String path = String(FILES_DIR) + "/" + fn;
  if (!sdMounted || !SD_MMC.exists(path)) { server.send(404, "text/plain", "Not found"); return; }

  File f = SD_MMC.open(path, FILE_READ);
  if (!f) { server.send(500, "text/plain", "Open error"); return; }

  size_t fileSize = f.size();

  uint8_t magic[ENCRYPT_MAGIC_LEN];
  bool isEncrypted = false;
  if (fileSize >= (size_t)(ENCRYPT_MAGIC_LEN + AES_IV_LEN + 16)) {
    f.read(magic, ENCRYPT_MAGIC_LEN);
    isEncrypted = (memcmp(magic, ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN) == 0);
  }
  f.seek(0);
  uint8_t ctrNonce[CTRLOG_NONCE_LEN];
  size_t ctrPlainSize = 0;
  bool isCtrAudio = aiLogOpenForRead(f, ctrNonce, &ctrPlainSize);
  if (!isCtrAudio) f.seek(0);

  WiFiClient client = server.client();
  String disposition = download ? "attachment" : "inline";
  int fnSlash = fn.lastIndexOf('/');
  String fnBasename = (fnSlash >= 0) ? fn.substring(fnSlash + 1) : fn;
  String dlName = isDeviceGeneratedDownload(fn) ? withDeviceSuffix(fnBasename) : fnBasename;
  server.sendHeader("Content-Disposition", disposition + "; filename=\"" + dlName + "\"");

  if (isCtrAudio) {
    server.setContentLength(ctrPlainSize);
    server.send(200, fn.endsWith(".wav") ? "audio/wav" : fileMimeType(fn), "");
    if (webServerModeActive) {
      wsTransfer = WsTransfer(); wsTransfer.active = true; wsTransfer.isUpload = false;
      wsTransfer.filename = fn; wsTransfer.total = ctrPlainSize; wsTransfer.startMs = millis();
    }
    const size_t CHUNK = 8192;
    uint8_t* buf = (uint8_t*)ps_malloc(CHUNK);
    if (!buf) { f.close(); return; }
    size_t plainPos = 0;
    while (plainPos < ctrPlainSize && client.connected() && !wsTransfer.abort) {
      size_t want = ctrPlainSize - plainPos;
      if (want > CHUNK) want = CHUNK;
      size_t got = f.read(buf, want);
      if (got == 0) break;
      aiLogDecryptBlock(ctrNonce, plainPos, buf, got);
      size_t written = 0;
      while (written < got && client.connected()) {
        size_t step = min(got - written, (size_t)4096);
        size_t w = client.write(buf + written, step);
        if (w == 0) break;
        written += w;
        yield();
      }
      plainPos += got;
      if (webServerModeActive) wsTransfer.bytes += written;
      if (written == 0) break;
    }
    free(buf);
    f.close();
    if (webServerModeActive) wsTransfer.active = false;
    return;
  }

  if (isEncrypted) {
    f.seek(ENCRYPT_MAGIC_LEN);
    uint8_t iv[AES_IV_LEN];
    f.read(iv, AES_IV_LEN);

    size_t origSize = getStoredFileOrigSize(fn);
    bool isAudioWav = fn.endsWith(".wav");
    size_t wavHdrLen = isAudioWav ? 44 : 0;
    size_t totalContentLen = (origSize > 0) ? (origSize + wavHdrLen) : 0;

    if (totalContentLen > 0) server.setContentLength(totalContentLen);
    server.send(200, isAudioWav ? "audio/wav" : fileMimeType(fn), "");

    if (webServerModeActive) {
      wsTransfer = WsTransfer(); wsTransfer.active=true; wsTransfer.isUpload=false; wsTransfer.filename=fn; wsTransfer.total=totalContentLen; wsTransfer.startMs=millis();
    }

    if (isAudioWav && origSize > 0) {
      uint8_t h[44] = {};
      uint32_t dataSize  = (uint32_t)origSize;
      uint32_t chunkSz   = 36 + dataSize;
      uint32_t fmtSz     = 16;
      uint16_t audioFmt  = 1;
      uint16_t channels  = 1;
      uint32_t sampleRate = SAMPLE_RATE;
      uint32_t byteRate  = SAMPLE_RATE * 2;
      uint16_t blockAlign = 2;
      uint16_t bps        = 16;
      memcpy(h,    "RIFF", 4); memcpy(h+4,  &chunkSz,    4);
      memcpy(h+8,  "WAVE", 4); memcpy(h+12, "fmt ",       4);
      memcpy(h+16, &fmtSz, 4); memcpy(h+20, &audioFmt,   2);
      memcpy(h+22, &channels, 2); memcpy(h+24, &sampleRate, 4);
      memcpy(h+28, &byteRate, 4); memcpy(h+32, &blockAlign, 2);
      memcpy(h+34, &bps,   2); memcpy(h+36, "data",       4); memcpy(h+40, &dataSize, 4);
      client.write(h, 44);
      if (webServerModeActive) wsTransfer.bytes += 44;
    }

    mbedtls_aes_context aes;
    mbedtls_aes_init(&aes);
    mbedtls_aes_setkey_dec(&aes, activeAesKey, 256);

    const size_t CHUNK = 16384;
    uint8_t* encBuf = (uint8_t*)ps_malloc(CHUNK);
    uint8_t* decBuf = (uint8_t*)ps_malloc(CHUNK);
    if (!encBuf || !decBuf) {
      if (encBuf) free(encBuf); if (decBuf) free(decBuf);
      mbedtls_aes_free(&aes); f.close(); return;
    }

    uint8_t curIV[AES_IV_LEN];
    memcpy(curIV, iv, AES_IV_LEN);
    size_t encRemaining = fileSize - ENCRYPT_MAGIC_LEN - AES_IV_LEN;

    while (encRemaining > 0 && client.connected() && !wsTransfer.abort) {
      size_t toRead = min(encRemaining, CHUNK);
      toRead = (toRead / 16) * 16;
      if (toRead == 0) break;
      size_t didRead = f.read(encBuf, toRead);
      if (didRead == 0) break;
      didRead = (didRead / 16) * 16;

      for (size_t blk = 0; blk < didRead; blk += 16) {
        uint8_t* eb = encBuf + blk;
        uint8_t* db = decBuf + blk;
        mbedtls_aes_crypt_ecb(&aes, MBEDTLS_AES_DECRYPT, eb, db);
        for (int i = 0; i < 16; i++) db[i] ^= curIV[i];
        memcpy(curIV, eb, 16);
      }

      encRemaining -= didRead;
      size_t toSend = didRead;
      if (encRemaining == 0) {
        uint8_t padByte = decBuf[didRead - 1];
        if (padByte >= 1 && padByte <= 16) toSend = didRead - padByte;
      }
      size_t written = 0;
      while (written < toSend && client.connected()) {
        size_t step = min(toSend - written, (size_t)4096);
        size_t w = client.write(decBuf + written, step);
        if (w == 0) break;
        written += w;
        yield();
      }
      if (webServerModeActive) {
        wsTransfer.bytes += written;
      }
    }

    free(encBuf); free(decBuf);
    mbedtls_aes_free(&aes);

  } else {

    if (!download && fileMimeType(fn) == "text/html; charset=utf-8" && fileSize <= 65536) {
      String content = "";
      content.reserve((unsigned int)fileSize + 80);
      f.seek(0);
      while (f.available()) content += (char)f.read();
      f.close();

      int lastSlash = fn.lastIndexOf('/');
      String dir = (lastSlash >= 0) ? fn.substring(0, lastSlash + 1) : "";
      String baseTag = "<base href=\"/files/" + dir + "\">";

      String lc = content; lc.toLowerCase();
      int idx = lc.indexOf("<head>");
      if (idx >= 0) {
        content = content.substring(0, idx + 6) + baseTag + content.substring(idx + 6);
      } else {
        int hi = lc.indexOf("<head");
        if (hi >= 0) {
          int gt = content.indexOf('>', hi);
          content = (gt >= 0)
            ? content.substring(0, gt + 1) + baseTag + content.substring(gt + 1)
            : baseTag + content;
        } else {
          content = baseTag + content;
        }
      }

      server.send(200, "text/html; charset=utf-8", content);
      return;
    }

    f.seek(0);
    server.setContentLength(fileSize);
    server.send(200, download ? "application/octet-stream" : fileMimeType(fn), "");

    if (webServerModeActive) {
      wsTransfer = WsTransfer(); wsTransfer.active=true; wsTransfer.isUpload=false; wsTransfer.filename=fn; wsTransfer.total=fileSize; wsTransfer.startMs=millis();
    }

    const size_t CHUNK = 16384;
    uint8_t* buf = (uint8_t*)ps_malloc(CHUNK);
    if (!buf) { f.close(); return; }

    size_t remaining = fileSize;
    while (remaining > 0 && client.connected() && !wsTransfer.abort) {
      size_t toRead = min(remaining, CHUNK);
      size_t didRead = f.read(buf, toRead);
      if (didRead == 0) break;
      size_t written = 0;
      while (written < didRead && client.connected()) {
        size_t step = min(didRead - written, (size_t)4096);
        size_t w = client.write(buf + written, step);
        if (w == 0) break;
        written += w;
        yield();
      }
      remaining -= didRead;
      if (webServerModeActive) {
        wsTransfer.bytes += written;
      }
    }

    free(buf);
  }

  if (webServerModeActive) {
    if (wsTransfer.abort) {
      client.stop();
      wsTransfer.aborted = true;
      wsTransfer.abort   = false;
      wsAbortBlock       = true;
      delay(200);
    }
    wsTransfer.active = false;
  }

  f.close();
}

void handleFileDownload() { _serveFile(true); }
void handleFileView()     { _serveFile(false); }

WebServer audioServer(8081);
TaskHandle_t audioServerTaskHandle = nullptr;
unsigned long lastAudioServerActivityMs = 0;
#define AUDIO_SERVER_IDLE_TIMEOUT_MS (180000UL)

static bool requireAuthAudio() {
  if (activeWebPassword.length() == 0) return true;
  if (audioServer.authenticate("admin", activeWebPassword.c_str())) return true;
  audioStreamCommonHeaders();
  audioServer.requestAuthentication(BASIC_AUTH, "device", "Device access (username: admin)");
  return false;
}

static bool parseRangeHeader(const String& rangeHeader, size_t fileSize, size_t* outStart, size_t* outEnd) {
  if (!rangeHeader.startsWith("bytes=")) return false;
  String spec = rangeHeader.substring(6);
  int dash = spec.indexOf('-');
  if (dash < 0) return false;
  String startStr = spec.substring(0, dash);
  String endStr = spec.substring(dash + 1);
  if (startStr.length() == 0) return false;
  long start = startStr.toInt();
  if (start < 0 || (size_t)start >= fileSize) return false;
  long end = (endStr.length() > 0) ? endStr.toInt() : (long)(fileSize - 1);
  if (end < start) return false;
  if ((size_t)end >= fileSize) end = (long)(fileSize - 1);
  *outStart = (size_t)start;
  *outEnd = (size_t)end;
  return true;
}

void handleAudioStreamOptions() {
  lastAudioServerActivityMs = millis();
  audioStreamCommonHeaders();
  audioServer.send(204);
}

static void audioStreamCommonHeaders() {
  String origin = audioServer.hasHeader("Origin") ? audioServer.header("Origin") : "*";
  audioServer.sendHeader("Access-Control-Allow-Origin", origin);
  if (origin != "*") audioServer.sendHeader("Access-Control-Allow-Credentials", "true");
  audioServer.sendHeader("Cache-Control", "no-store");
}

volatile bool audioStreamActive = false;
volatile long audioStreamBytesHeld = 0;
volatile long audioStreamSramBytes = -1;
uint32_t audioStreamSramHeapBefore = 0;
volatile long audioStreamBytesHeldLast = 0;
unsigned long audioStreamStartCount = 0;
unsigned long audioStreamEndCount = 0;

volatile bool audioServerStopRequested = false;
void requestAudioServerStop() {
  audioServerStopRequested = true;
}

void handleAudioStream() {
  lastAudioServerActivityMs = millis();
  if (!requireAuthAudio()) return;
  requestDevicePlaybackStop();
  if (!audioServer.hasArg("file")) { audioStreamCommonHeaders(); audioServer.send(400, "text/plain", "missing file"); return; }
  String fn = audioServer.arg("file");
  String path = String(FILES_DIR) + "/" + fn;

  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  bool exists = sdMounted && SD_MMC.exists(path);
  if (_sdMutex) xSemaphoreGive(_sdMutex);
  if (!exists) { audioStreamCommonHeaders(); audioServer.send(404, "text/plain", "Not found"); return; }

  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  File f = SD_MMC.open(path, FILE_READ);
  size_t fileSize = f ? f.size() : 0;
  uint8_t magic[ENCRYPT_MAGIC_LEN];
  bool isEncrypted = false;
  if (f && fileSize >= (size_t)(ENCRYPT_MAGIC_LEN + AES_IV_LEN + 16)) {
    f.read(magic, ENCRYPT_MAGIC_LEN);
    isEncrypted = (memcmp(magic, ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN) == 0);
  }
  if (f && !isEncrypted) f.seek(0);
  uint8_t ctrNonce[CTRLOG_NONCE_LEN];
  size_t ctrPlainSize = 0;
  bool isCtrAudio = f && !isEncrypted && aiLogOpenForRead(f, ctrNonce, &ctrPlainSize);
  if (f && !isEncrypted && !isCtrAudio) f.seek(0);
  if (_sdMutex) xSemaphoreGive(_sdMutex);
  if (!f) { audioStreamCommonHeaders(); audioServer.send(500, "text/plain", "Open error"); return; }

  WiFiClient client = audioServer.client();
  int fnSlash = fn.lastIndexOf('/');
  String fnBasename = (fnSlash >= 0) ? fn.substring(fnSlash + 1) : fn;
  String dlName = isDeviceGeneratedDownload(fn) ? withDeviceSuffix(fnBasename) : fnBasename;
  audioServer.sendHeader("Content-Disposition", "inline; filename=\"" + dlName + "\"");

  const size_t CHUNK = 16384;
  uint8_t* buf = (uint8_t*)ps_malloc(CHUNK);
  if (!buf) {
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    f.close();
    if (_sdMutex) xSemaphoreGive(_sdMutex);
    audioStreamCommonHeaders();
    audioServer.send(500, "text/plain", "Out of memory");
    return;
  }
  audioStreamActive = true;
  audioStreamBytesHeld = (long)CHUNK;
  audioStreamSramHeapBefore = ESP.getFreeHeap();
  audioStreamStartCount++;

  if (isCtrAudio) {
    audioStreamCommonHeaders();
    audioServer.setContentLength(ctrPlainSize);
    audioServer.send(200, "audio/wav", "");
    size_t plainPos = 0;
    while (plainPos < ctrPlainSize && client.connected()) {
      size_t want = ctrPlainSize - plainPos;
      if (want > CHUNK) want = CHUNK;
      if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
      size_t got = f.read(buf, want);
      if (_sdMutex) xSemaphoreGive(_sdMutex);
      if (got == 0) break;
      aiLogDecryptBlock(ctrNonce, plainPos, buf, got);
      size_t written = 0;
      while (written < got && client.connected()) {
        size_t step = min(got - written, (size_t)4096);
        size_t w = client.write(buf + written, step);
        if (w == 0) break;
        written += w;
        yield();
      }
      plainPos += got;
      if (written == 0) break;
    }
    free(buf);
    audioStreamBytesHeld = 0;
    audioStreamActive = false;
    audioStreamEndCount++;
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    f.close();
    if (_sdMutex) xSemaphoreGive(_sdMutex);
    return;
  }

  if (isEncrypted) {
    uint8_t iv[AES_IV_LEN];
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    f.seek(ENCRYPT_MAGIC_LEN);
    f.read(iv, AES_IV_LEN);
    if (_sdMutex) xSemaphoreGive(_sdMutex);

    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    size_t origSize = getStoredFileOrigSize(fn);
    if (_sdMutex) xSemaphoreGive(_sdMutex);
    bool isWav = fn.endsWith(".wav");

    audioServer.setContentLength((origSize > 0) ? (origSize + (isWav ? 44 : 0)) : CONTENT_LENGTH_UNKNOWN);
    audioStreamCommonHeaders();
    audioServer.send(200, isWav ? "audio/wav" : fileMimeType(fn), "");

    if (isWav && origSize > 0) {
      uint8_t h[44] = {};
      uint32_t dataSize = (uint32_t)origSize, chunkSz = 36 + dataSize, fmtSz = 16;
      uint16_t audioFmt = 1, channels = 1; uint32_t sampleRate = SAMPLE_RATE;
      uint32_t byteRate = SAMPLE_RATE * 2; uint16_t blockAlign = 2, bps = 16;
      memcpy(h,    "RIFF", 4); memcpy(h+4,  &chunkSz,    4);
      memcpy(h+8,  "WAVE", 4); memcpy(h+12, "fmt ",       4);
      memcpy(h+16, &fmtSz, 4); memcpy(h+20, &audioFmt,   2);
      memcpy(h+22, &channels, 2); memcpy(h+24, &sampleRate, 4);
      memcpy(h+28, &byteRate, 4); memcpy(h+32, &blockAlign, 2);
      memcpy(h+34, &bps,   2); memcpy(h+36, "data",       4); memcpy(h+40, &dataSize, 4);
      client.write(h, 44);
    }

    mbedtls_aes_context aes;
    mbedtls_aes_init(&aes);
    mbedtls_aes_setkey_dec(&aes, activeAesKey, 256);
    uint8_t curIV[AES_IV_LEN];
    memcpy(curIV, iv, AES_IV_LEN);
    size_t encRemaining = fileSize - ENCRYPT_MAGIC_LEN - AES_IV_LEN;
    uint8_t* decBuf = (uint8_t*)ps_malloc(CHUNK);
    if (!decBuf) {
      audioStreamActive = false;
      audioStreamBytesHeldLast = audioStreamBytesHeld;
      audioStreamBytesHeld = 0;
      audioStreamSramBytes = (long)audioStreamSramHeapBefore - (long)ESP.getFreeHeap();
      audioStreamEndCount++;
      free(buf); mbedtls_aes_free(&aes);
      if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
      f.close();
      if (_sdMutex) xSemaphoreGive(_sdMutex);
      return;
    }
    audioStreamBytesHeld += (long)CHUNK;

    while (encRemaining > 0 && client.connected() && !audioServerStopRequested) {
      size_t toRead = min(encRemaining, CHUNK);
      toRead = (toRead / 16) * 16;
      if (toRead == 0) break;
      if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
      size_t didRead = f.read(buf, toRead);
      if (_sdMutex) xSemaphoreGive(_sdMutex);
      if (didRead == 0) break;
      didRead = (didRead / 16) * 16;

      for (size_t blk = 0; blk < didRead; blk += 16) {
        uint8_t* eb = buf + blk;
        uint8_t* db = decBuf + blk;
        mbedtls_aes_crypt_ecb(&aes, MBEDTLS_AES_DECRYPT, eb, db);
        for (int i = 0; i < 16; i++) db[i] ^= curIV[i];
        memcpy(curIV, eb, 16);
      }
      encRemaining -= didRead;
      size_t toSend = didRead;
      if (encRemaining == 0) {
        uint8_t padByte = decBuf[didRead - 1];
        if (padByte >= 1 && padByte <= 16) toSend = didRead - padByte;
      }
      size_t written = 0;
      while (written < toSend && client.connected()) {
        size_t step = min(toSend - written, (size_t)4096);
        size_t w = client.write(decBuf + written, step);
        if (w == 0) break;
        written += w;
        yield();
      }
    }
    free(decBuf);
    mbedtls_aes_free(&aes);
  } else {
    size_t rangeStart = 0, rangeEnd = fileSize > 0 ? fileSize - 1 : 0;
    bool isRange = false;
    if (fileSize > 0 && audioServer.hasHeader("Range")) {
      isRange = parseRangeHeader(audioServer.header("Range"), fileSize, &rangeStart, &rangeEnd);
    }
    audioServer.sendHeader("Accept-Ranges", "bytes");
    size_t sendLen = rangeEnd - rangeStart + 1;
    if (isRange) {
      audioServer.sendHeader("Content-Range", "bytes " + String((unsigned long)rangeStart) + "-"
        + String((unsigned long)rangeEnd) + "/" + String((unsigned long)fileSize));
      audioServer.setContentLength(sendLen);
      audioStreamCommonHeaders();
      audioServer.send(206, fileMimeType(fn), "");
      if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
      f.seek(rangeStart);
      if (_sdMutex) xSemaphoreGive(_sdMutex);
    } else {
      audioServer.setContentLength(fileSize);
      audioStreamCommonHeaders();
      audioServer.send(200, fileMimeType(fn), "");
      sendLen = fileSize;
    }

    size_t remaining = sendLen;
    while (remaining > 0 && client.connected() && !audioServerStopRequested) {
      size_t toRead = min(remaining, CHUNK);
      if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
      size_t didRead = f.read(buf, toRead);
      if (_sdMutex) xSemaphoreGive(_sdMutex);
      if (didRead == 0) break;
      size_t written = 0;
      while (written < didRead && client.connected()) {
        size_t step = min(didRead - written, (size_t)4096);
        size_t w = client.write(buf + written, step);
        if (w == 0) break;
        written += w;
        yield();
      }
      remaining -= didRead;
    }
  }

  audioStreamActive = false;
  audioStreamBytesHeldLast = audioStreamBytesHeld;
  audioStreamBytesHeld = 0;
  audioStreamSramBytes = (long)audioStreamSramHeapBefore - (long)ESP.getFreeHeap();
  audioStreamEndCount++;
  free(buf);
  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  f.close();
  if (_sdMutex) xSemaphoreGive(_sdMutex);
}

void requestDevicePlaybackStop() {
  devicePlaybackStopRequested = true;
}

static bool parseWavHeader(File& f, uint32_t* sampleRate, uint16_t* channels, uint16_t* bitsPerSample, uint32_t* dataOffset, uint32_t* dataSize) {
  uint8_t riffHdr[12];
  if (f.read(riffHdr, 12) != 12) return false;
  if (memcmp(riffHdr, "RIFF", 4) != 0 || memcmp(riffHdr + 8, "WAVE", 4) != 0) return false;

  bool haveFmt = false, haveData = false;
  uint16_t audioFormat = 0;
  while (f.available() >= 8) {
    uint8_t chunkHdr[8];
    if (f.read(chunkHdr, 8) != 8) break;
    uint32_t chunkSize; memcpy(&chunkSize, chunkHdr + 4, 4);
    if (memcmp(chunkHdr, "fmt ", 4) == 0 && chunkSize >= 16) {
      uint8_t fmt[16];
      if (f.read(fmt, 16) != 16) break;
      memcpy(&audioFormat,    fmt + 0,  2);
      memcpy(channels,        fmt + 2,  2);
      memcpy(sampleRate,      fmt + 4,  4);
      memcpy(bitsPerSample,   fmt + 14, 2);
      if (chunkSize > 16) f.seek(f.position() + (chunkSize - 16));
      haveFmt = true;
    } else if (memcmp(chunkHdr, "data", 4) == 0) {
      *dataOffset = f.position();
      *dataSize = chunkSize;
      haveData = true;
      break;
    } else {
      f.seek(f.position() + chunkSize + (chunkSize & 1));
    }
  }
  return haveFmt && haveData && audioFormat == 1 && *bitsPerSample == 16;
}

void devicePlaybackTaskFn(void* pv) {
  devicePlaybackActive = true;
  devicePlaybackStartCount++;

  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  File f = SD_MMC.open(devicePlaybackPath, FILE_READ);
  size_t fileSize = f ? f.size() : 0;
  if (_sdMutex) xSemaphoreGive(_sdMutex);

  if (f && fileSize > 0) {
    uint8_t magic[ENCRYPT_MAGIC_LEN];
    bool isEncrypted = false;
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    if (fileSize >= (size_t)(ENCRYPT_MAGIC_LEN + AES_IV_LEN + 16)) {
      f.read(magic, ENCRYPT_MAGIC_LEN);
      isEncrypted = (memcmp(magic, ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN) == 0);
    }
    if (!isEncrypted) f.seek(0);
    uint8_t ctrNonce[CTRLOG_NONCE_LEN];
    size_t ctrPlainSize = 0;
    bool isCtrAudio = !isEncrypted && aiLogOpenForRead(f, ctrNonce, &ctrPlainSize);
    if (!isEncrypted && !isCtrAudio) f.seek(0);
    if (_sdMutex) xSemaphoreGive(_sdMutex);

    {
      const size_t CHUNK = 16384;
      uint8_t* buf = (uint8_t*)ps_malloc(CHUNK);
      int16_t* stereoBuf = (int16_t*)ps_malloc(CHUNK * 2);

      if (buf && stereoBuf) {
        if (isEncrypted) {
          uint8_t iv[AES_IV_LEN];
          if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
          f.read(iv, AES_IV_LEN);
          if (_sdMutex) xSemaphoreGive(_sdMutex);

          mbedtls_aes_context aes;
          mbedtls_aes_init(&aes);
          mbedtls_aes_setkey_dec(&aes, activeAesKey, 256);
          uint8_t curIV[AES_IV_LEN];
          memcpy(curIV, iv, AES_IV_LEN);
          size_t encRemaining = fileSize - ENCRYPT_MAGIC_LEN - AES_IV_LEN;
          uint8_t* decBuf = (uint8_t*)ps_malloc(CHUNK);

          if (decBuf) {
            while (encRemaining > 0 && !devicePlaybackStopRequested) {
              size_t toRead = min(encRemaining, CHUNK);
              toRead = (toRead / 16) * 16;
              if (toRead == 0) break;
              if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
              size_t didRead = f.read(buf, toRead);
              if (_sdMutex) xSemaphoreGive(_sdMutex);
              if (didRead == 0) break;
              didRead = (didRead / 16) * 16;

              for (size_t blk = 0; blk < didRead; blk += 16) {
                uint8_t* eb = buf + blk;
                uint8_t* db = decBuf + blk;
                mbedtls_aes_crypt_ecb(&aes, MBEDTLS_AES_DECRYPT, eb, db);
                for (int i = 0; i < 16; i++) db[i] ^= curIV[i];
                memcpy(curIV, eb, 16);
              }
              encRemaining -= didRead;
              size_t toWrite = didRead;
              if (encRemaining == 0) {
                uint8_t padByte = decBuf[didRead - 1];
                if (padByte >= 1 && padByte <= 16) toWrite = didRead - padByte;
              }
              size_t frames = toWrite / 2;
              for (size_t i = 0; i < frames; i++) {
                int16_t s; memcpy(&s, decBuf + i * 2, 2);
                stereoBuf[i * 2] = s; stereoBuf[i * 2 + 1] = s;
              }
              i2s.write((const uint8_t*)stereoBuf, frames * 4);
            }
            free(decBuf);
          }
          mbedtls_aes_free(&aes);
        } else if (isCtrAudio) {
          size_t remaining = (ctrPlainSize > 44) ? (ctrPlainSize - 44) : 0;
          size_t plainPos = 44;
          if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
          f.seek(CTRLOG_HEADER_LEN + 44);
          if (_sdMutex) xSemaphoreGive(_sdMutex);
          while (remaining > 0 && !devicePlaybackStopRequested) {
            size_t toRead = min(remaining, CHUNK);
            toRead -= (toRead % 2);
            if (toRead == 0) break;
            if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
            size_t didRead = f.read(buf, toRead);
            if (_sdMutex) xSemaphoreGive(_sdMutex);
            if (didRead == 0) break;
            aiLogDecryptBlock(ctrNonce, plainPos, buf, didRead);
            plainPos += didRead;
            remaining -= didRead;
            size_t frames = didRead / 2;
            for (size_t i = 0; i < frames; i++) {
              int16_t s; memcpy(&s, buf + i * 2, 2);
              stereoBuf[i * 2] = s; stereoBuf[i * 2 + 1] = s;
            }
            i2s.write((const uint8_t*)stereoBuf, frames * 4);
          }
        } else {
          uint32_t sampleRate = 0, dataOffset = 0, dataSize = 0;
          uint16_t channels = 0, bitsPerSample = 0;
          if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
          bool hdrOk = parseWavHeader(f, &sampleRate, &channels, &bitsPerSample, &dataOffset, &dataSize);
          if (_sdMutex) xSemaphoreGive(_sdMutex);

          if (!hdrOk) {
            Serial.println("[devicePlayback] not a readable PCM WAV file — skipping");
          } else if (sampleRate != (uint32_t)AUDIO_SAMPLE_RATE) {
            Serial.printf("[devicePlayback] %u Hz file, device plays at %d Hz — needs re-exporting, skipping\n", (unsigned)sampleRate, AUDIO_SAMPLE_RATE);
          } else if (channels != 1 && channels != 2) {
            Serial.printf("[devicePlayback] unsupported channel count (%u) — skipping\n", (unsigned)channels);
          } else {
            if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
            f.seek(dataOffset);
            if (_sdMutex) xSemaphoreGive(_sdMutex);

            size_t remaining = dataSize;
            while (remaining > 0 && !devicePlaybackStopRequested) {
              size_t toRead = min(remaining, CHUNK);
              if (channels == 1) toRead -= (toRead % 2);
              else               toRead -= (toRead % 4);
              if (toRead == 0) break;
              if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
              size_t didRead = f.read(buf, toRead);
              if (_sdMutex) xSemaphoreGive(_sdMutex);
              if (didRead == 0) break;
              remaining -= didRead;

              if (channels == 2) {
                i2s.write(buf, didRead);
              } else {
                size_t frames = didRead / 2;
                for (size_t i = 0; i < frames; i++) {
                  int16_t s; memcpy(&s, buf + i * 2, 2);
                  stereoBuf[i * 2] = s; stereoBuf[i * 2 + 1] = s;
                }
                i2s.write((const uint8_t*)stereoBuf, frames * 4);
              }
            }
          }
        }
      }
      if (buf) free(buf);
      if (stereoBuf) free(stereoBuf);
    }
  }

  if (f) {
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    f.close();
    if (_sdMutex) xSemaphoreGive(_sdMutex);
  }

  devicePlaybackActive = false;
  devicePlaybackEndCount++;
  devicePlaybackTaskHandle = nullptr;
  devicePlaybackRedrawPending = true;
  vTaskDelete(NULL);
}

#define DEVICE_PLAYBACK_START_OK          0
#define DEVICE_PLAYBACK_START_NOT_FOUND   1
#define DEVICE_PLAYBACK_START_UNSUPPORTED 2
#define DEVICE_PLAYBACK_START_FAILED      3
#define DEVICE_PLAYBACK_START_MIC_BUSY    4

static inline bool micCurrentlyInUse() {
  return noteState == NOTE_RECORDING || aiListening;
}

int startDevicePlayback(const String& relPath) {
  if (micCurrentlyInUse()) return DEVICE_PLAYBACK_START_MIC_BUSY;

  if (!relPath.endsWith(".wav")) return DEVICE_PLAYBACK_START_UNSUPPORTED;

  String path = String(FILES_DIR) + "/" + relPath;
  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  bool exists = sdMounted && SD_MMC.exists(path);
  if (_sdMutex) xSemaphoreGive(_sdMutex);
  if (!exists) return DEVICE_PLAYBACK_START_NOT_FOUND;

  requestAudioServerStop();

  if (devicePlaybackActive) {
    devicePlaybackStopRequested = true;
    unsigned long waitStart = millis();
    while (devicePlaybackActive && millis() - waitStart < 2000) delay(10);
  }

  audioCodecReinit();
  if (!audioOk) return DEVICE_PLAYBACK_START_FAILED;

  int slash = relPath.lastIndexOf('/');
  devicePlaybackName = (slash >= 0) ? relPath.substring(slash + 1) : relPath;
  devicePlaybackPath = path;
  devicePlaybackStopRequested = false;

  devicePlaybackScrollText = "Playing: " + devicePlaybackName;
  gfx->setTextSize(2);
  int16_t tbx, tby; uint16_t tbw, tbh;
  gfx->getTextBounds(devicePlaybackScrollText.c_str(), 0, 0, &tbx, &tby, &tbw, &tbh);
  devicePlaybackScrollTextWidth = (int)tbw;
  devicePlaybackScrolls = devicePlaybackScrollTextWidth > (SCREEN_WIDTH - 2 * DEVICE_PLAYBACK_MARQUEE_MARGIN_PX);
  devicePlaybackScrollX = DEVICE_PLAYBACK_MARQUEE_MARGIN_PX;

  BaseType_t ok = xTaskCreatePinnedToCore(devicePlaybackTaskFn, "devPlay", 8192, NULL, 1, &devicePlaybackTaskHandle, 1);
  if (ok != pdPASS) return DEVICE_PLAYBACK_START_FAILED;
  devicePlaybackRedrawPending = true;
  return DEVICE_PLAYBACK_START_OK;
}

void handleApiAudioPlayDevice() {
  if (!requireAuth()) return;
  if (!server.hasArg("file")) { server.send(400, "text/plain", "missing file"); return; }
  int result = startDevicePlayback(server.arg("file"));
  switch (result) {
    case DEVICE_PLAYBACK_START_OK:          server.send(200, "text/plain", "OK"); break;
    case DEVICE_PLAYBACK_START_UNSUPPORTED: server.send(415, "text/plain", "Only .wav files can be played on the device"); break;
    case DEVICE_PLAYBACK_START_FAILED:      server.send(500, "text/plain", "Couldn't start playback"); break;
    case DEVICE_PLAYBACK_START_MIC_BUSY:    server.send(409, "text/plain", "Microphone is in use (recording a note, or AI Assistant/Translator listening) — try again once it's free"); break;
    default:                                server.send(404, "text/plain", "Not found"); break;
  }
}

void handleApiAudioPlayDeviceStop() {
  if (!requireAuth()) return;
  requestDevicePlaybackStop();
  server.send(204);
}

bool audioStreamingServerRoutesRegistered = false;
bool audioStreamingServerRunning = false;
void audioServerTaskFn(void* pv) {
  for (;;) {
    audioServer.handleClient();
    vTaskDelay(pdMS_TO_TICKS(2));
    if (!audioStreamActive
        && (audioServerStopRequested || millis() - lastAudioServerActivityMs > AUDIO_SERVER_IDLE_TIMEOUT_MS)) {
      audioServer.stop();
      audioStreamingServerRunning = false;
      audioServerStopRequested = false;
      audioServerTaskHandle = nullptr;
      Serial.println("[Audio] streaming server stopped — :8081 socket + task stack released");
      vTaskDelete(NULL);
    }
  }
}

void ensureAudioStreamingServer() {
  if (audioStreamingServerRunning) return;
  if (!audioStreamingServerRoutesRegistered) {
    audioServer.on("/audiostream", HTTP_GET, handleAudioStream);
    audioServer.on("/audiostream", HTTP_OPTIONS, handleAudioStreamOptions);
    static const char* AUDIO_HEADER_KEYS[] = { "Range", "Origin" };
    audioServer.collectHeaders(AUDIO_HEADER_KEYS, 2);
    audioStreamingServerRoutesRegistered = true;
  }
  audioServer.begin();
  lastAudioServerActivityMs = millis();
  BaseType_t audioServerTaskOk = xTaskCreatePinnedToCore(audioServerTaskFn, "audioSrv", 8192, NULL, 1, &audioServerTaskHandle, 1);
  Serial.println(audioServerTaskOk == pdPASS ? "[Audio] streaming server started on :8081" : "[Audio] streaming server task creation FAILED");
  audioStreamingServerRunning = true;
}

void fileEncryptTaskFn(void* pv) {
  String fn = fileEncryptTargetRef;
  String srcPath = String(FILES_DIR) + "/" + fn;
  String tmpPath = srcPath + "_etmp";
  bool ok = true;
  String errMsg = "";
  size_t fileSize = 0;

  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  File src = SD_MMC.open(srcPath, FILE_READ);
  if (_sdMutex) xSemaphoreGive(_sdMutex);
  if (!src) { ok = false; errMsg = "Cannot open file"; }
  if (ok) { fileSize = src.size(); fileEncryptBytesTotal = fileSize; }

  uint8_t iv[AES_IV_LEN];
  File dst;
  if (ok) {
    for (int i = 0; i < AES_IV_LEN; i++) iv[i] = esp_random() & 0xFF;
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    SD_MMC.remove(tmpPath);
    dst = SD_MMC.open(tmpPath, FILE_WRITE);
    if (dst) {
      dst.write((const uint8_t*)ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN);
      dst.write(iv, AES_IV_LEN);
    }
    if (_sdMutex) xSemaphoreGive(_sdMutex);
    if (!dst) { ok = false; errMsg = "Cannot create temp file"; }
  }

  if (ok) {
    mbedtls_aes_context aes; mbedtls_aes_init(&aes);
    mbedtls_aes_setkey_enc(&aes, activeAesKey, 256);

    const size_t CHUNK = 4096;
    uint8_t* plainBuf = (uint8_t*)ps_malloc(CHUNK + 16);
    uint8_t* encBuf   = (uint8_t*)ps_malloc(CHUNK + 16);
    if (!plainBuf || !encBuf) { ok = false; errMsg = "Out of memory"; }

    if (ok) {
      uint8_t curIV[AES_IV_LEN]; memcpy(curIV, iv, AES_IV_LEN);
      size_t remaining = fileSize;
      while (ok && remaining > 0) {
        size_t toRead = min(remaining, CHUNK);
        if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
        size_t didRead = src.read(plainBuf, toRead);
        if (_sdMutex) xSemaphoreGive(_sdMutex);
        if (didRead == 0) { ok = false; errMsg = "Read error"; break; }
        remaining -= didRead;
        size_t blockLen = didRead;
        if (remaining == 0) {
          uint8_t padByte = (uint8_t)(16 - (didRead % 16));
          blockLen = didRead + padByte;
          memset(plainBuf + didRead, padByte, padByte);
        } else if (didRead % 16 != 0) {
          ok = false; errMsg = "Misaligned read"; break;
        }
        for (size_t blk = 0; blk < blockLen; blk += 16) {
          for (int i = 0; i < 16; i++) plainBuf[blk + i] ^= curIV[i];
          mbedtls_aes_crypt_ecb(&aes, MBEDTLS_AES_ENCRYPT, plainBuf + blk, encBuf + blk);
          memcpy(curIV, encBuf + blk, 16);
        }
        if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
        dst.write(encBuf, blockLen);
        if (_sdMutex) xSemaphoreGive(_sdMutex);
        fileEncryptBytesDone = fileSize - remaining;
        vTaskDelay(1);
      }
    }
    free(plainBuf); free(encBuf);
    mbedtls_aes_free(&aes);
  }

  if (dst) {
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    dst.close();
    if (_sdMutex) xSemaphoreGive(_sdMutex);
  }

  if (ok) {
    bool verified = aesVerifyRoundTrip(tmpPath, src, fileSize, activeAesKey);
    if (!verified) { ok = false; errMsg = "Encryption verification failed"; }
  }

  if (src) {
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    src.close();
    if (_sdMutex) xSemaphoreGive(_sdMutex);
  }

  if (ok) {
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    String metaPath = srcPath + ".meta";
    SD_MMC.remove(metaPath);
    File meta = SD_MMC.open(metaPath, FILE_WRITE);
    if (meta) { meta.print(String(fileSize)); meta.close(); }
    SD_MMC.remove(srcPath);
    bool renamed = SD_MMC.rename(tmpPath, srcPath);
    if (_sdMutex) xSemaphoreGive(_sdMutex);
    if (!renamed) { ok = false; errMsg = "Failed to replace file"; }
  } else {
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    SD_MMC.remove(tmpPath);
    if (_sdMutex) xSemaphoreGive(_sdMutex);
  }

  fileEncryptBytesDone = fileEncryptBytesTotal;
  fileEncryptFailed = !ok;
  if (!ok) fileEncryptFailedAcked = false;
  fileEncryptErrorMsg = errMsg;
  fileEncryptActive = false;
  fileEncryptTaskHandle = nullptr;
  vTaskDelete(NULL);
}

void handleFileEncrypt() {
  if (!requireAuth()) return;
  if (!sdEncryptionActive) { server.send(400, "application/json", "{\"ok\":false,\"error\":\"Activate SD card encryption first (Credentials > Encryption).\"}"); return; }
  if (!server.hasArg("file")) { server.send(400, "application/json", "{\"ok\":false,\"error\":\"missing file\"}"); return; }
  if (fileEncryptActive) { server.send(409, "application/json", "{\"ok\":false,\"error\":\"Already encrypting a file\"}"); return; }
  String fn      = server.arg("file");
  String srcPath = String(FILES_DIR) + "/" + fn;
  if (!sdMounted || !SD_MMC.exists(srcPath)) { server.send(404, "application/json", "{\"ok\":false,\"error\":\"File not found\"}"); return; }

  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  File src = SD_MMC.open(srcPath, FILE_READ);
  bool opened = (bool)src;
  size_t fileSize = opened ? src.size() : 0;
  bool alreadyEncrypted = false;
  if (opened && fileSize >= (size_t)(ENCRYPT_MAGIC_LEN + AES_IV_LEN + 16)) {
    uint8_t mag[ENCRYPT_MAGIC_LEN]; src.read(mag, ENCRYPT_MAGIC_LEN);
    alreadyEncrypted = (memcmp(mag, ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN) == 0);
  }
  if (opened) src.close();
  if (_sdMutex) xSemaphoreGive(_sdMutex);
  if (!opened) { server.send(500, "application/json", "{\"ok\":false,\"error\":\"Cannot open file\"}"); return; }
  if (alreadyEncrypted) { server.send(200, "application/json", "{\"ok\":true,\"alreadyEncrypted\":true}"); return; }

  fileEncryptTargetRef = fn;
  fileEncryptBytesDone = 0;
  fileEncryptBytesTotal = fileSize;
  fileEncryptFailed = false;
  fileEncryptFailedAcked = true;
  fileEncryptErrorMsg = "";
  fileEncryptActive = true;

  BaseType_t ok = xTaskCreatePinnedToCore(fileEncryptTaskFn, "fileEncrypt", 8192, NULL, 1, &fileEncryptTaskHandle, 1);
  if (ok != pdPASS) {
    fileEncryptActive = false;
    fileEncryptTaskHandle = nullptr;
    server.send(500, "application/json", "{\"ok\":false,\"error\":\"Out of memory\"}");
    return;
  }
  server.send(200, "application/json", "{\"ok\":true}");
}

