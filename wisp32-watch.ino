static void collectChatEntryAudio(const String& header, String& out) {
  int ap = header.indexOf(" | a=");
  if (ap < 0) return;
  int start = ap + 5;
  int e1 = header.indexOf(" | ", start);
  int e2 = header.indexOf(']', start);
  int end = -1;
  if (e1 >= 0) end = e1;
  if (e2 >= 0 && (end < 0 || e2 < end)) end = e2;
  String akey = (end >= 0) ? header.substring(start, end) : header.substring(start);
  if (akey.length() <= 2 || akey.charAt(1) != ':') return;
  bool isT = (akey.charAt(0) == 'T');
  String folder = isT ? "Translator Audio" : "AI Assistant Audio";
  String id = akey.substring(2);
  out += folder + "/" + id + ".wav\n";
  if (isT) out += folder + "/" + id + "-full.wav\n";
}

static void deleteChatAudioList(const String& list) {
  int pos = 0;
  while (pos < (int)list.length()) {
    int nl = list.indexOf('\n', pos);
    if (nl < 0) nl = list.length();
    String rel = list.substring(pos, nl);
    pos = nl + 1;
    if (rel.length() == 0) continue;
    String full = String(FILES_DIR) + "/" + rel;
    if (SD_MMC.exists(full)) SD_MMC.remove(full);
  }
}

void handleClearChat() {
  if (!requireAuth()) return;
  if (sdMounted) {
    ChatLogReader src;
    if (src.open("/chat_log.txt")) {
      while (src.available()) {
        String line = src.readStringUntil('\n');
        if (line.endsWith("\r")) line.remove(line.length() - 1);
        if (isChatLogHeader(line)) { String one; collectChatEntryAudio(line, one); deleteChatAudioList(one); }
      }
      src.close();
    }
    SD_MMC.remove("/chat_log.txt");
  }
  chatLogEntryCount = 0;
  server.sendHeader("Location", "/chatlog");
  server.send(303);
}

void handleChatDelete() {
  if (!requireAuth()) return;
  int delIdx[200]; int delCnt = 0;
  for (int i = 0; i < server.args() && delCnt < 200; i++)
    if (server.argName(i) == "sel") delIdx[delCnt++] = server.arg(i).toInt();

  if (delCnt == 0 || !sdMounted) { server.sendHeader("Location", "/chatlog"); server.send(303); return; }

  ChatLogReader src;
  if (!src.open("/chat_log.txt")) { server.sendHeader("Location", "/chatlog"); server.send(303); return; }
  String survivors;
  survivors.reserve(src.size());

  int entryIdx = -1;
  String pending = "";
  String cq = "";
  bool sawAnswer = false;
  int qaState = 0;
  bool started = false;
  int removedCount = 0;
  String delAudio;

  auto flushPending = [&]() {
    if (pending.length() == 0) return;
    bool skip = false;
    if (cq.length() > 0 || sawAnswer) {
      entryIdx++;
      for (int i = 0; i < delCnt; i++) if (delIdx[i] == entryIdx) { skip = true; removedCount++; break; }
    }
    if (!skip) survivors += pending;
    else { int nl = pending.indexOf('\n'); collectChatEntryAudio(nl >= 0 ? pending.substring(0, nl) : pending, delAudio); }
    pending = "";
  };

  while (src.available()) {
    String line = src.readStringUntil('\n');
    if (line.endsWith("\r")) line.remove(line.length() - 1);
    if (isChatLogHeader(line)) {
      flushPending();
      cq = ""; sawAnswer = false; qaState = 0; started = true;
    } else if (qaState == 0 && line.startsWith("Q: ")) { cq = line.substring(3); qaState = 1; }
    else if (qaState == 1 && line.startsWith("A: ")) { qaState = 2; sawAnswer = true; }
    else if (qaState == 1) { cq += "\n" + line; }
    if (started) pending += line + "\n";
  }
  flushPending();
  src.close();
  if (chatLogEntryCount >= 0) chatLogEntryCount = max(0, chatLogEntryCount - removedCount);

  String tmpPath = "/chat_log.txt_deltmp";
  SD_MMC.remove(tmpPath);
  bool ok = chatLogWriteFresh(tmpPath, survivors);
  if (ok) {
    ChatLogReader verify;
    ok = verify.open(tmpPath) && verify.size() == survivors.length();
    if (ok && survivors.length() > 0) {
      uint8_t* checkBuf = (uint8_t*)ps_malloc(survivors.length() + 1);
      if (checkBuf) {
        size_t gotCheck = verify.read(checkBuf, survivors.length());
        checkBuf[gotCheck] = 0;
        ok = (gotCheck == survivors.length()) && (memcmp(checkBuf, survivors.c_str(), gotCheck) == 0);
        free(checkBuf);
      } else ok = false;
    }
    verify.close();
  }
  if (ok) {
    SD_MMC.remove("/chat_log.txt"); SD_MMC.rename(tmpPath, "/chat_log.txt");
    deleteChatAudioList(delAudio);
  }
  else SD_MMC.remove(tmpPath);

  String backPage = server.hasArg("page") ? server.arg("page") : "";
  server.sendHeader("Location", "/chatlog" + (backPage.length() > 0 ? "?page=" + backPage : String("")));
  server.send(303);
}

void handleChatToKnowledge() {
  if (!requireAuth()) return;
  int addIdx[200]; int addCnt = 0;
  for (int i = 0; i < server.args() && addCnt < 200; i++)
    if (server.argName(i) == "sel") addIdx[addCnt++] = server.arg(i).toInt();

  if (addCnt == 0 || !sdMounted) { server.sendHeader("Location", "/chatlog"); server.send(303); return; }

  ChatLogReader src;
  if (!src.open("/chat_log.txt")) { server.sendHeader("Location", "/chatlog"); server.send(303); return; }

  String toAdd = "";
  int entryIdx = -1;
  String pending = "";
  String cq = "";
  bool sawAnswer = false;
  int qaState = 0;
  bool started = false;
  int addedCount = 0;

  auto flushPending = [&]() {
    if (pending.length() == 0) return;
    if (cq.length() > 0 || sawAnswer) {
      entryIdx++;
      for (int i = 0; i < addCnt; i++) if (addIdx[i] == entryIdx) { toAdd += pending; addedCount++; break; }
    }
    pending = "";
  };

  while (src.available()) {
    String line = src.readStringUntil('\n');
    if (line.endsWith("\r")) line.remove(line.length() - 1);
    if (isChatLogHeader(line)) {
      flushPending();
      cq = ""; sawAnswer = false; qaState = 0; started = true;
    } else if (qaState == 0 && line.startsWith("Q: ")) { cq = line.substring(3); qaState = 1; }
    else if (qaState == 1 && line.startsWith("A: ")) { qaState = 2; sawAnswer = true; }
    else if (qaState == 1) { cq += "\n" + line; }
    if (started) pending += line + "\n";
  }
  flushPending();
  src.close();

  if (toAdd.length() > 0) {
    String historyPath = String(KNOWLEDGE_DIR) + "/history.txt";
    String existing = SD_MMC.exists(historyPath) ? readKnowledgeFile(historyPath) : "";
    if (existing.length() + toAdd.length() > AI_FILE_OPEN_MAX_CHARS) {
      sendKbFileTooLargeError();
      return;
    }
    appendKnowledgeFile(historyPath, toAdd);
    reloadKnowledge();
  }
  String backPage = server.hasArg("page") ? server.arg("page") : "";
  String loc = "/chatlog?added=" + String(addedCount);
  if (backPage.length() > 0) loc += "&page=" + backPage;
  server.sendHeader("Location", loc);
  server.send(303);
}

void handleChatDownload() {
  if (!requireAuth()) return;

  int selIdx[200]; int selCnt = 0;
  for (int i = 0; i < server.args() && selCnt < 200; i++)
    if (server.argName(i) == "sel") selIdx[selCnt++] = server.arg(i).toInt();

  ChatLogReader src;
  if (!sdMounted || !src.open("/chat_log.txt")) {
    server.send(404, "text/plain", "No chat history available.");
    return;
  }

  struct tm ti;
  char stamp[20] = "";
  if (getLocalTime(&ti)) strftime(stamp, sizeof(stamp), "_%Y-%m-%d", &ti);
  String _sfx = deviceIdSuffix(); String _sfxPart = _sfx.length() ? "-" + _sfx : "";
  server.sendHeader("Content-Disposition",
                    String("attachment; filename=\"chat_history") + stamp + _sfxPart + ".txt\"");
  server.setContentLength(CONTENT_LENGTH_UNKNOWN);
  server.send(200, "text/plain; charset=utf-8", "");

  if (selCnt == 0) {
    String chunk;
    chunk.reserve(1200);
    while (src.available()) {
      chunk += src.readStringUntil('\n');
      chunk += "\n";
      if (chunk.length() >= 1024) { server.sendContent(chunk); chunk = ""; }
    }
    if (chunk.length() > 0) server.sendContent(chunk);
    src.close();
    server.sendContent("");
    return;
  }

  int entryIdx = -1;
  String pending = "";
  String cq = "";
  bool sawAnswer = false;
  int qaState = 0;
  bool started = false;

  auto flushPending = [&]() {
    if (pending.length() == 0) return;
    if (cq.length() > 0 || sawAnswer) {
      entryIdx++;
      for (int i = 0; i < selCnt; i++) if (selIdx[i] == entryIdx) { server.sendContent(pending); break; }
    }
    pending = "";
  };

  while (src.available()) {
    String line = src.readStringUntil('\n');
    if (line.endsWith("\r")) line.remove(line.length() - 1);
    if (isChatLogHeader(line)) {
      flushPending();
      cq = ""; sawAnswer = false; qaState = 0; started = true;
    } else if (qaState == 0 && line.startsWith("Q: ")) { cq = line.substring(3); qaState = 1; }
    else if (qaState == 1 && line.startsWith("A: ")) { qaState = 2; sawAnswer = true; }
    else if (qaState == 1) { cq += "\n" + line; }
    if (started) pending += line + "\n";
  }
  flushPending();
  src.close();
  server.sendContent("");
}

static String csvCell(const String& in) {
  String out = "\"";
  out.reserve(in.length() + 8);
  for (size_t i = 0; i < in.length(); i++) {
    char c = in[i];
    if (c == '"')      out += "\"\"";
    else if (c == '\r') {   }
    else               out += c;
  }
  out += "\"";
  return out;
}

void handleChatDownloadCsv() {
  if (!requireAuth()) return;

  int selIdx[200]; int selCnt = 0;
  for (int i = 0; i < server.args() && selCnt < 200; i++)
    if (server.argName(i) == "sel") selIdx[selCnt++] = server.arg(i).toInt();

  ChatLogReader src;
  if (!sdMounted || !src.open("/chat_log.txt")) {
    server.send(404, "text/plain", "No chat history available.");
    return;
  }

  struct tm ti;
  char stamp[20] = "";
  if (getLocalTime(&ti)) strftime(stamp, sizeof(stamp), "_%Y-%m-%d", &ti);
  String _sfx = deviceIdSuffix(); String _sfxPart = _sfx.length() ? "-" + _sfx : "";
  server.sendHeader("Content-Disposition",
                    String("attachment; filename=\"chat_history") + stamp + _sfxPart + ".csv\"");
  server.setContentLength(CONTENT_LENGTH_UNKNOWN);
  server.send(200, "text/csv; charset=utf-8", "");

  server.sendContent(String("\xEF\xBB\xBF") +
    "index,date,time,model,question,answer,tool_count,tool_calls,redacted\n");

  int entryIdx = -1;
  String hdr = "", cq = "", body = "";
  int qaState = 0;

  auto emitRow = [&]() {
    if (hdr.length() == 0) return;
    if (cq.length() == 0 && body.length() == 0) return;
    entryIdx++;
    if (selCnt > 0) {
      bool sel = false;
      for (int i = 0; i < selCnt; i++) if (selIdx[i] == entryIdx) { sel = true; break; }
      if (!sel) return;
    }
    String inner = hdr;
    if (inner.startsWith("[")) inner = inner.substring(1);
    if (inner.endsWith("]"))   inner = inner.substring(0, inner.length() - 1);
    { int sp = inner.indexOf(" | s="); int ap = inner.indexOf(" | a=");
      int cut = sp; if (ap >= 0 && (cut < 0 || ap < cut)) cut = ap;
      if (cut >= 0) inner = inner.substring(0, cut); }
    int pipePos = inner.indexOf(" | ");
    String dt = (pipePos >= 0) ? inner.substring(0, pipePos) : inner;
    String model = (pipePos >= 0) ? inner.substring(pipePos + 3) : "";
    dt.trim(); model.trim();
    String datePart = dt.length() >= 10 ? dt.substring(0, 10) : dt;
    String timePart = dt.length() > 11  ? dt.substring(11)    : "";

    String answer = "", tools = "";
    int toolCount = 0;
    int pos = 0;
    while (true) {
      int b = body.indexOf("<em>Tool : ", pos);
      if (b < 0) { answer += body.substring(pos); break; }
      answer += body.substring(pos, b);
      int e = body.indexOf("</em>", b);
      bool closed = (e >= 0);
      if (!closed) e = body.length();
      String block = body.substring(b + 4, e);
      block.replace("\r", "");
      block.replace("\n\n", "; ");
      block.replace("\n", " ");
      block.trim();
      if (toolCount > 0) tools += "\n";
      tools += block;
      toolCount++;
      pos = closed ? e + 5 : e;
    }
    answer.trim();

    String row = String(entryIdx) + ",";
    row += csvCell(datePart) + ",";
    row += csvCell(timePart) + ",";
    row += csvCell(model)    + ",";
    row += csvCell(cq)       + ",";
    row += csvCell(answer)   + ",";
    row += String(toolCount) + ",";
    row += csvCell(tools)    + ",";
    row += String(cq == "(redacted)" ? "yes" : "no") + "\n";
    server.sendContent(row);
  };

  while (src.available()) {
    String line = src.readStringUntil('\n');
    if (line.endsWith("\r")) line.remove(line.length() - 1);
    if (isChatLogHeader(line)) {
      emitRow();
      hdr = line; cq = ""; body = ""; qaState = 0;
    } else if (qaState == 0 && line.startsWith("Q: ")) { cq = line.substring(3); qaState = 1; }
    else if (qaState == 1 && line.startsWith("A: ")) { body = line.substring(3); qaState = 2; }
    else if (qaState == 1) { cq   += "\n" + line; }
    else if (qaState == 2) { body += "\n" + line; }
  }
  emitRow();
  src.close();
  server.sendContent("");
}

String fileSizeStr(size_t sz) {
  if (sz == 0)               return "?";
  if (sz < 1024)             return String(sz) + "B";
  if (sz < 1048576)          return String(sz / 1024) + "KB";
  if (sz < 1073741824)       return String(sz / 1048576) + "MB";
  return String(sz / 1073741824) + "GB";
}

String fileDateStr(time_t t) {
  if (t == 0) return "";
  struct tm* ti = localtime(&t);
  char buf[20];
  strftime(buf, sizeof(buf), "%b %d %Y %H:%M", ti);
  return String(buf);
}

static String sanitizeDirPath(const String& p) {
  String s = p; s.trim();
  while (s.startsWith("/")) s = s.substring(1);
  while (s.endsWith("/"))   s = s.substring(0, s.length() - 1);
  if (s.indexOf("..") >= 0) return "";
  return s;
}

void handleFiles() {
  if (!requireAuth()) return;
  if (navRouteBlocked("files")) return;

  String curPath = server.hasArg("path") ? sanitizeDirPath(server.arg("path")) : "";
  String sdDirPath = String(FILES_DIR) + (curPath.length() > 0 ? "/" + curPath : "");

  if (server.hasArg("sort") || server.hasArg("dir")) {
    String newSort = server.hasArg("sort") ? server.arg("sort") : fileSortCol;
    String newDir  = server.hasArg("dir")  ? server.arg("dir")  : fileSortDir;
    if (newSort != "name" && newSort != "size" && newSort != "date") newSort = "name";
    if (newDir != "asc" && newDir != "desc") newDir = "asc";
    if (newSort != fileSortCol || newDir != fileSortDir) {
      fileSortCol = newSort;
      fileSortDir = newDir;
      saveSettings();
    }
    server.sendHeader("Location", "/files" + (curPath.length() > 0 ? "?path=" + curPath : ""));
    server.send(303);
    return;
  }

  String curSort = fileSortCol;
  String curDir  = fileSortDir;
  const int PAGE = 40;
  int    pgNum   = server.hasArg("pg") ? server.arg("pg").toInt() : 1;
  String cDir    = server.hasArg("cdir")  ? server.arg("cdir")  : "";
  bool   cIsDir  = server.hasArg("cflag") && server.arg("cflag") == "1";
  long long cNum = server.hasArg("cnum")  ? strtoll(server.arg("cnum").c_str(), nullptr, 10) : 0LL;
  String cName   = server.hasArg("cname") ? server.arg("cname") : "";
  bool   hasCursor = (cDir == "a" || cDir == "b") && cName.length() > 0;
  if (!hasCursor) pgNum = 1;
  if (pgNum < 1)  pgNum = 1;

  String crumbHtml = "<div class='bc'>";
  if (curPath.length() == 0) {
  } else {
    crumbHtml += "<a href='/files' class='bc-a'>Files</a>";
    String built = "", remaining = curPath;
    while (remaining.length() > 0) {
      int sl = remaining.indexOf('/');
      String part = (sl >= 0) ? remaining.substring(0, sl) : remaining;
      remaining  = (sl >= 0) ? remaining.substring(sl + 1) : "";
      built += (built.length() > 0 ? "/" : "") + part;
      crumbHtml += "<span class='bc-sep'>&#8250;</span>";
      if (remaining.length() == 0)
        crumbHtml += "<span class='bc-cur'>" + part + "</span>";
      else
        crumbHtml += "<a href='/files?path=" + built + "' class='bc-a'>" + part + "</a>";
    }
  }
  crumbHtml += "</div>";

  struct DirEntry { String name; bool isDir; size_t rawSize; String date; time_t rawDate; };
  static DirEntry entries[80]; int entryCount = 0;
  for (int _i = 0; _i < 80; _i++) { entries[_i].name = ""; entries[_i].date = ""; entries[_i].isDir = false; entries[_i].rawSize = 0; entries[_i].rawDate = 0; }

  auto cmpDisp = [&](bool aDir, long long aNum, const String& aName,
                     bool bDir, long long bNum, const String& bName) -> int {
    int ra = aDir ? 0 : 1, rb = bDir ? 0 : 1;
    if (ra != rb) return ra - rb;
    int c = (curSort == "name") ? naturalCompareCI(aName, bName)
                                : (aNum < bNum ? -1 : (aNum > bNum ? 1 : 0));
    if (curDir == "desc") c = -c;
    if (c != 0) return c;
    return naturalCompareCI(aName, bName);
  };
  auto entNum = [&](const DirEntry& e) -> long long {
    return (curSort == "size") ? (long long)e.rawSize : (long long)e.rawDate;
  };

  long totalEntries = 0;

  auto fillPage = [&](bool useCur, bool wantAfter, bool doCount) {
    entryCount = 0;
    File dir = SD_MMC.open(sdDirPath);
    if (!dir || !dir.isDirectory()) { if (dir) dir.close(); return; }
    File f = dir.openNextFile();
    while (f) {
      bool isDir = f.isDirectory();
      String fullName = f.name();
      size_t sz = f.size();
      time_t wt = f.getLastWrite();
      String fdt = isDir ? "" : fileDateStr(wt);
      f.close();
      int lastSlash = fullName.lastIndexOf('/');
      String name = (lastSlash >= 0) ? fullName.substring(lastSlash + 1) : fullName;
      if (name.startsWith("_") || name.startsWith(".")) { f = dir.openNextFile(); continue; }
      if (!isDir && name.endsWith(".meta")) { f = dir.openNextFile(); continue; }
      if (doCount) totalEntries++;
      long long num = (curSort == "size") ? (long long)sz : (long long)wt;
      bool inWindow = !useCur
        || (wantAfter ? cmpDisp(isDir, num, name, cIsDir, cNum, cName) > 0
                      : cmpDisp(isDir, num, name, cIsDir, cNum, cName) < 0);
      if (inWindow) {
        if (entryCount < PAGE) {
          entries[entryCount++] = {name, isDir, sz, fdt, wt};
        } else {
          int ext = 0;
          for (int k = 1; k < PAGE; k++) {
            int c = cmpDisp(entries[k].isDir, entNum(entries[k]), entries[k].name,
                            entries[ext].isDir, entNum(entries[ext]), entries[ext].name);
            if (wantAfter ? (c > 0) : (c < 0)) ext = k;
          }
          int c = cmpDisp(isDir, num, name,
                          entries[ext].isDir, entNum(entries[ext]), entries[ext].name);
          if (wantAfter ? (c < 0) : (c > 0)) entries[ext] = {name, isDir, sz, fdt, wt};
        }
      }
      f = dir.openNextFile();
    }
    dir.close();
  };
  auto sortPage = [&]() {
    for (int i = 1; i < entryCount; i++) {
      DirEntry key = entries[i];
      long long kNum = entNum(key);
      int j = i - 1;
      while (j >= 0 && cmpDisp(entries[j].isDir, entNum(entries[j]), entries[j].name,
                               key.isDir, kNum, key.name) > 0) {
        entries[j + 1] = entries[j];
        j--;
      }
      entries[j + 1] = key;
    }
  };

  if (sdMounted) { fillPage(hasCursor, cDir != "b", true); sortPage(); }

  int totalPages = (int)((totalEntries + (PAGE - 1)) / PAGE);
  if (totalPages < 1) totalPages = 1;
  if (pgNum > totalPages) pgNum = totalPages;

  if (entryCount == 0 && totalEntries > 0 && sdMounted && hasCursor) {
    server.sendHeader("Location", "/files" + (curPath.length() > 0 ? "?path=" + curPath : ""));
    server.send(303);
    return;
  }

  String sortButtonsHtml = "";
  {
    const char* sortColKeys[3]   = {"name", "size", "date"};
    const char* sortColLabels[3] = {"Name", "Size", "Date"};
    for (int si = 0; si < 3; si++) {
      bool active = (curSort == sortColKeys[si]);
      String nextDir = active ? (curDir == "asc" ? "desc" : "asc") : "asc";
      String href = "/files?sort=" + String(sortColKeys[si]) + "&dir=" + nextDir
                  + (curPath.length() > 0 ? "&path=" + curPath : "");
      String arrow = active ? (curDir == "asc" ? " &#9650;" : " &#9660;") : "";
      sortButtonsHtml += "<a href='" + href + "' class='srt" + String(active ? " on" : "") + "'>"
                        + sortColLabels[si] + arrow + "</a>";
    }
  }

  static String allDirs[30]; int allDirCount = 0;
  for (int _i = 0; _i < 30; _i++) allDirs[_i] = "";
  if (sdMounted) {
    static String scanQ[30]; int qH = 0, qT = 0;
    for (int _i = 0; _i < 30; _i++) scanQ[_i] = "";
    scanQ[qT++] = "";
    while (qH < qT) {
      String scanRel = scanQ[qH++];
      String scanFull = String(FILES_DIR) + (scanRel.length() > 0 ? "/" + scanRel : "");
      File sdir = SD_MMC.open(scanFull);
      if (!sdir || !sdir.isDirectory()) { if (sdir) sdir.close(); continue; }
      File sf = sdir.openNextFile();
      while (sf) {
        bool sd_isDir = sf.isDirectory();
        String sfn = sf.name(); sf.close();
        if (sd_isDir) {
          int sls = sfn.lastIndexOf('/');
          String dn = (sls >= 0) ? sfn.substring(sls + 1) : sfn;
          if (!dn.startsWith("_") && !dn.startsWith(".") && allDirCount < 30) {
            String childRel = scanRel.length() > 0 ? scanRel + "/" + dn : dn;
            allDirs[allDirCount++] = childRel;
            if (qT < 30) scanQ[qT++] = childRel;
          }
        }
        sf = sdir.openNextFile();
      }
      sdir.close();
    }
  }
  for (int i = 1; i < allDirCount; i++) {
    String key = allDirs[i];
    int j = i - 1;
    while (j >= 0 && naturalCompareCI(allDirs[j], key) > 0) { allDirs[j + 1] = allDirs[j]; j--; }
    allDirs[j + 1] = key;
  }
  String dirsJs = "var _dirs=[{p:\"\",l:\"/ (root)\"}";
  for (int i = 0; i < allDirCount; i++) {
    String escaped = allDirs[i]; escaped.replace("\"","\\\"");
    dirsJs += ",{p:\"" + escaped + "\",l:\"" + escaped + "\"}";
  }
  dirsJs += "];";

  String kbTgtDirs[30]; int kbTgtDirCount = 0;
  if (sdMounted) {
    String scanQ3[30]; int qH3 = 0, qT3 = 0;
    scanQ3[qT3++] = "";
    while (qH3 < qT3) {
      String scanRel = scanQ3[qH3++];
      String scanFull = String(KNOWLEDGE_DIR) + (scanRel.length() > 0 ? "/" + scanRel : "");
      File sdir = SD_MMC.open(scanFull);
      if (!sdir || !sdir.isDirectory()) { if (sdir) sdir.close(); continue; }
      File sf = sdir.openNextFile();
      while (sf) {
        bool sd_isDir = sf.isDirectory();
        String sfn = sf.name(); sf.close();
        if (sd_isDir) {
          int sls = sfn.lastIndexOf('/');
          String dn = (sls >= 0) ? sfn.substring(sls + 1) : sfn;
          if (!dn.startsWith("_") && !dn.startsWith(".") && kbTgtDirCount < 30) {
            String childRel = scanRel.length() > 0 ? scanRel + "/" + dn : dn;
            kbTgtDirs[kbTgtDirCount++] = childRel;
            if (qT3 < 30) scanQ3[qT3++] = childRel;
          }
        }
        sf = sdir.openNextFile();
      }
      sdir.close();
    }
  }
  for (int i = 1; i < kbTgtDirCount; i++) {
    String key = kbTgtDirs[i];
    int j = i - 1;
    while (j >= 0 && naturalCompareCI(kbTgtDirs[j], key) > 0) { kbTgtDirs[j + 1] = kbTgtDirs[j]; j--; }
    kbTgtDirs[j + 1] = key;
  }
  String kbTgtDirsJs = "var _kbdirs=[{p:\"\",l:\"Knowledge Base (root)\"}";
  for (int i = 0; i < kbTgtDirCount; i++) {
    String escaped = kbTgtDirs[i]; escaped.replace("\"","\\\"");
    kbTgtDirsJs += ",{p:\"" + escaped + "\",l:\"" + escaped + "\"}";
  }
  kbTgtDirsJs += "];";

  uint64_t sdTotal = SD_MMC.totalBytes();
  uint64_t sdFree  = sdTotal - SD_MMC.usedBytes();
  auto fmtSD = [](uint64_t b) -> String {
    if (b < 1024ULL)         return String((uint32_t)b) + "B";
    if (b < 1048576ULL)      return String((uint32_t)(b / 1024)) + "KB";
    if (b < 1073741824ULL)   return String((uint32_t)(b / 1048576)) + "MB";
    return String((float)b / 1073741824.0f, 1) + "GB";
  };
  String sdSpaceStr = fmtSD(sdFree) + " free";

  String fileList = "";
  fileList.reserve(8192);
  for (int pass = 0; pass < 2; pass++) {
    for (int i = 0; i < entryCount; i++) {
      if (entries[i].isDir != (pass == 0)) continue;
      String name = entries[i].name;
      if (entries[i].isDir) {
        String subPath = curPath.length() > 0 ? curPath + "/" + name : name;
        String jpath = subPath; jpath.replace("\\","\\\\"); jpath.replace("\"","\\\""); jpath.replace("'","\\'");
        fileList += "<li><div class='fi'>";
        bool isDevDir = isDeviceCreatedFolder(false, curPath, name);
        String dirIcon = isDevDir ? String(DEVICE_FOLDER_ICON) : String(USER_FOLDER_ICON);
        fileList += "<div class='fr'><a href='/files?path=" + subPath + "' class='fn dir-fn'>" + dirIcon + name + "</a>";
        fileList += "<div class='dmwrap'><button type='button' class='dmbtn' onclick='toggleDm(this,event)'>&#8942;</button><div class='dm'>";
        fileList += "<button type='button' onclick='rendir(\""+jpath+"\",\""+name+"\",this)'>Rename</button>";
        fileList += "<button type='button' class='d' onclick='dirDel(\""+urlEncodeParam(subPath)+"\",\""+jpath+"\")'>Delete</button>";
        fileList += "</div></div>";
        fileList += "</div>";
        fileList += "</div></li>";
      } else {
        String fileRef = curPath.length() > 0 ? curPath + "/" + name : name;
        size_t origSize = getStoredFileOrigSize(fileRef);
        String sizeStr = (origSize > 0) ? fileSizeStr(origSize) : fileSizeStr(entries[i].rawSize);
        bool fileEnc = false;
        { File ef = SD_MMC.open(sdDirPath + "/" + name, FILE_READ);
          if (ef && ef.size() >= (size_t)(ENCRYPT_MAGIC_LEN + AES_IV_LEN + 16)) {
            uint8_t mag[ENCRYPT_MAGIC_LEN]; ef.read(mag, ENCRYPT_MAGIC_LEN);
            fileEnc = (memcmp(mag, ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN) == 0)
                   || (memcmp(mag, CTRLOG_MAGIC, CTRLOG_MAGIC_LEN) == 0);
          }
          if (ef) ef.close(); }
        String jref = kbAiAttrJs(fileRef);
        String jdisp = name; jdisp.replace("\\","\\\\"); jdisp.replace("\"","\\\""); jdisp.replace("'","\\'");
        fileList += "<li data-fname=\"" + name + "\"><input type='checkbox' class='fsel' data-kb=\""+String(isKnowledgeFile(name)?"1":"0")+"\" value='"+fileRef+"' onclick='event.stopPropagation();fSync()'><div class='fi'>";
        String encRef = urlEncodeParam(fileRef);
        fileList += "<div class='fr'><a href='/fileview?file="+encRef+"' target='_blank' class='fn'>" + name + "</a>";
        bool encryptingThisFile = fileEncryptActive && fileEncryptTargetRef == fileRef;
        bool decryptingThisFile = fileDecryptActive && fileDecryptTargetRef == fileRef;
        fileList += "<span class='fmeta'>"
                  + String(fileEnc ? "<span class='tag'>AES</span>" : "")
                  + String(encryptingThisFile ? "<span class='tag' style='background:#48a'>Encrypting…</span>" : "")
                  + String(decryptingThisFile ? "<span class='tag' style='background:#48a'>Decrypting…</span>" : "")
                  + "<span class='fs'>" + sizeStr + "</span>";
        fileList += "<div class='dmwrap'><button type='button' class='dmbtn' onclick='toggleDm(this,event)'>&#8942;</button><div class='dm'>";
        fileList += "<a href='/filedownload?file="+encRef+"'>Download</a>";
        { String lowerName = name; lowerName.toLowerCase();
          if (lowerName.endsWith(".wav") || lowerName.endsWith(".mp3")) {
            fileList += "<button type='button' onclick='trOpen(\""+jref+"\",\""+jdisp+"\")'>Transcribe</button>";
