    + (aiTaskActiveDir.length() > 0 ? " in this folder: " : " in the knowledge base: ") + names;
}

static int levenshteinDistance(const String& a, const String& b) {
  int la = a.length(), lb = b.length();
  if (la == 0) return lb;
  if (lb == 0) return la;
  int* prev = (int*)malloc((lb + 1) * sizeof(int));
  int* curr = (int*)malloc((lb + 1) * sizeof(int));
  if (!prev || !curr) { free(prev); free(curr); return la > lb ? la : lb; }
  for (int j = 0; j <= lb; j++) prev[j] = j;
  for (int i = 1; i <= la; i++) {
    curr[0] = i;
    char ca = a[i - 1];
    for (int j = 1; j <= lb; j++) {
      int cost = (ca == b[j - 1]) ? 0 : 1;
      int del = prev[j] + 1;
      int ins = curr[j - 1] + 1;
      int sub = prev[j - 1] + cost;
      int m = del < ins ? del : ins;
      curr[j] = m < sub ? m : sub;
    }
    int* tmp = prev; prev = curr; curr = tmp;
  }
  int result = prev[lb];
  free(prev); free(curr);
  return result;
}

static void _findSimilarKnowledgeFileRecursive(const String& relDir, const String& qSlug, String& bestName, int& bestDist) {
  String fullDir = String(KNOWLEDGE_DIR) + (relDir.length() > 0 ? "/" + relDir : "");
  File dir = SD_MMC.open(fullDir);
  if (!dir || !dir.isDirectory()) { if (dir) dir.close(); return; }
  File f = dir.openNextFile();
  while (f) {
    String fullName = f.name();
    int ls = fullName.lastIndexOf('/');
    String childName = (ls >= 0) ? fullName.substring(ls + 1) : fullName;
    bool isDir = f.isDirectory();
    f.close();
    String childRel = relDir.length() > 0 ? relDir + "/" + childName : childName;
    if (isDir) {
      _findSimilarKnowledgeFileRecursive(childRel, qSlug, bestName, bestDist);
    } else if (isKnowledgeFile(childName)) {
      int dot = childName.lastIndexOf('.');
      String base = (dot > 0) ? childName.substring(0, dot) : childName;
      String cSlug = aiKbSlug(base);
      String qCmp = qSlug; qCmp.replace('-', '_');
      String cCmp = cSlug; cCmp.replace('-', '_');
      int dist = levenshteinDistance(qCmp, cCmp);
      if (cCmp.indexOf(qCmp) >= 0 || qCmp.indexOf(cCmp) >= 0) dist = 1;
      if (bestDist < 0 || dist < bestDist) { bestDist = dist; bestName = childRel; }
    }
    f = dir.openNextFile();
  }
  dir.close();
}

static String _stripFillerWords(const String& s) {
  static const char* fillers[] = {"file", "files", "document", "documents", "the"};
  String out; out.reserve(s.length());
  int start = 0;
  while (start <= (int)s.length()) {
    int sp = s.indexOf(' ', start);
    String word = (sp >= 0) ? s.substring(start, sp) : s.substring(start);
    bool isFiller = false;
    for (const char* f : fillers) if (word.equalsIgnoreCase(f)) { isFiller = true; break; }
    if (!isFiller && word.length() > 0) { if (out.length() > 0) out += ' '; out += word; }
    if (sp < 0) break;
    start = sp + 1;
  }
  return out;
}

static String aiFindSimilarKnowledgeFile(const String& query, bool* outExact) {
  if (!sdMounted) return "";
  String qSlug = aiKbSlug(_stripFillerWords(query));
  if (qSlug.length() == 0) return "";

  String bestName = "";
  int bestDist = -1;
  _findSimilarKnowledgeFileRecursive("", qSlug, bestName, bestDist);

  if (bestName.length() == 0) return "";
  int threshold = qSlug.length() / 2;
  if (threshold < 2) threshold = 2;
  if (bestDist > threshold) return "";
  if (outExact) *outExact = (bestDist == 0);
  return bestName;
}

static String formatDurationSecs(long secs) {
  if (secs < 60) return String(secs) + (secs == 1 ? " second" : " seconds");
  long mins = secs / 60;
  long rem = secs % 60;
  String out = String(mins) + (mins == 1 ? " minute" : " minutes");
  if (rem > 0) out += " " + String(rem) + (rem == 1 ? " second" : " seconds");
  return out;
}

static int findAlarmSlotByName(const String& query) {
  String q = query; q.toLowerCase();
  for (int i = 0; i < MAX_ALARMS; i++) {
    if (alarmEpochs[i] == 0) continue;
    String nm = String(alarmNames[i]); nm.toLowerCase();
    if (nm == q) return i;
  }
  for (int i = 0; i < MAX_ALARMS; i++) {
    if (alarmEpochs[i] == 0) continue;
    String nm = String(alarmNames[i]); nm.toLowerCase();
    if (nm.indexOf(q) >= 0 || q.indexOf(nm) >= 0) return i;
  }
  return -1;
}

String aiToolSetAlarm(String name, long secondsFromNow, String timeStr) {
  time_t now = time(NULL);
  time_t target;
  timeStr.trim();
  if (timeStr.length() > 0) {
    int hh = -1, mm = -1, ss = 0;
    sscanf(timeStr.c_str(), "%d:%d:%d", &hh, &mm, &ss);
    if (hh < 0 || hh > 23 || mm < 0 || mm > 59 || ss < 0 || ss > 59) return "Error: time must be 24-hour \"HH:MM\" or \"HH:MM:SS\", e.g. \"08:45\" or \"08:45:30\"";
    struct tm targetTm;
    if (!getLocalTime(&targetTm)) return "Error: device clock isn't synced yet — use secondsFromNow instead";
    targetTm.tm_hour = hh;
    targetTm.tm_min  = mm;
    targetTm.tm_sec  = ss;
    target = mktime(&targetTm);
    if (target <= now) target += 24UL * 60UL * 60UL;
    secondsFromNow = (long)(target - now);
  } else {
    if (secondsFromNow <= 0) return "Error: provide either time (\"HH:MM\") or a positive secondsFromNow";
    target = now + (time_t)secondsFromNow;
  }
  int slot = -1;
  for (int i = 0; i < MAX_ALARMS; i++) {
    if (alarmEpochs[i] == 0) { slot = i; break; }
  }
  if (slot < 0) return "Error: " + String(MAX_ALARMS) + " alarms are already in use — cancel one before setting a new one.";

  alarmEpochs[slot] = target;
  name.trim();
  if (name.length() > 0) {
    if ((int)name.length() >= ALARM_NAME_LEN) name = name.substring(0, ALARM_NAME_LEN - 1);
    strncpy(alarmNames[slot], name.c_str(), ALARM_NAME_LEN - 1);
    alarmNames[slot][ALARM_NAME_LEN - 1] = '\0';
  } else {
    snprintf(alarmNames[slot], ALARM_NAME_LEN, "Alarm %d", slot + 1);
  }

  char buf[12] = "";
  struct tm dummy;
  if (getLocalTime(&dummy)) {
    struct tm tt;
    localtime_r(&target, &tt);
    strftime(buf, sizeof(buf), "%H:%M:%S", &tt);
  }
  return String("Alarm '") + alarmNames[slot] + "' set for " + formatDurationSecs(secondsFromNow) + " from now" + (buf[0] ? (String(" (") + buf + ")") : "") + ". The device will wake itself from sleep to play it even if the screen is off.";
}

String aiToolListAlarms() {
  time_t now = time(NULL);
  int idx[MAX_ALARMS];
  int n = 0;
  for (int i = 0; i < MAX_ALARMS; i++) {
    if (alarmEpochs[i] != 0) idx[n++] = i;
  }
  for (int i = 1; i < n; i++) {
    int key = idx[i];
    int j = i - 1;
    while (j >= 0 && alarmEpochs[idx[j]] > alarmEpochs[key]) { idx[j + 1] = idx[j]; j--; }
    idx[j + 1] = key;
  }
  String out = "";
  for (int i = 0; i < n; i++) {
    int s = idx[i];
    long secsLeft = (long)(alarmEpochs[s] - now);
    if (secsLeft < 0) secsLeft = 0;
    char buf[12] = "";
    struct tm tt; localtime_r(&alarmEpochs[s], &tt);
    strftime(buf, sizeof(buf), "%H:%M:%S", &tt);
    if (i > 0) out += ", ";
    out += "'" + String(alarmNames[s]) + "' at " + buf + " (in " + formatDurationSecs(secsLeft) + ")";
  }
  if (n == 0) return "No alarms are currently set.";
  return String(n) + (n == 1 ? " alarm set: " : " alarms set: ") + out;
}

String aiToolCancelAlarms(String timeFilter, String nameFilter) {
  timeFilter.trim();
  nameFilter.trim();
  int count = 0;

  if (timeFilter.length() == 0 && nameFilter.length() == 0) {
    for (int i = 0; i < MAX_ALARMS; i++) {
      if (alarmEpochs[i] != 0) {
        alarmEpochs[i] = 0; count++;
      }
    }
    return count == 0 ? "No alarms were set." : (String(count) + (count == 1 ? " alarm" : " alarms") + " cancelled.");
  }

  if (nameFilter.length() > 0) {
    int i = findAlarmSlotByName(nameFilter);
    if (i < 0) return "No alarm found named '" + nameFilter + "'.";
    String nm = alarmNames[i];
    alarmEpochs[i] = 0;
    return "Alarm '" + nm + "' cancelled.";
  }

  for (int i = 0; i < MAX_ALARMS; i++) {
    if (alarmEpochs[i] == 0) continue;
    struct tm tt; localtime_r(&alarmEpochs[i], &tt);
    char bufHM[8]; strftime(bufHM, sizeof(bufHM), "%H:%M", &tt);
    char bufHMS[12]; strftime(bufHMS, sizeof(bufHMS), "%H:%M:%S", &tt);
    if (timeFilter == bufHM || timeFilter == bufHMS) { alarmEpochs[i] = 0; count++; }
  }
  if (count == 0) return "No alarm found set for " + timeFilter + ".";
  return String(count) + (count == 1 ? " alarm" : " alarms") + " set for " + timeFilter + " cancelled.";
}

static long timerElapsedSecs(int i) {
  long e = timerAccumulatedSecs[i];
  if (timerStartEpoch[i] != 0) e += (long)(time(NULL) - timerStartEpoch[i]);
  return e < 0 ? 0 : e;
}

static String formatTimerElapsed(long totalSecs) {
  if (totalSecs < 0) totalSecs = 0;
  long h = totalSecs / 3600, m = (totalSecs % 3600) / 60, s = totalSecs % 60;
  char buf[16];
  snprintf(buf, sizeof(buf), "%ld:%02ld:%02ld", h, m, s);
  return String(buf);
}

static int findTimerSlot(const String& query) {
  String q = query; q.trim(); q.toLowerCase();
  if (q.length() == 0) return -1;
  for (int i = 0; i < MAX_TIMERS; i++) {
    if (timerNames[i][0] == '\0') continue;
    String nm = String(timerNames[i]); nm.toLowerCase();
    if (nm == q) return i;
  }
  int best = -1, bestDist = -1;
  for (int i = 0; i < MAX_TIMERS; i++) {
    if (timerNames[i][0] == '\0') continue;
    String nm = String(timerNames[i]); nm.toLowerCase();
    int dist = levenshteinDistance(q, nm);
    if (nm.indexOf(q) >= 0 || q.indexOf(nm) >= 0) dist = 1;
    if (bestDist < 0 || dist < bestDist) { bestDist = dist; best = i; }
  }
  if (best < 0) return -1;
  int threshold = q.length() / 2; if (threshold < 2) threshold = 2;
  if (bestDist > threshold) return -1;
  return best;
}

String aiToolStartTimer(String name) {
  name.trim();
  if (name.length() == 0) return "Error: no timer name given";
  if ((int)name.length() >= TIMER_NAME_LEN) name = name.substring(0, TIMER_NAME_LEN - 1);

  int existing = findTimerSlot(name);
  if (existing >= 0) {
    if (timerStartEpoch[existing] != 0) {
      return "Timer '" + String(timerNames[existing]) + "' is already running (at " + formatTimerElapsed(timerElapsedSecs(existing)) + ").";
    }
    timerStartEpoch[existing] = time(NULL);
    return "Resumed timer '" + String(timerNames[existing]) + "' (already at " + formatTimerElapsed(timerAccumulatedSecs[existing]) + ").";
  }

  int slot = -1;
  for (int i = 0; i < MAX_TIMERS; i++) { if (timerNames[i][0] == '\0') { slot = i; break; } }
  if (slot < 0) return "Error: " + String(MAX_TIMERS) + " timers are already in use — stop, reset, or delete one before starting a new one.";

  strncpy(timerNames[slot], name.c_str(), TIMER_NAME_LEN - 1);
  timerNames[slot][TIMER_NAME_LEN - 1] = '\0';
  timerStartEpoch[slot] = time(NULL);
  timerAccumulatedSecs[slot] = 0;
  return "Started timer '" + name + "'.";
}

String aiToolStopTimer(String name) {
  name.trim();
  int i = (name.length() > 0) ? findTimerSlot(name) : -1;
  if (i < 0) {
    int runningIdx = -1, runningCount = 0;
    for (int k = 0; k < MAX_TIMERS; k++) {
      if (timerNames[k][0] != '\0' && timerStartEpoch[k] != 0) { runningIdx = k; runningCount++; }
    }
    if (name.length() == 0 && runningCount == 1) {
      i = runningIdx;
    } else if (name.length() == 0 && runningCount == 0) {
      return "No timers are currently running.";
    } else if (name.length() == 0) {
      return "More than one timer is running — call list_timers and say which one to stop.";
    } else {
      return "No timer found matching '" + name + "'.";
    }
  }
  if (timerStartEpoch[i] == 0) {
    return "Timer '" + String(timerNames[i]) + "' is already stopped (at " + formatTimerElapsed(timerAccumulatedSecs[i]) + ").";
  }
  timerAccumulatedSecs[i] = timerElapsedSecs(i);
  timerStartEpoch[i] = 0;
  return "Stopped timer '" + String(timerNames[i]) + "' at " + formatTimerElapsed(timerAccumulatedSecs[i]) + ".";
}

String aiToolResetTimer(String name) {
  int i = findTimerSlot(name);
  if (i < 0) return "No timer found matching '" + name + "'.";
  timerAccumulatedSecs[i] = 0;
  bool running = timerStartEpoch[i] != 0;
  if (running) timerStartEpoch[i] = time(NULL);
  return "Timer '" + String(timerNames[i]) + "' reset to 0:00:00" + (running ? " (still running)." : " (stopped).");
}

String aiToolDeleteTimer(String name) {
  int i = findTimerSlot(name);
  if (i < 0) return "No timer found matching '" + name + "'.";
  String nm = timerNames[i];
  timerNames[i][0] = '\0';
  timerStartEpoch[i] = 0;
  timerAccumulatedSecs[i] = 0;
  return "Deleted timer '" + nm + "'.";
}

String aiToolListTimers() {
  String out = ""; int count = 0;
  for (int i = 0; i < MAX_TIMERS; i++) {
    if (timerNames[i][0] == '\0') continue;
    if (count > 0) out += ", ";
    out += String(timerNames[i]) + ": " + formatTimerElapsed(timerElapsedSecs(i)) + (timerStartEpoch[i] != 0 ? " (running)" : " (stopped)");
    count++;
  }
  if (count == 0) return "No timers are currently set.";
  return String(count) + (count == 1 ? " timer: " : " timers: ") + out;
}

