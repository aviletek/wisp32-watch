  if (aiTranslatorModelIndex != 0) {
    for (int i = 0; i < aiTranslatorModelCount; i++) {
      if (aiModelIsGemini(aiTranslatorModels[i]) == wantGemini) {
        aiTranslatorModelIndex = i + 1;
        activeTranslatorRealtimeModel = aiTranslatorModels[i];
        break;
