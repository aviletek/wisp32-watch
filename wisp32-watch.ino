  if (aiDeepThinkModelIndex != 0) {
    for (int i = 0; i < aiDeepThinkModelCount; i++) {
      if (aiModelIsGemini(aiDeepThinkModels[i]) == wantGemini) {
        aiDeepThinkModelIndex = i + 1;
        activeDeepThinkModel = aiDeepThinkModels[i];
        break;
      }
