  kbSyncRemoveUnder(relPath);
  reloadKnowledge();
  if (wantsJson) { server.send(200, "application/json", "{\"ok\":true}"); return; }
  int lastSlash = relPath.lastIndexOf('/');
  String parentPath = (lastSlash > 0) ? relPath.substring(0, lastSlash) : "";
