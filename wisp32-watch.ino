    "function apiSave(){"
    "var m=document.getElementById('apiMethodSel').value;"
    "var u=document.getElementById('apiUrlIn').value.trim();"
    "if(u&&!m){alert('Select a method.');return;}"
    "if(m&&!u){alert('Enter a URL.');return;}"
    "document.getElementById('apiMethodH').value=(m&&u)?m:'';"
    "document.getElementById('apiUrlH').value=(m&&u)?u:'';"
    "document.getElementById('apiHeadersH').value=document.getElementById('apiHeadersIn').value;"
    "document.getElementById('apiAuthTypeH').value=document.getElementById('apiAuthTypeSel').value;"
    "document.getElementById('apiAuthKeyNameH').value=document.getElementById('apiAuthKeyNameIn').value;"
    "document.getElementById('apiAuthValueH').value=document.getElementById('apiAuthValueIn').value;"
    "document.getElementById('apiBodyH').value=document.getElementById('apiBodyIn').value;"
