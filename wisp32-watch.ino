void deriveKeyFromCidAndPassword(int32_t cid, const String& password, uint8_t out[AES_KEY_LEN]) {
  size_t n = sizeof(cid) + password.length();
  uint8_t* buf = (uint8_t*)malloc(n);
  if (!buf) { memset(out, 0, AES_KEY_LEN); return; }
  memcpy(buf, &cid, sizeof(cid));
  memcpy(buf + sizeof(cid), password.c_str(), password.length());
  mbedtls_sha256(buf, n, out, 0);
  free(buf);
}

void loadEncryptionState() {
  sdEncryptionActive = false;
  int32_t cardSerial;
  if (!readSdCardSerial(&cardSerial)) return;

  Preferences prefs;
  prefs.begin(NVS_ENC_NAMESPACE, true);
  bool hasCid = prefs.isKey(NVS_ENC_CID_FIELD);
  int32_t storedCid = prefs.getInt(NVS_ENC_CID_FIELD, 0);
  size_t keyLen = prefs.getBytesLength(NVS_ENC_KEY_FIELD);
  if (hasCid && keyLen == AES_KEY_LEN && storedCid == cardSerial) {
    prefs.getBytes(NVS_ENC_KEY_FIELD, activeAesKey, AES_KEY_LEN);
    sdEncryptionActive = true;
  }
  prefs.end();
}

void loadSecretsBaselineKey() {
  int32_t cardSerial;
  secretsBaselineKeyReady = readSdCardSerial(&cardSerial);
  if (secretsBaselineKeyReady) {
    deriveKeyFromCidAndPassword(cardSerial, "", secretsBaselineKey);
  }
}

void saveEncryptionStateToNvs(int32_t cid, const uint8_t* key) {
  Preferences prefs;
  prefs.begin(NVS_ENC_NAMESPACE, false);
  prefs.putInt(NVS_ENC_CID_FIELD, cid);
  prefs.putBytes(NVS_ENC_KEY_FIELD, key, AES_KEY_LEN);
  prefs.end();
}

void clearEncryptionStateFromNvs() {
  Preferences prefs;
  prefs.begin(NVS_ENC_NAMESPACE, false);
  prefs.remove(NVS_ENC_CID_FIELD);
  prefs.remove(NVS_ENC_KEY_FIELD);
  prefs.end();
}

class SDMMCCardAccessor : public fs::SDMMCFS {
public:
  sdmmc_card_t* getCardPtr() { return _card; }
};

bool readSdCardSerial(int32_t* serial) {
  sdmmc_card_t* card = ((SDMMCCardAccessor*)&SD_MMC)->getCardPtr();
  if (!card) return false;
  *serial = card->cid.serial;
  return true;
}

void checkSdCardIdentity() {
  sdCardRecognized = true;
  int32_t serial;
  if (!readSdCardSerial(&serial)) return;

  Preferences prefs;
  prefs.begin(NVS_CARD_NAMESPACE, true);
  bool hasStored = prefs.isKey(NVS_CARD_SERIAL_FIELD);
  int32_t stored = prefs.getInt(NVS_CARD_SERIAL_FIELD, 0);
  prefs.end();

  if (!hasStored) {
    Preferences w;
    w.begin(NVS_CARD_NAMESPACE, false);
    w.putInt(NVS_CARD_SERIAL_FIELD, serial);
    w.end();
    Serial.println("[SDCard] first boot with this card — remembering its serial");
    return;
  }

  sdCardRecognized = (stored == serial);
  if (!sdCardRecognized) {
    Serial.println("[SDCard] unrecognized card — a different SD card is inserted than last time");
  }
}

void authorizeCurrentSdCard() {
  int32_t serial;
  if (readSdCardSerial(&serial)) {
    Preferences w;
    w.begin(NVS_CARD_NAMESPACE, false);
    w.putInt(NVS_CARD_SERIAL_FIELD, serial);
    w.end();
  }
  sdCardRecognized = true;
  saveCredentials();
}

uint8_t* aesEncryptWithKey(const uint8_t* input, size_t inputLen, size_t* outputLen, const uint8_t* key) {
  size_t paddedLen = ((inputLen / 16) + 1) * 16;
  uint8_t* padded = (uint8_t*)ps_malloc(paddedLen);
  if (!padded) return nullptr;
  memcpy(padded, input, inputLen);
  uint8_t padByte = paddedLen - inputLen;
  memset(padded + inputLen, padByte, padByte);
  uint8_t iv[AES_IV_LEN];
  for (int i = 0; i < AES_IV_LEN; i++) iv[i] = esp_random() & 0xFF;
  uint8_t* encrypted = (uint8_t*)ps_malloc(paddedLen);
  if (!encrypted) { free(padded); return nullptr; }
  mbedtls_aes_context aes;
  mbedtls_aes_init(&aes);
  mbedtls_aes_setkey_enc(&aes, key, 256);
  uint8_t ivCopy[AES_IV_LEN];
  memcpy(ivCopy, iv, AES_IV_LEN);
  mbedtls_aes_crypt_cbc(&aes, MBEDTLS_AES_ENCRYPT, paddedLen, ivCopy, padded, encrypted);
  mbedtls_aes_free(&aes);
  free(padded);
  *outputLen = ENCRYPT_MAGIC_LEN + AES_IV_LEN + paddedLen;
  uint8_t* output = (uint8_t*)ps_malloc(*outputLen);
  if (!output) { free(encrypted); return nullptr; }
  memcpy(output, ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN);
  memcpy(output + ENCRYPT_MAGIC_LEN, iv, AES_IV_LEN);
  memcpy(output + ENCRYPT_MAGIC_LEN + AES_IV_LEN, encrypted, paddedLen);
  free(encrypted);
  return output;
}

uint8_t* aesEncrypt(const uint8_t* input, size_t inputLen, size_t* outputLen) {
  return aesEncryptWithKey(input, inputLen, outputLen, activeAesKey);
}

char* aesDecryptWithKey(const uint8_t* input, size_t inputLen, const uint8_t* key) {
  if (inputLen < ENCRYPT_MAGIC_LEN + AES_IV_LEN + 16) return nullptr;
  uint8_t iv[AES_IV_LEN];
  memcpy(iv, input + ENCRYPT_MAGIC_LEN, AES_IV_LEN);
  const uint8_t* encData = input + ENCRYPT_MAGIC_LEN + AES_IV_LEN;
  size_t encLen = inputLen - ENCRYPT_MAGIC_LEN - AES_IV_LEN;
  uint8_t* decrypted = (uint8_t*)ps_malloc(encLen + 1);
  if (!decrypted) return nullptr;
  mbedtls_aes_context aes;
  mbedtls_aes_init(&aes);
  mbedtls_aes_setkey_dec(&aes, key, 256);
  mbedtls_aes_crypt_cbc(&aes, MBEDTLS_AES_DECRYPT, encLen, iv, encData, decrypted);
  mbedtls_aes_free(&aes);
  uint8_t padByte = decrypted[encLen - 1];
  if (padByte > 0 && padByte <= 16) encLen -= padByte;
  decrypted[encLen] = 0;
  return (char*)decrypted;
}

char* aesDecrypt(const uint8_t* input, size_t inputLen) {
  return aesDecryptWithKey(input, inputLen, activeAesKey);
}

char* aesDecryptVerify(const uint8_t* input, size_t inputLen, const uint8_t* key) {
  if (inputLen < ENCRYPT_MAGIC_LEN + AES_IV_LEN + 16) return nullptr;
  uint8_t iv[AES_IV_LEN];
  memcpy(iv, input + ENCRYPT_MAGIC_LEN, AES_IV_LEN);
  const uint8_t* encData = input + ENCRYPT_MAGIC_LEN + AES_IV_LEN;
  size_t encLen = inputLen - ENCRYPT_MAGIC_LEN - AES_IV_LEN;
  if (encLen == 0 || (encLen % 16) != 0) return nullptr;
  uint8_t* decrypted = (uint8_t*)ps_malloc(encLen + 1);
  if (!decrypted) return nullptr;
  mbedtls_aes_context aes;
  mbedtls_aes_init(&aes);
  mbedtls_aes_setkey_dec(&aes, key, 256);
  mbedtls_aes_crypt_cbc(&aes, MBEDTLS_AES_DECRYPT, encLen, iv, encData, decrypted);
  mbedtls_aes_free(&aes);
  uint8_t padByte = decrypted[encLen - 1];
  if (padByte < 1 || padByte > 16 || (size_t)padByte > encLen) { free(decrypted); return nullptr; }
  for (size_t i = 0; i < padByte; i++) {
    if (decrypted[encLen - 1 - i] != padByte) { free(decrypted); return nullptr; }
  }
  encLen -= padByte;
  decrypted[encLen] = 0;
  return (char*)decrypted;
}

uint8_t* aesDecryptBinaryWithKey(const uint8_t* input, size_t inputLen, size_t* outLen, const uint8_t* key) {
  if (inputLen < ENCRYPT_MAGIC_LEN + AES_IV_LEN + 16) return nullptr;
  uint8_t iv[AES_IV_LEN];
  memcpy(iv, input + ENCRYPT_MAGIC_LEN, AES_IV_LEN);
  const uint8_t* encData = input + ENCRYPT_MAGIC_LEN + AES_IV_LEN;
  size_t encLen = inputLen - ENCRYPT_MAGIC_LEN - AES_IV_LEN;
  uint8_t* dec = (uint8_t*)ps_malloc(encLen);
  if (!dec) return nullptr;
  mbedtls_aes_context aes;
  mbedtls_aes_init(&aes);
  mbedtls_aes_setkey_dec(&aes, key, 256);
  uint8_t ivCopy[AES_IV_LEN];
  memcpy(ivCopy, iv, AES_IV_LEN);
  mbedtls_aes_crypt_cbc(&aes, MBEDTLS_AES_DECRYPT, encLen, ivCopy, encData, dec);
  mbedtls_aes_free(&aes);
  uint8_t padByte = dec[encLen - 1];
  if (padByte > 0 && padByte <= 16) encLen -= padByte;
  *outLen = encLen;
  return dec;
}

uint8_t* aesDecryptBinary(const uint8_t* input, size_t inputLen, size_t* outLen) {
  return aesDecryptBinaryWithKey(input, inputLen, outLen, activeAesKey);
}

#define CTRLOG_MAGIC      "CTR:"
#define CTRLOG_MAGIC_LEN  4
#define CTRLOG_NONCE_LEN  16
#define CTRLOG_CANARY_LEN 16
#define CTRLOG_HEADER_LEN (CTRLOG_MAGIC_LEN + CTRLOG_NONCE_LEN + CTRLOG_CANARY_LEN)

const uint8_t CTRLOG_CANARY_PLAIN[CTRLOG_CANARY_LEN] = {
  'C','H','A','T','L','O','G',':','C','A','N','A','R','Y','!','!'
};

static void ctrAddBlockIndex(uint8_t counter[16], uint64_t blockIndex) {
  for (int i = 15; i >= 0 && blockIndex > 0; i--) {
    uint32_t sum = counter[i] + (blockIndex & 0xFF);
    counter[i] = (uint8_t)sum;
    blockIndex >>= 8;
    int carry = sum >> 8;
    int j = i - 1;
    while (carry && j >= 0) {
      uint32_t s2 = counter[j] + carry;
      counter[j] = (uint8_t)s2;
      carry = s2 >> 8;
      j--;
    }
  }
}

static void ctrKeystreamBlock(const uint8_t* key, const uint8_t counter[16], uint8_t out[16]) {
  mbedtls_aes_context aes;
  mbedtls_aes_init(&aes);
  mbedtls_aes_setkey_enc(&aes, key, 256);
  mbedtls_aes_crypt_ecb(&aes, MBEDTLS_AES_ENCRYPT, counter, out);
  mbedtls_aes_free(&aes);
}

static void ctrCryptRange(const uint8_t* key, const uint8_t baseNonce[16], size_t byteOffset, uint8_t* data, size_t len) {
  size_t pos = 0;
  while (pos < len) {
    uint64_t blockIndex = (byteOffset + pos) / 16;
    size_t blockOff = (byteOffset + pos) % 16;
    uint8_t counter[16];
    memcpy(counter, baseNonce, 16);
    ctrAddBlockIndex(counter, blockIndex);
    uint8_t keystream[16];
    ctrKeystreamBlock(key, counter, keystream);
    size_t chunk = min((size_t)(16 - blockOff), len - pos);
    for (size_t i = 0; i < chunk; i++) data[pos + i] ^= keystream[blockOff + i];
    pos += chunk;
  }
}

class CtrLogReader {
  File f;
  uint8_t key[AES_KEY_LEN];
  uint8_t nonce[CTRLOG_NONCE_LEN];
  size_t plainLen = 0;
  size_t pos = 0;
  bool ok = false;
public:
  bool open(const String& path, const uint8_t* useKey) {
    f = SD_MMC.open(path, FILE_READ);
    if (!f) return false;
    size_t fileSize = f.size();
    if (fileSize < CTRLOG_HEADER_LEN) { f.close(); return false; }
    uint8_t magic[CTRLOG_MAGIC_LEN];
    f.read(magic, CTRLOG_MAGIC_LEN);
    if (memcmp(magic, CTRLOG_MAGIC, CTRLOG_MAGIC_LEN) != 0) { f.close(); return false; }
    f.read(nonce, CTRLOG_NONCE_LEN);
    uint8_t canaryCt[CTRLOG_CANARY_LEN];
    f.read(canaryCt, CTRLOG_CANARY_LEN);
    memcpy(key, useKey, AES_KEY_LEN);
    ctrCryptRange(key, nonce, 0, canaryCt, CTRLOG_CANARY_LEN);
    if (memcmp(canaryCt, CTRLOG_CANARY_PLAIN, CTRLOG_CANARY_LEN) != 0) { f.close(); return false; }
    plainLen = fileSize - CTRLOG_HEADER_LEN;
    pos = 0;
    ok = true;
    return true;
  }
  bool isOpen() const { return ok; }
  size_t size() const { return plainLen; }
  bool available() { return ok && pos < plainLen; }
  void seek(size_t plainPos) { pos = min(plainPos, plainLen); }
  size_t read(uint8_t* buf, size_t len) {
    if (!ok) return 0;
    size_t avail = plainLen - pos;
    size_t toRead = min(len, avail);
    if (toRead == 0) return 0;
    f.seek(CTRLOG_HEADER_LEN + pos);
    size_t got = f.read(buf, toRead);
    ctrCryptRange(key, nonce, pos, buf, got);
    pos += got;
    return got;
  }
  String readStringUntil(char delim) {
    String out;
    uint8_t c;
    while (available()) {
      if (read(&c, 1) != 1) break;
      if ((char)c == delim) break;
      out += (char)c;
    }
    return out;
  }
  void close() { if (f) f.close(); ok = false; }
};

static bool ctrLogCreateFile(const String& path, const uint8_t* key, uint8_t* outNonce) {
  uint8_t nonce[CTRLOG_NONCE_LEN];
  for (int i = 0; i < CTRLOG_NONCE_LEN; i++) nonce[i] = esp_random() & 0xFF;
  File f = SD_MMC.open(path, FILE_WRITE);
  if (!f) return false;
  f.write((const uint8_t*)CTRLOG_MAGIC, CTRLOG_MAGIC_LEN);
  f.write(nonce, CTRLOG_NONCE_LEN);
  uint8_t canaryCt[CTRLOG_CANARY_LEN];
  memcpy(canaryCt, CTRLOG_CANARY_PLAIN, CTRLOG_CANARY_LEN);
  ctrCryptRange(key, nonce, 0, canaryCt, CTRLOG_CANARY_LEN);
  f.write(canaryCt, CTRLOG_CANARY_LEN);
  f.close();
  if (outNonce) memcpy(outNonce, nonce, CTRLOG_NONCE_LEN);
  return true;
}

static bool ctrLogAppend(const String& path, const uint8_t* key, const String& newPlaintext) {
  size_t plainLen = 0;
  uint8_t nonce[CTRLOG_NONCE_LEN];
  if (!SD_MMC.exists(path)) {
    if (!ctrLogCreateFile(path, key, nonce)) return false;
    plainLen = 0;
  } else {
    File f = SD_MMC.open(path, FILE_READ);
    if (!f) return false;
    size_t fileSize = f.size();
    if (fileSize < CTRLOG_HEADER_LEN) { f.close(); return false; }
    uint8_t magic[CTRLOG_MAGIC_LEN];
    f.read(magic, CTRLOG_MAGIC_LEN);
    if (memcmp(magic, CTRLOG_MAGIC, CTRLOG_MAGIC_LEN) != 0) { f.close(); return false; }
    f.read(nonce, CTRLOG_NONCE_LEN);
    f.close();
    plainLen = fileSize - CTRLOG_HEADER_LEN;
  }
  if (newPlaintext.length() == 0) return true;

  size_t n = newPlaintext.length();
  uint8_t* buf = (uint8_t*)ps_malloc(n);
  if (!buf) return false;
  memcpy(buf, newPlaintext.c_str(), n);
  ctrCryptRange(key, nonce, plainLen, buf, n);

  File f = SD_MMC.open(path, FILE_APPEND);
  if (!f) { free(buf); return false; }
  size_t written = f.write(buf, n);
  f.close();
  free(buf);
  return written == n;
}

class ChatLogReader {
  File plainF;
  CtrLogReader ctr;
  bool encrypted = false;
  bool ok = false;
public:
  bool open(const String& path) {
    encrypted = sdEncryptionActive;
    if (encrypted) {
      ok = ctr.open(path, activeAesKey);
    } else {
      plainF = SD_MMC.open(path, FILE_READ);
      if (plainF) {
        uint8_t magic[CTRLOG_MAGIC_LEN];
        bool looksEncrypted = plainF.size() >= CTRLOG_MAGIC_LEN
          && plainF.read(magic, CTRLOG_MAGIC_LEN) == CTRLOG_MAGIC_LEN
          && memcmp(magic, CTRLOG_MAGIC, CTRLOG_MAGIC_LEN) == 0;
        if (looksEncrypted) { plainF.close(); ok = false; return false; }
        plainF.seek(0);
      }
      ok = (bool)plainF;
    }
    return ok;
  }
  bool isOpen() const { return ok; }
  size_t size() const { return !ok ? 0 : (encrypted ? ctr.size() : plainF.size()); }
  bool available() { return ok && (encrypted ? ctr.available() : plainF.available()); }
  void seek(size_t pos) { if (!ok) return; if (encrypted) ctr.seek(pos); else plainF.seek(pos); }
  size_t read(uint8_t* buf, size_t len) { return !ok ? 0 : (encrypted ? ctr.read(buf, len) : plainF.read(buf, len)); }
  String readStringUntil(char delim) { return !ok ? String() : (encrypted ? ctr.readStringUntil(delim) : plainF.readStringUntil(delim)); }
  void close() { if (encrypted) ctr.close(); else if (plainF) plainF.close(); ok = false; }
};

static bool replaySavedActive = false;

static bool chatLogAppendEntry(const String& path, const String& newPlaintext) {
  if (sdEncryptionActive) return ctrLogAppend(path, activeAesKey, newPlaintext);
  if (newPlaintext.length() == 0) return true;
  File f = SD_MMC.open(path, FILE_APPEND);
  if (!f) return false;
  size_t written = f.write((const uint8_t*)newPlaintext.c_str(), newPlaintext.length());
  f.close();
  return written == newPlaintext.length();
}

static bool chatLogWriteFresh(const String& path, const String& content) {
  SD_MMC.remove(path);
  if (sdEncryptionActive) {
    return content.length() > 0 ? ctrLogAppend(path, activeAesKey, content) : ctrLogCreateFile(path, activeAesKey, nullptr);
  }
  File f = SD_MMC.open(path, FILE_WRITE);
  if (!f) return false;
  size_t written = content.length() > 0 ? f.write((const uint8_t*)content.c_str(), content.length()) : 0;
  f.close();
  return written == content.length();
}

static bool isValidUtf8(const String& s) {
  size_t i = 0, n = s.length();
  const uint8_t* b = (const uint8_t*)s.c_str();
  while (i < n) {
    uint8_t c = b[i];
    int extra;
    if (c <= 0x7F) { i++; continue; }
    else if ((c & 0xE0) == 0xC0) extra = 1;
    else if ((c & 0xF0) == 0xE0) extra = 2;
    else if ((c & 0xF8) == 0xF0) extra = 3;
    else return false;
    if (i + extra >= n) return false;
    for (int k = 1; k <= extra; k++) {
      if ((b[i + k] & 0xC0) != 0x80) return false;
    }
    i += extra + 1;
  }
  return true;
}

static void appendUtf8(String& out, uint32_t cp) {
  if (cp <= 0x7F) {
    out += (char)cp;
  } else if (cp <= 0x7FF) {
    out += (char)(0xC0 | (cp >> 6));
    out += (char)(0x80 | (cp & 0x3F));
  } else {
    out += (char)(0xE0 | (cp >> 12));
    out += (char)(0x80 | ((cp >> 6) & 0x3F));
    out += (char)(0x80 | (cp & 0x3F));
  }
}

static uint32_t win1252ToCodepoint(uint8_t c) {
  switch (c) {
    case 0x80: return 0x20AC; case 0x82: return 0x201A; case 0x83: return 0x0192;
    case 0x84: return 0x201E; case 0x85: return 0x2026; case 0x86: return 0x2020;
    case 0x87: return 0x2021; case 0x88: return 0x02C6; case 0x89: return 0x2030;
    case 0x8A: return 0x0160; case 0x8B: return 0x2039; case 0x8C: return 0x0152;
    case 0x8E: return 0x017D; case 0x91: return 0x2018; case 0x92: return 0x2019;
    case 0x93: return 0x201C; case 0x94: return 0x201D; case 0x95: return 0x2022;
    case 0x96: return 0x2013; case 0x97: return 0x2014; case 0x98: return 0x02DC;
    case 0x99: return 0x2122; case 0x9A: return 0x0161; case 0x9B: return 0x203A;
    case 0x9C: return 0x0153; case 0x9E: return 0x017E; case 0x9F: return 0x0178;
    default: return c;
  }
}

static String win1252ToUtf8(const String& s) {
  String out;
  out.reserve(s.length());
  const uint8_t* b = (const uint8_t*)s.c_str();
  size_t n = s.length();
  for (size_t i = 0; i < n; i++) {
    uint8_t c = b[i];
    if (c <= 0x7F) out += (char)c;
    else appendUtf8(out, win1252ToCodepoint(c));
  }
  return out;
}

String readKnowledgeFile(String path) {
  File f = SD_MMC.open(path, FILE_READ);
  if (!f) return "";
  size_t fileSize = f.size();
  uint8_t* buf = (uint8_t*)ps_malloc(fileSize);
  if (!buf) { f.close(); return ""; }
  f.read(buf, fileSize);
  f.close();
  String result = "";
  if (fileSize >= ENCRYPT_MAGIC_LEN && memcmp(buf, ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN) == 0) {
    if (sdEncryptionActive) {
      char* plain = aesDecrypt(buf, fileSize);
      free(buf);
      if (plain) { result = String(plain); free(plain); }
    } else {
      free(buf);
      result = "";
    }
  } else {
    result = String((char*)buf).substring(0, fileSize);
    free(buf);
  }
  return result;
}

bool writeKnowledgeFile(String path, String content) {
  if (!sdEncryptionActive) {
    String tmpPath = path + "_tmp";
    SD_MMC.remove(tmpPath);
    File f = SD_MMC.open(tmpPath, FILE_WRITE);
    if (!f) return false;
    size_t written = f.write((const uint8_t*)content.c_str(), content.length());
    f.close();
    if (written != content.length()) { SD_MMC.remove(tmpPath); return false; }
    SD_MMC.remove(path);
    return SD_MMC.rename(tmpPath, path);
  }

  size_t encLen;
  uint8_t* enc = aesEncrypt((const uint8_t*)content.c_str(), content.length(), &encLen);
  if (!enc) {
    Serial.printf("[writeKB] %s: aesEncrypt FAILED (contentLen=%u, freeHeap=%u) — malloc failure inside aesEncrypt\n",
                  path.c_str(), (unsigned)content.length(), (unsigned)ESP.getFreeHeap());
    return false;
  }
  size_t checkLen = 0;
  uint8_t* check = aesDecryptBinary(enc, encLen, &checkLen);
  bool matches = check && checkLen == content.length() && memcmp(check, content.c_str(), checkLen) == 0;
  if (!check) {
    Serial.printf("[writeKB] %s: aesDecryptBinary round-trip check FAILED to even allocate (encLen=%u, freeHeap=%u)\n",
                  path.c_str(), (unsigned)encLen, (unsigned)ESP.getFreeHeap());
  } else if (!matches) {
    Serial.printf("[writeKB] %s: round-trip MISMATCH — contentLen=%u, checkLen=%u\n",
                  path.c_str(), (unsigned)content.length(), (unsigned)checkLen);
  }
  if (check) free(check);
  if (!matches) { free(enc); return false; }

  String tmpPath = path + "_tmp";
  SD_MMC.remove(tmpPath);
  File f = SD_MMC.open(tmpPath, FILE_WRITE);
  if (!f) {
    Serial.printf("[writeKB] %s: couldn't open tmp path %s for write\n", path.c_str(), tmpPath.c_str());
    free(enc); return false;
  }
  size_t written = f.write(enc, encLen);
  f.close(); free(enc);
  if (written != encLen) {
    Serial.printf("[writeKB] %s: SHORT WRITE — wrote %u of %u encrypted bytes to tmp file\n",
                  path.c_str(), (unsigned)written, (unsigned)encLen);
    SD_MMC.remove(tmpPath); return false;
  }
  SD_MMC.remove(path);
  bool renamed = SD_MMC.rename(tmpPath, path);
  if (!renamed) {
    Serial.printf("[writeKB] %s: RENAME FAILED after removing original — tmp file left at %s\n",
                  path.c_str(), tmpPath.c_str());
  }
  return renamed;
}

