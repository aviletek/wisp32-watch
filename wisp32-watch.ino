void handleFolderRename() {
  if (!requireAuth()) return;
  if (!server.hasArg("path") || !server.hasArg("newname")) {
    server.send(400, "application/json", "{\"ok\":false,\"err\":\"Missing parameters\"}"); return;
  }
  String oldPath = sanitizeDirPath(server.arg("path"));
  String newName = server.arg("newname"); newName.trim();
  if (oldPath.length() == 0) { server.send(400, "application/json", "{\"ok\":false,\"err\":\"Invalid path\"}"); return; }
  if (newName.length() == 0 || newName.indexOf('/') >= 0 || newName.indexOf("..") >= 0) {
    server.send(400, "application/json", "{\"ok\":false,\"err\":\"Invalid name\"}"); return;
  }
  int lastSlash = oldPath.lastIndexOf('/');
  String parentDir = (lastSlash >= 0) ? oldPath.substring(0, lastSlash) : "";
  String newRelPath = (parentDir.length() > 0) ? parentDir + "/" + newName : newName;
  String oldSD = String(FILES_DIR) + "/" + oldPath;
  String newSD = String(FILES_DIR) + "/" + newRelPath;
  if (!sdMounted || !SD_MMC.exists(oldSD)) { server.send(404, "application/json", "{\"ok\":false,\"err\":\"Folder not found\"}"); return; }
  if (!newSD.equalsIgnoreCase(oldSD) && SD_MMC.exists(newSD)) { server.send(409, "application/json", "{\"ok\":false,\"err\":\"Name already exists\"}"); return; }
  if (SD_MMC.rename(oldSD, newSD)) {
    server.send(200, "application/json",
      "{\"ok\":true,\"name\":\"" + newRelPath + "\",\"display\":\"" + newName + "\"}");
  } else {
    server.send(500, "application/json", "{\"ok\":false,\"err\":\"Rename failed\"}");
  }
}

void handleFileRename() {
  if (!requireAuth()) return;
  if (!server.hasArg("file")) { server.sendHeader("Location", "/files"); server.send(303); return; }
  String fn = server.arg("file");
  int fnDirSlash = fn.lastIndexOf('/');
  String dirPrefix = (fnDirSlash >= 0) ? fn.substring(0, fnDirSlash + 1) : "";
  String fnBase   = (fnDirSlash >= 0) ? fn.substring(fnDirSlash + 1) : fn;
  if (server.method() == HTTP_POST) {
    String newName = server.arg("newname"); newName.trim();
    bool jsonMode = server.hasArg("json");
    if (newName.length() > 0) {
      int oldDot = fnBase.lastIndexOf('.');
      int newDot = newName.lastIndexOf('.');
      if (newDot < 0 && oldDot >= 0) newName += fnBase.substring(oldDot);
      String fullNewName = dirPrefix + newName;
      String oldBase = String(FILES_DIR) + "/" + fn;
      String newBase = String(FILES_DIR) + "/" + fullNewName;
      File src = SD_MMC.open(oldBase, FILE_READ);
      File dst = SD_MMC.open(newBase, FILE_WRITE);
      if (src && dst) {
        uint8_t buf[512];
        while (src.available()) { size_t n = src.read(buf, sizeof(buf)); dst.write(buf, n); }
        src.close(); dst.close(); SD_MMC.remove(oldBase);
        for (const char* suf : {".meta"}) {
          String os = oldBase + suf, ns = newBase + suf;
          if (SD_MMC.exists(os)) {
            File ps = SD_MMC.open(os, FILE_READ); File pd = SD_MMC.open(ns, FILE_WRITE);
            if (ps && pd) {
              while (ps.available()) { size_t n = ps.read(buf, sizeof(buf)); pd.write(buf, n); }
              ps.close(); pd.close(); SD_MMC.remove(os);
            }
          }
        }
      } else { if (src) src.close(); if (dst) dst.close(); }
      if (jsonMode) {
        server.send(200, "application/json",
          "{\"ok\":true,\"name\":\"" + fullNewName + "\",\"display\":\"" + newName + "\"}");
        return;
      }
    } else if (jsonMode) {
      server.send(200, "application/json", "{\"ok\":false,\"err\":\"Empty name\"}"); return;
    }
    String parentPath = dirPrefix.length() > 0 ? dirPrefix.substring(0, dirPrefix.length() - 1) : "";
    server.sendHeader("Location", "/files" + (parentPath.length() > 0 ? "?path=" + parentPath : ""));
    server.send(303);
  } else {
    int dot = fnBase.lastIndexOf('.');
    String baseName = (dot >= 0) ? fnBase.substring(0, dot) : fnBase;
    String html = "<!DOCTYPE html><html><head><meta charset='UTF-8'><title>" + webTitleBrand() + "</title>" WEB_FAVICON
      "<style>body{font-family:sans-serif;display:flex;justify-content:center;align-items:center;"
      "height:100vh;margin:0;background:#111;color:#eee;}"
      ".box{background:#1a1a1a;padding:32px;border-radius:8px;border:1px solid #333;min-width:300px;}"
      "h2{color:#4af;margin-bottom:4px;}p{color:#888;font-size:0.9em;margin:0 0 16px;}"
      "label{color:#aaa;font-size:0.85em;}input[type=text]{width:100%;padding:10px;background:#222;"
      "color:#eee;border:1px solid #444;border-radius:4px;margin:6px 0 16px;font-size:16px;box-sizing:border-box;}"
      "input[type=submit]{background:#4af;color:#000;border:none;padding:10px 24px;border-radius:4px;"
      "cursor:pointer;font-weight:bold;font-size:16px;margin-right:8px;}a{color:#f84;}</style></head><body>"
      "<div class='box'><h2>Rename: " + fnBase + "</h2>"
      "<form method='POST' action='/filerename'>"
      "<input type='hidden' name='file' value='" + fn + "'>"
      "<label>New name (extension kept if omitted)</label>"
      "<input type='text' name='newname' value='" + baseName + "' autofocus><br>"
      "<input type='submit' value='Rename'> <a href='/files'>Cancel</a>"
      "</form></div></body></html>";
    server.send(200, "text/html; charset=utf-8", html);
  }
}

void handleKBTransfer() {
  if (!requireAuth()) return;
  String fn   = server.hasArg("file") ? server.arg("file") : "";
  String dest = server.hasArg("dest") ? sanitizeDirPath(server.arg("dest")) : "";
  if (fn.length() == 0) { server.sendHeader("Location", "/"); server.send(303); return; }
  int ls = fn.lastIndexOf('/');
  String basename = (ls >= 0) ? fn.substring(ls + 1) : fn;
  String srcDir = (ls > 0) ? fn.substring(0, ls) : "";
  String srcPath = String(KNOWLEDGE_DIR) + "/" + fn;
  String dstPath = String(FILES_DIR) + (dest.length() > 0 ? "/" + dest : "") + "/" + basename;
  if (SD_MMC.exists(srcPath)) {
    File src = SD_MMC.open(srcPath, FILE_READ);
    File dst = SD_MMC.open(dstPath, FILE_WRITE);
    if (src && dst) {
      uint8_t buf[512];
      while (src.available()) { size_t n = src.read(buf, sizeof(buf)); dst.write(buf, n); }
      src.close(); dst.close();
      SD_MMC.remove(srcPath);
      String srcPw = srcPath + ".pwd";
      if (SD_MMC.exists(srcPw)) SD_MMC.remove(srcPw);
      reloadKnowledge();
