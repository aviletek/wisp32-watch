String aiToolForget(String what) {
  what.trim();
  if (what.length() == 0) return "Nothing specified to forget.";
  if (!sdMounted) return "Error: SD card not mounted";
  String path = String(KNOWLEDGE_DIR) + "/" + AI_MEMORIES_FILE;
  if (!SD_MMC.exists(path)) return "No memories saved yet.";
  String content = readKnowledgeFile(path);
  if (content.length() == 0) return "No memories saved yet.";

  String needle = what; needle.toLowerCase();
  String kept = "";
  int removedCount = 0;
  int start = 0;
  while (start < (int)content.length()) {
    int nl = content.indexOf('\n', start);
    String line = (nl == -1) ? content.substring(start) : content.substring(start, nl);
    String trimmedLine = line; trimmedLine.trim();
    if (trimmedLine.length() > 0) {
      String factPart = trimmedLine;
      if (factPart.startsWith("[")) {
        int close = factPart.indexOf(']');
        if (close != -1) factPart = factPart.substring(close + 1);
      }
      factPart.trim();
      String factLower = factPart; factLower.toLowerCase();
      if (factLower.indexOf(needle) != -1) {
        removedCount++;
      } else {
        kept += line + "\n";
      }
    }
    if (nl == -1) break;
    start = nl + 1;
  }

  if (removedCount == 0) return "Couldn't find a matching memory to forget.";
  if (!writeKnowledgeFile(path, kept)) return "Error: write failed";
  reloadKnowledge();
  return removedCount == 1 ? "Done, I've forgotten that." : ("Done, I've forgotten " + String(removedCount) + " matching entries.");
}

static void _listKnowledgeFilesRecursive(const String& relDir, String& outJoined, int& outCount, int maxCount) {
  if (outCount >= maxCount) return;
  String fullDir = String(KNOWLEDGE_DIR) + (relDir.length() > 0 ? "/" + relDir : "");
  File dir = SD_MMC.open(fullDir);
  if (!dir || !dir.isDirectory()) { if (dir) dir.close(); return; }
  File f = dir.openNextFile();
  while (f && outCount < maxCount) {
    String fullName = f.name();
    int ls = fullName.lastIndexOf('/');
    String childName = (ls >= 0) ? fullName.substring(ls + 1) : fullName;
    bool isDir = f.isDirectory();
    f.close();
    String childRel = relDir.length() > 0 ? relDir + "/" + childName : childName;
    if (isDir) {
      _listKnowledgeFilesRecursive(childRel, outJoined, outCount, maxCount);
    } else if (isKnowledgeFile(childName)) {
      if (outCount > 0) outJoined += ", ";
      outJoined += childRel;
      outCount++;
    }
    f = dir.openNextFile();
  }
  dir.close();
}

