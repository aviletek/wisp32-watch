void fetchClockWeather() {
  if (weatherPaused) return;
  bool isConnected = (WiFi.status() == WL_CONNECTED);
  static bool wxWasConnected = false;
  if (isConnected && !wxWasConnected) wifiConnectSettleUntilMs = millis() + WIFI_SETTLE_MS;
  wxWasConnected = isConnected;
  if (!isConnected) { lastWeatherFetch = millis(); return; }
  if ((long)(millis() - wifiConnectSettleUntilMs) < 0) { lastWeatherFetch = millis(); return; }
  lastWeatherFetch = (clockTempC == -999) ? millis() : millis() - 25UL * 60UL * 1000UL;

  WiFiClient _wc;
  HTTPClient http;
  String uri = "/v1/forecast"
               "?latitude=" + String(clockLat, 4) + "&longitude=" + String(clockLon, 4) +
               "&current=temperature_2m,apparent_temperature,weather_code,relative_humidity_2m,wind_speed_10m,pressure_msl"
               "&daily=sunrise,sunset,precipitation_probability_max,temperature_2m_min,temperature_2m_max"
               "&timezone=America%2FToronto&forecast_days=1";
  http.begin(_wc, "api.open-meteo.com", 80, uri);
  http.setTimeout(10000);
  int code = http.GET();
  Serial.printf("[Weather] HTTP %d\n", code);
  if (code != 200) return;
  String body = http.getString();
  DynamicJsonDocument doc(4096);
  DeserializationError err = deserializeJson(doc, body);
  if (err != DeserializationError::Ok) { Serial.printf("[Weather] parse error: %s\n", err.c_str()); return; }

  JsonVariant v;
  v = doc["current"]["temperature_2m"];       if (!v.isNull()) clockTempC       = (int)round(v.as<float>());
  v = doc["current"]["apparent_temperature"]; if (!v.isNull()) clockFeelsC      = (int)round(v.as<float>());
  v = doc["current"]["weather_code"];         if (!v.isNull()) clockWeatherCode = v.as<int>();
  v = doc["current"]["relative_humidity_2m"]; if (!v.isNull()) clockHumidity    = v.as<int>();
  v = doc["current"]["wind_speed_10m"];       if (!v.isNull()) clockWindSpeed   = v.as<float>();
  v = doc["current"]["pressure_msl"];         if (!v.isNull()) clockPressure    = v.as<float>();
  v = doc["daily"]["precipitation_probability_max"][0]; if (!v.isNull()) clockRainPct = v.as<int>();
  v = doc["daily"]["temperature_2m_min"][0]; if (!v.isNull()) clockTempMin = (int)round(v.as<float>());
  v = doc["daily"]["temperature_2m_max"][0]; if (!v.isNull()) clockTempMax = (int)round(v.as<float>());
  String sr = doc["daily"]["sunrise"][0] | "";
  String ss = doc["daily"]["sunset"][0]  | "";
  if (_wxStrMutex) xSemaphoreTake(_wxStrMutex, portMAX_DELAY);
  clockSunrise = sr.length() >= 16 ? sr.substring(11, 16) : "";
  clockSunset  = ss.length() >= 16 ? ss.substring(11, 16) : "";
  if (_wxStrMutex) xSemaphoreGive(_wxStrMutex);
  lastWeatherFetch = millis();

  weatherCacheEpoch      = time(nullptr);
  weatherCacheTempC       = clockTempC;
  weatherCacheFeelsC      = clockFeelsC;
  weatherCacheTempMin     = clockTempMin;
  weatherCacheTempMax     = clockTempMax;
  weatherCacheRainPct     = clockRainPct;
  weatherCacheWeatherCode = clockWeatherCode;
  weatherCacheHumidity    = clockHumidity;
  weatherCacheWindSpeed   = clockWindSpeed;
  weatherCachePressure    = clockPressure;
  strlcpy(weatherCacheSunrise, clockSunrise.c_str(), sizeof(weatherCacheSunrise));
  strlcpy(weatherCacheSunset,  clockSunset.c_str(),  sizeof(weatherCacheSunset));
  weatherCacheValid       = true;

  Serial.printf("[Weather] temp=%d feels=%d code=%d rain=%d%% sr=%s ss=%s\n",
                clockTempC, clockFeelsC, clockWeatherCode, clockRainPct,
                clockSunrise.c_str(), clockSunset.c_str());
}

#define WX_TASK_STACK_BYTES 4096
static StaticTask_t wxTaskTCB;
static StackType_t* wxTaskStack = nullptr;
static TaskHandle_t wxTaskHandle = nullptr;
static volatile bool wxFetchPending = false;
static void _wxTask(void*) {
  for (;;) {
    if (wxFetchPending) {
      wxFetchPending = false;
      if (_netMutex) xSemaphoreTake(_netMutex, portMAX_DELAY);
      fetchClockWeather();
      if (_netMutex) xSemaphoreGive(_netMutex);
      Serial.printf("[Mem] wx_fetch stack: reserved=%u unused-floor=%u (peak usage so far ~%d)\n",
                    (unsigned)WX_TASK_STACK_BYTES, (unsigned)uxTaskGetStackHighWaterMark(wxTaskHandle),
                    (int)WX_TASK_STACK_BYTES - (int)uxTaskGetStackHighWaterMark(wxTaskHandle));
      wxFetchRunning = false;
    }
    vTaskDelay(pdMS_TO_TICKS(250));
  }
}
static void triggerWxFetch() {
  static bool wxTaskCreated = false;
  if (!wxTaskCreated) {
    if (!wxTaskStack) wxTaskStack = (StackType_t*)ps_malloc(WX_TASK_STACK_BYTES);
    if (wxTaskStack) {
      wxTaskHandle = xTaskCreateStaticPinnedToCore(_wxTask, "wx_fetch", WX_TASK_STACK_BYTES, NULL, 1, wxTaskStack, &wxTaskTCB, 1);
      Serial.println("[Mem] wx_fetch stack allocated in PSRAM (4KB kept out of SRAM)");
    } else {
      Serial.println("[Mem] wx_fetch PSRAM stack alloc failed — falling back to internal");
      xTaskCreatePinnedToCore(_wxTask, "wx_fetch", WX_TASK_STACK_BYTES, NULL, 1, &wxTaskHandle, 1);
    }
    wxTaskCreated = true;
  }
  if (wxFetchRunning) return;
  wxFetchRunning = true;
  wxFetchPending = true;
}

static const char* weatherCodeText(int code) {
  if (code == 0)                 return TR(UISTR_WX_CLEAR);
  if (code >= 1  && code <= 3)   return TR(UISTR_WX_CLOUDY);
  if (code == 45 || code == 48)  return TR(UISTR_WX_FOG);
  if (code >= 51 && code <= 57)  return TR(UISTR_WX_DRIZZLE);
  if (code >= 61 && code <= 67)  return TR(UISTR_WX_RAIN_C);
  if (code >= 71 && code <= 77)  return TR(UISTR_WX_SNOW);
  if (code >= 80 && code <= 82)  return TR(UISTR_WX_SHOWERS);
  if (code >= 85 && code <= 86)  return TR(UISTR_WX_SNOW_SHOWERS);
  if (code >= 95 && code <= 99)  return TR(UISTR_WX_THUNDER);
  return "";
}

static String wxSlotFullText(int dp, const struct tm& timeinfo) {
  switch (dp) {
    case WX_TEMP: {
      if (clockTempC == -999) return "";
      String s = String(clockTempC) + "\xF8" "C";
      if (clockFeelsC != -999) s += " (" + String(clockFeelsC) + "\xF8" "C)";
      return s;
    }
    case WX_CONDITION: {
      const char* wx = weatherCodeText(clockWeatherCode);
      return wx[0] ? String(wx) : "";
    }
    case WX_HUMIDITY:
      return (clockHumidity == -999) ? "" : (String(TR(UISTR_WX_HUMIDITY)) + String(clockHumidity) + "%");
    case WX_WIND:
      return (clockWindSpeed < -998.0f) ? "" : (String((int)round(clockWindSpeed)) + " km/h");
    case WX_PRESSURE:
      return (clockPressure < -998.0f) ? "" : (String((int)round(clockPressure)) + " hPa");
    case WX_RAIN:
      return (clockRainPct < 0) ? "" : (String(TR(UISTR_WX_RAIN)) + String(clockRainPct) + "%");
    case WX_TEMP_MINMAX:
      if (clockTempMin == -999 || clockTempMax == -999) return "";
      return String(TR(UISTR_WX_LOW)) + String(clockTempMin) + "\xF8 / " + TR(UISTR_WX_HIGH) + String(clockTempMax) + "\xF8" "C";
    case WX_SUN: {
      if (_wxStrMutex) xSemaphoreTake(_wxStrMutex, portMAX_DELAY);
      String sr = clockSunrise, ss = clockSunset;
      if (_wxStrMutex) xSemaphoreGive(_wxStrMutex);
      if (sr.length() == 0 || ss.length() == 0) return "";
      int nowMin = timeinfo.tm_hour * 60 + timeinfo.tm_min;
      int srMin = sr.substring(0,2).toInt() * 60 + sr.substring(3,5).toInt();
      int ssMin = ss.substring(0,2).toInt() * 60 + ss.substring(3,5).toInt();
      bool nextIsSunrise = (nowMin < srMin) || (nowMin >= ssMin);
      return String(nextIsSunrise ? TR(UISTR_WX_RISE) : TR(UISTR_WX_SET)) + (nextIsSunrise ? sr : ss);
    }
    default: return "";
  }
}

