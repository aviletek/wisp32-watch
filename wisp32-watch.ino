  int availIdx[TRANSLATOR_LANG_COUNT];
  int availCount = 0;
  for (size_t i = 0; i < TRANSLATOR_LANG_COUNT; i++) if (!included[i]) availIdx[availCount++] = (int)i;
  for (int i = 1; i < availCount; i++) {
    int key = availIdx[i];
    int j = i - 1;
    while (j >= 0 && naturalCompareCI(TRANSLATOR_LANGS[availIdx[j]].name, TRANSLATOR_LANGS[key].name) > 0) {
      availIdx[j + 1] = availIdx[j];
