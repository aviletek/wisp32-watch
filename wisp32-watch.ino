static int aiNextAvailableModelIndex(int index, String* models, int count, bool hasNone, bool isWebSearch) {
  int total = count + (hasNone ? 1 : 0);
  if (total <= 0) return index;
  for (int step = 1; step <= total; step++) {
    int cand = (index + step) % total;
    int slot = hasNone ? cand - 1 : cand;
    if (slot < 0) return cand;
    if (aiProviderHasKeyFor(models[slot], isWebSearch)) return cand;
  }
  return index;
}

static bool wifiTryDirectConnect() {
  if (wifiLastSsid[0] == 0) return false;
  for (int i = 0; i < activeWifiNetworkCount; i++) {
    if (activeWifiNetworks[i].ssid == wifiLastSsid) {
      if (_netMutex) xSemaphoreTake(_netMutex, portMAX_DELAY);
      WiFi.mode(WIFI_STA);
      if (wifiLastChannel != 0) {
        WiFi.begin(activeWifiNetworks[i].ssid.c_str(), activeWifiNetworks[i].pass.c_str(), wifiLastChannel, wifiLastBssid);
      } else {
        WiFi.begin(activeWifiNetworks[i].ssid.c_str(), activeWifiNetworks[i].pass.c_str());
      }
      if (_netMutex) xSemaphoreGive(_netMutex);
      return true;
    }
  }
  return false;
}

static void wifiRememberSsid() {
  WiFi.SSID().toCharArray(wifiLastSsid, sizeof(wifiLastSsid));
  wifiLastChannel = WiFi.channel();
  memcpy(wifiLastBssid, WiFi.BSSID(), 6);
}

