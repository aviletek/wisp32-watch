String aiToolWebSearchGoogle(String query, const String& model) {
  String payload;
  payload.reserve(query.length() + model.length() + 250);
  payload = "{\"model\":\"" + model + "\",\"input\":\"";
  jsonEscapeAppendTo(payload, query);
  payload += "\",\"tools\":[{\"type\":\"google_search\"}]";
  if (AI_MAX_OUT_TOKENS_VALUES[aiMaxOutTokensIndex] > 0) {
    payload += ",\"generation_config\":{\"max_output_tokens\":";
    payload += String(AI_MAX_OUT_TOKENS_VALUES[aiMaxOutTokensIndex]);
    payload += "}";
  }
  payload += "}";

  HTTPClient http;
  http.begin("https://generativelanguage.googleapis.com/v1beta/interactions?key=" + activeGeminiKey);
  http.setTimeout(20000);
  http.addHeader("Content-Type", "application/json");
  int code = http.POST(payload);
  taskRebootOnHttpDashOne(code);
  if (code != 200) {
    String errBody = http.getString();
    http.end();
    Serial.print("[AI] web_search (google) failed, HTTP "); Serial.print(code);
    Serial.print(", body: "); Serial.println(errBody.substring(0, 500));
    return "Search failed: HTTP " + String(code);
  }
  String rb = http.getString();
  http.end();
  BasicJsonDocument<PsramJsonAllocator> res(16384);
  if (deserializeJson(res, rb) != DeserializationError::Ok) return "Search failed: bad response";

  String answer = "";
  for (JsonObject step : res["steps"].as<JsonArray>()) {
    if (strcmp(step["type"] | "", "model_output") == 0) {
      for (JsonObject c : step["content"].as<JsonArray>()) {
        if (strcmp(c["type"] | "", "text") == 0) {
          answer = String((const char*)(c["text"] | ""));
          break;
        }
      }
      if (answer.length() > 0) break;
    }
  }
  int wsgInTok = res["usage"]["total_input_tokens"] | 0;
  int wsgOutTok = res["usage"]["total_output_tokens"] | 0;
  int wsgTotalTok = res["usage"]["total_tokens"] | 0;
  Serial.printf("[AI] web_search (google): tokens input=%d output=%d total=%d\n",
                wsgInTok, wsgOutTok, wsgTotalTok);
  logTokenUsage("websearch", "", "gemini", model,
                AI_MAX_OUT_TOKENS_VALUES[aiMaxOutTokensIndex] > 0 ? AI_MAX_OUT_TOKENS_VALUES[aiMaxOutTokensIndex] : -1,
                wsgInTok, wsgOutTok, -1, -1, -1, -1, -1, -1, -1, wsgTotalTok, -1, -1);
  return answer.length() > 0 ? answer : "No result";
}

