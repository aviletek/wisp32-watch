static String fileListToHtml(const String& csvList) {
  if (csvList.length() == 0) return "<span style='color:#666'>(none)</span>";
  String out = "<ul style='margin:6px 0 0;padding-left:20px;font-size:.82em;color:#ccc'>";
  int start = 0;
  while (start <= (int)csvList.length()) {
    int comma = csvList.indexOf(", ", start);
    String item = (comma < 0) ? csvList.substring(start) : csvList.substring(start, comma);
    if (item.length() > 0) out += "<li>" + escapeHtmlAttr(item) + "</li>";
    if (comma < 0) break;
    start = comma + 2;
  }
  out += "</ul>";
  return out;
}

void handleActivateEncryption() {
  if (!requireAuth()) return;
  if (!sdMounted) { server.send(503, "text/html; charset=utf-8", "<span style='color:#f66'>SD not mounted.</span>"); return; }
  if (sdEncryptionActive) { server.send(400, "text/html; charset=utf-8", "<span style='color:#f66'>Encryption is already active — remove it first before activating again.</span>"); return; }

  String password = server.hasArg("password") ? server.arg("password") : "";
  bool firstTime = server.hasArg("firstTime") && server.arg("firstTime") == "1";

  if (!passwordMeetsStrength(password)) {
    server.send(400, "text/html; charset=utf-8", "<span style='color:#f66'>Password doesn't meet the strength requirements.</span>");
    return;
  }

  if (firstTime) {
    int ok = 0, failed = 0; String okList, failedList;
    bool ranOk = activateEncryptionFirstTime(password, &ok, &failed, &okList, &failedList);
    if (!ranOk && failed == 0) {
      server.send(200, "text/html; charset=utf-8", "<span style='color:#f66'>Failed — couldn't read this SD card's hardware ID. Nothing was changed.</span>");
      return;
    }
    if (!ranOk) {
      String msg = "<span style='color:#f66'><strong>Activation FAILED</strong> — " + String(failed) + " file(s) could not be "
        "encrypted: " + failedList + "</span><br>Nothing on this card is encrypted — every file that had already been "
        "converted was automatically reverted back to plain text, so the card is exactly as it was before you clicked "
        "Activate.";
      server.send(200, "text/html; charset=utf-8", msg);
      return;
    }
    String msg = "<span style='color:#4c4'><strong>Encryption activated</strong></span> — all " + String(ok) + " file(s) on "
      "this card are now encrypted:" + fileListToHtml(okList);
    server.send(200, "text/html; charset=utf-8", msg);
  } else {
    if (!activateEncryptionReactivate(password)) {
      server.send(200, "text/html; charset=utf-8", "<span style='color:#f66'>Failed — couldn't read this SD card's hardware ID.</span>");
      return;
    }
    server.send(200, "text/html; charset=utf-8", "<span style='color:#4c4'><strong>Encryption activated.</strong></span> If the password matches what was used before, everything should read normally now.");
  }
}

void handleRemoveEncryption() {
  if (!requireAuth()) return;
  if (!sdMounted) { server.send(503, "text/html; charset=utf-8", "<span style='color:#f66'>SD not mounted.</span>"); return; }
  if (!sdEncryptionActive) { server.send(400, "text/html; charset=utf-8", "<span style='color:#f66'>Encryption isn't active.</span>"); return; }

  String password = server.hasArg("password") ? server.arg("password") : "";
  if (password.length() == 0) {
    server.send(400, "text/html; charset=utf-8", "<span style='color:#f66'>Enter the encryption password to confirm.</span>");
    return;
  }

  int ok = 0, failed = 0; String okList, failedList, blockedReason;
  bool ranOk = removeEncryption(password, &ok, &failed, &okList, &failedList, &blockedReason);
  if (!ranOk && blockedReason.length() > 0) {
    server.send(200, "text/html; charset=utf-8", "<span style='color:#f66'><strong>Remove blocked</strong> — " + blockedReason + "</span>");
    return;
  }
  if (!ranOk) {
    String msg = "<span style='color:#f66'><strong>Remove FAILED</strong> — " + String(failed) + " file(s) could not be "
      "decrypted: " + failedList + "</span><br>Encryption is still fully active — every file that had already been "
      "decrypted was automatically re-encrypted, so the card is exactly as it was before you clicked Remove.";
    server.send(200, "text/html; charset=utf-8", msg);
    return;
  }
  String msg = "<span style='color:#4c4'><strong>Encryption removed</strong></span> — all " + String(ok) + " file(s) are "
    "now plain text:" + fileListToHtml(okList);
  server.send(200, "text/html; charset=utf-8", msg);
}

void handleCardIdInfo() {
  if (!requireAuth()) return;
  int32_t cid = 0;
  bool ok = sdMounted && readSdCardSerial(&cid);
  char le[9] = "";
  if (ok) snprintf(le, sizeof(le), "%02x%02x%02x%02x",
                   (unsigned)((uint32_t)cid & 0xFF), (unsigned)(((uint32_t)cid >> 8) & 0xFF),
                   (unsigned)(((uint32_t)cid >> 16) & 0xFF), (unsigned)(((uint32_t)cid >> 24) & 0xFF));
  String j = "{\"ok\":";   j += ok ? "true" : "false";
  j += ",\"mounted\":";    j += sdMounted ? "true" : "false";
  j += ",\"encActive\":";  j += sdEncryptionActive ? "true" : "false";
  j += ",\"le\":\"";      j += le; j += "\"";
  j += "}";
  server.send(200, "application/json", j);
}

static bool testProviderKeyLive(const String& provider, const String& key, int* codeOut) {
  int code = -1;
  if (provider == "openai") {
    HTTPClient http;
    http.begin("https://api.openai.com/v1/models");
    http.setTimeout(15000);
    http.addHeader("Authorization", "Bearer " + key);
    code = http.GET();
    http.end();
  } else if (provider == "gemini") {
    HTTPClient http;
    http.begin("https://generativelanguage.googleapis.com/v1beta/models/" AI_FILEQA_MODEL_DEFAULT ":generateContent?key=" + key);
    http.setTimeout(15000);
    http.addHeader("Content-Type", "application/json");
    String payload = "{\"contents\":[{\"parts\":[{\"text\":\"Hi\"}]}],\"generationConfig\":{\"maxOutputTokens\":1}}";
    code = http.POST(payload);
    http.end();
  }
  if (codeOut) *codeOut = code;
  return code == 200;
}

void handleCredentialsKeyTest() {
  if (!requireAuth()) return;
  String provider = server.hasArg("provider") ? server.arg("provider") : "";
  String key = server.hasArg("key") ? server.arg("key") : "";
  key.trim();
  if (key.length() == 0) { server.send(200, "application/json", "{\"ok\":false,\"error\":\"No key given\"}"); return; }
  if (provider != "openai" && provider != "gemini") {
    server.send(200, "application/json", "{\"ok\":false,\"error\":\"Unknown provider\"}"); return;
  }

  if (_netMutex) xSemaphoreTake(_netMutex, portMAX_DELAY);
  int code = -1;
  bool ok = testProviderKeyLive(provider, key, &code);
  if (_netMutex) xSemaphoreGive(_netMutex);

  Serial.printf("[Web] credentials key test: provider=%s code=%d\n", provider.c_str(), code);
  String err = ok ? "" : ("HTTP " + String(code));
  server.send(200, "application/json", String("{\"ok\":") + (ok ? "true" : "false") + ",\"error\":\"" + jsonEscape(err) + "\"}");
}

void handleSaveCredentials() {
  if (!requireAuth()) return;
  activeOpenAiKey = "";
  String newGemini     = server.hasArg("geminiKey")     ? server.arg("geminiKey")     : "";
  String newWebPass    = server.hasArg("webPassword")   ? server.arg("webPassword")   : "";
  String newDeviceLockPin = server.hasArg("deviceLockPin") ? server.arg("deviceLockPin") : "";
  String newDeviceName = sanitizeDeviceName(server.hasArg("deviceName") ? server.arg("deviceName") : "");
  if (newDeviceName.length() == 0) newDeviceName = defaultDeviceName();
  bool deviceNameChanged = (newDeviceName != deviceName);
  String newNotifyEmail    = server.hasArg("notifyEmail")       ? server.arg("notifyEmail")       : "";
  String newNotifyAppPass  = server.hasArg("notifyAppPassword") ? server.arg("notifyAppPassword") : "";
  String newNotifySmtpHost = server.hasArg("notifySmtpHost")    ? server.arg("notifySmtpHost")    : "smtp.gmail.com";
  int newNotifySmtpPort    = server.hasArg("notifySmtpPort")    ? server.arg("notifySmtpPort").toInt() : 465;
  String newEmailDefaultSubject = server.hasArg("emailDefaultSubject") ? server.arg("emailDefaultSubject") : "";
  String newEmailSignature      = server.hasArg("emailSignature")      ? server.arg("emailSignature")      : "";
  newGemini.trim(); newWebPass.trim(); newDeviceLockPin.trim();
  newNotifyEmail.trim(); newNotifyAppPass.trim(); newNotifySmtpHost.trim(); newEmailDefaultSubject.trim(); newEmailSignature.trim();
  if (newNotifySmtpHost.length() == 0) newNotifySmtpHost = "smtp.gmail.com";
  if (newNotifySmtpPort <= 0) newNotifySmtpPort = 465;
  if (newEmailDefaultSubject.length() == 0) newEmailDefaultSubject = "Message from your badge";
  String rejectedKeys = "";
  if (newGemini.length() == 0) {
    activeGeminiKey = "";
  } else if (newGemini != activeGeminiKey) {
    int code;
    if (_netMutex) xSemaphoreTake(_netMutex, portMAX_DELAY);
    bool ok = testProviderKeyLive("gemini", newGemini, &code);
    if (_netMutex) xSemaphoreGive(_netMutex);
    activeGeminiKey = ok ? newGemini : "";
    if (!ok) {
      rejectedKeys += String("Gemini");
      Serial.printf("[Credentials] Gemini key failed validation on save (HTTP %d) — erased\n", code);
    }
  }
  activeWebPassword   = newWebPass;
  bool pinAllDigits = newDeviceLockPin.length() > 0;
  for (size_t i = 0; i < newDeviceLockPin.length(); i++) {
    if (!isDigit(newDeviceLockPin[i])) { pinAllDigits = false; break; }
  }
  activeDeviceLockPin = (pinAllDigits && newDeviceLockPin.length() >= 4 && newDeviceLockPin.length() <= 6)
                          ? newDeviceLockPin : "";
  Serial.printf("[DeviceLock] PIN save: received %u chars, allDigits=%d -> stored length=%u\n",
                (unsigned)newDeviceLockPin.length(), (int)pinAllDigits, (unsigned)activeDeviceLockPin.length());
  activeNotifyEmail       = newNotifyEmail;
  activeNotifyAppPassword = newNotifyAppPass;
  activeNotifySmtpHost    = newNotifySmtpHost;
  activeNotifySmtpPort    = newNotifySmtpPort;
  activeEmailDefaultSubject = newEmailDefaultSubject;
  activeEmailSignature      = newEmailSignature;
  MODEL_GPT.api_key   = activeOpenAiKey;

  WifiCred newNetworks[MAX_WIFI_NETWORKS];
  int newCount = 0;
  String pendingSsid = "";
  bool havePendingSsid = false;
  auto commitNetwork = [&](const String& rawSsid, const String& pass) {
    if (newCount >= MAX_WIFI_NETWORKS) return;
    String s = rawSsid; s.trim();
    if (s.length() == 0) return;
    newNetworks[newCount].ssid = s;
    newNetworks[newCount].pass = pass;
    newCount++;
  };
  for (int i = 0; i < server.args(); i++) {
    String an = server.argName(i);
    if (an == "wifiSsid") {
      if (havePendingSsid) commitNetwork(pendingSsid, "");
      pendingSsid = server.arg(i);
      havePendingSsid = true;
    } else if (an == "wifiPass" && havePendingSsid) {
      commitNetwork(pendingSsid, server.arg(i));
      havePendingSsid = false;
    }
  }
  if (havePendingSsid) commitNetwork(pendingSsid, "");

  bool wifiChanged = (newCount != activeWifiNetworkCount);
  if (!wifiChanged) {
    for (int i = 0; i < newCount; i++) {
      if (newNetworks[i].ssid != activeWifiNetworks[i].ssid || newNetworks[i].pass != activeWifiNetworks[i].pass) {
        wifiChanged = true; break;
      }
    }
  }
  if (activeWifiNetworks) {
    activeWifiNetworkCount = newCount;
    for (int i = 0; i < newCount; i++) activeWifiNetworks[i] = newNetworks[i];
  }

  String contactNames[MAX_CONTACTS], contactEmails[MAX_CONTACTS];
  int contactNameCount = 0, contactEmailCount = 0;
  for (int i = 0; i < server.args(); i++) {
    if (server.argName(i) == "contactName" && contactNameCount < MAX_CONTACTS) contactNames[contactNameCount++] = server.arg(i);
    else if (server.argName(i) == "contactEmail" && contactEmailCount < MAX_CONTACTS) contactEmails[contactEmailCount++] = server.arg(i);
  }
  activeContactCount = 0;
  for (int i = 0; i < contactNameCount && activeContacts && activeContactCount < MAX_CONTACTS; i++) {
    String n = contactNames[i]; n.trim();
    String e = (i < contactEmailCount) ? contactEmails[i] : "";
    e.trim();
    if (n.length() == 0 || e.length() == 0) continue;
    activeContacts[activeContactCount].name = n;
    activeContacts[activeContactCount].email = e;
    activeContactCount++;
  }
  saveContacts();

  saveCredentials();

  if (deviceNameChanged) {
    deviceName = newDeviceName;
    saveSettings();
  }

  if (wifiChanged || deviceNameChanged) {
    String why = (wifiChanged && deviceNameChanged) ? "WiFi and Device Name changes"
               : wifiChanged ? "WiFi changes" : "the Device Name change";
    String rejectedNote = rejectedKeys.length() > 0
      ? ("<p style='color:#f66'>" + rejectedKeys + " key failed validation and was erased.</p>") : "";
    server.send(200, "text/html; charset=utf-8",
      "<!DOCTYPE html><html><head><meta charset='UTF-8'>"
      "<meta http-equiv='refresh' content='6;url=/'>"
      "<style>body{font-family:sans-serif;background:#111;color:#eee;text-align:center;padding-top:80px}"
      "h2{color:#4af}p{color:#888;font-size:.9em}</style></head><body>"
      "<h2>Saved — restarting to apply " + why + "&hellip;</h2>"
      "<p>The device is rebooting. This page will reload in 6 seconds.</p>"
      + rejectedNote +
      "</body></html>");
    delay(200);
    ESP.restart();
  } else {
    redirectWithSaveMessage("/credentials",
      rejectedKeys.length() > 0 ? ("Saved (" + rejectedKeys + " key failed validation and was erased)") : "Saved",
      rejectedKeys.length() == 0);
  }
}

