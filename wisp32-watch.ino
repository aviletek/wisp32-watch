void onAiEvent(WebsocketsEvent event, String data) {
  if (event == WebsocketsEvent::ConnectionOpened) {
    Serial.println("[AI] WebSocket connected");
  } else if (event == WebsocketsEvent::GotPing) {
    Serial.println("[AI] got keepalive ping, ponged");
    aiClient.pong(data);
  } else if (event == WebsocketsEvent::ConnectionClosed) {
    Serial.print("[AI] WebSocket closed, reason code=");
    Serial.println((int)aiClient.getCloseReason());
    String closeReasonText = "";
    if (data.length() > 2) {
      closeReasonText = data.substring(2);
      Serial.print("[AI] close reason text: ");
      Serial.println(closeReasonText);
    }
    Serial.print("[AI] WiFi RSSI at close: ");
    Serial.println(WiFi.status() == WL_CONNECTED ? String(WiFi.RSSI()) : "not connected");
    aiSessionReady = false;
    if ((aiPageOpen || translatorPageOpen) && aiState != AI_ERROR) {
      aiErrorMsg = "Session closed by server";
      aiErrorDetail = aiShortReason(closeReasonText);
      aiState = AI_ERROR;
      drawAiOrTranslatorPage();
    }
  }
}

static bool aiResampleHavePrev = false;
static int16_t aiResamplePrevTail = 0;
static double aiResamplePos = 0.0;

static const float AI_LPF_ALPHA = 0.79f;
static float aiLpfState1 = 0.0f;
static float aiLpfState2 = 0.0f;

void resetAiPlaybackResampler() {
  aiResampleHavePrev = false;
  aiResamplePos = 0.0;
  aiLpfState1 = 0.0f;
  aiLpfState2 = 0.0f;
}

void aiPlayRingReset() {
  aiPlayHead = 0;
  aiPlayTail = 0;
  aiPlayPrimed = false;
}

void aiPlayRingWrite(const uint8_t* data, size_t len) {
  if (!aiPlayRing) return;
  len -= len % 4;
  if (len == 0) return;

  size_t free = aiPlayFreeBytes();
  if (len > free) len = free - (free % 4);
  if (len == 0) return;

  size_t h = aiPlayHead;
  size_t firstPart = aiPlayRingCap - h;
  if (firstPart > len) firstPart = len;
  memcpy(aiPlayRing + h, data, firstPart);
  size_t remaining = len - firstPart;
  if (remaining > 0) memcpy(aiPlayRing, data + firstPart, remaining);
  aiPlayHead = (h + len) % aiPlayRingCap;
}

void aiPlaybackTaskFn(void* pv) {
  static size_t totalWritten = 0;
  for (;;) {
    if (!aiPlayActive || !aiPlayRing) {
      vTaskDelay(pdMS_TO_TICKS(20));
      continue;
    }
    size_t used = aiPlayUsedBytes();
    if (used == 0) {
      if (aiPlayPrimed) {
        Serial.print("[AI] playback drained, total bytes written to i2s this turn=");
        Serial.println(totalWritten);
        if (aiState == AI_SPEAKING) {
          aiUnderrunCountThisTurn++;
        }
      }
      totalWritten = 0;
      aiPlayPrimed = false;
      vTaskDelay(pdMS_TO_TICKS(5));
      continue;
    }
    if (!aiPlayPrimed) {
      size_t primeThreshold = aiActiveProviderIsGemini
                                ? (size_t)AI_VOICE_BUFFER_VALUES[aiVoiceBufferEffectiveIndex()]
                                : AI_PLAY_PRIME_BYTES_OPENAI;
      if (aiPlayRingCap > 0 && primeThreshold > aiPlayRingCap / 2) primeThreshold = aiPlayRingCap / 2;
      if (used < primeThreshold && aiState == AI_SPEAKING) {
        vTaskDelay(pdMS_TO_TICKS(10));
        continue;
      }
      aiPlayPrimed = true;
      totalWritten = 0;
      Serial.print("[AI] playback starting, buffered bytes=");
      Serial.println(used);
    }
    const size_t maxChunk = 512;
    size_t chunk = used < maxChunk ? used : maxChunk;
    size_t t = aiPlayTail;
    size_t firstPart = aiPlayRingCap - t;
    if (firstPart > chunk) firstPart = chunk;
    unsigned long _i2sT0 = micros();
    size_t w1 = i2s.write((const uint8_t*)(aiPlayRing + t), firstPart);
    if (w1 != firstPart) {
    }
    totalWritten += w1;
    t = (t + firstPart) % aiPlayRingCap;
    size_t remaining = chunk - firstPart;
    if (remaining > 0) {
      size_t w2 = i2s.write((const uint8_t*)(aiPlayRing + t), remaining);
      if (w2 != remaining) {
      }
      totalWritten += w2;
      t = (t + remaining) % aiPlayRingCap;
    }
    aiPlayTail = t;
    unsigned long _i2sUs = micros() - _i2sT0;
    if (_i2sUs > aiI2sWriteMaxUs) {
      aiI2sWriteMaxUs = _i2sUs;
    }
  }
}

#define AI_DECODE_CAP_BYTES (64UL * 1024UL)
#define AI_RESAMPLE_MAX_OUT_SAMPLES (AI_DECODE_CAP_BYTES / 2 * 2 / 3 + 4)
static uint8_t* aiDecodeBuf = nullptr;
static int16_t* aiResampleOutBuf = nullptr;

bool aiEnsureDeltaBuffers() {
  if (aiDecodeBuf && aiResampleOutBuf) return true;
  if (!aiDecodeBuf) aiDecodeBuf = (uint8_t*)ps_malloc(AI_DECODE_CAP_BYTES);
  if (!aiResampleOutBuf) aiResampleOutBuf = (int16_t*)ps_malloc(AI_RESAMPLE_MAX_OUT_SAMPLES * 2 * sizeof(int16_t));
  if (!aiDecodeBuf || !aiResampleOutBuf) {
    Serial.println("[AI] delta decode/resample buffer alloc FAILED");
    return false;
  }
  return true;
}

#define AI_DELTA_POOL_SIZE 43
#define AI_DELTA_MAX_B64_LEN 65536UL
#define AI_DELTA_RESET_SENTINEL (-1)
static char* aiDeltaPool[AI_DELTA_POOL_SIZE] = { nullptr };
static volatile bool aiDeltaSlotBusy[AI_DELTA_POOL_SIZE] = { false };
static QueueHandle_t aiDeltaQueue = nullptr;
static volatile bool aiDeltaTaskActive = false;
static TaskHandle_t aiDeltaTaskHandle = nullptr;
static volatile int aiDeltaSlotsBusyNow = 0;
static volatile uint32_t aiDeltaPoolPeakUsedThisTurn = 0;
static volatile uint32_t aiDeltaDroppedThisTurn = 0;

#define AI_DELTA_POOL_SIZE_RECORDING 22

static int aiDeltaPoolActiveSize = AI_DELTA_POOL_SIZE;

bool aiEnsureDeltaQueue() {
  if (aiDeltaQueue) return true;
  if (scrRecActive || scrRecTaskHandle) {
    aiDeltaPoolActiveSize = AI_DELTA_POOL_SIZE_RECORDING;
    Serial.printf("[AI] delta pool: screen recording already active, using %d slots instead of %d\n",
                  aiDeltaPoolActiveSize, AI_DELTA_POOL_SIZE);
  }
  for (int i = 0; i < aiDeltaPoolActiveSize; i++) {
    if (!aiDeltaPool[i]) aiDeltaPool[i] = (char*)ps_malloc(AI_DELTA_MAX_B64_LEN);
    if (!aiDeltaPool[i]) { Serial.println("[AI] delta pool alloc FAILED"); return false; }
    if ((i & 7) == 7) vTaskDelay(1);
  }
  aiDeltaQueue = xQueueCreate(AI_DELTA_POOL_SIZE + 2, sizeof(int));
  if (!aiDeltaQueue) { Serial.println("[AI] delta queue create FAILED"); return false; }
  return true;
}

void aiDrainDeltaQueue() {
  if (!aiDeltaQueue) return;
  int idx;
  while (xQueueReceive(aiDeltaQueue, &idx, 0) == pdTRUE) {
    if (idx >= 0 && idx < AI_DELTA_POOL_SIZE) {
      if (aiDeltaSlotBusy[idx]) aiDeltaSlotsBusyNow--;
      aiDeltaSlotBusy[idx] = false;
    }
  }
}

void aiEnqueueDeltaReset() {
  if (!aiEnsureDeltaQueue()) { resetAiPlaybackResampler(); return; }
  int sentinel = AI_DELTA_RESET_SENTINEL;
  xQueueSend(aiDeltaQueue, &sentinel, 0);
}

void aiEnqueueDelta(const char* b64) {
  if (!aiEnsureDeltaQueue()) return;
  size_t len = strlen(b64);
  if (len == 0) return;
  if (len >= AI_DELTA_MAX_B64_LEN) {
    Serial.printf("[AI] delta too large for pool slot, dropped (len=%u, limit=%lu)\n", (unsigned)len, AI_DELTA_MAX_B64_LEN);
    if (!aiActiveProviderIsGemini) wispTrace("AI delta DROPPED oversized len=" + String((unsigned)len));
    aiDeltaDroppedThisTurn++;
    return;
  }
  int slot = -1;
  for (int i = 0; i < aiDeltaPoolActiveSize; i++) {
    if (!aiDeltaSlotBusy[i]) { slot = i; break; }
  }
  if (slot < 0) {
    Serial.println("[AI] delta pool full, dropping audio chunk");
    if (!aiActiveProviderIsGemini) wispTrace("AI delta DROPPED pool full");
    aiDeltaDroppedThisTurn++;
    return;
  }
  memcpy(aiDeltaPool[slot], b64, len + 1);
  aiDeltaSlotBusy[slot] = true;
  if (++aiDeltaSlotsBusyNow > (int)aiDeltaPoolPeakUsedThisTurn) aiDeltaPoolPeakUsedThisTurn = (uint32_t)aiDeltaSlotsBusyNow;
  if (xQueueSend(aiDeltaQueue, &slot, 0) != pdTRUE) {
    aiDeltaSlotBusy[slot] = false;
    aiDeltaSlotsBusyNow--;
    Serial.println("[AI] delta queue send failed, dropping audio chunk");
    if (!aiActiveProviderIsGemini) wispTrace("AI delta DROPPED queue send failed");
    aiDeltaDroppedThisTurn++;
  }
}

static volatile unsigned long aiLastDecodeUs = 0;
static volatile unsigned long aiLastResampleUs = 0;
static volatile unsigned long aiLastRingWriteUs = 0;
static volatile unsigned long aiLastRecCopyUs = 0;
static volatile unsigned long aiSlowDeltaDecodeUs = 0;
static volatile unsigned long aiSlowDeltaResampleUs = 0;
static volatile unsigned long aiSlowDeltaRingWriteUs = 0;
static volatile unsigned long aiSlowDeltaRecCopyUs = 0;

void aiDeltaTaskFn(void* pv) {
  for (;;) {
    if (!aiDeltaTaskActive) {
      vTaskDelay(pdMS_TO_TICKS(10));
      continue;
    }
    int idx;
    if (xQueueReceive(aiDeltaQueue, &idx, pdMS_TO_TICKS(20)) != pdTRUE) continue;
    UBaseType_t backlog = uxQueueMessagesWaiting(aiDeltaQueue);
    if (backlog >= 4) {
      Serial.printf("[AI DIAG] delta task woke up to %u item(s) already queued behind this one\n", (unsigned)backlog);
    }
    if (backlog > aiDeltaBacklogMax) {
      aiDeltaBacklogMax = backlog;
    }
    if (idx == AI_DELTA_RESET_SENTINEL) {
      resetAiPlaybackResampler();
      continue;
    }
    if (idx < 0 || idx >= AI_DELTA_POOL_SIZE) continue;
    unsigned long procStartUs = micros();
    playAiAudioDeltaB64(aiDeltaPool[idx]);
    unsigned long procUs = micros() - procStartUs;
    if (procUs > 3000) {
      Serial.printf("[AI DIAG] playAiAudioDeltaB64() took %luus\n", procUs);
    }
    if (procUs > aiDeltaProcUsMax) {
      aiDeltaProcUsMax = procUs;
      aiSlowDeltaDecodeUs = aiLastDecodeUs;
      aiSlowDeltaResampleUs = aiLastResampleUs;
      aiSlowDeltaRingWriteUs = aiLastRingWriteUs;
      aiSlowDeltaRecCopyUs = aiLastRecCopyUs;
    }
    if (aiDeltaSlotBusy[idx]) aiDeltaSlotsBusyNow--;
    aiDeltaSlotBusy[idx] = false;
  }
}

void aiResampleChunk24to16(int16_t* samples24, size_t n24, int16_t* outBuf, size_t* outCount, size_t outCap) {
  if (n24 == 0) return;

  for (size_t i = 0; i < n24; i++) {
    aiLpfState1 += AI_LPF_ALPHA * ((float)samples24[i] - aiLpfState1);
    aiLpfState2 += AI_LPF_ALPHA * (aiLpfState1 - aiLpfState2);
    samples24[i] = (int16_t)aiLpfState2;
  }

  if (!aiResampleHavePrev) {
    aiResamplePrevTail = samples24[0];
    aiResampleHavePrev = true;
    aiResamplePos = 0.0;
  }

  size_t frameLen = n24 + 1;
  auto frameAt = [&](size_t i) -> int16_t {
    return i == 0 ? aiResamplePrevTail : samples24[i - 1];
  };

  while (true) {
    size_t i0 = (size_t)aiResamplePos;
    size_t i1 = i0 + 1;
    if (i1 >= frameLen) break;
    if (*outCount >= outCap) break;
    float frac = (float)(aiResamplePos - i0);
    int16_t s = (int16_t)((1.0f - frac) * frameAt(i0) + frac * frameAt(i1));
    outBuf[*outCount * 2] = s;
    outBuf[*outCount * 2 + 1] = s;
    (*outCount)++;
    aiResamplePos += 1.5;
  }

  aiResamplePrevTail = samples24[n24 - 1];
  aiResamplePos -= (double)(frameLen - 1);
}

File aiLogFile;
bool aiLogActive = false;
uint32_t aiLogBytesWritten = 0;

#define AILOG_CRYPT_CHUNK 4096
#define AILOG_PLAIN_BASE  CTRLOG_CANARY_LEN
static bool     aiLogEncrypted = false;
static uint8_t  aiLogNonce[CTRLOG_NONCE_LEN];
static bool     aiLogEncryptedOut = false;
static uint8_t  aiLogNonceOut[CTRLOG_NONCE_LEN];
static bool     noteBackupEncrypted = false;
static uint8_t  noteBackupNonce[CTRLOG_NONCE_LEN];
static uint8_t* aiLogCryptBuf = nullptr;

static size_t aiLogWriteMaybeEnc(File& f, bool enc, const uint8_t* nonce,
                                 size_t plainOffset, const uint8_t* data, size_t len) {
  if (!enc) return f.write(data, len);
  if (!aiLogCryptBuf) {
    aiLogCryptBuf = (uint8_t*)ps_malloc(AILOG_CRYPT_CHUNK);
    if (!aiLogCryptBuf) {
      Serial.println("[AILog] crypt buffer alloc FAILED — refusing to write plaintext audio");
      return 0;
    }
  }
  size_t done = 0;
  while (done < len) {
    size_t n = len - done;
    if (n > AILOG_CRYPT_CHUNK) n = AILOG_CRYPT_CHUNK;
    memcpy(aiLogCryptBuf, data + done, n);
    ctrCryptRange(activeAesKey, nonce, plainOffset + done, aiLogCryptBuf, n);
    size_t w = f.write(aiLogCryptBuf, n);
    done += w;
    if (w != n) break;
  }
  return done;
}

static bool aiLogBeginEncrypted(File& f, uint8_t* outNonce) {
  for (int i = 0; i < CTRLOG_NONCE_LEN; i++) outNonce[i] = esp_random() & 0xFF;
  if (f.write((const uint8_t*)CTRLOG_MAGIC, CTRLOG_MAGIC_LEN) != CTRLOG_MAGIC_LEN) return false;
  if (f.write(outNonce, CTRLOG_NONCE_LEN) != CTRLOG_NONCE_LEN) return false;
  uint8_t canary[CTRLOG_CANARY_LEN];
  memcpy(canary, CTRLOG_CANARY_PLAIN, CTRLOG_CANARY_LEN);
  ctrCryptRange(activeAesKey, outNonce, 0, canary, CTRLOG_CANARY_LEN);
  return f.write(canary, CTRLOG_CANARY_LEN) == CTRLOG_CANARY_LEN;
}
static bool aiLogOpenForRead(File& f, uint8_t* outNonce, size_t* outPlainSize) {
  if (!f) return false;
  size_t sz = f.size();
  if (sz < CTRLOG_HEADER_LEN) return false;
  size_t startPos = f.position();
  uint8_t magic[CTRLOG_MAGIC_LEN];
  if (f.read(magic, CTRLOG_MAGIC_LEN) != CTRLOG_MAGIC_LEN ||
      memcmp(magic, CTRLOG_MAGIC, CTRLOG_MAGIC_LEN) != 0) {
    f.seek(startPos);
    return false;
  }
  if (f.read(outNonce, CTRLOG_NONCE_LEN) != CTRLOG_NONCE_LEN) { f.seek(startPos); return false; }
  if (!sdEncryptionActive) { f.seek(startPos); return false; }
  f.seek(CTRLOG_HEADER_LEN);
  if (outPlainSize) *outPlainSize = sz - CTRLOG_HEADER_LEN;
  return true;
}

static inline void aiLogDecryptBlock(const uint8_t* nonce, size_t plainOffset, uint8_t* data, size_t len) {
  ctrCryptRange(activeAesKey, nonce, AILOG_PLAIN_BASE + plainOffset, data, len);
}
String aiLogFilePath = "";
String aiLogTranscriptAccum = "";
bool aiLogIsTranslator = false;
String aiLogDir = "";
bool aiLogTurnOpen = false;
bool aiLogSavingAudio = false;
File aiLogFileOut;
bool aiLogOutActive = false;
uint32_t aiLogBytesWrittenOut = 0;
String aiLogFilePathOut = "";

static void aiLogSessionStart() {
  if (saveHistoryMode != SAVE_TEXT_AUDIO && saveHistoryMode != SAVE_AUDIO_ONLY) return;
  if (aiLogActive) return;
  aiLogTranscriptAccum = "";
  aiLogIsTranslator = translatorPageOpen;
  aiLogOutActive = false;
  aiLogBytesWrittenOut = 0;
  aiLogTurnOpen = false;
  aiLogDir = translatorPageOpen ? "/files/Translator Audio" : "/files/AI Assistant Audio";
  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  if (!SD_MMC.exists(aiLogDir)) SD_MMC.mkdir(aiLogDir);
  if (_sdMutex) xSemaphoreGive(_sdMutex);

  if (aiLogIsTranslator) {
    aiLogActive = true;
    return;
  }

  if (!aiRecordUserInput) return;

  time_t now = time(NULL);
  struct tm lt; localtime_r(&now, &lt);
  char tsBuf[16]; strftime(tsBuf, sizeof(tsBuf), "%Y%m%d_%H%M%S", &lt);
  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  aiLogFilePath = aiLogDir + "/" + String(tsBuf) + ".wav";
  aiLogFile = SD_MMC.open(aiLogFilePath, FILE_WRITE);
  if (aiLogFile) {
    aiLogEncrypted = sdEncryptionActive && aiLogBeginEncrypted(aiLogFile, aiLogNonce);
    uint8_t hdr[44];
    noteBuildWavHeader(hdr, 0, AUDIO_SAMPLE_RATE, 1);
    aiLogWriteMaybeEnc(aiLogFile, aiLogEncrypted, aiLogNonce, AILOG_PLAIN_BASE, hdr, 44);
    aiLogBytesWritten = 0;
    aiLogActive = true;
  } else {
    Serial.println("[AILog] could not open session log file");
  }
  if (_sdMutex) xSemaphoreGive(_sdMutex);
}

static void aiLogTurnStart() {
  if (!aiLogActive || !aiLogIsTranslator || aiLogTurnOpen) return;
  time_t now = time(NULL);
  struct tm lt; localtime_r(&now, &lt);
  char tsBuf[16]; strftime(tsBuf, sizeof(tsBuf), "%Y%m%d_%H%M%S", &lt);
  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  aiLogFilePath = aiLogDir + "/" + String(tsBuf) + ".wav";
  aiLogFile = SD_MMC.open(aiLogFilePath, FILE_WRITE);
  bool ok = (bool)aiLogFile;
  if (ok) {
    aiLogEncrypted = sdEncryptionActive && aiLogBeginEncrypted(aiLogFile, aiLogNonce);
    uint8_t hdr[44];
    noteBuildWavHeader(hdr, 0, AUDIO_SAMPLE_RATE, 1);
    aiLogWriteMaybeEnc(aiLogFile, aiLogEncrypted, aiLogNonce, AILOG_PLAIN_BASE, hdr, 44);
    aiLogBytesWritten = 0;
  }
  aiLogFilePathOut = aiLogDir + "/" + String(tsBuf) + "_out.wav";
  aiLogFileOut = SD_MMC.open(aiLogFilePathOut, FILE_WRITE);
  aiLogOutActive = (bool)aiLogFileOut;
  if (aiLogOutActive) {
    aiLogEncryptedOut = sdEncryptionActive && aiLogBeginEncrypted(aiLogFileOut, aiLogNonceOut);
    uint8_t hdrOut[44];
    noteBuildWavHeader(hdrOut, 0, AUDIO_SAMPLE_RATE, 1);
    aiLogWriteMaybeEnc(aiLogFileOut, aiLogEncryptedOut, aiLogNonceOut, AILOG_PLAIN_BASE, hdrOut, 44);
    aiLogBytesWrittenOut = 0;
  }
  if (_sdMutex) xSemaphoreGive(_sdMutex);
  if (!ok) {
    Serial.println("[AILog] could not open this turn's log file");
    return;
  }
  aiLogTurnOpen = true;
}

static void aiLogWriteReceivedAudio() {
  if (!aiLogActive || !aiRecBuf || aiRecFilled == 0 || aiRecBufAiReplyLogged) return;
  const int16_t* stereo = (const int16_t*)aiRecBuf;
  size_t stereoSamples = aiRecFilled / 4;
  int16_t* mono = (int16_t*)ps_malloc(stereoSamples * sizeof(int16_t));
  if (!mono) {
    Serial.println("[AILog] mono downmix alloc failed — this turn's received audio not logged");
    return;
  }
  for (size_t i = 0; i < stereoSamples; i++) {
    mono[i] = (int16_t)(((int32_t)stereo[i * 2] + (int32_t)stereo[i * 2 + 1]) / 2);
  }
  size_t monoBytes = stereoSamples * sizeof(int16_t);
  unsigned long _sdSaveT0 = millis();
  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  size_t wrote = aiLogWriteMaybeEnc(aiLogFile, aiLogEncrypted, aiLogNonce,
                                    AILOG_PLAIN_BASE + 44 + aiLogBytesWritten,
                                    (const uint8_t*)mono, monoBytes);
  size_t woreOut = aiLogOutActive ? aiLogWriteMaybeEnc(aiLogFileOut, aiLogEncryptedOut, aiLogNonceOut,
                                                      AILOG_PLAIN_BASE + 44 + aiLogBytesWrittenOut,
                                                      (const uint8_t*)mono, monoBytes) : 0;
  if (_sdMutex) xSemaphoreGive(_sdMutex);
  unsigned long _sdSaveMs = millis() - _sdSaveT0;
  Serial.printf("[Timing] received-audio SD save: %lu bytes, %lums\n", (unsigned long)monoBytes, _sdSaveMs);
  if (!aiActiveProviderIsGemini && _sdSaveMs > 300) {
    wispTrace("AI received-audio SD save bytes=" + String((unsigned)monoBytes) + " ms=" + String(_sdSaveMs));
  }
  aiLogBytesWritten += (uint32_t)wrote;
  if (wrote != monoBytes) Serial.printf("[AILog] short write on received audio: wanted=%u wrote=%u\n", (unsigned)monoBytes, (unsigned)wrote);
  if (aiLogOutActive) {
    aiLogBytesWrittenOut += (uint32_t)woreOut;
    if (woreOut != monoBytes) Serial.printf("[AILog] short write on received audio (out): wanted=%u wrote=%u\n", (unsigned)monoBytes, (unsigned)woreOut);
  }
  aiRecBufAiReplyLogged = true;
  free(mono);
}

static String aiBuildAudioBase(const String& userTranscript) {
  String id = aiChatSessionId + "-" + String(aiChatTurnN);
  String base = userTranscript; base.trim();
  if (base.length() > 60) base = base.substring(0, 60);
  String slug = aiKbSlug(base);
  if (slug.length() > 0) slug.setCharAt(0, toupper(slug.charAt(0)));
  if (translatorPageOpen) {
    String langCode = String(TRANSLATOR_LANGS[translatorTargetIndex].code);
    slug = (slug.length() > 0) ? (slug + "-" + langCode) : langCode;
  }
  return slug.length() > 0 ? (id + "-" + slug) : id;
}

static void aiWriteResponseClip(const String& audioBase) {
  if (!aiRecBuf || aiRecFilled == 0) return;
  const int16_t* stereo = (const int16_t*)aiRecBuf;
  size_t stereoSamples = aiRecFilled / 4;
  size_t monoBytes = stereoSamples * sizeof(int16_t);
  if (monoBytes == 0) return;
  int16_t* mono = (int16_t*)ps_malloc(monoBytes);
  if (!mono) return;
  for (size_t i = 0; i < stereoSamples; i++)
    mono[i] = (int16_t)(((int32_t)stereo[i * 2] + (int32_t)stereo[i * 2 + 1]) / 2);

  String dir  = String(FILES_DIR) + "/AI Assistant Audio";
  String path = dir + "/" + audioBase + ".wav";
  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  if (!SD_MMC.exists(dir)) SD_MMC.mkdir(dir);
  SD_MMC.remove(path);
  File f = SD_MMC.open(path, FILE_WRITE);
  bool ok = false;
  if (f) {
    uint8_t nonce[CTRLOG_NONCE_LEN];
    bool enc = sdEncryptionActive && aiLogBeginEncrypted(f, nonce);
    uint8_t hdr[44];
    noteBuildWavHeader(hdr, monoBytes, AUDIO_SAMPLE_RATE, 1);
    size_t w1 = aiLogWriteMaybeEnc(f, enc, nonce, AILOG_PLAIN_BASE,      hdr, 44);
    size_t w2 = aiLogWriteMaybeEnc(f, enc, nonce, AILOG_PLAIN_BASE + 44, (const uint8_t*)mono, monoBytes);
    f.close();
    ok = (w1 == 44 && w2 == monoBytes);
  }
  if (!ok) SD_MMC.remove(path);
  if (_sdMutex) xSemaphoreGive(_sdMutex);
  free(mono);
  if (ok) Serial.printf("[AILog] AI-response clip saved: %s\n", path.c_str());
}

static void aiLogTurnEnd(const String& audioBase) {
  if (!aiLogActive || !aiLogIsTranslator || !aiLogTurnOpen) return;
  aiLogSavingAudio = true;
  drawAiOrTranslatorPage();
  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  aiLogFile.seek(aiLogEncrypted ? CTRLOG_HEADER_LEN : 0);
  uint8_t hdr[44];
  noteBuildWavHeader(hdr, aiLogBytesWritten, AUDIO_SAMPLE_RATE, 1);
  aiLogWriteMaybeEnc(aiLogFile, aiLogEncrypted, aiLogNonce, AILOG_PLAIN_BASE, hdr, 44);
  aiLogFile.close();
  if (aiLogOutActive) {
    aiLogFileOut.seek(aiLogEncryptedOut ? CTRLOG_HEADER_LEN : 0);
    uint8_t hdrOut[44];
    noteBuildWavHeader(hdrOut, aiLogBytesWrittenOut, AUDIO_SAMPLE_RATE, 1);
    aiLogWriteMaybeEnc(aiLogFileOut, aiLogEncryptedOut, aiLogNonceOut, AILOG_PLAIN_BASE, hdrOut, 44);
    aiLogFileOut.close();
  }
  if (_sdMutex) xSemaphoreGive(_sdMutex);

  if (aiLogBytesWritten == 0) {
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    SD_MMC.remove(aiLogFilePath);
    if (aiLogOutActive) SD_MMC.remove(aiLogFilePathOut);
    if (_sdMutex) xSemaphoreGive(_sdMutex);
  } else {
    int cut = aiLogFilePath.lastIndexOf('/') + 1;
    String dirPart = aiLogFilePath.substring(0, cut);
    String fullPath = dirPart + audioBase + "-full.wav";
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    SD_MMC.remove(fullPath);
    SD_MMC.rename(aiLogFilePath, fullPath);
    if (_sdMutex) xSemaphoreGive(_sdMutex);
    if (aiLogOutActive) {
      if (aiLogBytesWrittenOut == 0) {
        if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
        SD_MMC.remove(aiLogFilePathOut);
        if (_sdMutex) xSemaphoreGive(_sdMutex);
      } else {
        String outPath = dirPart + audioBase + ".wav";
        if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
        SD_MMC.remove(outPath);
        SD_MMC.rename(aiLogFilePathOut, outPath);
        if (_sdMutex) xSemaphoreGive(_sdMutex);
      }
    }
  }
  Serial.print("[AILog] turn log closed, bytes="); Serial.print(aiLogBytesWritten);
  if (aiLogOutActive) { Serial.print(", out bytes="); Serial.print(aiLogBytesWrittenOut); }
  Serial.println();
  aiLogTurnOpen = false;
  aiLogOutActive = false;
  aiLogSavingAudio = false;
  drawAiOrTranslatorPage();
}

#define SESSION_TURNS_FILE (KNOWLEDGE_DIR "/.session_turns")
#define SESSION_TURNS_MAX  300
static void sessionTurnsSet(const String& sid, long total) {
  if (!sdMounted || sid.length() == 0 || total <= 0) return;
  String raw = SD_MMC.exists(SESSION_TURNS_FILE) ? readKnowledgeFile(SESSION_TURNS_FILE) : "";
  DynamicJsonDocument doc(raw.length() + 2048);
  if (raw.length() == 0 || deserializeJson(doc, raw) != DeserializationError::Ok) doc.clear();
  JsonArray arr = doc["s"].is<JsonArray>() ? doc["s"].as<JsonArray>() : doc.createNestedArray("s");
  JsonObject found;
  for (JsonObject o : arr) if (String((const char*)(o["id"] | "")) == sid) { found = o; break; }
  if (found.isNull()) { found = arr.createNestedObject(); found["id"] = sid; }
  found["n"] = total;
  while ((int)arr.size() > SESSION_TURNS_MAX) arr.remove(0);
  String out; serializeJson(doc, out);
  writeKnowledgeFile(SESSION_TURNS_FILE, out);
}
static long sessionTurnsGetFrom(const String& raw, const String& sid) {
  if (raw.length() == 0) return -1;
  DynamicJsonDocument doc(raw.length() + 2048);
  if (deserializeJson(doc, raw) != DeserializationError::Ok) return -1;
  for (JsonObject o : doc["s"].as<JsonArray>())
    if (String((const char*)(o["id"] | "")) == sid) return (long)(o["n"] | 0);
  return -1;
}

