static bool featureDisabled(const char* key) {
  if (!key || !key[0]) return false;
  String s = activeFeaturesDisabled;
  int start = 0;
  while (start < (int)s.length()) {
    int comma = s.indexOf(',', start);
    String k = (comma >= 0) ? s.substring(start, comma) : s.substring(start);
    k.trim();
    if (k == key) return true;
    if (comma < 0) break;
    start = comma + 1;
  }
  return false;
}

static bool settingsPageDisabled(int pageNum) {
  if (pageNum < 1 || pageNum > 5) return false;
  char key[6] = { 's', 'e', 't', (char)('0' + pageNum), '\0', '\0' };
  return featureDisabled(key);
}

static int nextEnabledSettingsPage(int from) {
  for (int p = from; p <= 6; p++) if (!settingsPageDisabled(p)) return p;
  return 0;
}

