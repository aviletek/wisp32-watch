struct UiLang { const char* code; const char* label; };
static const UiLang UI_LANGS[] = { { "en", "English" }, { "fr", "Francais" } };
static const int UI_LANG_COUNT = sizeof(UI_LANGS) / sizeof(UI_LANGS[0]);

static uint8_t uiLangIndex = 0;
static const char** uiLangTable = nullptr;
static char*        uiLangBlob  = nullptr;

static const char* const DOW_EN[7]  = {"Sun","Mon","Tue","Wed","Thu","Fri","Sat"};
static const char* const DOW_FR[7]  = {"dim.","lun.","mar.","mer.","jeu.","ven.","sam."};
static const char* const MON_EN[12] = {"Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"};
static const char* const MON_FR[12] = {"janv.","fevr.","mars","avr.","mai","juin","juil.","aout","sept.","oct.","nov.","dec."};

static const char* builtinStr(uint8_t lang, int id) {
  return (lang == 1) ? UI_STRINGS[id].fr : UI_STRINGS[id].en;
}
static const char* TR(int id) {
  if (id < 0 || id >= UISTR_COUNT) return "";
  if (uiLangTable && uiLangTable[id]) return uiLangTable[id];
  return builtinStr(uiLangIndex < UI_LANG_COUNT ? uiLangIndex : 0, id);
}
static bool uiLangIsFrench() { return uiLangIndex < UI_LANG_COUNT && strcmp(UI_LANGS[uiLangIndex].code, "fr") == 0; }
static const char* uiModeName(int idx) {
  static const int ids[3] = { UISTR_MODE_VOICE, UISTR_MODE_SILENT, UISTR_MODE_DUAL };
  return TR(ids[(idx >= 0 && idx < 3) ? idx : 2]);
}
static const char* uiOnOff(bool on) { return TR(on ? UISTR_ON : UISTR_OFF); }

static void loadUiLang(uint8_t idx) {
  uiLangIndex = (idx < UI_LANG_COUNT) ? idx : 0;
  if (uiLangTable) { free((void*)uiLangTable); uiLangTable = nullptr; }
  if (uiLangBlob)  { free(uiLangBlob); uiLangBlob = nullptr; }
  uiLangTable = (const char**)ps_malloc(sizeof(char*) * UISTR_COUNT);
  if (!uiLangTable) return;
  for (int i = 0; i < UISTR_COUNT; i++) uiLangTable[i] = nullptr;
  if (!sdMounted) return;
  String path = String(KNOWLEDGE_DIR) + LANG_DIR_SUFFIX + "/" + UI_LANGS[uiLangIndex].code + ".txt";
  if (!SD_MMC.exists(path)) return;
  String content = readKnowledgeFile(path);
  if (content.length() == 0) return;
  uiLangBlob = (char*)ps_malloc(content.length() + 1);
  if (!uiLangBlob) return;
  memcpy(uiLangBlob, content.c_str(), content.length() + 1);
  char* p = uiLangBlob;
  while (*p) {
    char* ls = p;
    while (*p && *p != '\n') p++;
    char* le = p; if (*p) p++;
    if (le > ls && *(le - 1) == '\r') le--;
    *le = 0;
    if (ls[0] && ls[0] != '#') {
      char* eq = strchr(ls, '=');
      if (eq) { *eq = 0; const char* val = eq + 1;
        for (int i = 0; i < UISTR_COUNT; i++) if (strcmp(ls, UI_STRINGS[i].key) == 0) { uiLangTable[i] = val; break; } }
    }
  }
}

static void seedUiLangs() {
  if (!sdMounted) return;
  String dir = String(KNOWLEDGE_DIR) + LANG_DIR_SUFFIX;
  if (!SD_MMC.exists(dir)) SD_MMC.mkdir(dir);
  for (int L = 0; L < UI_LANG_COUNT; L++) {
    String path = dir + "/" + UI_LANGS[L].code + ".txt";
    if (SD_MMC.exists(path)) continue;
    String body = String("# ") + UI_LANGS[L].label + " UI strings.\n"
                  "# Edit the text AFTER each '='. Keep the key (before '=') unchanged.\n"
                  "# Missing/removed keys fall back to English. Lines starting with # are ignored.\n"
                  "# After saving, switch the Language away and back (or reboot) to apply.\n";
    String lastSection = "";
    for (int i = 0; i < UISTR_COUNT; i++) {
      if (String(UI_STRINGS[i].section) != lastSection) {
        lastSection = UI_STRINGS[i].section;
        body += "\n# === "; body += lastSection; body += " ===\n";
      }
      body += UI_STRINGS[i].key; body += "="; body += builtinStr(L, i); body += "\n";
    }
    writeKnowledgeFile(path, body);
  }
}

static void uiFormatClockDate(char* out, size_t outLen, const struct tm& t) {
  int wday = (t.tm_wday >= 0 && t.tm_wday < 7) ? t.tm_wday : 0;
  int mon  = (t.tm_mon  >= 0 && t.tm_mon < 12) ? t.tm_mon  : 0;
  if (uiLangIsFrench())
    snprintf(out, outLen, "%s %02d %s", DOW_FR[wday], t.tm_mday, MON_FR[mon]);
  else
    snprintf(out, outLen, "%s %s %02d", DOW_EN[wday], MON_EN[mon], t.tm_mday);
}

