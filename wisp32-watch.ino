#define AI_TOOL_DESC_COUNT (sizeof(AI_TOOL_DESCS) / sizeof(AI_TOOL_DESCS[0]))
static String* activeToolDescs = nullptr;

bool allocToolDescsInPsram() {
  activeToolDescs = (String*)ps_malloc(sizeof(String) * AI_TOOL_DESC_COUNT);
  if (!activeToolDescs) return false;
  for (size_t i = 0; i < AI_TOOL_DESC_COUNT; i++) new (&activeToolDescs[i]) String();
  return true;
}

void loadToolDescriptions() {
  if (!activeToolDescs) return;
  for (size_t i = 0; i < AI_TOOL_DESC_COUNT; i++) activeToolDescs[i] = AI_TOOL_DESCS[i].defaultDesc;
  if (!sdMounted) return;
  for (size_t i = 0; i < AI_TOOL_DESC_COUNT; i++) {
    if (SD_MMC.exists(AI_TOOL_DESCS[i].file)) {
      String v = readKnowledgeFile(AI_TOOL_DESCS[i].file);
      if (v.length() > 0) activeToolDescs[i] = v;
    }
  }
}

static String toolDesc(const char* name) {
  for (size_t i = 0; i < AI_TOOL_DESC_COUNT; i++) {
    if (strcmp(AI_TOOL_DESCS[i].name, name) == 0) return activeToolDescs ? activeToolDescs[i] : String(AI_TOOL_DESCS[i].defaultDesc);
  }
  return "";
}

static bool toolListHas(const String& list, const char* name) {
  String hay = "," + list + ",";
  String needle = String(",") + name + ",";
  return hay.indexOf(needle) != -1;
}

static bool toolCheckboxOn(const char* name) {
  return !toolListHas(toolsDisabledList, name);
}

static bool isToolEnabled(const char* name) {
  if (!toolCheckboxOn(name)) return false;
  if (strcmp(name, "ask_file_question") == 0 && !toolCheckboxOn("file_open")) return false;
  if (strcmp(name, "forget") == 0 && !toolCheckboxOn("remember")) return false;
  return true;
}

void aiAddSimpleTool(JsonArray& tools, const char* name, const String& desc, const char* argName, const char* argDesc) {
  JsonObject t = tools.createNestedObject();
  t["type"] = "function";
  t["name"] = name;
  t["description"] = desc;
  JsonObject params = t.createNestedObject("parameters");
  params["type"] = "object";
  JsonObject props = params.createNestedObject("properties");
  JsonObject argObj = props.createNestedObject(argName);
  argObj["type"] = "string";
  argObj["description"] = argDesc;
  JsonArray req = params.createNestedArray("required");
  req.add(argName);
}

static void sendAiResponseCreate() {
  DynamicJsonDocument respCreate(128);
  respCreate["type"] = "response.create";
  bool needsResponseObj = (!translatorPageOpen && aiDisplayModeIndex == AI_DISPLAY_SILENT)
                          || (!translatorPageOpen && AI_MAX_OUT_TOKENS_VALUES[aiMaxOutTokensIndex] > 0);
  if (needsResponseObj) {
    JsonObject resp = respCreate.createNestedObject("response");
    if (!translatorPageOpen && aiDisplayModeIndex == AI_DISPLAY_SILENT) {
      JsonArray mod = resp.createNestedArray("output_modalities");
      mod.add("text");
    }
    if (!translatorPageOpen && AI_MAX_OUT_TOKENS_VALUES[aiMaxOutTokensIndex] > 0) {
      resp["max_output_tokens"] = AI_MAX_OUT_TOKENS_VALUES[aiMaxOutTokensIndex];
      Serial.printf("[AI] response.create: max_output_tokens=%d (unverified — watch for an error event)\n",
                    AI_MAX_OUT_TOKENS_VALUES[aiMaxOutTokensIndex]);
    }
  }
  String respStr; serializeJson(respCreate, respStr);
  aiClient.send(respStr);
}

static bool fileIsTask(const String& firstLine) {
  String t = firstLine; t.trim();
  return t == "#TASK";
}

static bool parseTaskFile(const String& content, String* model, String* notifyEmail, String* body) {
  *model = ""; *notifyEmail = ""; *body = "";
  int nl = content.indexOf('\n');
  String line1 = (nl >= 0) ? content.substring(0, nl) : content;
  line1.trim();
  if (line1 != "#TASK") return false;
  int pos = (nl >= 0) ? nl + 1 : content.length();

  while (pos < (int)content.length()) {
    int nextNl = content.indexOf('\n', pos);
    String line = (nextNl >= 0) ? content.substring(pos, nextNl) : content.substring(pos);
    String trimmed = line; trimmed.trim();
    if (trimmed.startsWith("#MODEL")) {
      *model = trimmed.substring(6); model->trim();
    } else if (trimmed.startsWith("#NOTIFY")) {
      *notifyEmail = trimmed.substring(7); notifyEmail->trim();
    } else {
      break;
    }
    pos = (nextNl >= 0) ? nextNl + 1 : content.length();
  }
  *body = content.substring(pos);
  body->trim();
  return true;
}

