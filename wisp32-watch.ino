    unsigned long wifiCheckInterval = (mdnsStarted || activeWifiNetworkCount == 0) ? 15000 : 250;
    if (millis() - lastWifiCheck > wifiCheckInterval) {
      lastWifiCheck = millis();
      bool inFastPathGrace = wifiFastPathPending && (long)(millis() - wifiFastPathDeadlineMs) < 0;
      if (WiFi.status() == WL_CONNECTED && !mdnsStarted) {
        wifiFastPathPending = false;
        if (_netMutex) xSemaphoreTake(_netMutex, portMAX_DELAY);
        wifiRememberSsid();
