#define CLOCK_BOOT_DEBOUNCE_MS 5000
#define CLOCK_WIFI_MSG_DELAY_MS 20000

static void _drawWifiIcon(int y, bool connected) {
  wifiSetupTapActive = false;
  if (clockIdMode == CLOCK_ID_NAME) {
    if (deviceName.length() > 0) _clockCenterPrint(deviceName.c_str(), y, 3, COLOR_BLUE);
    return;
  }
  if (clockIdMode == CLOCK_ID_CUSTOM) {
    if (clockIpCustomText.length() > 0) _clockCenterPrint(clockIpCustomText.c_str(), y, 3, COLOR_BLUE);
    return;
  }
  if (!connected) {
    if (wifiDisconnectedSinceMs == 0 || millis() - wifiDisconnectedSinceMs < CLOCK_WIFI_MSG_DELAY_MS) return;
  }
  if (!connected && activeWifiNetworkCount == 0) {
    const char* msg = "TAP TO SETUP WIFI";
    int sz = 3;
    gfx->setTextSize(sz);
    int16_t bx, by; uint16_t bw, bh;
    gfx->getTextBounds(msg, 0, 0, &bx, &by, &bw, &bh);
    if ((int)bw <= SCREEN_WIDTH - 20) {
      _clockCenterPrint(msg, y, sz, COLOR_YELLOW);
      wifiSetupTapY0 = y - 10;
      wifiSetupTapY1 = y + (int)bh + 10;
    } else {
      String full = msg;
      int mid = full.length() / 2;
      int splitAt = full.lastIndexOf(' ', mid);
      if (splitAt < 0) splitAt = full.indexOf(' ', mid);
      String line1 = splitAt > 0 ? full.substring(0, splitAt) : full;
      String line2 = splitAt > 0 ? full.substring(splitAt + 1) : "";
      int16_t lx, ly; uint16_t lw, lh;
      gfx->getTextBounds(line1.c_str(), 0, 0, &lx, &ly, &lw, &lh);
      int lineGap = (int)lh + 6;
      _clockCenterPrint(line1.c_str(), y, sz, COLOR_YELLOW);
      if (line2.length() > 0) _clockCenterPrint(line2.c_str(), y + lineGap, sz, COLOR_YELLOW);
      wifiSetupTapY0 = y - 10;
      wifiSetupTapY1 = y + lineGap + (int)lh + 10;
    }
    wifiSetupTapActive = true;
    return;
  }
  String s = connected ? WiFi.localIP().toString() : String("NO WIFI");
  _clockCenterPrint(s.c_str(), y, connected ? 3 : 2, connected ? COLOR_BLUE : COLOR_YELLOW);
}

