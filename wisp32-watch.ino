static uint8_t* rwCacheBuf = nullptr;
static size_t rwCacheLen = 0;
static String rwCacheKey = "";

void handleTasksReadWebpageTest() {
  if (!requireAuth()) return;
  String url     = server.hasArg("url")     ? server.arg("url")     : "";
  String keyword = server.hasArg("keyword") ? server.arg("keyword") : "";
  int offset     = server.hasArg("offset")  ? server.arg("offset").toInt()  : 0;
  int range      = server.hasArg("range")   ? server.arg("range").toInt()   : 0;
  String radius  = server.hasArg("radius")  ? server.arg("radius")           : "";

  if (server.hasArg("sliceStart")) {
    int sliceStart = server.arg("sliceStart").toInt();
    if (sliceStart < 0) sliceStart = 0;
    String key = url + "|" + String(offset) + "|" + String(range);
    if (rwCacheKey != key) {
      if (rwCacheBuf) { free(rwCacheBuf); rwCacheBuf = nullptr; rwCacheLen = 0; rwCacheKey = ""; }
      uint8_t* buf = nullptr; size_t len = 0; long declaredSize = -2;
      String fetchErr = taskFetchWebpageRaw(url, offset, range, &buf, &len, &declaredSize);
      if (fetchErr.length() > 0) {
        BasicJsonDocument<PsramJsonAllocator> errDoc(fetchErr.length() + 256);
        errDoc["ok"] = false;
        errDoc["response"] = fetchErr;
        String errOut; serializeJson(errDoc, errOut);
        server.send(200, "application/json", errOut);
        return;
      }
      rwCacheBuf = buf; rwCacheLen = len; rwCacheKey = key;
    }
    int sliceLen = READ_WEBPAGE_MAX_PREVIEW_LEN;
    if ((size_t)sliceStart >= rwCacheLen) sliceLen = 0;
    else if (sliceStart + sliceLen > (int)rwCacheLen) sliceLen = (int)rwCacheLen - sliceStart;
    String slice;
    if (sliceLen > 0) {
      uint8_t* sliceBuf = (uint8_t*)ps_malloc(sliceLen + 1);
      if (sliceBuf) {
        memcpy(sliceBuf, rwCacheBuf + sliceStart, sliceLen);
        sliceBuf[sliceLen] = 0;
        slice = String((char*)sliceBuf, (unsigned int)sliceLen);
        free(sliceBuf);
      }
    }
    BasicJsonDocument<PsramJsonAllocator> doc(slice.length() + 256);
    doc["ok"] = true;
    doc["raw"] = slice;
    doc["rawFetchedLen"] = sliceLen;
    doc["rawDeclaredSize"] = -2;
    String out; serializeJson(doc, out);
    server.send(200, "application/json", out);
    return;
  }

  String raw;
  int rawLen = 0;
  long declaredSize = -2;
  String response = taskReadWebpageContent(url, keyword, offset, range, radius, &raw, &rawLen, &declaredSize);
  bool ok = !response.startsWith("Error:");
  BasicJsonDocument<PsramJsonAllocator> doc(response.length() + raw.length() + 512);
  doc["ok"] = ok;
  doc["response"] = response;
  doc["raw"] = raw;
  doc["rawFetchedLen"] = rawLen;
  doc["rawDeclaredSize"] = declaredSize;
  String out; serializeJson(doc, out);
  server.send(200, "application/json", out);
}

