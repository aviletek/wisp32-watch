        gfx->setTextColor(noteSaveMode == NOTE_SAVE_AUDIO_ONLY ? COLOR_GRAY : (noteEmailToContact.length() > 0 ? CLK_TIME_COLOR : CLK_DATE_COLOR), COLOR_DARK_GRAY);
