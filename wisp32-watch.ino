void fireAlarm() {
  gfx->fillScreen(COLOR_BLACK);
  _clockCenterPrint("ALARM", SCREEN_HEIGHT / 2 - 60, 6, CLK_TIME_COLOR);
  struct tm ti;
  if (getLocalTime(&ti)) {
    char buf[8]; strftime(buf, sizeof(buf), "%H:%M", &ti);
    _clockCenterPrint(buf, SCREEN_HEIGHT / 2 + 20, 5, COLOR_WHITE);
  }
  if (lastFiredAlarmNames.length() > 0) {
    const int nameMargin = 12;
    int nameSize = 3;
    int16_t nbx, nby; uint16_t nbw, nbh;
    for (int sz = 4; sz >= 3; sz--) {
      gfx->setTextSize(sz);
      gfx->getTextBounds(lastFiredAlarmNames.c_str(), 0, 0, &nbx, &nby, &nbw, &nbh);
      if ((int)nbw <= SCREEN_WIDTH - 2 * nameMargin) { nameSize = sz; break; }
    }
    _clockCenterPrintWrapped(lastFiredAlarmNames.c_str(), SCREEN_HEIGHT / 2 + 70,
                             nameSize, COLOR_GRAY, nameMargin, nameSize * 8 + 6);
  }
  gfx->flush();

  {
    struct tm lt; String ts = "";
    if (getLocalTime(&lt)) { char b[20]; strftime(b, sizeof(b), "%Y-%m-%d %H:%M:%S", &lt); ts = String(b); }
    String names = lastFiredAlarmNames.length() ? lastFiredAlarmNames : String("Alarm");
    appendChatLog("[" + ts + " | alarm]\nQ: (alarm)\nA: Alarm went off: " + names + ".\n");
  }

  audioCodecReinit();
  if (audioOk) {
    const int toneFreq = 1000;
    const int beepMs    = 300;
    const int gapMs      = 200;
    const int repeats    = 20;
    es8311_voice_volume_set(esHandle, speakerVolumeCurve(80), NULL);
    const int samplesPerBeep = AUDIO_SAMPLE_RATE * beepMs / 1000;
    int16_t* buf = (int16_t*)malloc((size_t)samplesPerBeep * 2 * sizeof(int16_t));
    if (buf) {
      for (int i = 0; i < samplesPerBeep; i++) {
        int16_t s = (int16_t)(8000.0 * sin(2.0 * PI * toneFreq * i / AUDIO_SAMPLE_RATE));
        buf[i * 2] = s; buf[i * 2 + 1] = s;
      }
      scrPumpRecording();
      for (int r = 0; r < repeats; r++) {
        if (digitalRead(WAKE_BUTTON_PIN) == LOW) break;
        i2s.write((const uint8_t*)buf, (size_t)samplesPerBeep * 2 * sizeof(int16_t));
        scrPumpRecording();
        bool stopped = false;
        for (int waited = 0; waited < gapMs; waited += 20) {
          if (digitalRead(WAKE_BUTTON_PIN) == LOW) { stopped = true; break; }
          scrPumpRecording();
          delay(20);
        }
        if (stopped) break;
      }
      free(buf);
    }
    es8311_voice_volume_set(esHandle, speakerVolumeCurve(speakerVolume), NULL);
  }
}

void playTaskCompletionBeep() {
  if (!audioOk) return;
  const int toneFreq = 1400;
  const int beepMs    = 120;
  const int gapMs      = 500;
  const int repeats    = 2;
  const int samplesPerBeep = AUDIO_SAMPLE_RATE * beepMs / 1000;
  int16_t* buf = (int16_t*)malloc((size_t)samplesPerBeep * 2 * sizeof(int16_t));
  if (!buf) return;
  for (int i = 0; i < samplesPerBeep; i++) {
    int16_t s = (int16_t)(8000.0 * sin(2.0 * PI * toneFreq * i / AUDIO_SAMPLE_RATE));
    buf[i * 2] = s; buf[i * 2 + 1] = s;
  }
  for (int r = 0; r < repeats; r++) {
    i2s.write((const uint8_t*)buf, (size_t)samplesPerBeep * 2 * sizeof(int16_t));
    if (r < repeats - 1) delay(gapMs);
  }
  free(buf);
}

static long micSramCostBytes = -1;

void audioCodecInit() {
  uint32_t heapBeforeI2sInit = ESP.getFreeHeap();
  i2s.setPins(41, 45, 40, 42, 16);
  if (!i2s.begin(I2S_MODE_STD, AUDIO_SAMPLE_RATE, I2S_DATA_BIT_WIDTH_16BIT,
                 I2S_SLOT_MODE_STEREO, I2S_STD_SLOT_BOTH)) {
    return;
  }
  micSramCostBytes = (long)heapBeforeI2sInit - (long)ESP.getFreeHeap();
  pinMode(46, OUTPUT);
  digitalWrite(46, HIGH);

  esHandle = es8311_create(0, ES8311_ADDRRES_0);
  audioCodecReinit();

  micParkForPage();
}

