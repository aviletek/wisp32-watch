void playAiAudioDeltaB64(const char* b64) {
  if (!aiEnsureDeltaBuffers()) return;
  size_t b64Len = strlen(b64);
  if (b64Len == 0) {
    aiDecodeEmptyCountThisTurn++;
    return;
  }
  unsigned long _t0 = micros();
  size_t decodedLen = 0;
  int rc = mbedtls_base64_decode(aiDecodeBuf, AI_DECODE_CAP_BYTES, &decodedLen, (const uint8_t*)b64, b64Len);
  aiLastDecodeUs = micros() - _t0;
  if (rc != 0) {
    aiDecodeFailCountThisTurn++;
    return;
  }
  int16_t* samples24 = (int16_t*)aiDecodeBuf;
  size_t n24 = decodedLen / 2;
  if (n24 == 0) {
    aiDecodeZeroSamplesThisTurn++;
    return;
  }

  unsigned long _t1 = micros();
  size_t outCount = 0;
  aiResampleChunk24to16(samples24, n24, aiResampleOutBuf, &outCount, AI_RESAMPLE_MAX_OUT_SAMPLES);
  aiLastResampleUs = micros() - _t1;

  if (outCount == 0) aiResampleZeroCountThisTurn++;
  if (outCount > 0) {
    bool ringLive = (aiPlayRing != nullptr && aiPlayRingCap >= 4);
    size_t freeBefore = ringLive ? aiPlayFreeBytes() : 0;
    size_t needed = outCount * 2 * sizeof(int16_t);
    if (ringLive && freeBefore < needed) {
      aiRingOverflowBytesThisTurn += (uint32_t)(needed - freeBefore);
    }
    unsigned long _t2 = micros();
    aiPlayRingWrite((const uint8_t*)aiResampleOutBuf, needed);
    aiLastRingWriteUs = micros() - _t2;
    aiResponseAudioBytes += needed;

    unsigned long _t3 = micros();
    if ((translatorPageOpen || aiPageOpen) && aiRecBuf) {
      size_t room = aiRecCap - aiRecFilled;
      size_t toCopy = needed < room ? needed : room;
      if (toCopy > 0) {
        memcpy(aiRecBuf + aiRecFilled, aiResampleOutBuf, toCopy);
        aiRecFilled += toCopy;
      }
    }
    aiLastRecCopyUs = micros() - _t3;
  }
}

static void taskRebootOnHttpDashOne(int httpCode) {
  if (httpCode != -1 || currentlyRunningTaskIdx < 0 || heapRestartStreak >= 2) return;
  Serial.printf("[Task] HTTP -1 seen mid-run - rebooting once and retrying automatically\n");
  taskStampRestartingStatus(currentlyRunningTaskIdx);
  taskRunAfterRestartIdx = currentlyRunningTaskIdx;
  heapRestartStreak++;
  saveTaskRestartState(taskRunAfterRestartIdx, heapRestartStreak);
  delay(50);
  ESP.restart();
}

String aiToolWebSearchOpenAi(String query) {
  HTTPClient http;
  http.begin("https://api.openai.com/v1/chat/completions");
  http.setTimeout(20000);
  http.addHeader("Authorization", String("Bearer ") + activeOpenAiKey);
  http.addHeader("Content-Type", "application/json");
  int wsCap = AI_MAX_OUT_TOKENS_VALUES[aiMaxOutTokensIndex];
  String payload = "{\"model\":\"" + activeWebSearchModel + "\"";
  if (wsCap > 0) {
    payload += ",\"max_tokens\":" + String(wsCap);
  }
  payload += ",\"messages\":["
    "{\"role\":\"system\",\"content\":\"" + jsonEscape(getWebSearchSystemPrompt()) + "\"},"
    "{\"role\":\"user\",\"content\":\"" + jsonEscape(query) + "\"}]}";
  Serial.printf("[AI] web_search: model=%s\n", activeWebSearchModel.c_str());
  int code = http.POST(payload);
  taskRebootOnHttpDashOne(code);
  if (code != 200) {
    http.end();
    Serial.printf("[AI] web_search failed: HTTP %d, free heap=%u, max alloc=%u\n",
                  code, (unsigned)ESP.getFreeHeap(), (unsigned)ESP.getMaxAllocHeap());
    return "Search failed: HTTP " + String(code);
  }
  String rb = http.getString();
  http.end();
  BasicJsonDocument<PsramJsonAllocator> res(16384);
  if (deserializeJson(res, rb) != DeserializationError::Ok) return "Search failed: bad response";
  String content = res["choices"][0]["message"]["content"] | "No result";
  int wsPromptTok = res["usage"]["prompt_tokens"] | 0;
  int wsComplTok = res["usage"]["completion_tokens"] | 0;
  int wsTotalTok = res["usage"]["total_tokens"] | 0;
  Serial.printf("[AI] web_search: tokens prompt=%d completion=%d total=%d\n",
                wsPromptTok, wsComplTok, wsTotalTok);
  logTokenUsage("websearch", "", "openai", activeWebSearchModel,
                wsCap > 0 ? wsCap : -1,
                wsPromptTok, wsComplTok, -1, -1, -1, -1, -1, -1, -1, wsTotalTok, -1, -1);
  return content;
}

