static bool _looksLikeRealData(const uint8_t* buf, size_t n) {
  if (n == 0) return false;
  for (size_t i = 1; i < n; i++) if (buf[i] != buf[0]) return true;
  return false;
}

static bool _sdRootReadable() {
  File root = SD_MMC.open("/");
  if (!root || !root.isDirectory()) { if (root) root.close(); return false; }
  root.openNextFile();
  root.close();
  return SD_MMC.totalBytes() > 0;
}

bool mountSD() {
  if (sdMounted) return true;
  SD_MMC.end();
  SD_MMC.setPins(SDMMC_CLK, SDMMC_CMD, SDMMC_D0);
  if (!SD_MMC.begin("/sdcard", true)) {
    Serial.println("SD mount failed"); return false;
  }
  if (!_sdRootReadable()) {
    SD_MMC.end();
    Serial.println("SD mount succeeded but a real data read failed — treating as not present");
    return false;
  }
  sdMounted = true; Serial.println("SD mounted"); return true;
}

bool sdCardStillPresent() {
  if (!sdMounted) return false;
  File f = SD_MMC.open(CREDENTIALS_FILE, FILE_READ);
  if (f) {
    uint8_t probe[8];
    size_t n = f.read(probe, sizeof(probe));
    f.close();
    return _looksLikeRealData(probe, n);
  }
  File dir = SD_MMC.open(KNOWLEDGE_DIR);
  if (!dir || !dir.isDirectory()) { if (dir) dir.close(); return false; }
  dir.openNextFile();
  dir.close();
  return true;
}

void reloadKnowledge() {
  if (!sdMounted) return;
  if (knowledgeBase) { free(knowledgeBase); knowledgeBase = nullptr; knowledgeSize = 0; }

  String kbIncludePath = String(KNOWLEDGE_DIR) + "/.kb_include";
  bool hasFilter = SD_MMC.exists(kbIncludePath);
  String filterContent = hasFilter ? readKnowledgeFile(kbIncludePath) : "";
  if (hasFilter && filterContent.length() > 0 && !filterContent.endsWith("\n"))
    filterContent += "\n";

  File dir = SD_MMC.open(KNOWLEDGE_DIR);
  if (!dir || !dir.isDirectory()) return;
  String combined = "";
  File file = dir.openNextFile();
  while (file) {
    if (!file.isDirectory()) {
      String name = file.name();
      if (isKnowledgeFile(name)) {
        bool included = hasFilter
          ? (filterContent.length() > 0 && filterContent.indexOf(name + "\n") >= 0)
          : (name == AI_MEMORIES_FILE);
        if (included) {
          String c = readKnowledgeFile(String(KNOWLEDGE_DIR) + "/" + name);
          if (!c.startsWith("[Protected:")) combined += c + "\n\n";
        }
      }
    }
    file = dir.openNextFile();
  }
  dir.close();
  if (combined.length() == 0) return;
  knowledgeBase = (char*)ps_malloc(combined.length() + 1);
  if (!knowledgeBase) return;
  memcpy(knowledgeBase, combined.c_str(), combined.length() + 1);
  knowledgeSize = combined.length();
  Serial.print("KB loaded: "); Serial.println(knowledgeSize);
}

#define KB_SYNC_FILE      (KNOWLEDGE_DIR "/.kb_sync")
#define KB_SYNC_MAX_BYTES 200000
#define KB_AIMETA_COMPANION_SUFFIX ".aimeta.json"

static String kbSyncReadRaw() {
  if (!sdMounted || !SD_MMC.exists(KB_SYNC_FILE)) return "";
  return readKnowledgeFile(KB_SYNC_FILE);
}
static void kbSyncWriteRaw(const String& json) {
  if (sdMounted) writeKnowledgeFile(KB_SYNC_FILE, json);
}

static bool kbSyncGet(const String& name, String* url, int* intervalMin, long* lastSync, String* status, bool* syncInstr, bool* wipeAfterUse = nullptr) {
  String raw = kbSyncReadRaw();
  if (raw.length() == 0) return false;
  DynamicJsonDocument doc(raw.length() + 2048);
  if (deserializeJson(doc, raw) != DeserializationError::Ok) return false;
  for (JsonObject o : doc["files"].as<JsonArray>()) {
    if (String((const char*)(o["name"] | "")) == name) {
      if (url)          *url = String((const char*)(o["url"] | ""));
      if (intervalMin)  *intervalMin = o["intervalMin"] | 60;
      if (lastSync)     *lastSync = (long)(o["lastSync"] | 0);
      if (status)       *status = String((const char*)(o["status"] | ""));
      if (syncInstr)    *syncInstr = o["syncInstr"] | false;
      if (wipeAfterUse) *wipeAfterUse = o["wipeAfterUse"] | false;
      return true;
    }
  }
  return false;
}

static void kbSyncSet(const String& name, const String& url, int intervalMin, bool syncInstr, bool wipeAfterUse = false) {
  String raw = kbSyncReadRaw();
  DynamicJsonDocument doc(raw.length() + 2048);
  if (raw.length() == 0 || deserializeJson(doc, raw) != DeserializationError::Ok) doc.clear();
  JsonArray arr = doc["files"].is<JsonArray>() ? doc["files"].as<JsonArray>() : doc.createNestedArray("files");
  JsonObject found;
  for (JsonObject o : arr) { if (String((const char*)(o["name"] | "")) == name) { found = o; break; } }
  if (found.isNull()) { found = arr.createNestedObject(); found["name"] = name; found["lastSync"] = 0; found["status"] = ""; }
  found["url"] = url;
  found["intervalMin"] = intervalMin;
  found["syncInstr"] = syncInstr;
  found["wipeAfterUse"] = wipeAfterUse;
  String out; serializeJson(doc, out);
  kbSyncWriteRaw(out);
}

static void kbSyncRemove(const String& name) {
  String raw = kbSyncReadRaw();
  if (raw.length() == 0) return;
  DynamicJsonDocument doc(raw.length() + 2048);
  if (deserializeJson(doc, raw) != DeserializationError::Ok) return;
  JsonArray arr = doc["files"].as<JsonArray>();
  for (int i = 0; i < (int)arr.size(); i++) {
    if (String((const char*)(arr[i]["name"] | "")) == name) { arr.remove(i); break; }
  }
  String out; serializeJson(doc, out);
  kbSyncWriteRaw(out);
}

static void kbSyncRename(const String& oldName, const String& newName) {
  String raw = kbSyncReadRaw();
  if (raw.length() == 0) return;
  DynamicJsonDocument doc(raw.length() + 2048);
  if (deserializeJson(doc, raw) != DeserializationError::Ok) return;
  bool changed = false;
  for (JsonObject o : doc["files"].as<JsonArray>()) {
    if (String((const char*)(o["name"] | "")) == oldName) { o["name"] = newName; changed = true; break; }
  }
  if (changed) { String out; serializeJson(doc, out); kbSyncWriteRaw(out); }
}

static void kbSyncRemoveUnder(const String& folderRel) {
  String raw = kbSyncReadRaw();
  if (raw.length() == 0) return;
  DynamicJsonDocument doc(raw.length() + 2048);
  if (deserializeJson(doc, raw) != DeserializationError::Ok) return;
  JsonArray arr = doc["files"].as<JsonArray>();
  String prefix = folderRel + "/";
  bool changed = false;
  for (int i = (int)arr.size() - 1; i >= 0; i--) {
    String n = String((const char*)(arr[i]["name"] | ""));
    if (n == folderRel || n.startsWith(prefix)) { arr.remove(i); changed = true; }
  }
  if (changed) { String out; serializeJson(doc, out); kbSyncWriteRaw(out); }
}

static void kbSyncRenameUnder(const String& oldFolderRel, const String& newFolderRel) {
  String raw = kbSyncReadRaw();
  if (raw.length() == 0) return;
  DynamicJsonDocument doc(raw.length() + 2048);
  if (deserializeJson(doc, raw) != DeserializationError::Ok) return;
  String oldPrefix = oldFolderRel + "/";
  String newPrefix = newFolderRel + "/";
  bool changed = false;
  for (JsonObject o : doc["files"].as<JsonArray>()) {
    String n = String((const char*)(o["name"] | ""));
    if (n.startsWith(oldPrefix)) { o["name"] = newPrefix + n.substring(oldPrefix.length()); changed = true; }
    else if (n == oldFolderRel)  { o["name"] = newFolderRel; changed = true; }
  }
  if (changed) { String out; serializeJson(doc, out); kbSyncWriteRaw(out); }
}

static void kbSyncUpdateStatus(const String& name, long lastSync, const String& status) {
  String raw = kbSyncReadRaw();
  if (raw.length() == 0) return;
  DynamicJsonDocument doc(raw.length() + 2048);
  if (deserializeJson(doc, raw) != DeserializationError::Ok) return;
  for (JsonObject o : doc["files"].as<JsonArray>()) {
    if (String((const char*)(o["name"] | "")) == name) {
      if (lastSync > 0) o["lastSync"] = lastSync;
      o["status"] = status;
      break;
    }
  }
  String out; serializeJson(doc, out);
  kbSyncWriteRaw(out);
}

static bool kbHttpGet(const String& url, String& out, String& err) {
  if (WiFi.status() != WL_CONNECTED) { err = "offline"; return false; }
  WiFiClientSecure sc; sc.setInsecure();
  WiFiClient wc;
  HTTPClient http;
  bool https = url.startsWith("https:");
  bool began = https ? http.begin(sc, url) : http.begin(wc, url);
  if (!began) { err = "bad URL"; return false; }
  http.setConnectTimeout(3000);
  http.setTimeout(8000);
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  int code = http.GET();
  if (code != HTTP_CODE_OK) { err = "HTTP " + String(code); http.end(); return false; }
  if (http.getSize() > KB_SYNC_MAX_BYTES) { err = "too large"; http.end(); return false; }
  out = http.getString();
  http.end();
  if ((int)out.length() > KB_SYNC_MAX_BYTES) { err = "too large"; out = ""; return false; }
  return true;
}

static void kbSyncDecryptBodyIfNeeded(String& body) {
  size_t n = body.length();
  if (n < (size_t)(ENCRYPT_MAGIC_LEN + AES_IV_LEN + 16)) return;
  if (memcmp(body.c_str(), ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN) != 0) return;
  const uint8_t* buf = (const uint8_t*)body.c_str();
  char* plain = nullptr;
  if (sdEncryptionActive) {
    plain = aesDecryptVerify(buf, n, activeAesKey);
    if (!plain && secretsBaselineKeyReady) plain = aesDecryptVerify(buf, n, secretsBaselineKey);
  } else if (secretsBaselineKeyReady) {
    plain = aesDecryptVerify(buf, n, secretsBaselineKey);
  }
  if (plain) { body = String(plain); free(plain); }
  else Serial.println("[KBSync] synced file is ENC:-encrypted but no key on this card fits — left as-is");
}

static bool kbSyncFileNow(const String& name, String& err) {
  String url; int interval = 60; long last = 0; String st; bool syncInstr = false;
  if (!kbSyncGet(name, &url, &interval, &last, &st, &syncInstr) || url.length() == 0) { err = "not configured"; return false; }
  String body;
  if (!kbHttpGet(url, body, err)) { kbSyncUpdateStatus(name, 0, "error: " + err); return false; }
  kbSyncDecryptBodyIfNeeded(body);
  if (!writeKnowledgeFile(String(KNOWLEDGE_DIR) + "/" + name, body)) {
    err = "write failed"; kbSyncUpdateStatus(name, 0, "error: write failed"); return false;
  }
  if (syncInstr) {
    String metaBody, metaErr;
    if (kbHttpGet(url + KB_AIMETA_COMPANION_SUFFIX, metaBody, metaErr)) {
      kbSyncDecryptBodyIfNeeded(metaBody);
      kbAiMetaApplyJson(metaBody, name);
    }
  }
  kbSyncUpdateStatus(name, (long)time(nullptr), "ok");
  return true;
}

static bool kbSyncFileIfStale(const String& name) {
  if (!sdMounted || WiFi.status() != WL_CONNECTED) return false;
  String url; int interval = 60; long last = 0; String st; bool si = false;
  if (!kbSyncGet(name, &url, &interval, &last, &st, &si) || url.length() == 0) return false;
  long now = (long)time(nullptr);
  bool timeOk = now > 1700000000L;
  bool stale = !timeOk || last == 0 || (now - last) >= (long)interval * 60;
  if (!stale) return false;
  String err;
  bool ok = kbSyncFileNow(name, err);
  Serial.printf("[KBSync] on-open %s -> %s\n", name.c_str(), ok ? "refreshed" : err.c_str());
  return ok;
}

