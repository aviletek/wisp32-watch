static bool aiFindUnitFactor(const UnitEntry* table, size_t n, const String& unit, double& outFactor) {
  for (size_t i = 0; i < n; i++) if (unit.equalsIgnoreCase(table[i].name)) { outFactor = table[i].factor; return true; }
  return false;
}
String aiToolConvert(double value, String from, String to) {
  from.trim(); to.trim();
  const UnitEntry* tables[3] = { AI_DISTANCE_UNITS, AI_WEIGHT_UNITS, AI_ENERGY_UNITS };
  size_t sizes[3] = {
    sizeof(AI_DISTANCE_UNITS) / sizeof(UnitEntry),
    sizeof(AI_WEIGHT_UNITS) / sizeof(UnitEntry),
    sizeof(AI_ENERGY_UNITS) / sizeof(UnitEntry)
  };
  for (int t = 0; t < 3; t++) {
    double ff, tf;
    if (aiFindUnitFactor(tables[t], sizes[t], from, ff) && aiFindUnitFactor(tables[t], sizes[t], to, tf)) {
      double r = value * ff / tf;
      return String(value, 4) + " " + from + " = " + String(r, 6) + " " + to;
    }
  }
  return "Cannot convert " + from + " to " + to + " — incompatible or unknown units.";
}

String aiToolNumberConvert(String value, String fromBase, String toBase) {
  fromBase.trim(); fromBase.toLowerCase();
  toBase.trim(); toBase.toLowerCase();
  int fb = 0, tb = 0;
  if (fromBase == "decimal" || fromBase == "dec") fb = 10;
  else if (fromBase == "binary" || fromBase == "bin") fb = 2;
  else if (fromBase == "hex" || fromBase == "hexadecimal") fb = 16;
  else if (fromBase == "octal" || fromBase == "oct") fb = 8;
  if (toBase == "decimal" || toBase == "dec") tb = 10;
  else if (toBase == "binary" || toBase == "bin") tb = 2;
  else if (toBase == "hex" || toBase == "hexadecimal") tb = 16;
  else if (toBase == "octal" || toBase == "oct") tb = 8;
  if (!fb) return "Unknown source base: " + fromBase;
  if (!tb) return "Unknown target base: " + toBase;
  String clean = value; clean.trim();
  if (clean.startsWith("0x") || clean.startsWith("0X")) clean = clean.substring(2);
  if (clean.startsWith("0b") || clean.startsWith("0B")) clean = clean.substring(2);
  char* endPtr;
  long num = strtol(clean.c_str(), &endPtr, fb);
  if (endPtr == clean.c_str()) return "Invalid " + fromBase + " value: " + value;
  String out;
  if (tb == 16) { char buf[16]; snprintf(buf, sizeof(buf), "%lX", num); out = "0x" + String(buf); }
  else if (tb == 2) {
    if (num == 0) out = "0b0";
    else { String bin = ""; unsigned long n = (unsigned long)num; while (n) { bin = String((int)(n & 1)) + bin; n >>= 1; } out = "0b" + bin; }
  }
  else if (tb == 8) { char buf[16]; snprintf(buf, sizeof(buf), "%lo", num); out = String(buf); }
  else out = String(num);
  return value + " (" + fromBase + ") = " + out + " (" + toBase + ")";
}

