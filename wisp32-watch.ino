void handleSetAiRecording() {
  if (!requireAuth()) return;
  aiRecordAiResponse = server.hasArg("recAi")   && server.arg("recAi")   == "1";
  aiRecordUserInput  = server.hasArg("recUser") && server.arg("recUser") == "1";
  if (!aiRecordAiResponse) aiRecordUserInput = false;
  aiShowOriginTags = server.hasArg("showTags") && server.arg("showTags") == "1";
  if (server.hasArg("replayMode")) aiReplayMode = (uint8_t)constrain(server.arg("replayMode").toInt(), 0, 2);
  if (server.hasArg("replayModel")) { aiReplayMatchModel = server.arg("replayModel"); aiReplayMatchModel.trim(); }
  if (server.hasArg("replayPrompt")) {
    String rp = server.arg("replayPrompt"); rp.trim();
    if (rp.length() == 0 || rp == String(DEFAULT_REPLAY_MATCH_PROMPT)) {
      customReplayMatchPrompt = "";
      if (sdMounted && SD_MMC.exists(PROMPT_REPLAYMATCH_FILE)) SD_MMC.remove(PROMPT_REPLAYMATCH_FILE);
    } else {
      customReplayMatchPrompt = rp;
      if (sdMounted) writeKnowledgeFile(PROMPT_REPLAYMATCH_FILE, rp);
    }
  }
  if (sdMounted) saveSettings();
  server.send(200, "text/plain", "ok");
