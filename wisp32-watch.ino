void handleScreenBmp() {
  if (!requireAuth()) return;
  if (!screenMirrorAvailable) { server.send(503, "text/plain", "Screen mirror unavailable"); return; }

  const int32_t w = LCD_WIDTH, h = LCD_HEIGHT;
  const size_t rowBytes = ((size_t)w * 3 + 3) & ~((size_t)3);
  const uint32_t pixelDataSize = (uint32_t)(rowBytes * (size_t)h);
  const uint32_t fileSize = 14 + 40 + pixelDataSize;

  uint8_t header[54] = {0};
  header[0] = 'B'; header[1] = 'M';
  memcpy(header + 2,  &fileSize, 4);
  uint32_t offBits = 54;
  memcpy(header + 10, &offBits, 4);
  uint32_t infoSize = 40;
  memcpy(header + 14, &infoSize, 4);
  memcpy(header + 18, &w, 4);
  int32_t negH = -h;
  memcpy(header + 22, &negH, 4);
  uint16_t planes = 1, bpp = 24;
  memcpy(header + 26, &planes, 2);
  memcpy(header + 28, &bpp, 2);
  memcpy(header + 34, &pixelDataSize, 4);

  server.setContentLength(fileSize);
  server.send(200, "image/bmp", "");
  WiFiClient client = server.client();
  client.setTimeout(200);
  if (client.write(header, sizeof(header)) != sizeof(header)) return;

  const uint16_t* fb = gfxCanvas->getFramebuffer();
  uint8_t* row = (uint8_t*)ps_malloc(rowBytes);
  if (!row || !fb) { if (row) free(row); return; }
  memset(row, 0, rowBytes);

  for (int32_t y = 0; y < h && client.connected(); y++) {
    const uint16_t* src = fb + (size_t)y * (size_t)w;
    uint8_t* dst = row;
    for (int32_t x = 0; x < w; x++) {
      uint16_t px = src[x];
      uint8_t r5 = (px >> 11) & 0x1F, g6 = (px >> 5) & 0x3F, b5 = px & 0x1F;
      *dst++ = (b5 << 3) | (b5 >> 2);
      *dst++ = (g6 << 2) | (g6 >> 4);
      *dst++ = (r5 << 3) | (r5 >> 2);
    }
    if (client.write(row, rowBytes) != rowBytes) break;
  }
  free(row);
}

void scrRecTaskFn(void* pv) {
  for (;;) {
    if (!scrRecActive) {
      if (!scrRecRing || scrRecRingHead == scrRecRingTail) {
        if (scrRecRing) { free(scrRecRing); scrRecRing = nullptr; scrRecRingCap = 0; }
        scrRecTaskHandle = nullptr;
        vTaskDelete(NULL);
      }
      vTaskDelay(pdMS_TO_TICKS(10));
      continue;
    }

    unsigned long frameStartMs = millis();

    if (frameStartMs - scrRecStartMs >= (unsigned long)SCR_REC_MAX_SECONDS * 1000UL) {
      scrRecLastDurationMs = frameStartMs - scrRecStartMs;
      scrRecActive = false;
      continue;
    }

    size_t used = (scrRecRingHead >= scrRecRingTail)
      ? (scrRecRingHead - scrRecRingTail)
      : (scrRecRingCap - scrRecRingTail + scrRecRingHead);
    size_t freeBytes = scrRecRingCap - used - 4;

    if (freeBytes >= SCR_REC_FRAME_BYTES && gfxCanvas) {
      const uint16_t* fb = gfxCanvas->getFramebuffer();
      if (fb) {
        size_t h = scrRecRingHead;
        size_t cap = scrRecRingCap;
        int srcY = 0, errY = 0;
        for (int y = 0; y < SCR_REC_H; y++) {
          const uint16_t* srcRow = fb + (size_t)srcY * LCD_WIDTH;
          int srcX = 0, errX = 0;
          for (int x = 0; x < SCR_REC_W; x++) {
            uint16_t px = srcRow[srcX];
            scrRecRing[h] = (uint8_t)(px & 0xFF);        h++; if (h >= cap) h = 0;
            scrRecRing[h] = (uint8_t)((px >> 8) & 0xFF); h++; if (h >= cap) h = 0;
            errX += LCD_WIDTH;
            while (errX >= SCR_REC_W) { errX -= SCR_REC_W; srcX++; }
          }
          errY += LCD_HEIGHT;
          while (errY >= SCR_REC_H) { errY -= SCR_REC_H; srcY++; }
        }
        scrRecRingHead = h;
        if (scrFrameTimestamps && scrRecFramesCaptured < SCR_FRAME_MAX_EVENTS) {
          scrFrameTimestamps[scrRecFramesCaptured] = (uint32_t)(frameStartMs - scrRecStartMs);
        }
        scrRecFramesCaptured++;
      }
    }

    long elapsedMs = (long)(millis() - frameStartMs);
    long remainingMs = (long)SCR_REC_PERIOD_MS - elapsedMs;
    vTaskDelay(pdMS_TO_TICKS(remainingMs > 0 ? remainingMs : 1));
  }
}

void scrPumpRecording() {
  if (scrRecFile) {
    size_t avail = (scrRecRingHead >= scrRecRingTail)
      ? (scrRecRingHead - scrRecRingTail)
      : (scrRecRingCap - scrRecRingTail + scrRecRingHead);
    if (avail > 0) {
      size_t toDrain = avail < SCR_REC_DRAIN_MAX_BYTES ? avail : SCR_REC_DRAIN_MAX_BYTES;
      static uint8_t* drainBuf = nullptr;
      if (!drainBuf) drainBuf = (uint8_t*)ps_malloc(SCR_REC_DRAIN_MAX_BYTES);
      if (!drainBuf) {
        Serial.printf("[ScrRec] drain buffer alloc failed, free PSRAM=%u\n", (unsigned)ESP.getFreePsram());
      } else {
        size_t t = scrRecRingTail;
        size_t firstPart = scrRecRingCap - t;
        if (firstPart > toDrain) firstPart = toDrain;
        memcpy(drainBuf, scrRecRing + t, firstPart);
        size_t remaining = toDrain - firstPart;
        if (remaining > 0) memcpy(drainBuf + firstPart, scrRecRing, remaining);
        scrRecRingTail = (t + toDrain) % scrRecRingCap;

        if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
        scrRecFile.write(drainBuf, toDrain);
        if (!scrRecActive) {
          scrRecFile.flush();
        } else {
          static unsigned long lastFlushMs = 0;
          if (millis() - lastFlushMs > 1000) { scrRecFile.flush(); lastFlushMs = millis(); }
        }
        if (_sdMutex) xSemaphoreGive(_sdMutex);
      }
    }
  }

  if (!scrRecActive && !scrRecTaskHandle && scrRecFile) {
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    scrRecFile.close();

    float secs = scrRecLastDurationMs / 1000.0f;
    scrRecActualFps = (secs > 0.05f) ? ((float)scrRecFramesCaptured / secs) : (float)SCR_REC_FPS;
    if (scrRecActualFps < 0.1f) scrRecActualFps = 0.1f;

    int roundedFps = (int)(scrRecActualFps + 0.5f);
    if (roundedFps < 1) roundedFps = 1;
    String newPath = String(SCR_REC_DIR) + "/" + scrRecBaseName + "_" + String(roundedFps) + "fps.raw";
    if (SD_MMC.rename(scrRecLastSavedPath, newPath)) {
      scrRecLastSavedPath = newPath;
    }

    if (scrTapEvents) {
      if (scrTapEventCount > 0) {
        String tapsPath = String(SCR_REC_DIR) + "/" + scrRecBaseName + "_taps.csv";
        File tapsFile = SD_MMC.open(tapsPath, "w");
        if (tapsFile) {
          for (int i = 0; i < scrTapEventCount; i++) {
            tapsFile.printf("%u,%u,%u\n", (unsigned)scrTapEvents[i].ms, (unsigned)scrTapEvents[i].x, (unsigned)scrTapEvents[i].y);
          }
          tapsFile.close();
        }
      }
      free(scrTapEvents);
      scrTapEvents = nullptr;
    }

    if (scrBtnEvents) {
      if (scrBtnEventCount > 0) {
        String btnPath = String(SCR_REC_DIR) + "/" + scrRecBaseName + "_buttons.csv";
        File btnFile = SD_MMC.open(btnPath, "w");
        if (btnFile) {
          for (int i = 0; i < scrBtnEventCount; i++) {
            btnFile.printf("%u,%u,%u\n", (unsigned)scrBtnEvents[i].ms, (unsigned)scrBtnEvents[i].button, (unsigned)scrBtnEvents[i].durationMs);
          }
          btnFile.close();
        }
      }
      free(scrBtnEvents);
      scrBtnEvents = nullptr;
    }

    if (scrSwipeEvents) {
      if (scrSwipeEventCount > 0) {
        String swipesPath = String(SCR_REC_DIR) + "/" + scrRecBaseName + "_swipes.csv";
        File swipesFile = SD_MMC.open(swipesPath, "w");
        if (swipesFile) {
          for (int i = 0; i < scrSwipeEventCount; i++) {
            swipesFile.printf("%u,%d,%d,%d,%d\n", (unsigned)scrSwipeEvents[i].ms,
              (int)scrSwipeEvents[i].x0, (int)scrSwipeEvents[i].y0,
              (int)scrSwipeEvents[i].x1, (int)scrSwipeEvents[i].y1);
          }
          swipesFile.close();
        }
      }
      free(scrSwipeEvents);
      scrSwipeEvents = nullptr;
    }

    if (scrFrameTimestamps) {
      uint32_t frameTsCount = scrRecFramesCaptured;
      if (frameTsCount > SCR_FRAME_MAX_EVENTS) frameTsCount = SCR_FRAME_MAX_EVENTS;
      if (frameTsCount > 0) {
        String framesPath = String(SCR_REC_DIR) + "/" + scrRecBaseName + "_frames.csv";
        File framesFile = SD_MMC.open(framesPath, "w");
        if (framesFile) {
          for (uint32_t i = 0; i < frameTsCount; i++) {
            framesFile.printf("%u\n", (unsigned)scrFrameTimestamps[i]);
          }
          framesFile.close();
        }
      }
      free(scrFrameTimestamps);
      scrFrameTimestamps = nullptr;
    }

    if (_sdMutex) xSemaphoreGive(_sdMutex);
  }
}

void scrStartRecording() {
  if (scrRecActive || scrRecTaskHandle != nullptr) return;
  if (!screenMirrorAvailable) return;

  wakeDisplay();

  scrRecRingHead = 0;
  scrRecRingTail = 0;
  scrRecFramesCaptured = 0;
  if (!scrRecRing) scrRecRing = (uint8_t*)ps_malloc(SCR_REC_RING_BYTES);
  if (!scrRecRing) return;
  scrRecRingCap = SCR_REC_RING_BYTES;

  if (!scrTapEvents) scrTapEvents = (ScrTapEvent*)ps_malloc(sizeof(ScrTapEvent) * SCR_TAP_MAX_EVENTS);
  scrTapEventCount = 0;
  if (!scrBtnEvents) scrBtnEvents = (ScrButtonEvent*)ps_malloc(sizeof(ScrButtonEvent) * SCR_BTN_MAX_EVENTS);
  scrBtnEventCount = 0;
  scrBtnPressEdgeMs = 0;
  if (!scrSwipeEvents) scrSwipeEvents = (ScrSwipeEvent*)ps_malloc(sizeof(ScrSwipeEvent) * SCR_SWIPE_MAX_EVENTS);
  scrSwipeEventCount = 0;
  if (!scrFrameTimestamps) scrFrameTimestamps = (uint32_t*)ps_malloc(sizeof(uint32_t) * SCR_FRAME_MAX_EVENTS);

  time_t now = time(NULL);
  struct tm lt; localtime_r(&now, &lt);
  char tsBuf[16]; strftime(tsBuf, sizeof(tsBuf), "%Y%m%d_%H%M%S", &lt);
  scrRecBaseName = "screenrec_" + String(tsBuf) + "_" + String(SCR_REC_W) + "x" + String(SCR_REC_H);
  String path = String(SCR_REC_DIR) + "/" + scrRecBaseName + "_" + String(SCR_REC_FPS) + "fps.raw";

  if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
  if (!SD_MMC.exists(SCR_REC_DIR)) SD_MMC.mkdir(SCR_REC_DIR);
  scrRecFile = SD_MMC.open(path, "w");
  if (_sdMutex) xSemaphoreGive(_sdMutex);
  if (!scrRecFile) {
    free(scrRecRing); scrRecRing = nullptr; scrRecRingCap = 0;
    return;
  }

  scrRecLastSavedPath = path;
  scrRecStartMs = millis();
  scrRecActive = true;

  BaseType_t ok = xTaskCreatePinnedToCore(scrRecTaskFn, "scrRecord", 4096, NULL, 1, &scrRecTaskHandle, 1);
  if (ok != pdPASS) {
    scrRecActive = false;
    scrRecTaskHandle = nullptr;
    free(scrRecRing); scrRecRing = nullptr; scrRecRingCap = 0;
    if (_sdMutex) xSemaphoreTake(_sdMutex, portMAX_DELAY);
    scrRecFile.close();
    SD_MMC.remove(path);
    if (_sdMutex) xSemaphoreGive(_sdMutex);
    scrRecLastSavedPath = "";
  }
}

void scrStopRecording() {
  if (scrRecActive) scrRecLastDurationMs = millis() - scrRecStartMs;
  scrRecActive = false;
}

void handleScreenRecStart() {
  if (!requireAuth()) return;
  scrStartRecording();
  server.sendHeader("Location", "/screen");
  server.send(303);
}

void handleScreenRecStop() {
  if (!requireAuth()) return;
  scrStopRecording();
  server.sendHeader("Location", "/screen");
  server.send(303);
}

void handleScreenDemoTime() {
  if (!requireAuth()) return;
  String dt = server.hasArg("dt") ? server.arg("dt") : "";
  int y = 0, mo = 0, d = 0, h = 0, mi = 0;
  if (sscanf(dt.c_str(), "%d-%d-%dT%d:%d", &y, &mo, &d, &h, &mi) == 5) {
    struct tm t = {0};
    t.tm_year = y - 1900;
    t.tm_mon  = mo - 1;
    t.tm_mday = d;
    t.tm_hour = h;
    t.tm_min  = mi;
    time_t targetEpoch = utcTmToEpoch(&t) - (-4 * 3600);
    struct timeval tv = { targetEpoch, 0 };
    settimeofday(&tv, NULL);
  }
  server.sendHeader("Location", "/screen");
  server.send(303);
}

void handleScreenDemoKeepOn() {
  if (!requireAuth()) return;
  demoForceScreenOn = server.hasArg("on") && server.arg("on") == "1";
  if (demoForceScreenOn && !displayOn) wakeDisplay();
  server.sendHeader("Location", "/screen");
  server.send(303);
}

void handleApiFile() {
  if (!requireAuth()) return;
  if (!server.hasArg("path")) { server.send(400, "text/plain", "missing path"); return; }
  String path = server.arg("path");
  if (!path.startsWith("/") || path.indexOf("..") >= 0) { server.send(400, "text/plain", "bad path"); return; }
  if (!sdMounted) { server.send(503, "text/plain", "SD not mounted"); return; }
  if (!SD_MMC.exists(path)) { server.send(404, "text/plain", "not found"); return; }

  File f = SD_MMC.open(path, FILE_READ);
  if (!f) { server.send(500, "text/plain", "open failed"); return; }
  size_t fileSize = f.size();
  uint8_t* buf = (uint8_t*)ps_malloc(fileSize + 1);
  if (!buf) { f.close(); server.send(500, "text/plain", "out of memory"); return; }
  size_t n = f.read(buf, fileSize);
  buf[n] = 0;
  f.close();

  String content;
  if (n >= (size_t)ENCRYPT_MAGIC_LEN && memcmp(buf, ENCRYPT_MAGIC, ENCRYPT_MAGIC_LEN) == 0) {
    size_t decLen = 0;
    uint8_t* dec = aesDecryptBinary(buf, n, &decLen);
    free(buf);
    if (!dec) { server.send(500, "text/plain", "decrypt failed"); return; }
    content = String((char*)dec).substring(0, decLen);
    free(dec);
  } else {
    content = String((char*)buf).substring(0, n);
    free(buf);
  }

  String ct = path.endsWith(".json") ? "application/json" : "text/plain";
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.send(200, ct, content);
}

