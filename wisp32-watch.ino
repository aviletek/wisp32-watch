    SD_MMC.end();
    sdMounted = false;
  }
  while (digitalRead(WAKE_BUTTON_PIN) == LOW) delay(10);
  delay(50);
  esp_sleep_enable_ext0_wakeup((gpio_num_t)WAKE_BUTTON_PIN, 0);
  long alarmSecs = secondsUntilNextAlarm();
  long taskSecs = secondsUntilNextTaskDue();
  long wakeSecs = alarmSecs;
  if (taskSecs >= 0 && (wakeSecs < 0 || taskSecs < wakeSecs)) wakeSecs = taskSecs;
  if (wakeSecs < 0 || wakeSecs > 2) wakeSecs = 2;
  if (wakeSecs < 1) wakeSecs = 1;
  esp_sleep_enable_timer_wakeup((uint64_t)wakeSecs * 1000000ULL);
  esp_deep_sleep_start();
}

