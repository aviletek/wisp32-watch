        largeFileContent = "";
        largeFileContentReleased = true;
      }
    } else {
      Serial.println("[AI] file Q&A (gemini): fresh request carried no document — chain NOT anchored to it");
      largeFileLastInteractionId = "";
    }
    int fqgInTok = res["usage"]["total_input_tokens"] | 0;
    int fqgCachedTok = res["usage"]["total_cached_tokens"] | 0;
    int fqgOutTok = res["usage"]["total_output_tokens"] | 0;
    int fqgThoughtTok = res["usage"]["total_thought_tokens"] | 0;
    int fqgTotalTok = res["usage"]["total_tokens"] | 0;
    Serial.printf("[AI] ask_file_question (gemini): status=%s id_len=%u tokens input=%d (cached=%d) output=%d (thought=%d) total=%d\n",
                  (const char*)(res["status"] | "?"), (unsigned)largeFileLastInteractionId.length(),
                  fqgInTok, fqgCachedTok, fqgOutTok, fqgThoughtTok, fqgTotalTok);
