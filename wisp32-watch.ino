String kbFindRestrictingPin(String relPath) {
  if (!sdMounted) return "";
  String cur = relPath;
  while (true) {
    String pwPath = String(KNOWLEDGE_DIR) + "/" + cur + ".pwd";
    if (SD_MMC.exists(pwPath)) {
      bool wasPlaintext = false;
      return readSecretFile(pwPath, &wasPlaintext);
    }
    int ls = cur.lastIndexOf('/');
    if (ls < 0) break;
    cur = cur.substring(0, ls);
  }
  return "";
}

