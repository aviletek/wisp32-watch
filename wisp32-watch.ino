    bool a = (strcmp(href, active) == 0) ||
             (strcmp(href, "/settings") == 0 && isSettingsSubpage()) ||
             (strcmp(href, "/tasks") == 0 && isTasksSubpage());
    return String("<a href='") + href + "' class='nb" + (a ? " nba" : "") + "'>" + icon + label + "</a>";
