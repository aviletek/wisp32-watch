void handleSaveAiModels() {
  if (!requireAuth()) return;
  auto setIfModel = [&](const char* field, String& target) {
    if (!server.hasArg(field)) return;
    String v = server.arg(field); v.trim(); v.toLowerCase();
    if (v.length() == 0) return;
    String filtered = "";
    int start = 0;
    while (start <= (int)v.length()) {
      int comma = v.indexOf(',', start);
      String entry = (comma < 0) ? v.substring(start) : v.substring(start, comma);
      entry.trim();
      if (entry.length() > 0 && aiModelIsGemini(entry)) {
        if (filtered.length() > 0) filtered += ",";
        filtered += entry;
      }
      if (comma < 0) break;
      start = comma + 1;
    }
    if (filtered.length() > 0) target = filtered;
  };
  auto setIf = [&](const char* field, String& target) {
    if (server.hasArg(field)) { String v = server.arg(field); v.trim(); if (v.length() > 0) target = v; }
  };
  setIfModel("taskModels", activeTaskModelsList);
  setIfModel("webSearchModels", activeWebSearchModelsList);
  setIfModel("voiceToTextModels", activeVoiceToTextModelsList);
  setIfModel("noteTitleModels", activeNoteTitleModelsList);
  setIfModel("translatorModels", activeTranslatorModelsList);
  setIfModel("realtimeModels", activeRealtimeModelsList);
  setIfModel("fileQaModels", activeFileQaModelsList);
  setIfModel("deepThinkModels", activeDeepThinkModelsList);
  setIf("geminiVoices", activeGeminiVoicesList);
  setIf("effortLevels", activeEffortLevelsList);
  setIf("fileQaEffort", aiFileQaEffort);
  setIf("deepThinkEffort", aiDeepThinkEffort);
  parseRealtimeModelsList();
  aiRealtimeModel = aiRealtimeModels[aiModelIndex];
  parseFileQaModelsList();
  if (aiFileAnalysisEnabled) {
    aiFileQaModelIndex = 1;
    for (int i = 0; i < aiFileQaModelCount; i++) {
      if (activeFileQaModel == aiFileQaModels[i]) { aiFileQaModelIndex = i + 1; break; }
    }
    activeFileQaModel = aiFileQaModels[aiFileQaModelIndex - 1];
  }
  parseDeepThinkModelsList();
  if (aiDeepThinkEnabled) {
    aiDeepThinkModelIndex = 1;
    for (int i = 0; i < aiDeepThinkModelCount; i++) {
      if (activeDeepThinkModel == aiDeepThinkModels[i]) { aiDeepThinkModelIndex = i + 1; break; }
    }
    activeDeepThinkModel = aiDeepThinkModels[aiDeepThinkModelIndex - 1];
  }
  parseTaskModelsList();
  parseWebSearchModelsList();
  if (aiWebSearchEnabled) {
    aiWebSearchModelIndex = 1;
    for (int i = 0; i < aiWebSearchModelCount; i++) {
      if (activeWebSearchModel == aiWebSearchModels[i]) { aiWebSearchModelIndex = i + 1; break; }
    }
    activeWebSearchModel = aiWebSearchModels[aiWebSearchModelIndex - 1];
  }
  parseTranslatorModelsList();
  if (aiTranslatorEnabled) {
    aiTranslatorModelIndex = 1;
    for (int i = 0; i < aiTranslatorModelCount; i++) {
      if (activeTranslatorRealtimeModel == aiTranslatorModels[i]) { aiTranslatorModelIndex = i + 1; break; }
    }
    activeTranslatorRealtimeModel = aiTranslatorModels[aiTranslatorModelIndex - 1];
  }
  parseVoiceToTextModelsList();
  if (aiVoiceToTextEnabled) {
    int idx = 1;
    for (int i = 0; i < aiVoiceToTextModelCount; i++) {
      if (activeVoiceToTextModel == aiVoiceToTextModels[i]) { idx = i + 1; break; }
    }
    aiVoiceToTextModelIndex = idx;
    activeVoiceToTextModel = aiVoiceToTextModels[aiVoiceToTextModelIndex - 1];
  }
  parseNoteTitleModelsList();
  if (aiNoteTitleEnabled) {
    int idx = 1;
    for (int i = 0; i < aiNoteTitleModelCount; i++) {
      if (activeNoteTitleModel == aiNoteTitleModels[i]) { idx = i + 1; break; }
    }
    aiNoteTitleModelIndex = idx;
    activeNoteTitleModel = aiNoteTitleModels[aiNoteTitleModelIndex - 1];
  }
  parseGeminiVoicesList();
  aiGeminiVoice = aiGeminiVoices[aiGeminiVoiceIndex];
  parseEffortLevelsList();
  saveSettings();
  redirectWithSaveMessage("/aimodels", "Saved");
}

void handleAiModelTest() {
  if (!requireAuth()) return;
  String kind  = server.hasArg("kind")  ? server.arg("kind")  : "";
  String model = server.hasArg("model") ? server.arg("model") : "";
  model.trim();
  model.toLowerCase();
  if (model.length() == 0) { server.send(200, "application/json", "{\"ok\":false,\"error\":\"No model given\"}"); return; }

  Serial.printf("[Web] aimodels test: kind=%s model=%s\n", kind.c_str(), model.c_str());
  if (_netMutex) xSemaphoreTake(_netMutex, portMAX_DELAY);
  int code = -1;
  String err;

  if (kind == "websearch") {
    if (aiModelIsGemini(model)) {
      HTTPClient http;
      http.begin("https://generativelanguage.googleapis.com/v1beta/interactions?key=" + activeGeminiKey);
      http.setTimeout(20000);
      http.addHeader("Content-Type", "application/json");
      String payload = "{\"model\":\"" + model + "\",\"input\":\"Reply with OK.\","
                        "\"tools\":[{\"type\":\"google_search\"}]}";
      code = http.POST(payload);
      if (code != 200) err = "HTTP " + String(code);
      http.end();
    } else {
      err = "Only Gemini models are supported";
    }
  } else if (kind == "fileqa") {
    String levelResults = "[";
    bool allOk = true;
    String failedLevels = "";
    for (int i = 0; i < aiEffortLevelCount; i++) {
      int lvlCode;
      if (aiModelIsGemini(model)) {
        HTTPClient http;
        http.begin("https://generativelanguage.googleapis.com/v1beta/interactions?key=" + activeGeminiKey);
        http.setTimeout(20000);
        http.addHeader("Content-Type", "application/json");
        bool sendEffort = (String(aiEffortLevels[i]) == "minimal" || String(aiEffortLevels[i]) == "low" ||
                            String(aiEffortLevels[i]) == "medium" || String(aiEffortLevels[i]) == "high");
        String payload = "{\"model\":\"" + model + "\",\"input\":\"Reply with OK.\"";
        if (sendEffort) payload += ",\"generation_config\":{\"thinking_level\":\"" + String(aiEffortLevels[i]) + "\"}";
        payload += "}";
        lvlCode = http.POST(payload);
        http.end();
      } else {
        lvlCode = -1;
      }
      bool lvlOk = (lvlCode == 200);
      Serial.printf("[Web] aimodels test: fileqa model=%s level=%s HTTP %d\n",
                    model.c_str(), aiEffortLevels[i], lvlCode);
      if (i > 0) levelResults += ",";
      levelResults += "{\"level\":\"" + jsonEscape(aiEffortLevels[i]) + "\",\"ok\":" + (lvlOk ? "true" : "false") + "}";
      if (!lvlOk) {
        allOk = false;
        failedLevels += (failedLevels.length() > 0 ? ", " : "") + String(aiEffortLevels[i]);
      }
    }
    levelResults += "]";
    if (_netMutex) xSemaphoreGive(_netMutex);
    String errMsg = allOk ? "" : ("Failed at effort level(s): " + failedLevels);
    Serial.printf("[Web] aimodels test result: kind=fileqa model=%s ok=%s err=%s\n",
                  model.c_str(), allOk ? "true" : "false", errMsg.c_str());
    server.send(200, "application/json", String("{\"ok\":") + (allOk ? "true" : "false")
      + ",\"error\":\"" + jsonEscape(errMsg) + "\",\"levels\":" + levelResults + "}");
    return;
  } else if (kind == "notetitle") {
    if (aiModelIsGemini(model)) {
      HTTPClient http;
      String url = "https://generativelanguage.googleapis.com/v1beta/models/" + model
                   + ":generateContent?key=" + activeGeminiKey;
      http.begin(url);
      http.setTimeout(15000);
      http.addHeader("Content-Type", "application/json");
      String payload = "{\"contents\":[{\"parts\":[{\"text\":\"Reply with OK.\"}]}],"
                       "\"generationConfig\":{\"maxOutputTokens\":5}}";
      code = http.POST(payload);
      if (code != 200) err = "HTTP " + String(code);
      http.end();
    } else {
      err = "Only Gemini models are supported";
    }
  } else if (kind == "deepthink") {
    String levelResults = "[";
    bool allOk = true;
    String failedLevels = "";
    for (int i = 0; i < aiEffortLevelCount; i++) {
      int lvlCode;
      if (aiModelIsGemini(model)) {
        HTTPClient http;
        http.begin("https://generativelanguage.googleapis.com/v1beta/interactions?key=" + activeGeminiKey);
        http.setTimeout(20000);
        http.addHeader("Content-Type", "application/json");
        bool sendEffort = (String(aiEffortLevels[i]) == "minimal" || String(aiEffortLevels[i]) == "low" ||
                            String(aiEffortLevels[i]) == "medium" || String(aiEffortLevels[i]) == "high");
        String payload = "{\"model\":\"" + model + "\",\"input\":\"Reply with OK.\"";
        if (sendEffort) payload += ",\"generation_config\":{\"thinking_level\":\"" + String(aiEffortLevels[i]) + "\"}";
        payload += "}";
        lvlCode = http.POST(payload);
        http.end();
      } else {
        lvlCode = -1;
      }
      bool lvlOk = (lvlCode == 200);
      Serial.printf("[Web] aimodels test: deepthink model=%s level=%s HTTP %d\n",
                    model.c_str(), aiEffortLevels[i], lvlCode);
      if (i > 0) levelResults += ",";
      levelResults += "{\"level\":\"" + jsonEscape(aiEffortLevels[i]) + "\",\"ok\":" + (lvlOk ? "true" : "false") + "}";
      if (!lvlOk) {
        allOk = false;
        failedLevels += (failedLevels.length() > 0 ? ", " : "") + aiEffortLevels[i];
      }
    }
    levelResults += "]";
    if (_netMutex) xSemaphoreGive(_netMutex);
    String errMsg = allOk ? "" : ("Failed at effort level(s): " + failedLevels);
    server.send(200, "application/json", String("{\"ok\":") + (allOk ? "true" : "false")
      + ",\"error\":\"" + jsonEscape(errMsg) + "\",\"levels\":" + levelResults + "}");
    return;
  } else if (kind == "realtime") {
    if (aiModelIsGemini(model)) {
      HTTPClient http;
      http.begin("https://generativelanguage.googleapis.com/v1beta/models/" + model + "?key=" + activeGeminiKey);
      http.setTimeout(15000);
      code = http.GET();
      if (code != 200) err = "HTTP " + String(code);
      http.end();
    } else {
      err = "Only Gemini models are supported";
    }
  } else if (kind == "transcribe" && aiModelIsGemini(model)) {
    const uint32_t sr = 16000;
    const size_t samples = sr / 2;
    size_t dataLen = samples * sizeof(int16_t);
    uint8_t* wav = (uint8_t*)malloc(44 + dataLen);
    if (!wav) { err = "Out of memory"; }
    else {
      noteBuildWavHeader(wav, (uint32_t)dataLen, sr, 1);
      {
        int16_t* pcm = (int16_t*)(wav + 44);
        for (size_t i = 0; i < samples; i++) {
          pcm[i] = (int16_t)(2000.0f * sinf(2.0f * PI * 440.0f * i / sr));
        }
      }
      size_t wavLen = 44 + dataLen;
      size_t b64Cap = ((wavLen + 2) / 3) * 4 + 4;
      uint8_t* b64buf = (uint8_t*)malloc(b64Cap);
      if (!b64buf) { err = "Out of memory"; free(wav); }
      else {
        size_t b64Len = 0;
        int rc = mbedtls_base64_encode(b64buf, b64Cap, &b64Len, wav, wavLen);
        free(wav);
        if (rc != 0) { err = "Base64 encode failed"; free(b64buf); }
        else {
          String payload;
          payload.reserve(b64Len + 200);
          payload += "{\"contents\":[{\"parts\":[{\"text\":\"Transcribe this audio.\"},"
                     "{\"inline_data\":{\"mime_type\":\"audio/wav\",\"data\":\"";
          payload += String((const char*)b64buf, b64Len);
          payload += "\"}}]}]}";
          free(b64buf);
          HTTPClient http;
          String url = "https://generativelanguage.googleapis.com/v1beta/models/" + model
                       + ":generateContent?key=" + activeGeminiKey;
          http.begin(url);
          http.setTimeout(20000);
          http.addHeader("Content-Type", "application/json");
          code = http.POST(payload);
          if (code != 200) err = "HTTP " + String(code);
          http.end();
        }
      }
    }
  } else if (kind == "transcribe") {
    err = "Only Gemini models are supported";
  } else {
    err = "Unknown test kind";
  }
  if (_netMutex) xSemaphoreGive(_netMutex);

  Serial.printf("[Web] aimodels test result: kind=%s model=%s code=%d err=%s\n",
                kind.c_str(), model.c_str(), code, err.c_str());
  bool ok = (code == 200);
  server.send(200, "application/json", String("{\"ok\":") + (ok ? "true" : "false") + ",\"error\":\"" + jsonEscape(err) + "\"}");
}

