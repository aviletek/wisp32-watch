static void resolveNavOrder(int* orderOut, int* countOut) {
  bool used[NAV_TAB_COUNT];
  for (int i = 0; i < NAV_TAB_COUNT; i++) used[i] = false;
  int n = 0;
  String s = activeNavOrder;
  int start = 0;
  while (start < (int)s.length() && n < NAV_TAB_COUNT) {
    int comma = s.indexOf(',', start);
    String key = (comma >= 0) ? s.substring(start, comma) : s.substring(start);
    key.trim();
    for (int i = 0; i < NAV_TAB_COUNT; i++) {
      if (!used[i] && key == NAV_TABS[i].key) { orderOut[n++] = i; used[i] = true; break; }
    }
    if (comma < 0) break;
    start = comma + 1;
  }
  for (int i = 0; i < NAV_TAB_COUNT; i++) {
    if (!used[i]) orderOut[n++] = i;
  }
  *countOut = n;
}

static const char* firstNavTabHref() {
  int order[NAV_TAB_COUNT], orderCount;
  resolveNavOrder(order, &orderCount);
  return NAV_TABS[(orderCount > 0) ? order[0] : 0].href;
}
static const char* firstNavTabLabel() {
  int order[NAV_TAB_COUNT], orderCount;
  resolveNavOrder(order, &orderCount);
  return NAV_TABS[(orderCount > 0) ? order[0] : 0].label;
}

